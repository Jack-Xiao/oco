{
  "$schema": "https://opencode.ai/config.json",
  "model": "oco-mock/mock",
  "small_model": "oco-mock/mock",
  "autoupdate": false,
  "share": "disabled",
  "permission": { "bash": "ask", "edit": "ask" },
  "provider": {
    "oco-mock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCO Mock",
      "options": { "baseURL": "http://127.0.0.1:4518/v1", "apiKey": "mock" },
      "models": {
        "mock": { "name": "OCO Mock", "tool_call": true, "attachment": true, "modalities": { "input": ["text", "image"], "output": ["text"] }, "limit": { "context": 128000, "output": 16000 } }
      }
    }
  }
}
