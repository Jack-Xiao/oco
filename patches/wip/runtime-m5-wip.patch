+    expect(list.groups.map((g) => [g.round, g.current, g.rows.length])).toEqual([
+      [2, false, 2],
+      [3, true, 2],
+    ])
+    expect(list.groups[1].rows.find((r) => r.uid === "ses_3_2")).toEqual({ uid: "ses_3_2", num: 2, state: "queued" })
+    expect(subListAt(subs, 1791105745936).total).toBe(0)
+    expect(subListAt(subs, 1791105745936).groups).toEqual([])
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-ring-sub.ts b/packages/app/src/components/session/session-runtime-ring-sub.ts
new file mode 100644
index 0000000..5c5701a
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-sub.ts
@@ -0,0 +1,296 @@
+// oco (patches/opencode/0019): M5 runtime ring — subagent state, detail panel and list as pure functions of t.
+// Every query reads only facts at or before t (D16, D2): a field whose time is later than t is never looked at,
+// so the result equals the one computed from data truncated at t. No geometry, no copy (keys only).
+import { LOOP_CONTINUE } from "./session-runtime-ring-types"
+import type {
+  Phrase,
+  PhraseParam,
+  RingChild,
+  RingSub,
+  RingSubAct,
+  RingSubDetail,
+  RingSubList,
+  RingTool,
+  SubState,
+} from "./session-runtime-ring-types"
+import type { RuntimeKey } from "./session-runtime-i18n"
+
+const ph = (key: RuntimeKey, params?: Record<string, PhraseParam>): Phrase => (params ? { key, params } : { key })
+const at = (v: number | undefined, t: number): v is number => v !== undefined && v <= t
+
+/** One-line preview: only whitespace is merged; `**` and backticks stay (mockup cutRaw L1172). */
+const cutRaw = (s: string | undefined, n: number) => {
+  const a = [
+    ...String(s ?? "")
+      .replace(/\s+/g, " ")
+      .trim(),
+  ]
+  return a.length > n ? a.slice(0, n - 1).join("") + "…" : a.join("")
+}
+const stripTags = (s: string | undefined) =>
+  String(s ?? "")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/\s+/g, " ")
+    .trim()
+
+/** The child's newest assistant message created at or before t. */
+function latestMessage(child: RingChild, t: number) {
+  let best: RingChild["messages"][number] | undefined
+  for (const m of child.messages) if (m.created <= t && (!best || m.created >= best.created)) best = m
+  return best
+}
+
+/** D16: when the child session finished, judged only from data at or before t. The newest child request created
+ *  at or before t must have completed by t, and either failed or ended the loop (`finish` not in LOOP_CONTINUE,
+ *  the same predicate as D5). Between steps (`tool-calls`) and with the child not loaded: undefined. */
+export function childDoneAt(sub: RingSub, t: number): number | undefined {
+  if (!sub.child) return undefined
+  const c = latestMessage(sub.child, t)
+  if (!c || !at(c.completed, t)) return undefined
+  if (c.error) return c.completed
+  if (c.finish !== undefined && !LOOP_CONTINUE.includes(c.finish)) return c.completed
+  return undefined
+}
+
+type Phase = {
+  state: SubState
+  /** docked: when the child finished (childDoneAt, else the latest done notice) */
+  dock?: number
+  /** done / err: when it was collected or failed */
+  fin?: number
+}
+
+/** Latest background notice at or before t (a `cleared` one resets the state to running). */
+function noticeAt(sub: RingSub, t: number) {
+  let last: NonNullable<RingSub["background"]>["notices"][number] | undefined
+  for (const n of sub.background?.notices ?? []) if (n.at <= t) last = n
+  return last
+}
+
+function phaseAt(sub: RingSub, t: number): Phase | undefined {
+  if (sub.created > t) return undefined
+  const bg = sub.background
+  if (!bg) {
+    if (at(sub.end, t)) return { state: sub.failed ? "err" : "done", fin: sub.end }
+    if (!at(sub.start, t)) return { state: "queued" }
+    const dock = childDoneAt(sub, t)
+    return dock !== undefined ? { state: "docked", dock } : { state: "run" }
+  }
+  // Background: the task part ends as soon as it hands back the task id; that end is not a pickup.
+  if (at(sub.end, t) && sub.failed) return { state: "err", fin: sub.end }
+  if (at(bg.retrievedAt, t)) return { state: "done", fin: bg.retrievedAt }
+  const last = noticeAt(sub, t)
+  if (last && (last.kind === "error" || last.kind === "cancelled")) return { state: "err", fin: last.at }
+  if (!at(sub.start, t)) return { state: "queued" }
+  const done = childDoneAt(sub, t)
+  const cleared = last?.kind === "cleared" ? last.at : undefined
+  if (done !== undefined && (cleared === undefined || done >= cleared)) return { state: "docked", dock: done }
+  if (last?.kind === "done") return { state: "docked", dock: last.at }
+  return { state: "run" }
+}
+
+/** D16 state at t; undefined while the task call is not created yet. */
+export function subStateAt(sub: RingSub, t: number): SubState | undefined {
+  return phaseAt(sub, t)?.state
+}
+
+/** Probe stage names kept from M4 for E2E: done/err are both absorbed (err additionally carries flag=error). */
+export function probeStageOfSub(state: SubState): "queued" | "running" | "docked" | "absorbed" {
+  if (state === "queued") return "queued"
+  if (state === "run") return "running"
+  if (state === "docked") return "docked"
+  return "absorbed"
+}
+
+/** Name, @type and handoff come from the task call's arguments: shown only once they are written (t >= start). */
+const argsIn = (sub: RingSub, t: number) => at(sub.start, t)
+const begin = (sub: RingSub) => sub.start ?? sub.created
+const took = (sub: RingSub, fin: number) => fin - begin(sub)
+
+function stateLineOf(sub: RingSub, p: Phase, t: number): Phrase {
+  switch (p.state) {
+    case "queued":
+      return ph("ring.sub.queued.line", { dur: { ms: t - sub.created }, agent: sub.agent })
+    case "run":
+      // No duration-only key exists yet; the cell's own wording is reused (see the Task 6 report).
+      return ph("ring.sub.cell.run", { dur: { ms: t - begin(sub) } })
+    case "docked": {
+      const dock = p.dock ?? t
+      return ph("ring.sub.docked.line", {
+        dur: { ms: t - begin(sub) },
+        done: { ms: dock - begin(sub) },
+        wait: { ms: t - dock },
+      })
+    }
+    case "done":
+      return ph("ring.sub.took", { dur: { ms: took(sub, p.fin ?? t) }, at: { at: p.fin ?? t } })
+    case "err":
+      return ph("ring.sub.tookErr", { dur: { ms: took(sub, p.fin ?? t) }, at: { at: p.fin ?? t } })
+  }
+}
+
+/** Second status line: origin, then the child's model / request count / cost at t; empty parts are omitted. */
+function secondOf(sub: RingSub, t: number): Phrase[] {
+  const out: Phrase[] = [ph("ring.sub.origin", { r: sub.round, q: sub.request, at: { at: sub.created } })]
+  const child = sub.child
+  if (!child) return out
+  const model = latestMessage(child, t)?.model
+  if (model) out.push(ph("ring.sub.model", { model }))
+  const n = child.messages.reduce((s, m) => s + (m.created <= t ? 1 : 0), 0)
+  if (n) out.push(ph("ring.sub.requests", { n }))
+  const cost = child.messages.reduce((s, m) => s + (at(m.completed, t) ? m.cost || 0 : 0), 0)
+  if (cost) out.push(ph("ring.sub.cost", { cost: { usd: cost } }))
+  return out
+}
+
+/** A child tool call as a panel row: pend while its arguments stream, run, then ok / err once it ended. */
+function toolAct(tool: RingTool, t: number): RingSubAct {
+  if (at(tool.end, t)) {
+    const durMs = tool.end - (tool.start ?? tool.created)
+    const arg = tool.arg
+    if (tool.declined) {
+      // D18: a declined permission / dismissed question is not a failure: neutral border, neutral text
+      // (你已拒绝授权 / 已忽略), never the raw error. The contract glyph union has no "⊘"; "✗" with the
+      // line-strong border only occurs here, so the view can draw it as the neutral ⊘.
+      const line2 = tool.declined === "rejected" ? ph("ring.tools.row.rejected") : ph("ring.card.kind.dismissed")
+      return { kind: "tool", id: tool.id, glyph: "✗", name: tool.name, arg, durMs, line2, border: "line-strong" }
+    }
+    if (tool.status === "error")
+      return {
+        kind: "tool",
+        id: tool.id,
+        glyph: "✗",
+        name: tool.name,
+        arg,
+        durMs,
+        line2: ph("ring.tools.row.err", { error: cutRaw(tool.error, 90) }),
+        border: "err",
+      }
+    const head = cutRaw(stripTags(tool.output), 80)
+    return {
+      kind: "tool",
+      id: tool.id,
+      glyph: "✓",
+      name: tool.name,
+      arg,
+      durMs,
+      line2: ph("ring.tools.row.ok", { n: tool.chars, head: head || ph("ring.tools.row.empty") }),
+      border: "ok",
+    }
+  }
+  if (at(tool.start, t)) {
+    const durMs = t - tool.start
+    return {
+      kind: "tool",
+      id: tool.id,
+      glyph: "●",
+      name: tool.name,
+      arg: tool.arg,
+      durMs,
+      line2: ph("ring.tools.row.run", { dur: { ms: durMs } }),
+      border: "sub",
+    }
+  }
+  // arguments still streaming: the view shows ring.tools.args.pending for the empty arg
+  return {
+    kind: "tool",
+    id: tool.id,
+    glyph: "…",
+    name: tool.name,
+    arg: "",
+    line2: ph("ring.tools.row.pend"),
+    border: "line-strong",
+  }
+}
+
+/** Detail panel content at t (D16, D2). Undefined while the task call is not created yet (the panel closes). */
+export function subDetailAt(
+  sub: RingSub,
+  t: number,
+  opts: { narrow: boolean; childLoad?: "loading" | "failed"; live?: boolean },
+): RingSubDetail | undefined {
+  const p = phaseAt(sub, t)
+  if (!p) return undefined
+  const ain = argsIn(sub, t)
+  const child = sub.child
+
+  // its own activity: tool calls and text, verbatim, newest last
+  const shown = child ? child.acts.filter((a) => a.at <= t) : []
+  const max = opts.narrow ? 4 : 6
+  const more = Math.max(0, shown.length - max)
+  const items: RingSubAct[] = shown.slice(more).map((a) => {
+    if (a.kind === "tool") return toolAct(a.tool, t)
+    const ended = at(a.span.end, t)
+    // D2: replay shows nothing of a span still streaming at t; live shows what has arrived, with a caret.
+    if (opts.live) return { kind: "text", id: a.span.partID, text: a.span.text, streaming: !ended }
+    return { kind: "text", id: a.span.partID, text: ended ? a.span.text : "", streaming: !ended }
+  })
+  const think = p.state === "run" && child ? child.thinks.find((k) => k.start <= t && !at(k.end, t)) : undefined
+  const acts: RingSubDetail["acts"] = { more, items }
+  if (think) acts.thinkingMs = t - think.start
+  if (opts.childLoad) acts.loading = opts.childLoad
+  if (!items.length && !think) {
+    acts.empty =
+      !child && opts.childLoad === "loading"
+        ? ph("child.loading")
+        : !child && opts.childLoad === "failed"
+          ? ph("child.sync_failed")
+          : p.state === "queued"
+            ? ph("ring.sub.acts.notStarted")
+            : p.state === "run"
+              ? ph("ring.sub.acts.noneYet")
+              : ph("ring.sub.acts.none")
+  }
+
+  const result: RingSubDetail["result"] =
+    p.state === "done"
+      ? { text: sub.result ?? "" }
+      : p.state === "err"
+        ? { error: sub.error ?? "" }
+        : p.state === "docked"
+          ? { note: ph("ring.sub.result.docked", { agent: sub.agent }) }
+          : { note: ph("ring.sub.result.wait") }
+
+  const canOpen = ain && !!sub.sessionID
+  const detail: RingSubDetail = {
+    uid: sub.uid,
+    num: sub.num,
+    state: p.state,
+    stateLine: stateLineOf(sub, p, t),
+    second: secondOf(sub, t),
+    handoff: ain ? { text: sub.prompt } : { pending: ph("ring.sub.handoff.pending", { agent: sub.agent }) },
+    acts,
+    result,
+    open: canOpen
+      ? { enabled: true, note: ph("ring.sub.open.note", { id: sub.sessionID! }) }
+      : { enabled: false, note: ph("ring.sub.open.disabled") },
+  }
+  if (ain) detail.name = sub.name
+  if (ain && sub.type) detail.type = sub.type
+  return detail
+}
+
+/** "Subagents in this session" list at t: task calls created at or before t, grouped by round ascending. */
+export function subListAt(subs: readonly RingSub[], t: number, currentRound?: number): RingSubList {
+  const groups = new Map<number, RingSubList["groups"][number]>()
+  let total = 0
+  for (const sub of subs) {
+    const p = phaseAt(sub, t)
+    if (!p) continue
+    total++
+    let g = groups.get(sub.round)
+    if (!g) {
+      g = { round: sub.round, current: sub.round === currentRound, rows: [] }
+      groups.set(sub.round, g)
+    }
+    const row: RingSubList["groups"][number]["rows"][number] = { uid: sub.uid, num: sub.num, state: p.state }
+    if (argsIn(sub, t)) {
+      row.name = sub.name
+      if (sub.type) row.type = sub.type
+    }
+    if (p.state === "run") row.ms = t - begin(sub)
+    else if ((p.state === "done" || p.state === "err") && p.fin !== undefined) row.ms = took(sub, p.fin)
+    g.rows.push(row)
+  }
+  return { total, groups: [...groups.values()].sort((a, b) => a.round - b.round) }
+}
diff --git a/packages/app/src/components/session/session-runtime-ring-track-view.tsx b/packages/app/src/components/session/session-runtime-ring-track-view.tsx
new file mode 100644
index 0000000..28f11a8
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-track-view.tsx
@@ -0,0 +1,152 @@
+// oco (patches/opencode/0019): M5 replay timeline (D6). A drawn track (rail, played fill, ticks, ≈ fold marks, labels)
+// with a transparent native range on top, so pointer drag and arrow keys (1 s of track per step) stay native.
+// Ticks, fold marks and labels after t are not in the DOM at all. Rules live in session-runtime-ring-track.ts.
+import { createMemo, createSignal, Index, onCleanup, onMount, type Accessor, type JSX } from "solid-js"
+import type { RuntimeText } from "./session-runtime-i18n"
+import type { Phrase, TrackInput, TrackMap } from "./session-runtime-ring-types"
+import {
+  foldElapsed,
+  foldVisible,
+  textWidth,
+  ticksAt,
+  TRACK_LABEL_PX,
+  trackLabelsAt,
+  trackRoundAt,
+} from "./session-runtime-ring-track"
+
+/** Native range step in track ms: arrow keys move 1 s of folded track. */
+const STEP = 1000
+
+const TICK: Record<TrackInput["ticks"][number]["cls"], JSX.CSSProperties> = {
+  "": { top: "5px", height: "12px", background: "var(--rt-line-strong)" },
+  r: { top: "4px", height: "14px", background: "var(--rt-main)" },
+  e: { top: "5px", height: "12px", background: "var(--rt-err)" },
+  a: { top: "5px", height: "12px", background: "var(--rt-attn)" },
+}
+
+export function RingTrack(props: {
+  map: Accessor<TrackMap>
+  input: Accessor<TrackInput>
+  t: Accessor<number>
+  /** Drawn the same in both modes: live has t = t1, so the playhead sits at the right end. */
+  mode: Accessor<"live" | "replay">
+  text: RuntimeText
+  onSeek(t: number): void
+}): JSX.Element {
+  let host: HTMLDivElement | undefined
+  const [width, setWidth] = createSignal(300)
+  onMount(() => {
+    const el = host
+    if (!el) return
+    const read = () => setWidth(el.clientWidth || 300)
+    read()
+    if (typeof ResizeObserver === "undefined") return
+    const observer = new ResizeObserver(read)
+    observer.observe(el)
+    onCleanup(() => observer.disconnect())
+  })
+
+  const pct = (v: number) => {
+    const total = props.map().total
+    return total > 0 ? Math.min(100, Math.max(0, (v / total) * 100)) : 100
+  }
+  const head = () => pct(props.map().vOf(props.t()))
+  const ticks = createMemo(() => ticksAt(props.input(), props.t()))
+  const folds = createMemo(() => props.map().segs.filter((s) => s.fold && foldVisible(s.fold, props.t())))
+  const measure = (p: Phrase) => textWidth(props.text.phrase(p), TRACK_LABEL_PX)
+  const labels = createMemo(() => trackLabelsAt(props.map(), props.input(), props.t(), width(), measure))
+  // Before round 1 there is no round number: the value text is the clock alone.
+  const valueText = () => {
+    const at = props.text.clock(props.t())
+    const round = trackRoundAt(props.input(), props.t())
+    return round ? props.text.t("ring.track.valuetext", { at, n: round.n }) : at
+  }
+  // max rounds up to a whole step so a drag to the right edge reaches t1 (tOf clamps v to total)
+  const max = () => Math.max(STEP, Math.ceil(props.map().total / STEP) * STEP)
+
+  return (
+    <div
+      ref={host}
+      data-oco-runtime-replay
+      data-oco-runtime-replay-t={Math.round(props.t())}
+      class="relative h-[30px] min-w-0 select-none rounded-sm has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-1 has-[:focus-visible]:outline-border-focus"
+      style={{ "touch-action": "none" }}
+    >
+      <div
+        aria-hidden="true"
+        class="absolute left-0 right-0 top-[9px] h-1 rounded-sm pointer-events-none"
+        style={{ background: "var(--rt-line)" }}
+      />
+      <div
+        aria-hidden="true"
+        class="absolute left-0 top-[9px] h-1 rounded-sm pointer-events-none"
+        style={{ background: "var(--rt-sub)", width: `${head()}%` }}
+      />
+      <Index each={ticks()}>
+        {(tick) => (
+          <div
+            aria-hidden="true"
+            class="absolute w-0.5 -ml-px rounded-[1px] pointer-events-none"
+            style={{ ...TICK[tick().cls], left: `${pct(props.map().vOf(tick().t))}%` }}
+          />
+        )}
+      </Index>
+      <Index each={folds()}>
+        {(seg) => (
+          <div
+            aria-hidden="true"
+            data-oco-runtime-fold={seg().fold!.kind}
+            data-oco-runtime-fold-ms={Math.round(foldElapsed(seg().fold!, props.t()))}
+            class="absolute top-[3px] h-4 w-3.5 -ml-[7px] text-center pointer-events-none"
+            style={{
+              left: `${pct(seg().v0 + seg().c / 2)}%`,
+              font: "12px/16px var(--font-family-mono)",
+              color: "var(--rt-weak)",
+              background: "var(--rt-bg)",
+            }}
+          >
+            ≈
+          </div>
+        )}
+      </Index>
+      <Index each={labels()}>
+        {(label) => (
+          <div
+            aria-hidden="true"
+            class="absolute top-[17px] whitespace-nowrap pointer-events-none"
+            style={{
+              left: `${label().x.toFixed(1)}px`,
+              font: `${TRACK_LABEL_PX}px/12px var(--font-family-mono)`,
+              color: label().cls === "r" ? "var(--rt-main)" : "var(--rt-weak)",
+            }}
+          >
+            {props.text.phrase(label().text)}
+          </div>
+        )}
+      </Index>
+      <div
+        aria-hidden="true"
+        class="absolute top-[5px] w-3 h-3 -ml-1.5 rounded-full pointer-events-none"
+        style={{
+          left: `${head()}%`,
+          background: "var(--rt-text)",
+          border: "2px solid var(--rt-sub)",
+        }}
+      />
+      <input
+        type="range"
+        min={0}
+        max={max()}
+        step={STEP}
+        value={props.map().vOf(props.t())}
+        aria-label={props.text.t("ring.track.aria")}
+        aria-valuetext={valueText()}
+        class="absolute inset-0 w-full h-full m-0 p-0 opacity-0 cursor-pointer"
+        onInput={(e) => {
+          const map = props.map()
+          props.onSeek(map.tOf(Math.min(map.total, Number(e.currentTarget.value))))
+        }}
+      />
+    </div>
+  )
+}
