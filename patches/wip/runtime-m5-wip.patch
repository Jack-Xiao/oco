+// oco (patches/opencode/0019): unit tests for mechanismOf pure projection.
+// Test cases 1-9 per docs/superpowers/plans/2026-10-03-runtime-dashboard-m3.md (Task 2).
+import { describe, expect, test } from "bun:test"
+import {
+  mechanismOf,
+  mechanismView,
+  type Mechanism,
+} from "./session-runtime-mechanism"
+import type { RuntimeModel, RuntimeRequest, RuntimeTool, Stage } from "./session-runtime-model"
+
+
+function createMockModel(overrides: Partial<RuntimeModel> = {}): RuntimeModel {
+  return {
+    mode: "live",
+    roundStart: 0,
+    freshness: { observedAt: 1000, evidence: "inferred" },
+    run: { state: "working", evidence: "event", attention: [], attentionKnown: true },
+    stage: "tools",
+    focus: { kind: "working", stage: "tools" },
+    sessions: [{ id: "root", kind: "root", state: "working", evidence: "event" }],
+    requests: [
+      {
+        index: 0,
+        messageID: "msg-0",
+        turn: 0,
+        start: 1000,
+        status: "running",
+        cancelled: false,
+        evidence: "event",
+        settled: false,
+        known: false,
+      },
+    ],
+    tools: [],
+    events: [],
+    usage: { requests: 1, knownRequests: 0, settled: false, context: {} },
+    ...overrides,
+  }
+}
+
+function createMockTool(overrides: Partial<RuntimeTool> = {}): RuntimeTool {
+  return {
+    id: "tool-1",
+    callID: "call-1",
+    messageID: "msg-0",
+    request: 0,
+    name: "bash",
+    state: "running",
+    interrupted: false,
+    cancelled: false,
+    input: "echo test",
+    ...overrides,
+  }
+}
+
+function createMockChildTool(overrides: Partial<RuntimeTool> = {}): RuntimeTool {
+  return {
+    id: "task-1",
+    callID: "call-task-1",
+    messageID: "msg-0",
+    request: 0,
+    name: "task",
+    state: "running",
+    interrupted: false,
+    cancelled: false,
+    input: "run task",
+    child: {
+      sessionID: "sub-1",
+      agent: "worker",
+      description: "do work",
+      background: false,
+      lifecycle: "running",
+      evidence: "event",
+    },
+    ...overrides,
+  }
+}
+
+describe("mechanismOf", () => {
+  test("1. empty requests yield empty=true and no slots", () => {
+    const model = createMockModel({ requests: [] })
+    const m = mechanismOf(model)
+    expect(m.empty).toBe(true)
+    expect(m.tools).toEqual([])
+    expect(m.children).toEqual([])
+    expect(m.toolsOverflow).toEqual({ total: 0, running: 0 })
+    expect(m.childrenOverflow).toEqual({ total: 0, running: 0 })
+  })
+
+  test("2. last request with 5 parallel tools (5th running) yields 4 slots and overflow with running count in model.tools order", () => {
+    const tools = [
+      createMockTool({ id: "t1", name: "tool1", state: "completed" }),
+      createMockTool({ id: "t2", name: "tool2", state: "completed" }),
+      createMockTool({ id: "t3", name: "tool3", state: "completed" }),
+      createMockTool({ id: "t4", name: "tool4", state: "completed" }),
+      createMockTool({ id: "t5", name: "tool5", state: "running" }),
+    ]
+    const model = createMockModel({ tools, stage: "tools" })
+    const m = mechanismOf(model)
+
+    expect(m.tools.length).toBe(4)
+    expect(m.tools.map((t) => t.toolID)).toEqual(["t1", "t2", "t3", "t4"])
+    expect(m.toolsOverflow).toEqual({ total: 1, running: 1 })
+  })
+
+  test("3. projecting again after tool completes preserves slot order and identities without reordering", () => {
+    const t1 = createMockTool({ id: "t1", name: "tool1", state: "running" })
+    const t2 = createMockTool({ id: "t2", name: "tool2", state: "running" })
+    const t3 = createMockTool({ id: "t3", name: "tool3", state: "pending" })
+    const model1 = createMockModel({ tools: [t1, t2, t3], stage: "tools" })
+    const m1 = mechanismOf(model1)
+    expect(m1.tools.map((t) => t.toolID)).toEqual(["t1", "t2", "t3"])
+    expect(m1.tools[0].state).toBe("running")
+
+    // Tool 1 completes
+    const t1Done: RuntimeTool = { ...t1, state: "completed" }
+    const model2 = createMockModel({ tools: [t1Done, t2, t3], stage: "tools" })
+    const m2 = mechanismOf(model2)
+    expect(m2.tools.map((t) => t.toolID)).toEqual(["t1", "t2", "t3"])
+    expect(m2.tools[0].state).toBe("completed")
+    expect(m2.tools[1].state).toBe("running")
+    expect(m2.tools[2].state).toBe("pending")
+  })
+
+  test("4. stage=tools: running tool has dispatch=true; awaiting tool has dispatch=false, awaiting=true; interrupted tool has dispatch=false", () => {
+    const tRunning = createMockTool({ id: "t1", state: "running", awaiting: undefined, interrupted: false })
+    const tAwaiting = createMockTool({
+      id: "t2",
+      state: "running",
+      awaiting: { kind: "permission", id: "perm-1" },
+      interrupted: false,
+    })
+    const tInterrupted = createMockTool({ id: "t3", state: "running", awaiting: undefined, interrupted: true })
+    const model = createMockModel({ tools: [tRunning, tAwaiting, tInterrupted], stage: "tools" })
+    const m = mechanismOf(model)
+
+    expect(m.tools[0]).toMatchObject({ toolID: "t1", dispatch: true, awaiting: false, interrupted: false })
+    expect(m.tools[1]).toMatchObject({ toolID: "t2", dispatch: false, awaiting: true, interrupted: false })
+    expect(m.tools[2]).toMatchObject({ toolID: "t3", dispatch: false, awaiting: false, interrupted: true })
+  })
+
+  test("5. stage=fill: last request slots have returning=true, dispatch=false; other stages have returning=false", () => {
+    const t = createMockTool({ id: "t1", state: "completed", request: 0 })
+    const child = createMockChildTool({
+      id: "c1",
+      state: "completed",
+      request: 0,
+      child: {
+        sessionID: "s1",
+        agent: "worker",
+        description: "",
+        background: false,
+        lifecycle: "done",
+        evidence: "event",
+      },
+    })
+    const modelFill = createMockModel({ tools: [t, child], stage: "fill" })
+    const mFill = mechanismOf(modelFill)
+    expect(mFill.tools[0].returning).toBe(true)
+    expect(mFill.tools[0].dispatch).toBe(false)
+    expect(mFill.children[0].returning).toBe(true)
+    expect(mFill.children[0].dispatch).toBe(false)
+
+    const otherStages: Stage[] = ["prepare", "model", "tools", "idle"]
+    for (const stage of otherStages) {
+      const mOther = mechanismOf(createMockModel({ tools: [t, child], stage }))
+      expect(mOther.tools[0].returning).toBe(false)
+      expect(mOther.children[0].returning).toBe(false)
+    }
+  })
+
+  test("6. background task: earlier request completed task with running child session appears in child slot with dispatch=true, deduped to one slot", () => {
+    const req0: RuntimeRequest = {
+      index: 0,
+      messageID: "m0",
+      turn: 0,
+      start: 1000,
+      status: "done",
+      cancelled: false,
+      evidence: "event",
+      settled: true,
+      known: true,
+    }
+    const req1: RuntimeRequest = {
+      index: 1,
+      messageID: "m1",
+      turn: 1,
+      start: 2000,
+      status: "running",
+      cancelled: false,
+      evidence: "event",
+      settled: false,
+      known: false,
+    }
+    const t1 = createMockChildTool({
+      id: "c1",
+      request: 0,
+      state: "completed",
+      child: {
+        sessionID: "s1",
+        agent: "agent-a",
+        description: "",
+        background: true,
+        lifecycle: "running",
+        evidence: "event",
+      },
+    })
+    const t2 = createMockChildTool({
+      id: "c2",
+      request: 0,
+      state: "completed",
+      child: {
+        sessionID: "s1",
+        agent: "agent-a",
+        description: "",
+        background: true,
+        lifecycle: "running",
+        evidence: "event",
+      },
+    })
+
+    const model = createMockModel({
+      requests: [req0, req1],
+      tools: [t1, t2],
+      stage: "tools",
+    })
+    const m = mechanismOf(model)
+
+    expect(m.children.length).toBe(1)
+    expect(m.children[0].toolID).toBe("c2")
+    expect(m.children[0].dispatch).toBe(true)
