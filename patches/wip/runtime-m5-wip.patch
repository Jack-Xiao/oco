+  // from the new position because each tick reads the current step.
+  const [playing, setPlaying] = createSignal(false)
+  const [speed, setSpeed] = createSignal<PlaybackSpeed>(1)
+  let playTimer: ReturnType<typeof setInterval> | undefined
+  const stopPlay = () => {
+    if (playTimer !== undefined) clearInterval(playTimer)
+    playTimer = undefined
+    setPlaying(false)
+  }
+  onCleanup(stopPlay)
+
+  const pause = () => {
+    stopPlay()
+    setPausedAt(steps().length)
