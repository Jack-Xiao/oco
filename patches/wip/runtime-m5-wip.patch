@@ -0,0 +1,252 @@
+// oco (patches/opencode/0019): M5 replay timeline. Long question waits and idle gaps fold to FOLD_LEN of track
+// (mockup L672-681); vOf / tOf map real time t <-> track position v. Nothing after t is revealed: ticks, fold marks
+// and fold labels only exist once they have happened (labels: mockup L1576-1618). Pure, so it unit-tests without a DOM.
+import {
+  RING,
+  type Fold,
+  type Phrase,
+  type PhraseParam,
+  type TrackInput,
+  type TrackLabel,
+  type TrackMap,
+  type TrackSeg,
+} from "./session-runtime-ring-types"
+
+// fold edges keep a little real time on each side so the moments around the gap stay scrubbable (mockup L675-677)
+const WAIT_IN = 2500
+const WAIT_OUT = 600
+const IDLE_IN = 2600
+const IDLE_OUT = 1200
+/** Label font size in px (mockup .track .lb). */
+export const TRACK_LABEL_PX = 10.5
+/** Minimum horizontal gap between two labels, px. */
+const LABEL_GAP = 6
+const HOUR = 3_600_000
+
+/**
+ * Folds over [t0, t1]. Geometry may use the whole history (round endAt), but anything later than t1 is treated as not
+ * happened yet: a question still waiting at t1 and the idle after the last round are open folds (`to` undefined) whose
+ * `b` follows t1.
+ */
+export function foldsOf(input: TrackInput): Fold[] {
+  const { t0 } = input
+  const t1 = Math.max(input.t1, t0)
+  const out: Fold[] = []
+  for (const w of input.waits) {
+    if (w.start > t1) continue
+    const to = w.end !== undefined && w.end <= t1 ? w.end : undefined
+    if ((to ?? t1) - w.start > RING.FOLD_MIN)
+      out.push({ a: w.start + WAIT_IN, b: (to ?? t1) - WAIT_OUT, kind: "wait", from: w.start, to })
+  }
+  const rounds = input.rounds.filter((r) => r.start <= t1).sort((x, y) => x.start - y.start)
+  rounds.forEach((r, i) => {
+    if (r.endAt === undefined || r.endAt > t1) return
+    const to = rounds[i + 1]?.start
+    if ((to ?? t1) - r.endAt > RING.FOLD_MIN)
+      out.push({ a: r.endAt + IDLE_IN, b: (to ?? t1) - IDLE_OUT, kind: "idle", from: r.endAt, to })
+  })
+  out.sort((x, y) => x.a - y.a)
+  const kept: Fold[] = []
+  for (const f of out) {
+    if (f.a < t0 || f.b > t1 || f.b <= f.a) continue
+    const prev = kept[kept.length - 1]
+    if (prev && f.a < prev.b) continue
+    kept.push(f)
+  }
+  return kept
+}
+
+/** Piecewise-linear track: real segments keep their length, each fold takes FOLD_LEN. vOf and tOf are inverses. */
+export function trackMap(input: TrackInput): TrackMap {
+  const t0 = input.t0
+  const t1 = Math.max(input.t1, t0)
+  const folds = foldsOf(input)
+  const segs: TrackSeg[] = []
+  let a = t0
+  let total = 0
+  const push = (b: number, c: number, fold?: Fold) => {
+    const seg: TrackSeg = { a, b, c, v0: total }
+    if (fold) seg.fold = fold
+    segs.push(seg)
+    total += c
+    a = b
+  }
+  for (const f of folds) {
+    push(f.a, f.a - a)
+    push(f.b, RING.FOLD_LEN, f)
+  }
+  push(t1, t1 - a)
+  // first segment whose upper bound (t: b, v: v0 + c) is >= x; segments are ascending in both t and v
+  const find = (x: number, top: (s: TrackSeg) => number) => {
+    let lo = 0
+    let hi = segs.length - 1
+    while (lo < hi) {
+      const mid = (lo + hi) >> 1
+      if (top(segs[mid]) >= x) hi = mid
+      else lo = mid + 1
+    }
+    return segs[lo]
+  }
+  const vOf = (t: number) => {
+    const x = Math.min(t1, Math.max(t0, t))
+    const s = find(x, (s) => s.b)
+    return s.v0 + (s.b > s.a ? ((x - s.a) / (s.b - s.a)) * s.c : 0)
+  }
+  const tOf = (v: number) => {
+    const x = Math.min(total, Math.max(0, v))
+    const s = find(x, (s) => s.v0 + s.c)
+    return s.a + (s.c > 0 ? ((x - s.v0) / s.c) * (s.b - s.a) : 0)
+  }
+  return { segs, total, folds, vOf, tOf }
+}
+
+/** A fold is only known to be a long gap once FOLD_MIN of it has passed; before that its ≈ mark stays hidden. */
+export function foldVisible(f: Fold, t: number): boolean {
+  return t >= f.from + RING.FOLD_MIN
+}
+
+/** Real time of the gap that has passed by t (never the whole span while t is inside it). */
+export function foldElapsed(f: Fold, t: number): number {
+  return Math.max(0, Math.min(t, f.to ?? t) - f.from)
+}
+
+/** Ticks at or before t; later ticks are not drawn at all. */
+export function ticksAt(input: TrackInput, t: number): TrackInput["ticks"] {
+  return input.ticks.filter((k) => k.t <= t)
+}
+
+/** The round the playhead is in: the last one started at or before t. */
+export function trackRoundAt(input: TrackInput, t: number): TrackInput["rounds"][number] | undefined {
+  let cur: TrackInput["rounds"][number] | undefined
+  for (const r of input.rounds) if (r.start <= t && (!cur || r.start >= cur.start)) cur = r
+  return cur
+}
+
+/** Width estimate for the track font (mockup textW L394): CJK and wider glyphs one em, the rest 0.61 em. */
+export function textWidth(s: string, px: number): number {
+  let n = 0
+  for (const ch of s) n += (ch.codePointAt(0) ?? 0) >= 0x2e80 ? px : px * 0.61
+  return n
+}
+
+// short labels: the short duration has no hour tier, so long gaps switch to the long form (a size rule, not a locale rule)
+const shortDur = (ms: number): PhraseParam => (ms >= HOUR ? { ms, long: true } : { ms })
+
+type Cand = { x: number; text: Phrase; start?: true }
+type Item = { c: Cand[]; cls: "" | "r"; pri: number; at: number }
+
+/**
+ * Labels at t, placed by priority (mockup L1586-1618): the ongoing wait / idle, then the current round, then past
+ * gaps of this round, other rounds, older gaps. Each candidate has long → short forms; a label that fits in none is
+ * dropped. A round right after an idle gap shares one label with it. `x` is the label's left edge in px.
+ */
+export function trackLabelsAt(
+  map: TrackMap,
+  input: TrackInput,
+  t: number,
+  width: number,
+  measure: (p: Phrase) => number,
+): TrackLabel[] {
+  const W = width
+  const px = (v: number) => (map.total > 0 ? (v / map.total) * W : 0)
+  const foldText = (s: TrackSeg, f: Fold) => {
+    const el = foldElapsed(f, t)
+    const wait = f.kind === "wait"
+    const long: Phrase = { key: wait ? "ring.fold.wait" : "ring.fold.idle", params: { dur: { ms: el, long: true } } }
+    const short: Phrase = { key: wait ? "ring.fold.wait.short" : "ring.fold.idle.short", params: { dur: shortDur(el) } }
+    return { mid: px(s.v0 + s.c / 2), long, short }
+  }
+  const started = input.rounds.filter((r) => r.start <= t).sort((x, y) => x.start - y.start)
+  const cur = started[started.length - 1]
+  const items: Item[] = []
+  const glued = new Set<TrackSeg>()
+  for (const r of started) {
+    const round: Phrase = { key: "ring.track.round", params: { n: r.n } }
+    const c: Cand[] = []
+    const s = map.segs.find((x) => x.fold?.kind === "idle" && x.fold.to === r.start)
+    if (s?.fold && foldVisible(s.fold, t)) {
+      glued.add(s)
+      const ft = foldText(s, s.fold)
+      c.push(
+        { x: ft.mid, text: { key: "ring.fold.glued", params: { fold: ft.long, round } } },
+        { x: ft.mid, text: { key: "ring.fold.glued.short", params: { fold: ft.short, round } } },
+      )
+    }
+    c.push({ x: px(map.vOf(r.start)), text: round, start: true })
+    items.push({ c, cls: "r", pri: r === cur ? 1 : 3, at: r.start })
+  }
+  for (const s of map.segs) {
+    const f = s.fold
+    if (!f || glued.has(s) || !foldVisible(f, t)) continue
+    const ft = foldText(s, f)
+    const ongoing = f.to === undefined || t < f.to
+    items.push({
+      c: [
+        { x: ft.mid, text: ft.long },
+        { x: ft.mid, text: ft.short },
+      ],
+      cls: "",
+      pri: ongoing ? 0 : cur && f.from >= cur.start ? 2 : 4,
+      at: f.from,
+    })
+  }
+  items.sort((a, b) => a.pri - b.pri || b.at - a.at)
+
+  const span = (c: Cand): [number, number] | undefined => {
+    const w = measure(c.text) + 2
+    if (w > W) return undefined
+    const x0 = Math.max(0, Math.min(c.start ? c.x : c.x - w / 2, W - w))
+    return [x0, x0 + w]
+  }
+  const free = (sp: [number, number], used: [number, number][]) =>
+    !used.some((u) => sp[0] < u[1] + LABEL_GAP && sp[1] > u[0] - LABEL_GAP)
+  const used: [number, number][] = []
+  const pick = new Map<Item, { c: Cand; sp: [number, number] }>()
+  // the first two (ongoing gap, current round) choose their forms together so both fit when possible
+  if (items.length > 1) {
+    outer: for (const c0 of items[0].c)
+      for (const c1 of items[1].c) {
+        const a = span(c0)
+        const b = span(c1)
+        if (a && b && free(a, [b])) {
+          pick.set(items[0], { c: c0, sp: a })
+          pick.set(items[1], { c: c1, sp: b })
+          used.push(a, b)
+          break outer
+        }
+      }
+  }
+  const out: TrackLabel[] = []
+  for (const item of items) {
+    let hit = pick.get(item)
+    if (!hit) {
+      for (const c of item.c) {
+        const sp = span(c)
+        if (sp && free(sp, used)) {
+          hit = { c, sp }
+          break
+        }
+      }
+      if (!hit) continue
+      used.push(hit.sp)
+    }
+    const label: TrackLabel = { x: hit.sp[0], text: hit.c.text, cls: item.cls }
+    if (hit.c.start) label.start = true
+    out.push(label)
+  }
+  return out
+}
+
+/** ←/→: the nearest nav point strictly before (after) t; past either end, t0 / t1. `nav` is ascending. */
+export function navStep(nav: readonly number[], t: number, dir: -1 | 1, t0: number, t1: number): number {
+  // first index whose value is >= t (dir -1) or > t (dir 1)
+  let lo = 0
+  let hi = nav.length
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1
+    if (dir < 0 ? nav[mid] < t : nav[mid] <= t) lo = mid + 1
+    else hi = mid
+  }
+  const hit = dir < 0 ? (lo > 0 ? nav[lo - 1] : undefined) : lo < nav.length ? nav[lo] : undefined
+  return Math.min(t1, Math.max(t0, hit ?? (dir < 0 ? t0 : t1)))
+}
diff --git a/packages/app/src/components/session/session-runtime-ring-types.ts b/packages/app/src/components/session/session-runtime-ring-types.ts
