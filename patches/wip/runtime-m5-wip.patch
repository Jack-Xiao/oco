+// ---------- no future leak: the same answer from data truncated at t ----------
+const le = (v: number | undefined, t: number) => v !== undefined && v <= t
+function truncTool(x: RingTool, t: number): RingTool {
+  let out: RingTool = { ...x }
+  if (!le(x.start, t)) out = { ...out, start: undefined, arg: "", input: {}, status: "pending" }
+  if (!le(x.end, t))
+    out = {
+      ...out,
+      end: undefined,
+      output: undefined,
+      error: undefined,
+      chars: 0,
+      declined: undefined,
+      status: le(x.start, t) ? "running" : "pending",
+    }
+  return out
+}
+function truncChild(c: RingChild, t: number): RingChild {
+  return {
+    messages: c.messages
+      .filter((m) => m.created <= t)
+      .map((m) => (le(m.completed, t) ? m : { created: m.created, model: m.model, cost: 0 })),
+    acts: c.acts
+      .filter((a) => a.at <= t)
+      .map((a) =>
+        a.kind === "tool"
+          ? { ...a, tool: truncTool(a.tool, t) }
+          : le(a.span.end, t)
+            ? a
+            : { ...a, span: { partID: a.span.partID, start: a.span.start, text: "" } },
+      ),
+    thinks: c.thinks.filter((k) => k.start <= t).map((k) => (le(k.end, t) ? k : { start: k.start })),
+  }
+}
+function truncSub(s: RingSub, t: number): RingSub {
+  let out: RingSub = { ...s }
+  if (!le(s.start, t)) out = { ...out, start: undefined, name: "", type: "", prompt: "", sessionID: undefined }
+  if (!le(s.end, t)) out = { ...out, end: undefined, result: undefined, error: undefined, failed: false }
+  if (s.background)
+    out.background = {
+      taskId: s.background.taskId,
+      retrievedAt: le(s.background.retrievedAt, t) ? s.background.retrievedAt : undefined,
+      notices: s.background.notices.filter((n) => n.at <= t),
+    }
+  if (s.child) out.child = truncChild(s.child, t)
+  return out
+}
+const timesOf = (s: RingSub) => {
+  const ts = [s.created, s.start, s.end, s.background?.retrievedAt, ...(s.background?.notices.map((n) => n.at) ?? [])]
+  for (const m of s.child?.messages ?? []) ts.push(m.created, m.completed)
+  for (const a of s.child?.acts ?? []) {
+    ts.push(a.at)
+    if (a.kind === "tool") ts.push(a.tool.start, a.tool.end)
+    else ts.push(a.span.end)
+  }
+  for (const k of s.child?.thinks ?? []) ts.push(k.start, k.end)
+  return [...new Set(ts.filter((v): v is number => v !== undefined).flatMap((v) => [v - 1, v, v + 1]))].sort(
+    (a, b) => a - b,
+  )
+}
+
+describe("no future leak", () => {
+  const rich = sub({
+    end: 12_000,
+    failed: true,
+    error: "late failure",
+    child: (() => {
+      const c = child({
+        messages: steps().messages,
+        thinks: [
+          { start: 3700, end: 3900 },
+          { start: 4600, end: 6500 },
+        ],
+      })
+      c.acts = [
+        toolAct(tool({ id: "t1", created: 2200, start: 2300, end: 2600, output: "out", chars: 3 })),
+        toolAct(tool({ id: "t2", created: 2700, start: 2800, end: 3200, status: "error", error: "bad" })),
+        text({ partID: "x1", start: 3300, end: 3600, text: "streamed **text**" }),
+        toolAct(
+          tool({
+            id: "t3",
+            created: 5100,
+            start: 5200,
+            end: 6900,
+            status: "error",
+            declined: "rejected",
+            error: "rejected",
+          }),
+        ),
+        text({ partID: "x2", start: 6000, end: 6950, text: "final" }),
+        ...[0, 1, 2, 3].map((i) =>
+          toolAct(
+            tool({ id: `u${i}`, created: 4000 + i * 50, start: 4010 + i * 50, end: 4500, output: "o", chars: 1 }),
+          ),
+        ),
+      ].sort((a, b) => a.at - b.at)
+      return c
+    })(),
+  })
+  const bg = sub({
+    end: 2500,
+    child: steps(),
+    background: {
+      taskId: "bg_1",
+      retrievedAt: 9000,
+      notices: [
+        { at: 4000, kind: "done" },
+        { at: 5000, kind: "cleared" },
+        { at: 8000, kind: "done" },
+      ],
+    },
+  })
+  for (const [name, s] of [
+    ["sync", rich],
+    ["background", bg],
+  ] as const)
+    test(`subDetailAt / subStateAt equal on data truncated at t (${name}, wide and narrow)`, () => {
+      const ts = timesOf(s)
+      expect(ts.length).toBeGreaterThan(20)
+      for (const t of ts) {
+        const cut = truncSub(s, t)
+        expect(subStateAt(cut, t)).toEqual(subStateAt(s, t))
+        expect(childDoneAt(cut, t)).toEqual(childDoneAt(s, t))
+        for (const narrow of [false, true])
+          expect(subDetailAt(cut, t, { narrow })).toEqual(subDetailAt(s, t, { narrow }))
+        expect(subListAt([cut], t, 2)).toEqual(subListAt([s], t, 2))
+      }
+    })
+})
