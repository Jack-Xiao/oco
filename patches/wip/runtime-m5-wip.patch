index 0000000..c25d12b
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-child.tsx
@@ -0,0 +1,322 @@
+import type { Accessor } from "solid-js"
+import { createMemo, createSignal, For, Show } from "solid-js"
+import { BTN, FOCUS, lastChildToolIds, retryWait, toolDetail } from "./session-runtime-actions"
+import { keyed } from "./session-runtime-keyed"
+import type { RuntimeText } from "./session-runtime-i18n"
+import type { ChildLifecycle, RuntimeModel, RuntimeTool, Stage } from "./session-runtime-model"
+
+const GLYPH = { pending: "○", running: "◐", completed: "✓", error: "✕" } as const
+const COLOR = {
+  model: "var(--rt-main)",
+  tool: "var(--rt-tool)",
+  subagent: "var(--rt-sub)",
+  attention: "var(--rt-attn)",
+  error: "var(--rt-err)",
+  ok: "var(--rt-ok)",
+} as const
+
+const stageKey = (s: Stage): Exclude<Stage, "idle"> => (s === "idle" ? "prepare" : s)
+const lifecycleKey = (lifecycle: ChildLifecycle) => `child.lifecycle.${lifecycle}` as "child.lifecycle.running"
+
+const focusLine = (m: RuntimeModel, t: RuntimeText["t"], now: number) => {
+  const focus = m.focus
+  switch (focus.kind) {
+    case "attention":
+      return focus.attention.kind === "permission"
+        ? t("focus.attention.permission", { what: [focus.attention.permission, ...focus.attention.patterns].join(" ") })
+        : t("focus.attention.question", { what: focus.attention.text })
+    case "retry": {
+      const wait = retryWait(focus.next, now)
+      return wait.due ? t("retry.soon") : t("retry.countdown", { attempt: focus.attempt, seconds: wait.seconds })
+    }
+    case "error":
+      return focus.message ? t("focus.error", { message: focus.message }) : t("focus.error.unknown")
+    case "working":
+      return focus.tool
+        ? t("focus.working.tool", { tool: focus.tool.child?.agent ?? focus.tool.name, input: focus.tool.input })
+        : t(`stage.${stageKey(focus.stage)}`)
+    case "interrupted":
+      return t("focus.interrupted")
+    case "cancelled":
+      return t("focus.cancelled")
+    case "done":
+      return t("focus.done")
+    default:
+      return t("focus.idle")
+  }
+}
+
+export type RuntimeChildPanelProps = {
+  sessionID: string
+  lifecycle: ChildLifecycle
+  model: Accessor<RuntimeModel>
+  now: Accessor<number>
+  t: RuntimeText["t"]
+  depth?: number
+  ancestors?: readonly string[]
+  childOpen?: (sessionID: string) => boolean
+  toggleChild?: (sessionID: string) => void
+  assembleChild?: (sessionID: string) => RuntimeModel
+  onOpen?: (sessionID: string) => void
+}
+
+export function RuntimeChildPanel(props: RuntimeChildPanelProps) {
+  const depth = () => props.depth ?? 1
+  const ancestors = () => props.ancestors ?? [props.sessionID]
+  const isSubagent = (x: RuntimeTool) => x.child !== undefined
+
+  // Active tools: pending/running tools plus any subagent tools
+  const visibleTools = createMemo(() =>
+    props.model().tools.filter(
+      (x) => (!x.interrupted && (x.state === "pending" || x.state === "running")) || isSubagent(x),
+    ),
+  )
+  const toolKeys = keyed(visibleTools, (x) => x.id)
+  const lastChildTools = createMemo(() => lastChildToolIds(props.model().tools))
+  const [openTools, setOpenTools] = createSignal<ReadonlySet<string>>(new Set())
+  const isToolOpen = (id: string) => openTools().has(id)
+  const toggleTool = (id: string) => {
+    setOpenTools((prev) => {
+      const next = new Set(prev)
+      if (next.has(id)) next.delete(id)
+      else next.add(id)
+      return next
+    })
+  }
+
+  const toolRow = (x: Accessor<RuntimeTool>) => {
+    const child = () => x().child
+    const isLastChild = () => lastChildTools().has(x().id)
+    const info = createMemo(() => toolDetail(x(), props.t))
+    const statusText = () =>
+      x().cancelled ? props.t("tool.cancelled") : props.t(`tool.state.${x().state}`)
+
+    return (
+      <Show
+        when={child()}
+        fallback={
+          <div
+            data-oco-runtime-tool={x().id}
+            class="flex flex-col gap-1 rounded p-2 bg-surface-inset-base border border-dashed border-border-subtle font-mono text-11-regular min-w-0 break-words"
+            style={{ "border-color": COLOR.tool }}
+          >
+            <button
+              type="button"
+              class={`w-full flex items-center gap-2 min-w-0 text-left bg-transparent border-0 p-0 ${FOCUS} rounded-[3px] cursor-pointer font-mono`}
+              data-oco-runtime-tool-toggle={x().id}
+              aria-expanded={isToolOpen(x().id)}
+              aria-controls={`oco-runtime-tool-detail-${x().id}`}
+              onClick={() => toggleTool(x().id)}
+            >
+              <span aria-hidden="true">{x().cancelled ? "⊘" : GLYPH[x().state]}</span>
+              <span class="text-12-medium text-text-strong shrink-0">{x().name}</span>
+              <span class="min-w-0 break-words text-11-regular text-text-weak">{x().input}</span>
+              <span class="ml-auto shrink-0 text-11-regular text-text-weak">
+                {statusText()}
+              </span>
+            </button>
+            <Show when={x().lastOutput}>
+              <div class="min-w-0 break-words whitespace-pre-wrap text-11-regular font-mono text-text-weak">{x().lastOutput}</div>
+            </Show>
+            <Show when={isToolOpen(x().id)}>
+              <div
+                id={`oco-runtime-tool-detail-${x().id}`}
+                data-oco-runtime-tool-detail={x().id}
+                class="flex flex-col gap-1 pt-1.5 border-t border-border-subtle text-11-regular text-text-weak font-mono"
+              >
+                <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
+                  <span>
+                    <span class="text-text-strong">{props.t("tool.detail.start")}:</span> {info().startText}
+                  </span>
+                  <span>
+                    <span class="text-text-strong">{props.t("tool.detail.end")}:</span> {info().endText}
+                  </span>
+                  <span>
+                    <span class="text-text-strong">{props.t("tool.detail.duration")}:</span> {info().durationText}
+                  </span>
+                  <Show when={info().evidence}>
+                    {(ev) => (
+                      <span>
+                        <span class="text-text-strong">{props.t("tool.detail.evidence")}:</span> {props.t(`evidence.${ev()}` as any) || ev()}
+                      </span>
+                    )}
+                  </Show>
+                </div>
+                <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
+                  <span>
+                    <span class="text-text-strong">{props.t("tool.detail.call_id")}:</span> <span class="font-mono">{info().callID}</span>
+                  </span>
+                </div>
+                <Show when={info().error}>
+                  {(err) => (
+                    <div class="text-11-regular break-words" style={{ color: COLOR.error }}>
+                      <span class="text-text-strong">{props.t("tool.detail.error")}:</span> {err()}
+                    </div>
+                  )}
+                </Show>
+              </div>
+            </Show>
+          </div>
+        }
+      >
+        {(c) => {
+          const childSessionID = () => c().sessionID
+          const canExpand = () => {
+            const id = childSessionID()
+            if (!id) return false
+            if (depth() >= 8) return false
+            if (ancestors().includes(id)) return false
+            return true
+          }
+          const isMaxDepth = () => depth() >= 8
+
+          return (
+            <div
+              data-oco-runtime-tool={x().id}
+              class="flex flex-col gap-1 rounded p-2 bg-surface-inset-base border border-dashed font-mono text-11-regular min-w-0 break-words"
+              style={{ "border-color": COLOR.subagent }}
+            >
+              <button
+                type="button"
+                class={`w-full flex items-center gap-2 min-w-0 text-left bg-transparent border-0 p-0 ${FOCUS} rounded-[3px] cursor-pointer font-mono`}
+                data-oco-runtime-tool-toggle={x().id}
+                aria-expanded={isToolOpen(x().id)}
+                aria-controls={`oco-runtime-tool-detail-${x().id}`}
+                onClick={() => toggleTool(x().id)}
+              >
+                <span aria-hidden="true">{x().cancelled ? "⊘" : GLYPH[x().state]}</span>
+                <span class="text-12-medium text-text-strong break-words" style={{ color: COLOR.subagent }}>{c().agent}</span>
+                <Show when={c().description}>
+                  <span class="min-w-0 break-words text-11-regular text-text-weak">{c().description}</span>
+                </Show>
+                <span class="ml-auto shrink-0 text-11-regular text-text-weak">
+                  {props.t(lifecycleKey(c().lifecycle))}
+                </span>
+              </button>
+              <Show when={isLastChild() ? childSessionID() : undefined}>
+                {(id) => (
+                  <>
+                    <Show
+                      when={canExpand()}
+                      fallback={
+                        <div class="flex items-center gap-2 flex-wrap">
+                          <button
+                            type="button"
+                            class={`${BTN} self-start`}
+                            data-oco-runtime-child-open={id()}
+                            onClick={() => props.onOpen?.(id())}
+                          >
+                            {props.t("child.open")}
+                          </button>
+                          <Show when={isMaxDepth()}>
+                            <span class="text-11-regular text-text-weak">{props.t("child.max_depth")}</span>
+                          </Show>
+                        </div>
+                      }
+                    >
+                      <button
+                        type="button"
+                        class={`${BTN} self-start`}
+                        data-oco-runtime-child-toggle={id()}
+                        aria-expanded={props.childOpen?.(id()) ?? false}
+                        onClick={() => props.toggleChild?.(id())}
+                      >
+                        {props.childOpen?.(id()) ? props.t("child.collapse") : props.t("child.expand")}
+                      </button>
+                      <Show when={props.childOpen?.(id())}>
+                        <RuntimeChildPanel
+                          sessionID={id()}
+                          lifecycle={c().lifecycle}
+                          model={createMemo(() =>
+                            props.assembleChild ? props.assembleChild(id()) : props.model(),
+                          )}
+                          now={props.now}
+                          t={props.t}
+                          depth={depth() + 1}
+                          ancestors={[...ancestors(), id()]}
+                          childOpen={props.childOpen}
+                          toggleChild={props.toggleChild}
+                          assembleChild={props.assembleChild}
+                          onOpen={props.onOpen}
+                        />
+                      </Show>
+                    </Show>
+                  </>
+                )}
+              </Show>
+              <Show when={isToolOpen(x().id)}>
+                <div
+                  id={`oco-runtime-tool-detail-${x().id}`}
+                  data-oco-runtime-tool-detail={x().id}
+                  class="flex flex-col gap-1 pt-1.5 border-t border-border-subtle text-11-regular text-text-weak font-mono"
+                >
+                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
+                    <span>
+                      <span class="text-text-strong">{props.t("tool.detail.start")}:</span> {info().startText}
+                    </span>
+                    <span>
+                      <span class="text-text-strong">{props.t("tool.detail.end")}:</span> {info().endText}
+                    </span>
+                    <span>
+                      <span class="text-text-strong">{props.t("tool.detail.duration")}:</span> {info().durationText}
+                    </span>
+                    <Show when={info().evidence}>
+                      {(ev) => (
+                        <span>
+                          <span class="text-text-strong">{props.t("tool.detail.evidence")}:</span> {props.t(`evidence.${ev()}` as any) || ev()}
+                        </span>
+                      )}
+                    </Show>
+                  </div>
+                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
+                    <span>
+                      <span class="text-text-strong">{props.t("tool.detail.call_id")}:</span> <span class="font-mono">{info().callID}</span>
+                    </span>
+                    <Show when={info().sessionID}>
+                      {(sid) => (
+                        <span>
+                          <span class="text-text-strong">{props.t("tool.detail.session_id")}:</span> <span class="font-mono">{sid()}</span>
+                        </span>
+                      )}
+                    </Show>
+                  </div>
+                  <Show when={info().error}>
+                    {(err) => (
+                      <div class="text-11-regular break-words" style={{ color: COLOR.error }}>
+                        <span class="text-text-strong">{props.t("tool.detail.error")}:</span> {err()}
+                      </div>
+                    )}
+                  </Show>
+                </div>
+              </Show>
+            </div>
+          )
+        }}
+      </Show>
+    )
+  }
+
+  return (
+    <div
+      data-oco-runtime-child={props.sessionID}
+      data-oco-runtime-child-depth={depth()}
+      data-oco-runtime-child-lifecycle={props.lifecycle}
+      class="flex flex-col gap-2 rounded px-2 py-1.5 font-mono text-11-regular border-l border-dashed border-border-strong pl-3 ml-1"
+    >
+      <Show when={props.model().mode === "replay"}>
+        <div class="text-11-regular text-text-weak">{props.t("child.replay.unknown")}</div>
+      </Show>
+      <div class="text-12-medium text-text-strong">{focusLine(props.model(), props.t, props.now())}</div>
+      <For each={toolKeys.ids()}>{(id) => toolRow(() => toolKeys.get(id)!)}</For>
+      <div class="text-11-regular text-text-weak">{props.t(lifecycleKey(props.lifecycle))}</div>
+      <button
+        type="button"
+        class={`${BTN} self-start`}
+        data-oco-runtime-child-open={props.sessionID}
+        onClick={() => props.onOpen?.(props.sessionID)}
+      >
+        {props.t("child.open")}
+      </button>
+    </div>
+  )
+}
