+const dicts: Partial<Record<string, Record<Key, string>>> = { zh, zht }
+
+export const RUNTIME_DICTS_FOR_TEST = { en: en as Record<string, string>, zh: zh as Record<string, string>, zht: zht as Record<string, string> }
+
+export type RuntimeText = ReturnType<typeof runtimeText>
+
+// oco (patches/opencode/0019): M5 formatters run on every frame, so the Intl objects are built once per locale tag.
+const clocks = new Map<string, Intl.DateTimeFormat>()
+const counts = new Map<string, Intl.NumberFormat>()
+
+function cached<T>(map: Map<string, T>, tag: string, make: (tag: string) => T) {
+  const hit = map.get(tag)
+  if (hit) return hit
+  const made = make(tag)
+  map.set(tag, made)
+  return made
+}
+
+/** Reads the app language reactively; call t inside tracked scopes. */
+export function runtimeText(language: Pick<ReturnType<typeof useLanguage>, "locale" | "intl">) {
+  const dict = () => dicts[language.locale()] ?? en
+  const fill = (text: string, params: Params = {}) =>
+    text.replace(/{{\s*(\w+)\s*}}/g, (_, name: string) => String(params[name] ?? ""))
+  const t = (key: Key, params?: Params) => fill(dict()[key], params)
+  // D20 (same arithmetic as the mockup's sK / sCN): <10 s one decimal, <60 s whole seconds, then minutes;
+  // the long form adds an hour tier.
+  const dur = (ms: number, long?: boolean) => {
+    const s = (Number.isFinite(ms) ? Math.max(0, ms) : 0) / 1000
+    if (s < 10) return t(long ? "ring.fmt.long.s" : "ring.fmt.s", { n: s.toFixed(1) })
+    if (s < 60) return t(long ? "ring.fmt.long.s" : "ring.fmt.s", { n: Math.floor(s) })
+    if (!long) return t("ring.fmt.ms", { m: Math.floor(s / 60), s: Math.floor(s) % 60 })
+    if (s < 3600) return t("ring.fmt.long.ms", { m: Math.floor(s / 60), s: Math.floor(s) % 60 })
+    return t("ring.fmt.long.hm", { h: Math.floor(s / 3600), m: Math.floor(s / 60) % 60 })
+  }
+  const clock = (at: number) =>
+    cached(
+      clocks,
+      language.intl(),
+      (tag) => new Intl.DateTimeFormat(tag, { hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23" }),
+    ).format(at)
+  const tok = (n: number) =>
+    cached(counts, language.intl(), (tag) => new Intl.NumberFormat(tag, { notation: "compact", maximumFractionDigits: 1 })).format(n)
+  const usd = (c: number) => "$" + c.toFixed(4)
+  const arg = (p: PhraseParam): string | number => {
+    if (typeof p !== "object") return p
+    if ("key" in p) return phrase(p)
+    if ("ms" in p) return dur(p.ms, p.long)
+    if ("at" in p) return clock(p.at)
+    if ("tok" in p) return tok(p.tok)
+    return usd(p.usd)
+  }
+  const phrase = (p: Phrase): string =>
+    t(p.key, p.params && Object.fromEntries(Object.entries(p.params).map(([name, value]) => [name, arg(value)])))
+  return {
+    intl: language.intl,
+    t,
+    dur,
+    clock,
+    tok,
+    usd,
+    phrase,
+  }
+}
