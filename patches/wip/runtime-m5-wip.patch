+// oco (patches/opencode/0019): tests for reasoningOf, reasoningAt, and tailLines
+import { describe, expect, test } from "bun:test"
+import type { Message, Part, ReasoningPart } from "@opencode-ai/sdk/v2/client"
+import { firstLine, reasoningAt, reasoningOf, tailLines } from "./session-runtime-reasoning"
+import { snapshotAt } from "./session-runtime-model"
+
+const rPart = (
+  id: string,
+  messageID: string,
+  text: string,
+  start?: number,
+  end?: number,
+): ReasoningPart => ({
+  id,
+  sessionID: "s1",
+  messageID,
+  type: "reasoning",
+  text,
+  time: {
+    start: start ?? 100,
+    ...(end !== undefined ? { end } : {}),
+  },
+})
+
+describe("reasoningOf", () => {
+  test("1. returns empty array when there is no reasoning or text is empty", () => {
+    const textPart = { id: "p0", sessionID: "s1", messageID: "m1", type: "text", text: "hello" } as unknown as Part
+    const emptyReasoning = rPart("p1", "m1", "", 100)
+    expect(reasoningOf([], true)).toEqual([])
+    expect(reasoningOf([textPart, emptyReasoning], true)).toEqual([])
+  })
+
+  test("2. in-flight reasoning without time.end is streaming", () => {
+    const part = rPart("p1", "m1", "Analyzing the codebase...", 100)
+    const res = reasoningOf([part], true)
+    expect(res).toHaveLength(1)
+    expect(res[0]).toEqual({
+      partID: "p1",
+      messageID: "m1",
+      text: "Analyzing the codebase...",
+      streaming: true,
+      start: 100,
+      end: undefined,
+    })
+  })
+
+  test("3. completed reasoning with time.end is not streaming", () => {
+    const part = rPart("p2", "m1", "Thought process complete.", 100, 200)
+    const res = reasoningOf([part], true)
+    expect(res).toHaveLength(1)
+    expect(res[0]).toEqual({
+      partID: "p2",
+      messageID: "m1",
+      text: "Thought process complete.",
+      streaming: false,
+      start: 100,
+      end: 200,
+    })
+  })
+
+  test("4. unfinished reasoning when NOT in-flight is treated as non-streaming", () => {
+    const part = rPart("p3", "m1", "Interrupted midway...", 100)
+    const res = reasoningOf([part], false)
+    expect(res).toHaveLength(1)
+    expect(res[0]).toEqual({
+      partID: "p3",
+      messageID: "m1",
+      text: "Interrupted midway...",
+      streaming: false,
+      start: 100,
+      end: undefined,
+    })
+  })
+})
+
+describe("reasoningAt (replay)", () => {
+  test("1. cursor between start and end shows streaming state with NO text leaked", () => {
+    const part = rPart("p1", "m1", "Secret future reasoning text", 100, 200)
+    const res = reasoningAt([part], 150)
+    expect(res).toHaveLength(1)
+    expect(res[0].streaming).toBe(true)
+    expect(res[0].text).toBe("")
+    expect(res[0].start).toBe(100)
+    expect(res[0].end).toBeUndefined()
+  })
+
+  test("2. cursor at or after end shows full text and not streaming", () => {
+    const part = rPart("p1", "m1", "Full reasoning explanation", 100, 200)
+    const atEnd = reasoningAt([part], 200)
+    expect(atEnd).toHaveLength(1)
+    expect(atEnd[0].streaming).toBe(false)
+    expect(atEnd[0].text).toBe("Full reasoning explanation")
+    expect(atEnd[0].start).toBe(100)
+    expect(atEnd[0].end).toBe(200)
+
+    const afterEnd = reasoningAt([part], 250)
+    expect(afterEnd).toHaveLength(1)
+    expect(afterEnd[0].streaming).toBe(false)
+    expect(afterEnd[0].text).toBe("Full reasoning explanation")
+  })
+
+  test("3. integrates with snapshotAt to hide text when cursor is mid-reasoning", () => {
+    const msg: Message = {
+      id: "m1",
+      sessionID: "s1",
+      role: "assistant",
+      time: { created: 50 },
+    } as Message
+    const part = rPart("p1", "m1", "Long deliberate thought chain", 100, 300)
+    const partsMap = (id: string) => (id === "m1" ? [part] : [])
+
+    // Cursor at 150 (mid-thought)
+    const midSnapshot = snapshotAt([msg], partsMap, 150)
+    const midReasoning = reasoningAt(midSnapshot.parts("m1"), 150)
+    expect(midReasoning).toHaveLength(1)
+    expect(midReasoning[0].streaming).toBe(true)
+    expect(midReasoning[0].text).toBe("")
+
+    // Cursor at 350 (thought finished)
+    const postSnapshot = snapshotAt([msg], partsMap, 350)
+    const postReasoning = reasoningAt(postSnapshot.parts("m1"), 350)
+    expect(postReasoning).toHaveLength(1)
+    expect(postReasoning[0].streaming).toBe(false)
+    expect(postReasoning[0].text).toBe("Long deliberate thought chain")
+  })
+})
+
+describe("tailLines and firstLine", () => {
+  test("tailLines returns all lines when count <= maxLines", () => {
+    expect(tailLines("line 1\nline 2\nline 3", 6)).toBe("line 1\nline 2\nline 3")
+  })
+
+  test("tailLines returns last 6 lines when count > 6", () => {
+    const text = Array.from({ length: 10 }, (_, i) => `line ${i + 1}`).join("\n")
+    const tail = tailLines(text, 6)
+    expect(tail).toBe("line 5\nline 6\nline 7\nline 8\nline 9\nline 10")
+  })
+
+  test("tailLines handles empty input", () => {
+    expect(tailLines("")).toBe("")
+  })
+
+  test("firstLine extracts first non-empty line", () => {
+    expect(firstLine("   \n\n  First step: inspect files  \nSecond line")).toBe("First step: inspect files")
+    expect(firstLine("")).toBe("")
+  })
+})
