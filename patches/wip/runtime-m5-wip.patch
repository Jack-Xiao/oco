+const expectFoldMatches = (messages: Message[], parts: RuntimeInput["parts"]) => {
+  const state = new Map<string, BackgroundNotice>()
+  messages.forEach((message, k) => {
+    const before = new Map(state)
+    const changes = applyBackgroundNotices(state, message, parts)
+    expect([...state]).toEqual([...backgroundNoticesOf(messages.slice(0, k + 1), parts)])
+    const rebuilt = new Map(before)
+    for (const change of changes) {
+      expect(change.notice).not.toBe(before.get(change.id))
+      if (change.notice) rebuilt.set(change.id, change.notice)
+      else rebuilt.delete(change.id)
+    }
+    expect(Object.fromEntries(rebuilt)).toEqual(Object.fromEntries(state))
+  })
