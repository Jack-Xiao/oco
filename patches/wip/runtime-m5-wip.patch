+          data-oco-runtime-events
+          class="box rounded-lg px-3 py-2 flex flex-col overflow-hidden shrink-0 relative"
+          style={{
+            background: "var(--rt-panel)",
+            border: "1px solid var(--rt-line)",
+            height: isStack() ? "176px" : "clamp(88px, 13.5cqh, 176px)",
+          }}
+        >
+          {/* The title is a corner tag (not a row) so an 88 px box still shows about three events. */}
+          <button
+            type="button"
+            ref={logTagRef}
+            data-oco-runtime-log-open
+            class={`absolute right-2 top-1.5 z-[1] px-1.5 rounded bg-transparent border-0 cursor-pointer text-11-regular font-mono ${FOCUS}`}
+            style={{ color: "var(--rt-faint)", background: "var(--rt-panel)" }}
+            aria-label={t("log.open")}
+            title={t("log.open")}
+            onClick={() => setLogOpen(true)}
+          >
+            {t("log.tag", { count: model().events.length })} ⤢
+          </button>
+          <div class="overflow-y-auto flex flex-col text-12-regular min-h-0 flex-1 pr-24">
+            <Show
+              when={model().events.length > 0}
+              fallback={
+                <div class="text-12-regular" style={{ color: "var(--rt-weak)" }}>
+                  {t("events.none")}
+                </div>
+              }
+            >
+              <For each={[...eventKeys.ids()].reverse()}>
+                {(id) => {
+                  const ev = () => eventKeys.get(id)!
+                  const isCurrent = () => cursor() !== undefined && ev().at === cursor()
+                  return eventRow(ev, isCurrent)
+                }}
+              </For>
+            </Show>
+          </div>
+        </div>
+
+        {/* Row 4: 状态栏 (Bottom Summary) */}
+        <div
+          data-oco-runtime-summary
+          class="flex items-center gap-6 text-12-regular whitespace-nowrap overflow-hidden px-1 shrink-0 font-mono"
+          style={{ color: "var(--rt-weak)" }}
+        >
+          {/* Session numbers that matter (user feedback, M4 batch 3): time, context headroom, cost, tokens.
+              Agent, model and round live on the core disc and the focus card; request / tool counts were dropped. */}
+          <Show when={summaryDuration()}>
+            <span data-oco-runtime-duration>{summaryDuration()}</span>
+          </Show>
+          <Show when={summaryContext()}>
+            <span data-oco-runtime-context>{summaryContext()}</span>
+          </Show>
+          <Show when={summaryCost()}>
+            <span data-oco-runtime-cost>{summaryCost()}</span>
+          </Show>
+          <span data-oco-runtime-usage class="oco-sum-p3">
+            {summaryUsage()}
+          </span>
+          <Show when={summaryChildren().shown}>
+            <span data-oco-runtime-summary-children>
+              {summaryChildren().before}
+              <span
+                data-oco-runtime-summary-blocked={rootLoop().counts.blocked}
+                style={{ color: summaryChildren().alert ? "var(--rt-err)" : undefined }}
+              >
+                {summaryChildren().blocked}
+              </span>
+              {summaryChildren().after}
+            </span>
+          </Show>
+          {/* Legend (moved from the top bar so the top bar stays on one line) */}
+          <div
+            data-oco-runtime-legend
+            class="oco-legend ml-auto flex items-center gap-4 text-12-regular whitespace-nowrap"
+            style={{ color: "var(--rt-weak)" }}
+          >
+            {/* Probe states on the loop lane (M4 batch 2). */}
+            <span class="flex items-center gap-1.5" title={t("legend.running")}>
+              <span style={{ color: "var(--rt-sub)" }}>○</span>
+              <span class="oco-legend-label">{t("legend.running")}</span>
+            </span>
+            <span class="flex items-center gap-1.5" title={t("legend.waiting")}>
+              <span style={{ color: "var(--rt-attn)" }}>○</span>
+              <span class="oco-legend-label">{t("legend.waiting")}</span>
+            </span>
+            <span class="flex items-center gap-1.5" title={t("legend.failed")}>
+              <span style={{ color: "var(--rt-err)" }}>○</span>
+              <span class="oco-legend-label">{t("legend.failed")}</span>
+            </span>
+            <span class="flex items-center gap-1.5" title={t("legend.absorbed")}>
+              <span style={{ color: "var(--rt-ok)" }}>●</span>
+              <span class="oco-legend-label">{t("legend.absorbed")}</span>
+            </span>
+            <span class="oco-sum-p2 flex items-center gap-1.5" title={t("legend.flow")}>
+              <span>··●</span>
+              <span class="oco-legend-label">{t("legend.flow")}</span>
+            </span>
+          </div>
+        </div>
+      </div>
+
+      <Show when={logOpen()}>
+        <div
+          ref={logPanelRef}
+          data-oco-runtime-log-panel
+          role="dialog"
+          aria-label={t("runtime.log_title")}
+          tabIndex={-1}
+          class="absolute left-4 right-4 bottom-3 z-20 flex flex-col rounded-lg px-4 py-3 outline-none"
+          style={{
+            top: "32%",
+            background: "var(--rt-panel)",
+            border: "1px solid var(--rt-line-strong)",
+          }}
+        >
+          <div class="flex items-center gap-2 shrink-0">
+            <h3 class="m-0 text-12-bold tracking-wider font-bold" style={{ color: "var(--rt-weak)" }}>
+              {t("runtime.log_title")} · {logEvents().length}
+            </h3>
+            <For each={["all", "error", "subagent"] as const}>
+              {(f) => (
+                <button
+                  type="button"
+                  data-oco-runtime-log-filter={f}
+                  aria-pressed={logFilter() === f}
+                  class={`px-2.5 py-0.5 rounded border cursor-pointer text-11-regular font-mono ${FOCUS}`}
+                  style={{
+                    "border-color": "var(--rt-line-strong)",
+                    background:
+                      logFilter() === f ? "color-mix(in srgb, var(--rt-sub) 25%, var(--rt-inset))" : "transparent",
+                    color: logFilter() === f ? "var(--rt-text)" : "var(--rt-weak)",
+                  }}
+                  onClick={() => setLogFilter(f)}
+                >
+                  {t(`log.filter.${f}`)}
+                </button>
+              )}
+            </For>
+            <button
+              type="button"
+              data-oco-runtime-log-close
+              class={`ml-auto px-2 rounded bg-transparent border-0 cursor-pointer text-12-regular font-mono ${FOCUS}`}
+              style={{ color: "var(--rt-weak)" }}
+              onClick={closeLog}
+            >
+              {t("log.close")}
+            </button>
+          </div>
+          <div class="overflow-y-auto flex flex-col min-h-0 flex-1 mt-2">
+            <Show
+              when={logEvents().length > 0}
+              fallback={
+                <div class="text-12-regular" style={{ color: "var(--rt-weak)" }}>
+                  {t("events.none")}
+                </div>
+              }
+            >
+              <For each={logEvents()}>
+                {(ev) =>
+                  eventRow(
+                    () => ev,
+                    () => cursor() !== undefined && ev.at === cursor(),
+                  )
+                }
+              </For>
+            </Show>
+          </div>
+        </div>
+      </Show>
+
+      {/* Screen-reader mirror: run state + one focus sentence only */}
+      <div class="sr-only" aria-live="polite" data-oco-runtime-live>
+        {liveSentence()}
+      </div>
+    </div>
+  )
+}
