+// oco (patches/opencode/0019): smoke test for the test-browser Solid JSX preload (solid-jsx-preload.ts)
+import { expect, test } from "bun:test"
+import { createSignal, For, type JSX } from "solid-js"
+import { render } from "solid-js/web"
+
+function Smoke(props: { items: string[] }): JSX.Element {
+  const [count, setCount] = createSignal(0)
+  return (
+    <div data-oco-smoke={count()}>
+      <button type="button" onClick={() => setCount(count() + 1)}>
+        add
+      </button>
+      <ul>
+        <For each={props.items}>{(item) => <li>{item}</li>}</For>
+      </ul>
+    </div>
+  )
+}
+
+test("Solid TSX compiles and mounts: For renders rows, a click updates an attribute", () => {
+  const host = document.createElement("div")
+  document.body.appendChild(host)
+  const dispose = render(() => <Smoke items={["a", "b", "c"]} />, host)
+  try {
+    expect(host.querySelectorAll("li").length).toBe(3)
+    const root = host.querySelector("[data-oco-smoke]")!
+    expect(root.getAttribute("data-oco-smoke")).toBe("0")
+    ;(host.querySelector("button") as HTMLButtonElement).click()
+    expect(root.getAttribute("data-oco-smoke")).toBe("1")
+  } finally {
+    dispose()
+    host.remove()
+  }
+})
