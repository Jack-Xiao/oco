@@ -0,0 +1,98 @@
+import { describe, expect, test } from "bun:test"
+import { createEffect, createRoot, createSignal } from "solid-js"
+import { keyed } from "@/components/session/session-runtime-keyed"
+
+type Item = { id: string; value: number }
+
+describe("keyed", () => {
+  test("same id sequence keeps the ids reference and does not rerun an effect", () => {
+    let runs = 0
+    let ids: () => string[] = () => []
+    let setItems: (next: Item[]) => void = () => {}
+    let dispose = () => {}
+    createRoot((done: () => void) => {
+      dispose = done
+      const [items, set] = createSignal<Item[]>([
+        { id: "a", value: 1 },
+        { id: "b", value: 2 },
+      ])
+      setItems = set
+      ids = keyed(items, (item: Item) => item.id).ids
+      createEffect(() => {
+        ids()
+        runs++
+      })
+    })
+    try {
+      expect(runs).toBe(1)
+      const initial = ids()
+      expect(initial).toEqual(["a", "b"])
+      setItems([
+        { id: "a", value: 10 },
+        { id: "b", value: 20 },
+      ])
+      expect(ids()).toBe(initial)
+      expect(runs).toBe(1)
+    } finally {
+      dispose()
+    }
+  })
+
+  test("get returns the latest object for an id", () => {
+    createRoot((dispose: () => void) => {
+      const [items, setItems] = createSignal<Item[]>([
+        { id: "a", value: 1 },
+        { id: "b", value: 2 },
+      ])
+      const { get } = keyed(items, (item: Item) => item.id)
+      expect(get("a")).toEqual({ id: "a", value: 1 })
+      expect(get("c")).toBeUndefined()
+
+      setItems([
+        { id: "a", value: 10 },
+        { id: "b", value: 20 },
+      ])
+      expect(get("a")).toEqual({ id: "a", value: 10 })
+      expect(get("b")).toEqual({ id: "b", value: 20 })
+      dispose()
+    })
+  })
+
+  test("an id order change updates ids and reruns an effect", () => {
+    let runs = 0
+    let ids: () => string[] = () => []
+    let get: (id: string) => Item | undefined = () => undefined
+    let setItems: (next: Item[]) => void = () => {}
+    let dispose = () => {}
+    createRoot((done: () => void) => {
+      dispose = done
+      const [items, set] = createSignal<Item[]>([
+        { id: "a", value: 1 },
+        { id: "b", value: 2 },
+      ])
+      setItems = set
+      const view = keyed(items, (item: Item) => item.id)
+      ids = view.ids
+      get = view.get
+      createEffect(() => {
+        ids()
+        runs++
+      })
+    })
+    try {
+      expect(runs).toBe(1)
+      const initial = ids()
+      setItems([
+        { id: "b", value: 20 },
+        { id: "a", value: 10 },
+      ])
+      expect(runs).toBe(2)
+      expect(ids()).toEqual(["b", "a"])
+      expect(ids()).not.toBe(initial)
+      expect(get("a")).toEqual({ id: "a", value: 10 })
+      expect(get("b")).toEqual({ id: "b", value: 20 })
+    } finally {
+      dispose()
+    }
+  })
+})
