+      closeLog()
+      return
+    }
+    const action = playbackKey({
+      key: e.key,
+      altKey: e.altKey,
+      ctrlKey: e.ctrlKey,
+      metaKey: e.metaKey,
+      target: e.target as HTMLElement | null,
+    })
+    if (!action) return
