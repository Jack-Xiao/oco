+  const activeReasonings = createMemo<RuntimeReasoning[]>(() => {
+    const m = model()
+    if (m.mode === "replay") {
+      const at = cursor()
+      if (at === undefined) return []
+      const reqs = m.requests
+      const lastReq = reqs[reqs.length - 1]
+      if (!lastReq) return []
+      return reasoningAt(parts(lastReq.messageID), at)
+    }
+    const inFlight = inFlightMessageID()
+    const targetID = inFlight ?? m.requests[m.requests.length - 1]?.messageID
+    if (!targetID) return []
+    return reasoningOf(parts(targetID), inFlight === targetID)
+  })
+
+  // Reasoning shown in the think box: the root's, or an entered child's (its latest assistant message).
+  const reasoningFor = (sessionID?: string): RuntimeReasoning[] => {
+    if (!sessionID) return activeReasonings()
+    const msgs = childMessagesOf(sessionID)
+    const last = msgs && [...msgs].reverse().find((m) => m.role === "assistant")
+    if (!msgs || !last) return []
+    if (model().mode === "replay") {
+      const at = cursor()
+      return at === undefined ? [] : reasoningAt(parts(last.id), at)
+    }
+    const childBusy = (sync().data.session_status[sessionID]?.type ?? "idle") !== "idle"
+    return reasoningOf(parts(last.id), inFlightOf(msgs, childBusy) === last.id)
+  }
