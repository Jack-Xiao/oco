@@ -0,0 +1,24 @@
+// oco (patches/opencode/0019): stable keyed row projection for reactive lists.
+import { createMemo, type Accessor } from "solid-js"
+
+export const sameIds = (prev: string[], next: string[]) => {
+  if (prev.length !== next.length) return false
+  for (let i = 0; i < prev.length; i++) if (prev[i] !== next[i]) return false
+  return true
+}
+
+/** Projects a reactive list into stable ids plus a latest-value lookup.
+ *  ids is a memo with content equality: an unchanged id sequence does not notify.
+ *  get(id) reads the current object. */
+export function keyed<T>(
+  list: Accessor<T[]>,
+  key: (item: T) => string,
+): { ids: Accessor<string[]>; get: (id: string) => T | undefined } {
+  const ids = createMemo(() => list().map(key), [] as string[], { equals: sameIds })
+  const byId = createMemo(() => {
+    const map = new Map<string, T>()
+    for (const item of list()) map.set(key(item), item)
+    return map
+  })
+  return { ids, get: (id) => byId().get(id) }
+}
