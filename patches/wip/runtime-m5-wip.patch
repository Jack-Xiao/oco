--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-reasoning.ts
@@ -0,0 +1,81 @@
+// oco (patches/opencode/0019): runtime view reasoning stream. Pure functions over session parts;
+// contract and rules: docs/superpowers/plans/2026-10-03-runtime-dashboard-m3.md (section 6, Task 3).
+import type { Part } from "@opencode-ai/sdk/v2/client"
+
+export type RuntimeReasoning = {
+  partID: string
+  messageID: string
+  text: string
+  streaming: boolean
+  start?: number
+  end?: number
+}
+
+/** Extracts non-empty reasoning parts. streaming = inFlight && !time.end. */
+export function reasoningOf(parts: readonly Part[], inFlight: boolean): RuntimeReasoning[] {
+  const result: RuntimeReasoning[] = []
+  for (const part of parts) {
+    if (part.type !== "reasoning") continue
+    if (!part.text || part.text.length === 0) continue
+    const streaming = Boolean(inFlight && !part.time?.end)
+    result.push({
+      partID: part.id,
+      messageID: part.messageID,
+      text: part.text,
+      streaming,
+      start: part.time?.start,
+      end: part.time?.end,
+    })
+  }
+  return result
+}
+
+/** Replay: only reasoning parts whose time.end <= cursor show text (not streaming).
+ *  Reasoning in progress at cursor (start <= cursor < end, or no end) shows streaming=true and NO text. */
+export function reasoningAt(parts: readonly Part[], cursor: number): RuntimeReasoning[] {
+  const result: RuntimeReasoning[] = []
+  for (const part of parts) {
+    if (part.type !== "reasoning") continue
+    if (!part.text || part.text.length === 0) continue
+    const start = part.time?.start
+    const end = part.time?.end
+    if (start !== undefined && start > cursor) continue
+
+    if (end !== undefined && end <= cursor) {
+      result.push({
+        partID: part.id,
+        messageID: part.messageID,
+        text: part.text,
+        streaming: false,
+        start,
+        end,
+      })
+    } else {
+      // In progress at cursor: do not leak future text into replay
+      result.push({
+        partID: part.id,
+        messageID: part.messageID,
+        text: "",
+        streaming: true,
+        start,
+        end: undefined,
+      })
+    }
+  }
+  return result
+}
+
+/** Returns the last maxLines lines of text, separated by newline. Does not truncate lines. */
+export function tailLines(text: string, maxLines = 6): string {
+  if (!text) return ""
+  const lines = text.split("\n")
+  if (lines.length <= maxLines) return text
+  return lines.slice(-maxLines).join("\n")
+}
+
+/** Returns the first non-empty line of text for compact preview. */
+export function firstLine(text: string): string {
+  if (!text) return ""
+  const lines = text.split("\n").map((l) => l.trim()).filter(Boolean)
+  return lines[0] ?? ""
+}
diff --git a/packages/app/src/components/session/session-runtime-ring-fixture.test.ts b/packages/app/src/components/session/session-runtime-ring-fixture.test.ts
