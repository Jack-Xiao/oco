+  }
+
+  const isSubagent = (x: RuntimeTool) => x.child !== undefined
+  const recentEvents = createMemo(() => model().events.slice(-60))
+  const attention = createMemo(() => model().run.attention)
+
+  const stateLabel = () => t(`state.${model().run.state}`)
+
+
+  const liveSentence = createMemo(() => {
+    const m = model()
+    const state = stateLabel()
+    const f = m.focus
+    const focus =
+      f.kind === "attention"
+        ? attentionText(t, f.attention)
+        : f.kind === "retry"
+          ? t("focus.retry", { attempt: f.attempt, message: f.message })
+          : f.kind === "error"
+            ? f.message
+              ? t("focus.error", { message: f.message })
+              : t("focus.error.unknown")
+            : f.kind === "working"
+              ? f.tool
+                ? t("focus.working.tool", {
+                    tool: f.tool.child?.agent ?? f.tool.retrieves?.agent ?? f.tool.name,
+                    input: f.tool.input,
+                  })
+                : t(`stage.${stageKey(f.stage)}`)
+              : t(`focus.${f.kind}`)
+    return `${state}. ${focus}`
+  })
+
+  const eventKeys = keyed(recentEvents, (e) => e.id)
+
+  // Subagent rows live on the loop lane; the main agent's own tools and background_output do not.
+  const rootLoop = createMemo(() => loopOf(model(), (id) => (childMessagesOf(id) ? assembleChild(id) : undefined)))
+
+  // Left column overview (M4 batch 3): the round's goal, the todo list and session totals, all at the replay cursor.
+  const shownView = () => view() ?? { messages: messages(), parts }
+  const goal = createMemo(() => {
+    const m = model()
+    return goalOf(shownView(), m.requests.find((r) => r.index === m.roundStart)?.messageID)
+  })
+  // Live prefers the server's list (it follows todo.updated); replay rebuilds it from the todowrite calls so far.
+  const todos = createMemo(() => {
+    const derived = todosOf(shownView())
+    if (model().mode === "replay") return derived ?? []
+    const server = sync().data.todo[props.sessionID]
+    // An empty server list can mean "not fetched" (the v2 protocol never fetches), so the todowrite calls decide then.
+    return server?.length ? server.map((item, i) => ({ ...item, id: `server:${i}` })) : (derived ?? [])
+  })
+  const todoKeys = keyed(todos, (item) => item.id)
+  onMount(() => void sync().session.todo(props.sessionID))
+  const summaryDuration = createMemo(() => {
+    const list = messages()
+    const first = list[0]?.time.created
+    const lastOf = (msg: Message) =>
+      msg.role === "assistant" ? (msg.time.completed ?? msg.time.created) : msg.time.created
+    const end =
+      model().mode === "replay" ? cursor() : busy() ? wall() : list.length ? lastOf(list[list.length - 1]) : undefined
+    return first !== undefined && end !== undefined ? t("summary.duration", { value: ago(t, end - first) }) : undefined
+  })
+
+  // Same count as the loop lane: one per task of the current round.
+  // Split around the blocked phrase so it alone can turn red (only when something is blocked).
+  const summaryChildren = () => {
+    const c = rootLoop().counts
+    const [before, after = ""] = t("summary.children", { total: c.total, running: c.running, blocked: "\u0001" }).split(
+      "\u0001",
+    )
+    return {
+      before,
+      blocked: t("summary.blocked", { n: c.blocked }),
+      after,
+      alert: c.blocked > 0,
+      shown: c.running + c.blocked + c.queued + c.docked > 0,
+    }
+  }
+
+  const summaryUsage = () => {
+    const u = model().usage.tokens
+    if (!u) {
+      return model().usage.requests === 0
+        ? t("usage.none")
+        : model().usage.settled
+          ? t("usage.unknown")
+          : t("usage.counting")
+    }
+    return t("summary.tokens", { tokens: `${count(u.input, copy.intl())} / ${count(u.output, copy.intl())}` })
+  }
+
+  const summaryContext = () => {
+    const c = getSessionContext(messagesForContext(model().mode, messages(), view()?.messages), [
+      ...providers.all().values(),
+    ])
+    if (!c || c.limit === undefined) return ""
+    return t("summary.context", {
+      used: count(c.total ?? 0, copy.intl()),
+      limit: count(c.limit, copy.intl()),
+    })
+  }
+
+  const summaryCost = () => {
+    const reqs = model().requests
+    const cost = reqs.reduce((acc, r) => acc + (r.cost ?? 0), 0)
+    return cost > 0 ? t("summary.cost", { cost: cost.toFixed(4) }) : undefined
+  }
