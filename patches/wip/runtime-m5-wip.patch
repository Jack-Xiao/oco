+  const playbackButton = (id: string, glyph: () => string, label: () => string, run: () => void) => (
+    <button
+      type="button"
+      {...{ [`data-oco-runtime-replay-${id}`]: "" }}
+      class={`inline-flex items-center justify-center h-7 min-w-7 px-1.5 rounded border bg-transparent cursor-pointer text-12-regular font-mono disabled:opacity-40 disabled:cursor-default ${FOCUS}`}
+      style={{
+        "border-color": "var(--rt-line-strong)",
+        color: id === "play" && playing() ? "var(--rt-text)" : "var(--rt-weak)",
+      }}
