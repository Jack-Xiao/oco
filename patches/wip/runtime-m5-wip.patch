+import { elapsedClock, loopOf, messagesForContext } from "./session-runtime-loop"
+import { goalOf, todoCounts, todosOf } from "./session-runtime-overview"
+
+const emptyMessages: Message[] = []
+const emptyParts: Part[] = []
+
+const COLOR = {
+  model: "var(--rt-main)",
+  tool: "var(--rt-tool)",
+  subagent: "var(--rt-sub)",
+  attention: "var(--rt-attn)",
+  error: "var(--rt-err)",
+  ok: "var(--rt-ok)",
+  accent: "var(--rt-accent)",
+} as const
+
+const TODO_LOOK: Record<string, { glyph: string; mark: string; text: string; strike?: boolean }> = {
+  completed: { glyph: "✓", mark: "var(--rt-ok)", text: "var(--rt-faint)", strike: true },
+  in_progress: { glyph: "▸", mark: "var(--rt-main)", text: "var(--rt-text)" },
+  pending: { glyph: "○", mark: "var(--rt-faint)", text: "var(--rt-weak)" },
+  cancelled: { glyph: "×", mark: "var(--rt-faint)", text: "var(--rt-faint)", strike: true },
