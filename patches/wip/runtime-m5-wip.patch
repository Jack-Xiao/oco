+// oco (patches/opencode/0019): M5 replay timeline — folds, v <-> t, labels that never reveal the future, navigation.
+import { describe, expect, test } from "bun:test"
+import { runtimeText } from "./session-runtime-i18n"
+import { RING, type Phrase, type PhraseParam, type TrackInput } from "./session-runtime-ring-types"
+import {
+  foldElapsed,
+  foldsOf,
+  foldVisible,
+  navStep,
+  textWidth,
+  ticksAt,
+  TRACK_LABEL_PX,
+  trackLabelsAt,
+  trackMap,
+  trackRoundAt,
+} from "./session-runtime-ring-track"
+
+// Real session times (epoch ms) from the M5 timeline export (rounds 1-4). Task 4's fixture adapter and Task 5's
+// trackInputOf land in parallel, so the TrackInput is built here from the same constants; Task 11 checks the chain.
+const START = [1791104995369, 1791105736816, 1791119285329, 1791119355114]
+const END = [
+  1791105119024, // r1: finish stop (completed)
+  1791105780460, // r2: finish stop (completed)
+  1791119343457, // r3: aborted (error completion)
+  1791119427857, // r4: question dismissed (tool end)
+]
+const ASK = { start: 1791119398585, end: 1791119427857 }
+const KEY = { j04: 1791113400000, k08: 1791119405000, k09: 1791119428200, k10: 1791121200000 }
+const T0 = START[0] - RING.LEAD_MS
+
+const fixture = (t1 = KEY.k10): TrackInput => ({
+  t0: T0,
+  t1,
+  rounds: START.map((start, i) => ({ n: i + 1, start, endAt: END[i] })),
+  waits: [ASK],
+  ticks: [
+    ...START.map((t) => ({ t, cls: "r" as const })),
+    { t: 1791104995471, cls: "" },
+    { t: 1791105736865, cls: "" },
+    { t: 1791119285387, cls: "" },
+    { t: 1791119341683, cls: "" },
+    { t: 1791119343457, cls: "e" },
+    { t: 1791119387720, cls: "" },
+    { t: ASK.start, cls: "a" },
+  ],
+})
+
+const zh = runtimeText({ locale: () => "zh", intl: () => "zh-CN" })
