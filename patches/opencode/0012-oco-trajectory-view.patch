+// oco (patches/opencode/0012): trajectory view data model.
+import { describe, expect, test } from "bun:test"
+import { buildTrajectory, createTimeScale, idTime, requestTiming } from "./session-trajectory-model"
+
+const T0 = 1_790_000_000_000
+
+/** An ascending OpenCode id created at `ms` (same encoding as packages/opencode/src/id/id.ts). */
+const id = (prefix: string, ms: number, counter = 0) =>
+  `${prefix}_${((BigInt(ms) * 4096n + BigInt(counter)) % 2n ** 48n).toString(16).padStart(12, "0")}AbCdEfGhIjKlMn`
+
+const user = (ms: number, extra: Record<string, unknown> = {}) =>
+  ({ id: id("msg", ms), sessionID: "s", role: "user", time: { created: ms }, agent: "build", model: {}, ...extra }) as any
+
+const assistant = (parent: any, ms: number, extra: Record<string, unknown> = {}) =>
+  ({
+    id: id("msg", ms),
+    sessionID: "s",
+    role: "assistant",
+    parentID: parent.id,
+    time: { created: ms, completed: ms + 2100 },
+    modelID: "m",
+    providerID: "p",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/", root: "/" },
+    cost: 0.01,
+    tokens: { input: 100, output: 120, reasoning: 20, cache: { read: 900, write: 0 } },
+    ...extra,
+  }) as any
+
+const text = (ms: number, value: string, end?: number, extra: Record<string, unknown> = {}) =>
+  ({ id: id("prt", ms), type: "text", text: value, time: { start: ms, end }, ...extra }) as any
+
+describe("idTime", () => {
+  test("decodes the creation time of an ascending id", () => {
+    expect(idTime(id("prt", T0 + 1234, 7), T0)).toBe(T0 + 1234)
+  })
+  test("recovers the time across the 48-bit wrap", () => {
+    const wrap = Math.ceil(T0 / 2 ** 36) * 2 ** 36
+    expect(idTime(id("prt", wrap + 5), wrap - 10)).toBe(wrap + 5)
+    expect(idTime(id("prt", wrap - 5), wrap + 10)).toBe(wrap - 5)
+  })
+  test("rejects ids without a timestamp", () => {
+    expect(idTime("u1", T0)).toBeUndefined()
+  })
+})
+
+describe("buildTrajectory", () => {
+  const u = user(T0)
+  const a1 = assistant(u, T0 + 100)
+  const a2 = assistant(u, T0 + 2300, { time: { created: T0 + 2300, completed: T0 + 3000 }, cost: 0 })
+  const parts: Record<string, any[]> = {
+    [u.id]: [
+      text(T0, "hello"),
+      text(T0 + 1, "Called the Read tool with x", undefined, { synthetic: true }),
+      { id: id("prt", T0 + 2), type: "file", mime: "image/png", filename: "a.png", url: "data:" },
+    ],
+    [a1.id]: [
+      { id: id("prt", T0 + 300), type: "step-start" },
+      { id: id("prt", T0 + 500), type: "reasoning", text: "think", time: { start: T0 + 500, end: T0 + 900 } },
+      text(T0 + 950, "answer", T0 + 1300),
+      {
+        id: id("prt", T0 + 1000),
+        type: "tool",
+        tool: "bash",
+        callID: "c1",
+        state: { status: "completed", input: { command: "ls" }, output: "a\nb", title: "", metadata: {}, time: { start: T0 + 1100, end: T0 + 2000 } },
+      },
+      { id: id("prt", T0 + 2100), type: "step-finish", reason: "tool-calls", cost: 0.01, tokens: {} },
+    ],
+    [a2.id]: [text(T0 + 2600, "done", T0 + 2900)],
+  }
+  const tr = buildTrajectory({ messages: [u, a1, a2], parts: (m) => parts[m] ?? [], now: T0 + 10_000 })
+
+  test("rows follow the session order with request boundaries", () => {
+    expect(tr.rows.map((r) => r.kind)).toEqual(["system", "user", "context", "context", "reasoning", "text", "tool", "text"])
+    expect(tr.rows.filter((r) => r.firstOfRequest).map((r) => r.request)).toEqual([0, 1])
+    const tool = tr.rows.find((r) => r.kind === "tool") as any
+    expect(tool.input).toBe('{"command":"ls"}')
+    expect(tool.output).toBe("a b")
+  })
+
+  test("requests are numbered per turn and timed from stored data", () => {
+    expect(tr.requests.map((r) => [r.turn, r.step, r.status])).toEqual([
+      [0, 1, "done"],
+      [0, 2, "done"],
+    ])
+    const r = tr.requests[0]!
+    expect(r.firstToken).toBe(T0 + 500)
+    expect(r.generationEnd).toBe(T0 + 1300)
+    expect(r.windowEnd).toBe(T0 + 2200)
+    const timing = requestTiming(r)
+    expect(timing.ttft).toBe(400)
+    expect(timing.generation).toBe(800)
+    expect(timing.throughput).toBeCloseTo(140 / 0.8)
+    expect(timing.total).toBe(2100)
+  })
+
+  test("totals add up tokens, cost and tools", () => {
+    expect(tr.totals).toMatchObject({ input: 200, output: 240, reasoning: 40, cacheRead: 1800, cost: 0.01, requests: 2, tools: 1 })
+    expect(tr.turns).toHaveLength(1)
+    expect(tr.end).toBe(T0 + 3000)
+  })
+
+  test("running and failed requests", () => {
+    const running = assistant(u, T0 + 100, { time: { created: T0 + 100 } })
+    const failed = assistant(u, T0 + 200, { error: { name: "APIError", data: { message: "rate limited" } } })
+    const out = buildTrajectory({
+      messages: [u, running, failed],
+      parts: (m) =>
+        m === running.id
+          ? [{ id: id("prt", T0 + 400), type: "tool", tool: "read", callID: "c", state: { status: "running", input: {}, time: { start: T0 + 400 } } }] as any
+          : [],
+      now: T0 + 5000,
+    })
+    expect(out.requests[0]).toMatchObject({ status: "running", windowEnd: T0 + 5000 })
+    expect(out.requests[1]).toMatchObject({ status: "error", error: "APIError: rate limited" })
+    expect(out.rows.at(-1)).toMatchObject({ kind: "event", label: "错误", error: true })
+  })
+
+  test("a message held twice in the store is listed once", () => {
+    const out = buildTrajectory({ messages: [u, a1, u, a2], parts: (m) => parts[m] ?? [], now: T0 + 10_000 })
+    expect(out.rows.filter((r) => r.kind === "user")).toHaveLength(1)
+    expect(out.turns).toHaveLength(1)
+    expect(out.requests.map((r) => r.step)).toEqual([1, 2])
+  })
+
+  test("records a stored custom system prompt", () => {
+    const out = buildTrajectory({ messages: [user(T0, { system: "be brief" })], parts: () => [], now: T0 })
+    expect(out.rows[0]).toMatchObject({ kind: "system", text: "be brief" })
+  })
+})
+
+describe("createTimeScale", () => {
+  const u1 = user(T0)
+  const a1 = assistant(u1, T0 + 10, { time: { created: T0 + 10, completed: T0 + 1000 } })
+  const u2 = user(T0 + 3_600_000)
+  const a2 = assistant(u2, T0 + 3_600_010, { time: { created: T0 + 3_600_010, completed: T0 + 3_603_000 } })
+  const tr = buildTrajectory({ messages: [u1, a1, u2, a2], parts: () => [], now: T0 + 4_000_000 })
+
+  test("duration scale collapses idle time between turns", () => {
+    const { x } = createTimeScale(tr, "duration")
+    expect(x(T0)).toBe(0)
+    expect(x(T0 + 3_600_000)).toBeCloseTo(1000 / 4000)
+    expect(x(T0 + 1_000_000)).toBeCloseTo(1000 / 4000)
+    expect(x(T0 + 3_603_000)).toBe(1)
+  })
+
+  test("request scale gives each request the same width", () => {
+    const { x, boundaries } = createTimeScale(tr, "request")
+    expect(boundaries).toEqual([0.5])
+    expect(x(T0 + 3_600_000)).toBe(0.5)
+    expect(x(T0 + 505)).toBeCloseTo(0.25)
+  })
+})
