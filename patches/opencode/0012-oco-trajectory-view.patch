+// oco (patches/opencode/0012): trajectory view data model. Pure functions over the session's stored
+// messages and parts; no network, no Solid. One assistant message is one model request (one step).
+import type { AssistantMessage, Message, Part, ToolPart, UserMessage } from "@opencode-ai/sdk/v2/client"
+
+export type TrajectoryTokens = {
+  input: number
+  output: number
+  reasoning: number
+  cacheRead: number
+  cacheWrite: number
+}
+
+export type TrajectoryRequest = {
+  /** 0-based position in Trajectory.requests. */
+  index: number
+  /** 1-based step within its turn. */
+  step: number
+  /** 0-based turn index. */
+  turn: number
+  message: AssistantMessage
+  start: number
+  /** First streamed content (reasoning, text or tool input). */
+  firstToken?: number
+  /** Last generated content: text/reasoning end or the latest tool call's execution start. */
+  generationEnd?: number
+  /** Request finished (message completed, else the step-finish part time). */
+  end?: number
+  /** End of everything this request caused, including its tools; `now` while still running. */
+  windowEnd: number
+  tokens: TrajectoryTokens
+  cost: number
+  status: "running" | "done" | "error"
+  error?: string
+}
+
+export type TrajectoryTurn = {
+  index: number
+  user?: UserMessage
+  start: number
+  end: number
+  requests: number[]
+}
+
+type RowBase = { id: string; turn: number; request?: number; firstOfRequest?: boolean }
+
+export type TrajectoryRow =
+  | (RowBase & { kind: "system"; text: string })
+  | (RowBase & { kind: "user"; text: string; message: UserMessage })
+  | (RowBase & { kind: "context"; label: string; text: string; part: Part })
+  | (RowBase & { kind: "reasoning" | "text"; text: string; part: Part; start?: number; end?: number })
+  | (RowBase & {
+      kind: "tool"
+      tool: string
+      status: ToolPart["state"]["status"]
+      input: string
+      output: string
+      part: ToolPart
+      start?: number
+      end?: number
+    })
+  | (RowBase & { kind: "event"; label: string; text: string; part?: Part; error?: boolean })
+
+export type Trajectory = {
+  turns: TrajectoryTurn[]
+  requests: TrajectoryRequest[]
+  rows: TrajectoryRow[]
+  start: number
+  end: number
+  totals: TrajectoryTokens & { cost: number; requests: number; tools: number }
+}
+
+const ID_PERIOD = 2 ** 36
+
+/** Creation time (ms) encoded in an ascending OpenCode id (`prefix_` + 12 hex digits of
+ *  `ms * 0x1000 + counter`, low 48 bits). The high bits are lost, so align to a nearby time. */
+export function idTime(id: string, near: number): number | undefined {
+  const at = id.indexOf("_")
+  const hex = id.slice(at + 1, at + 13)
+  if (at < 0 || !/^[0-9a-f]{12}$/i.test(hex)) return
+  const low = Math.floor(parseInt(hex, 16) / 0x1000)
+  const base = near - (near % ID_PERIOD)
+  let t = base + low
+  if (t - near > ID_PERIOD / 2) t -= ID_PERIOD
+  if (near - t > ID_PERIOD / 2) t += ID_PERIOD
+  return t
+}
+
+export function oneLine(text: string, max = 240) {
+  const flat = text.replace(/\s+/g, " ").trim()
+  return flat.length > max ? flat.slice(0, max - 1) + "…" : flat
+}
+
+function stringify(value: unknown) {
+  if (typeof value === "string") return value
+  try {
+    return JSON.stringify(value) ?? ""
+  } catch {
+    return String(value)
+  }
+}
+
+function errorText(error: unknown): string | undefined {
+  if (!error || typeof error !== "object") return
+  const e = error as { name?: string; data?: { message?: string } }
+  return [e.name, e.data?.message].filter(Boolean).join(": ") || stringify(error)
+}
+
+function max(...values: (number | undefined)[]) {
+  let out: number | undefined
+  for (const v of values) if (v !== undefined && (out === undefined || v > out)) out = v
+  return out
+}
+
+function min(...values: (number | undefined)[]) {
+  let out: number | undefined
+  for (const v of values) if (v !== undefined && (out === undefined || v < out)) out = v
+  return out
+}
+
+function toolStart(part: ToolPart) {
+  return "time" in part.state ? part.state.time.start : undefined
+}
+
+function toolEnd(part: ToolPart) {
+  const time = "time" in part.state ? (part.state.time as { end?: number }) : undefined
+  return time?.end
+}
+
+function toolOutput(part: ToolPart) {
+  const s = part.state
+  if (s.status === "completed") return s.output
+  if (s.status === "error") return s.error
+  return ""
+}
+
+export function emptyTokens(): TrajectoryTokens {
+  return { input: 0, output: 0, reasoning: 0, cacheRead: 0, cacheWrite: 0 }
+}
+
+export function promptTokens(t: TrajectoryTokens) {
+  return t.input + t.cacheRead + t.cacheWrite
+}
+
+export function totalTokens(t: TrajectoryTokens) {
+  return promptTokens(t) + t.output + t.reasoning
+}
+
+/** Time-to-first-token, generation time and throughput (generated tokens per second). */
+export function requestTiming(r: TrajectoryRequest) {
+  const ttft = r.firstToken !== undefined ? r.firstToken - r.start : undefined
+  const generation =
+    r.firstToken !== undefined && r.generationEnd !== undefined ? r.generationEnd - r.firstToken : undefined
+  const generated = r.tokens.output + r.tokens.reasoning
+  const throughput = generation !== undefined && generation >= 100 && generated > 0 ? generated / (generation / 1000) : undefined
+  const total = r.end !== undefined ? r.end - r.start : undefined
+  return { ttft, generation, throughput, total }
+}
+
+const CONTEXT_LABEL = "上下文"
+
+export function buildTrajectory(input: {
+  messages: Message[]
+  parts: (messageID: string) => Part[]
+  now: number
+}): Trajectory {
+  const turns: TrajectoryTurn[] = []
+  const requests: TrajectoryRequest[] = []
+  const rows: TrajectoryRow[] = []
+  const turnByUser = new Map<string, number>()
+  const totals = { ...emptyTokens(), cost: 0, requests: 0, tools: 0 }
+
+  const system = input.messages.find((m): m is UserMessage => m.role === "user" && !!m.system)?.system
+  const firstUser = input.messages.find((m): m is UserMessage => m.role === "user")
+  rows.push({
+    id: "system",
+    kind: "system",
+    turn: -1,
+    text: system
+      ? oneLine(system)
+      : `智能体 ${firstUser?.agent ?? "-"} · 系统提示词由 OpenCode 运行时组装，未保存实际发送内容`,
+  })
+
+  // The sync store can briefly hold a message twice (optimistic copy + server copy, same id): keep the
+  // latest copy at the first position.
+  const unique = new Map<string, Message>()
+  for (const message of input.messages) unique.set(message.id, message)
+
+  for (const message of unique.values()) {
+    const parts = input.parts(message.id)
+    if (message.role === "user") {
+      const index = turns.length
+      turnByUser.set(message.id, index)
+      turns.push({ index, user: message, start: message.time.created, end: message.time.created, requests: [] })
+      const typed = parts
+        .filter((p) => p.type === "text" && !p.synthetic && !p.ignored)
+        .map((p) => (p.type === "text" ? p.text : ""))
+        .join("\n")
+      rows.push({ id: message.id, kind: "user", turn: index, text: oneLine(typed || "（无文本）"), message })
+      for (const part of parts) {
+        if (part.type === "text" && (part.synthetic || part.ignored)) {
+          if (!part.text.trim()) continue
+          rows.push({ id: part.id, kind: "context", turn: index, label: CONTEXT_LABEL, text: oneLine(part.text), part })
+        } else if (part.type === "file") {
+          rows.push({
+            id: part.id,
+            kind: "context",
+            turn: index,
+            label: "附件",
+            text: oneLine(`${part.filename ?? part.url} · ${part.mime}`),
+            part,
+          })
+        } else if (part.type === "agent") {
+          rows.push({ id: part.id, kind: "event", turn: index, label: "智能体", text: `@${part.name}`, part })
+        } else if (part.type === "subtask") {
+          rows.push({
+            id: part.id,
+            kind: "event",
+            turn: index,
+            label: "子任务",
+            text: oneLine(`${part.agent} · ${part.description}`),
+            part,
+          })
+        } else if (part.type === "compaction") {
+          rows.push({
+            id: part.id,
+            kind: "event",
+            turn: index,
+            label: "压缩",
+            text: part.auto ? "上下文自动压缩" : "上下文压缩",
+            part,
+          })
+        }
+      }
+      continue
+    }
+
+    let turnIndex = turnByUser.get(message.parentID) ?? turns.length - 1
+    if (turnIndex < 0) {
+      turnIndex = 0
+      turns.push({ index: 0, start: message.time.created, end: message.time.created, requests: [] })
+    }
+    const turn = turns[turnIndex]!
+    const index = requests.length
+    const near = message.time.created
+    let first: number | undefined
+    let genEnd: number | undefined
+    let finishAt: number | undefined
+    let toolsEnd: number | undefined
+    let firstRow = true
+    const push = (row: TrajectoryRow) => {
+      rows.push(firstRow ? { ...row, firstOfRequest: true } : row)
+      firstRow = false
+    }
+
+    for (const part of parts) {
+      if (part.type === "reasoning" || part.type === "text") {
+        const start = part.time?.start ?? idTime(part.id, near)
+        const end = part.time?.end
+        if (part.type === "text" && !part.text.trim() && !end) continue
+        first = min(first, start)
+        genEnd = max(genEnd, end, start)
+        if (!part.text.trim()) continue
+        push({ id: part.id, kind: part.type, turn: turnIndex, request: index, text: oneLine(part.text), part, start, end })
+      } else if (part.type === "tool") {
+        const created = idTime(part.id, near)
+        const start = toolStart(part) ?? created
+        const end = toolEnd(part)
+        first = min(first, created ?? start)
+        genEnd = max(genEnd, start)
+        toolsEnd = max(toolsEnd, end ?? (part.state.status === "running" || part.state.status === "pending" ? input.now : start))
+        totals.tools++
+        push({
+          id: part.id,
+          kind: "tool",
+          turn: turnIndex,
+          request: index,
+          tool: part.tool,
+          status: part.state.status,
+          input: oneLine(stringify(part.state.input), 160),
+          output: oneLine(toolOutput(part) || (part.state.status === "running" ? "运行中…" : "")),
+          part,
+          start,
+          end,
+        })
+      } else if (part.type === "step-finish") {
+        finishAt = idTime(part.id, near)
+      } else if (part.type === "patch") {
+        push({
+          id: part.id,
+          kind: "event",
+          turn: turnIndex,
+          request: index,
+          label: "变更",
+          text: oneLine(`${part.files.length} 个文件 · ${part.files.join(", ")}`),
+          part,
+        })
+      } else if (part.type === "retry") {
+        push({
+          id: part.id,
+          kind: "event",
+          turn: turnIndex,
+          request: index,
+          label: "重试",
+          text: oneLine(`第 ${part.attempt} 次 · ${errorText(part.error) ?? ""}`),
+          part,
+          error: true,
+        })
+      }
+    }
+
+    const error = errorText(message.error)
+    if (error) push({ id: `${message.id}:error`, kind: "event", turn: turnIndex, request: index, label: "错误", text: oneLine(error), error: true })
+
+    const end = message.time.completed ?? finishAt
+    const status: TrajectoryRequest["status"] = error ? "error" : end !== undefined ? "done" : "running"
+    const windowEnd = max(end, toolsEnd, genEnd, status === "running" ? input.now : undefined, message.time.created)!
+    const tokens: TrajectoryTokens = {
+      input: message.tokens?.input ?? 0,
+      output: message.tokens?.output ?? 0,
+      reasoning: message.tokens?.reasoning ?? 0,
+      cacheRead: message.tokens?.cache?.read ?? 0,
+      cacheWrite: message.tokens?.cache?.write ?? 0,
+    }
+    requests.push({
+      index,
+      step: turn.requests.length + 1,
+      turn: turnIndex,
+      message,
+      start: message.time.created,
+      firstToken: first,
+      generationEnd: genEnd ?? end,
+      end,
+      windowEnd,
+      tokens,
+      cost: message.cost ?? 0,
+      status,
+      error,
+    })
+    turn.requests.push(index)
+    turn.end = Math.max(turn.end, windowEnd)
+    totals.input += tokens.input
+    totals.output += tokens.output
+    totals.reasoning += tokens.reasoning
+    totals.cacheRead += tokens.cacheRead
+    totals.cacheWrite += tokens.cacheWrite
+    totals.cost += message.cost ?? 0
+    totals.requests++
+  }
+
+  const start = turns[0]?.start ?? input.now
+  const end = Math.max(start, ...turns.map((t) => t.end))
+  return { turns, requests, rows, start, end, totals }
+}
+
+export type TrajectoryScale = "duration" | "turn" | "request"
+
+type Window = { t0: number; t1: number; weight: number }
+
+/** Maps absolute times onto [0, 1]. Idle gaps between windows collapse to nothing, so long user
+ *  pauses do not dominate the "duration" scale. */
+export function createTimeScale(trajectory: Trajectory, scale: TrajectoryScale) {
+  const raw: Window[] =
+    scale === "request"
+      ? trajectory.requests.map((r) => ({ t0: r.start, t1: r.windowEnd, weight: 1 }))
+      : trajectory.turns.map((t) => ({ t0: t.start, t1: t.end, weight: 1 }))
+  const span = raw.reduce((sum, w) => sum + Math.max(0, w.t1 - w.t0), 0)
+  const windows =
+    scale === "duration" ? raw.map((w) => ({ ...w, weight: Math.max(w.t1 - w.t0, span * 0.01, 1) })) : raw
+  const total = windows.reduce((sum, w) => sum + w.weight, 0)
+  const offsets: number[] = []
+  let acc = 0
+  for (const w of windows) {
+    offsets.push(acc)
+    acc += w.weight
+  }
+  const x = (t: number): number => {
+    if (!windows.length || total <= 0) return 0
+    for (let i = 0; i < windows.length; i++) {
+      const w = windows[i]!
+      if (t < w.t0) return offsets[i]! / total
+      if (t <= w.t1) {
+        const f = w.t1 > w.t0 ? (t - w.t0) / (w.t1 - w.t0) : 0
+        return (offsets[i]! + f * w.weight) / total
+      }
+    }
+    return 1
+  }
+  const boundaries = offsets.slice(1).map((o) => o / total)
+  return { x, boundaries }
+}
