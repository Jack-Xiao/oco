+        class="absolute top-0 h-full rounded-[2px] opacity-40"
+        classList={{ "outline outline-1 outline-[var(--text-strong)] opacity-60": props.selected }}
+        style={{ ...props.span(r().start, first() ?? end()), background: color() }}
+        onClick={props.onSelect}
+      />
+      <Show when={first()}>
+        {(f) => (
+          <button
+            type="button"
+            tabIndex={-1}
+            aria-hidden="true"
+            title={label()}
+            class="absolute top-0 h-full rounded-[2px]"
+            classList={{ "outline outline-1 outline-[var(--text-strong)]": props.selected }}
+            style={{ ...props.span(f(), genEnd()), background: color() }}
+            onClick={props.onSelect}
+          />
+        )}
+      </Show>
+    </>
+  )
+}
+
+function toolStatus(status: string) {
+  return ({ pending: "等待", running: "运行中", completed: "已完成", error: "失败" } as Record<string, string>)[status] ?? status
+}
+
+function rawContent(row: TrajectoryRow, request: TrajectoryRequest | undefined) {
+  if (row.kind === "user") return pretty(row.message)
+  if (row.kind === "system") return row.text
+  if ("part" in row && row.part) return pretty(row.part)
+  return pretty(request?.message ?? row)
+}
+
+function RowContent(props: { row: TrajectoryRow; parts: (messageID: string) => Part[] }) {
+  const row = () => props.row
+  return (
+    <Switch>
+      <Match when={row().kind === "system"}>
+        <Section title="系统提示词">
+          <div class="text-12-regular text-text-base">
+            OpenCode 在每次请求时组装系统提示词（智能体指令、AGENTS.md、环境信息）和工具定义，但不保存实际发送的内容。
+            这里只能显示会话里保存的自定义系统提示词。
+          </div>
+          <Show when={(row() as { text: string }).text.startsWith("智能体 ") ? undefined : (row() as { text: string }).text}>
+            {(text) => <Pre text={text()} />}
+          </Show>
+        </Section>
+      </Match>
+      <Match when={row().kind === "user" ? (row() as Extract<TrajectoryRow, { kind: "user" }>) : undefined}>
+        {(user) => (
+          <Section title="用户输入">
+            <Pre
+              text={clip(
+                props
+                  .parts(user().message.id)
+                  .flatMap((p) => (p.type === "text" && !p.synthetic && !p.ignored ? [p.text] : []))
+                  .join("\n") || "（无文本）",
+                TEXT_LIMIT,
+              )}
+            />
+            <Field label="智能体">{user().message.agent}</Field>
+            <Field label="模型">{`${user().message.model?.providerID ?? "-"}/${user().message.model?.modelID ?? "-"}`}</Field>
+            <Field label="时间">{clock(user().message.time.created)}</Field>
+          </Section>
+        )}
+      </Match>
+      <Match when={row().kind === "tool" ? (row() as Extract<TrajectoryRow, { kind: "tool" }>) : undefined}>
+        {(tool) => (
+          <>
+            <Section title={`输入 · ${tool().tool}`}>
+              <Pre text={clip(pretty(tool().part.state.input), TEXT_LIMIT)} />
+            </Section>
+            <Section title={tool().status === "error" ? "错误" : "输出"}>
+              <Pre
+                text={clip(
+                  tool().part.state.status === "completed"
+                    ? (tool().part.state as { output: string }).output
+                    : tool().part.state.status === "error"
+                      ? (tool().part.state as { error: string }).error
+                      : toolStatus(tool().status),
+                  TEXT_LIMIT,
+                )}
+              />
+            </Section>
+          </>
+        )}
+      </Match>
+      <Match when={"part" in row() && (row() as { part?: Part }).part}>
+        {(part) => (
+          <Section title={row().kind === "reasoning" ? "思考" : row().kind === "text" ? "回复" : badge(row()).label}>
+            <Pre
+              text={clip(
+                part().type === "text" || part().type === "reasoning"
+                  ? (part() as { text: string }).text
+                  : "text" in row()
+                    ? (row() as { text: string }).text
+                    : "",
+                TEXT_LIMIT,
+              )}
+            />
+          </Section>
+        )}
+      </Match>
+      <Match when={true}>
+        <Section title={badge(row()).label}>
+          <Pre text={"text" in row() ? (row() as { text: string }).text : ""} />
+        </Section>
+      </Match>
+    </Switch>
+  )
+}
+
+function RequestOverview(props: { request: TrajectoryRequest; locale: string }) {
+  const r = () => props.request
+  const t = () => requestTiming(r())
+  const n = (value: number) => new Intl.NumberFormat(props.locale).format(value)
+  const prompt = () => promptTokens(r().tokens)
+  const status = () =>
+    r().status === "running" ? "运行中" : r().status === "error" ? `错误 · ${r().error ?? ""}` : `已完成${r().message.finish ? ` · ${r().message.finish}` : ""}`
+  return (
+    <>
+      <Section title="请求">
+        <Field label="来源">{`请求 #${r().index + 1}`}</Field>
+        <Field label="模型">{`${r().message.providerID}/${r().message.modelID}${r().message.variant ? ` · ${r().message.variant}` : ""}`}</Field>
+        <Field label="智能体">{r().message.agent}</Field>
+        <Field label="状态">{status()}</Field>
+      </Section>
+      <Section title="Token">
+        <Field label="合计">{`${n(totalTokens(r().tokens))} tok`}</Field>
+        <Field label="输入（未缓存）">{n(r().tokens.input)}</Field>
+        <Field label="缓存读取">{n(r().tokens.cacheRead)}</Field>
+        <Field label="缓存写入">{n(r().tokens.cacheWrite)}</Field>
+        <Field label="缓存命中">{prompt() > 0 ? `${Math.round((r().tokens.cacheRead / prompt()) * 100)}%` : "-"}</Field>
+        <Field label="输出">{n(r().tokens.output)}</Field>
+        <Field label="思考">{n(r().tokens.reasoning)}</Field>
+        <Field label="费用">{money(r().cost, totalTokens(r().tokens))}</Field>
+      </Section>
+      <Section title="请求计时">
+        <Field label="开始时间">{clock(r().start)}</Field>
+        <Field label="总时长">{duration(t().total)}</Field>
+        <Field label="首 token 延迟">{duration(t().ttft)}</Field>
+        <Field label="生成">{duration(t().generation)}</Field>
+        <Field label="吞吐量">{t().throughput !== undefined ? `${t().throughput!.toFixed(1)} tok/s` : "-"}</Field>
+        <div class="text-11-regular text-text-weaker">计时由 OpenCode 保存的时间戳推算（首 token = 首段思考/回复/工具输入的开始），不是服务商返回的原始计时。</div>
+      </Section>
+    </>
+  )
+}
