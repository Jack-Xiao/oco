diff --git a/packages/app/src/context/oco-review-intent.ts b/packages/app/src/context/oco-review-intent.ts
new file mode 100644
index 0000000..c03d752
--- /dev/null
+++ b/packages/app/src/context/oco-review-intent.ts
@@ -0,0 +1,30 @@
+// oco (patches/opencode/0021): "show me the diff" intent from the VS Code host. The sidebar's result row sends
+// navigate{review} (ADR-007 bridge); apps/chat-webview relays it as a window event because the page may not be on
+// the session yet. The session page takes the intent once it shows that session (pages/session.tsx).
+import { createSignal } from "solid-js"
+
+export type ReviewIntent = { sessionID: string; file?: string; at: number }
+
+const [intent, setIntent] = createSignal<ReviewIntent | undefined>(undefined)
+
+export const reviewIntent = intent
+
+export function requestReview(sessionID: string, file?: string) {
+  setIntent({ sessionID, file, at: Date.now() })
+}
+
+/** Takes the pending intent for `sessionID`; undefined when there is none or it is for another session. */
+export function takeReview(sessionID: string): ReviewIntent | undefined {
+  const cur = intent()
+  if (!cur || cur.sessionID !== sessionID) return undefined
+  setIntent(undefined)
+  return cur
+}
+
+if (typeof window !== "undefined") {
+  window.addEventListener("oco:review-intent", (e) => {
+    const d = (e as CustomEvent<{ sessionID?: unknown; file?: unknown }>).detail
+    if (!d || typeof d.sessionID !== "string" || !d.sessionID) return
+    requestReview(d.sessionID, typeof d.file === "string" && d.file ? d.file : undefined)
+  })
+}
