+// oco: the status + review-panel actions for an embedded host, rendered inline in the session (chat / trajectory)
+// header row instead of the hidden titlebar.
+export function SessionHeaderEmbeddedActions() {
+  const command = useCommand()
+  const language = useLanguage()
+  const settings = useSettings()
+  const { view } = useSessionLayout()
+  const isDesktop = createMediaQuery("(min-width: 768px)")
+  const state = createMemo<SessionHeaderV2ActionsState>(() => ({
+    statusVisible: settings.visibility.status(),
+    statusLabel: language.t("status.popover.trigger"),
+    reviewLabel: language.t("command.review.toggle"),
+    reviewKeybind: reviewTooltipKeybind(command),
+    reviewVisible: isDesktop(),
+    reviewOpened: view().reviewPanel.opened(),
+    onReviewToggle: () => view().reviewPanel.toggle(),
+  }))
+  return <SessionHeaderV2Actions state={state()} />
+}
