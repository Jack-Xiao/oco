+  // oco: host-driven draft insert. The VS Code host dispatches "oco:draft-insert" with plain
+  // text (e.g. an unsaved editor selection); it is appended to this composer's draft, never sent.
+  if (typeof window !== "undefined") {
+    const onOcoInsert = (event: Event) => {
+      const text = (event as CustomEvent<{ text?: string }>).detail?.text
+      if (!text) return
