+          : [...parts, { type: "text" as const, content: text, start: len, end: len + text.length }]
+      prompt.set(next, len + text.length)
+    }
+    window.addEventListener("oco:draft-insert", onOcoInsert)
+    onCleanup(() => window.removeEventListener("oco:draft-insert", onOcoInsert))
