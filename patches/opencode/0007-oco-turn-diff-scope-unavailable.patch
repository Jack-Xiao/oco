diff --git a/packages/app/src/pages/session/timeline/rows-oco-diff.test.ts b/packages/app/src/pages/session/timeline/rows-oco-diff.test.ts
new file mode 100644
index 0000000..0a241f0
--- /dev/null
+++ b/packages/app/src/pages/session/timeline/rows-oco-diff.test.ts
@@ -0,0 +1,40 @@
+// oco (patches/opencode/0007): turn diff row selection.
+import { describe, expect, mock, test } from "bun:test"
+
+mock.module("@opencode-ai/session-ui/message-part", () => ({
+  groupParts: () => [],
+  renderable: () => false,
+}))
+
+const { Timeline } = await import("./rows")
+
+const user = (diffs?: unknown[]) => ({ id: "u1", role: "user", sessionID: "s", time: { created: 1 }, summary: diffs ? { diffs } : undefined }) as any
+const assistant = { id: "a1", role: "assistant", sessionID: "s", parentID: "u1", time: { created: 2 } } as any
+const edit = { type: "tool", tool: "edit", state: { status: "completed", input: { filePath: "/w/a.ts" } } }
+const tags = (diffs: unknown[] | undefined, parts: unknown[], status = "idle") =>
+  Timeline.constructMessageRows(user(diffs), (id) => (id === "a1" ? (parts as any) : []), [assistant], 0, false, status as any, true, false)
+    .map((row) => row._tag)
+
+describe("oco turn diff rows", () => {
+  test("non-empty stored diff renders DiffSummary only", () => {
+    const t = tags([{ file: "a.ts", patch: "", additions: 1, deletions: 0, status: "modified" }], [edit])
+    expect(t).toContain("DiffSummary")
+    expect(t).not.toContain("DiffUnavailable")
+  })
+  test("empty stored diff with a file-writing tool renders DiffUnavailable", () => {
+    for (const diffs of [[], undefined]) {
+      const rows = Timeline.constructMessageRows(user(diffs), () => [edit] as any, [assistant], 0, false, "idle", true, false)
+      const row = rows.find((r) => r._tag === "DiffUnavailable") as any
+      expect(row?.files).toEqual(["/w/a.ts"])
+      expect(rows.some((r) => r._tag === "DiffSummary")).toBe(false)
+    }
+  })
+  test("empty stored diff without file-writing tools renders neither", () => {
+    const t = tags([], [])
+    expect(t).not.toContain("DiffUnavailable")
+    expect(t).not.toContain("DiffSummary")
+  })
+  test("no unavailable row while the active turn is still busy", () => {
+    expect(tags([], [edit], "busy")).not.toContain("DiffUnavailable")
+  })
+})
