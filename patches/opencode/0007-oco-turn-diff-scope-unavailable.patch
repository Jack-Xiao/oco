+
+// oco (patches/opencode/0007): files named by this turn's completed file-writing tools. Used only to
+// list files when the stored turn diff is empty; it is not a diff and carries no before/after content.
+export function turnToolFiles(parts: Part[]) {
+  const files = new Set<string>()
+  for (const part of parts) {
+    if (part.type !== "tool" || part.state.status !== "completed") continue
+    const input = part.state.input as { filePath?: unknown }
+    if ((part.tool === "edit" || part.tool === "write") && typeof input.filePath === "string") files.add(input.filePath)
+    if (part.tool === "apply_patch") {
+      const changed = (part.state.metadata as { files?: { filePath?: unknown; relativePath?: unknown }[] } | undefined)?.files
+      for (const f of changed ?? []) {
+        const file = typeof f.relativePath === "string" ? f.relativePath : f.filePath
+        if (typeof file === "string") files.add(file)
+      }
+    }
+  }
+  return [...files]
+}
