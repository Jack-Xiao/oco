@@ -18,3 +18,22 @@ export function uniqueSummaryDiffs(diffs: SnapshotFileDiff[] | undefined) {
 function isSummaryDiff(diff: SnapshotFileDiff): diff is SummaryDiff {
   return typeof diff.file === "string"
