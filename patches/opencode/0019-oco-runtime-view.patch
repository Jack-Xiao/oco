+import type { RingCardKind, RingIndexInput, RingSource, RingStageId, SubState, ToolRowState } from "./session-runtime-ring-types"
+
+// ---------- raw fixture (the mockup's timeline format, plus the keyframes) ----------
+type RawTokens = { total?: number; input: number; output: number; reasoning: number; cache: { read: number; write: number } }
+type RawPart = {
+  type: string
+  created: number
+  updated?: number
+  text?: string
+  time?: { start?: number; end?: number }
+  tool?: string
+  status?: string
+  input?: Record<string, unknown> | string
+  title?: string
+  error?: string
+  output_chars?: number
+  output_head?: string
+  metadata_sessionId?: string
+  tokens?: RawTokens
+  cost?: number
+  reason?: string
+}
+type RawMessage = {
+  id: string
+  role: "user" | "assistant"
+  agent: string
+  model?: string
+  created: number
+  completed?: number
+  tokens?: RawTokens
+  cost?: number
+  error?: string
+  parts: RawPart[]
+}
+export type M5Keyframe = { id: string; t: number; local?: string; expect: string }
+export type M5Raw = {
+  note: string
+  session: { id: string; title: string }
+  round_starts: number[]
+  root: RawMessage[]
+  children: { id: string; title: string; created: number; updated: number; messages: RawMessage[] }[]
+  keyframes: M5Keyframe[]
+}
+
+// ---------- oracle (the mockup's own verdicts at each keyframe, from scripts/runtime-m5-oracle.mjs) ----------
+export type M5OracleFrame = {
+  id: string
+  t: number
+  stage: RingStageId
+  why?: string                    // mockup value verbatim ("stop" | "dismiss" | "abort")
+  endAt?: number
+  card: { title: string; kind: RingCardKind; tone: string }
+  round?: number
+  m?: number
+  plan?: { done: number; inProgress: number; total: number; version: number }
+  own: [string, ToolRowState, [number, number] | null][]
+  subs: [number, SubState][]
+  you: { state: "pre" | "idle" | "sent" | "writing" | "need" | "dismissed"; cls: string; status: string }
+  status: { word: string; tone: string }
+  lane: number
+}
+export type M5Oracle = { source: Record<string, string>; frames: M5OracleFrame[] }
+
+/** Provider used when the export's model has no "provider/" prefix (all of this session's do not). */
+export const M5_PROVIDER = "fixture"
+
+const isObj = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v)
+
+let rawText: string | undefined
+let rawData: M5Raw | undefined
+
+/** The fixture file's text, verbatim (for the sensitive-pattern check). */
+export function m5RawText(): string {
+  rawText ??= readFileSync(new URL("./fixtures/runtime-m5-session.json", import.meta.url), "utf8")
+  return rawText
+}
+
+export function loadM5Raw(): M5Raw {
+  if (rawData) return rawData
+  const v: unknown = JSON.parse(m5RawText())
+  if (
+    !isObj(v) ||
+    typeof v.note !== "string" ||
+    !isObj(v.session) ||
+    !Array.isArray(v.round_starts) ||
+    !Array.isArray(v.root) ||
+    !Array.isArray(v.children) ||
+    !Array.isArray(v.keyframes)
+  )
+    throw new Error("M5 fixture: expected top-level note/session/round_starts/root/children/keyframes")
+  rawData = v as M5Raw
+  return rawData
+}
+
+export function loadM5Oracle(): M5Oracle {
+  const v: unknown = JSON.parse(readFileSync(new URL("./fixtures/runtime-m5-oracle.json", import.meta.url), "utf8"))
+  if (!isObj(v) || !isObj(v.source) || !Array.isArray(v.frames)) throw new Error("M5 oracle: expected top-level source/frames")
+  return v as M5Oracle
+}
+
+// ---------- ids ----------
+/** An ascending OpenCode-style id: `${prefix}_` + 12 hex of `(ms * 0x1000 + seq) mod 2^48` + a 14-char suffix. */
+export function m5Id(prefix: string, ms: number, seq: number, suffix: string) {
+  return `${prefix}_${((ms * 0x1000 + seq) % 2 ** 48).toString(16).padStart(12, "0")}${suffix}`
+}
+
+function idMaker() {
+  const seqs = new Map<string, number>()
+  let n = 0
+  const ids: { id: string; at: number }[] = []
+  const make = (prefix: string, ms: number) => {
+    const key = `${prefix}:${ms}`
+    const seq = seqs.get(key) ?? 0
+    if (seq >= 0x1000) throw new Error(`M5 fixture: more than 4096 ids at ${ms}`)
+    seqs.set(key, seq + 1)
+    const id = m5Id(prefix, ms, seq, "fx" + (n++).toString(36).padStart(12, "0"))
+    ids.push({ id, at: ms })
+    return id
+  }
+  return { make, ids }
+}
+
+// ---------- mapping ----------
+const ZERO: RawTokens = { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } }
+const PATH = { cwd: "/fixture", root: "/fixture" }
+
+function splitModel(model: string | undefined) {
+  if (!model) return { providerID: M5_PROVIDER, modelID: "unknown" }
+  const at = model.indexOf("/")
+  return at < 0 ? { providerID: M5_PROVIDER, modelID: model } : { providerID: model.slice(0, at), modelID: model.slice(at + 1) }
+}
+
+function errorOf(s: string | undefined): AssistantMessage["error"] {
+  if (!s) return undefined
+  let o: unknown
+  try {
+    o = JSON.parse(s)
+  } catch {
+    o = undefined
+  }
+  const name = isObj(o) && typeof o.name === "string" ? o.name : "UnknownError"
+  const data = isObj(o) && isObj(o.data) ? o.data : undefined
+  const message = data && typeof data.message === "string" ? data.message : isObj(o) ? "" : s
+  if (name === "MessageAbortedError") return { name, data: { message } }
+  return { name: "UnknownError", data: { message: name === "UnknownError" ? message : `${name}: ${message}` } }
+}
+
+function inputOf(v: RawPart["input"]): Record<string, unknown> {
+  if (isObj(v)) return v
+  if (typeof v !== "string") return {}
+  try {
+    const o: unknown = JSON.parse(v)
+    return isObj(o) ? o : {}
+  } catch {
+    return {}
+  }
+}
+
+function toolState(p: RawPart, input: Record<string, unknown>): ToolState {
+  const metadata: Record<string, unknown> = p.metadata_sessionId ? { sessionId: p.metadata_sessionId } : {}
+  const start = p.time?.start
+  const end = p.time?.end
+  if (p.status === "pending" || start === undefined) return { status: "pending", input, raw: "" }
+  if (p.status === "running" || end === undefined) return { status: "running", input, title: p.title, metadata, time: { start } }
+  if (p.status === "error") return { status: "error", input, error: p.error ?? "", metadata, time: { start, end } }
+  return { status: "completed", input, output: p.output_head ?? "", title: p.title ?? "", metadata, time: { start, end } }
+}
+
+type Built = { messages: Message[]; parts: Map<string, Part[]> }
+
+function session(sessionID: string, raw: RawMessage[], mk: ReturnType<typeof idMaker>, child: boolean, filled: { n: number }): Built {
+  const messages: Message[] = []
+  const parts = new Map<string, Part[]>()
+  const lastAssistant = raw.reduce((at, m, i) => (m.role === "assistant" ? i : at), -1)
+  let user = ""
+  raw.forEach((m, i) => {
+    const id = mk.make("msg", m.created)
+    const out: Part[] = []
+    m.parts.forEach((p, j) => {
+      const pid = mk.make("prt", p.created)
+      const base = { id: pid, sessionID, messageID: id }
+      const next = m.parts.slice(j + 1).find((x) => x.created != null)
+      if (p.type === "text") {
+        const end = Math.min(p.updated ?? Infinity, next?.created ?? Infinity, m.completed ?? Infinity)
+        const part: TextPart = { ...base, type: "text", text: p.text ?? "", time: { start: p.created, ...(isFinite(end) ? { end } : {}) } }
+        out.push(part)
+      } else if (p.type === "reasoning") {
+        const end = p.time?.end ?? p.updated ?? m.completed
+        const part: ReasoningPart = { ...base, type: "reasoning", text: p.text ?? "", time: { start: p.time?.start ?? p.created, ...(end !== undefined ? { end } : {}) } }
+        out.push(part)
+      } else if (p.type === "tool") {
+        const input = inputOf(p.input)
+        const part: ToolPart = { ...base, type: "tool", callID: mk.make("call", p.created), tool: p.tool ?? "", state: toolState(p, input) }
+        out.push(part)
+      } else if (p.type === "step-start") {
+        const part: StepStartPart = { ...base, type: "step-start" }
+        out.push(part)
+      } else if (p.type === "step-finish") {
+        const part: StepFinishPart = { ...base, type: "step-finish", reason: p.reason ?? "", cost: p.cost ?? 0, tokens: p.tokens ?? ZERO }
+        out.push(part)
+      } else throw new Error(`M5 fixture: unknown part type ${p.type}`)
+    })
+    parts.set(id, out)
+    if (m.role === "user") {
+      user = id
+      const model = splitModel((raw.slice(i + 1).find((x) => x.role === "assistant") ?? [...raw].reverse().find((x) => x.role === "assistant"))?.model)
+      const msg: UserMessage = { id, sessionID, role: "user", time: { created: m.created }, agent: m.agent, model }
+      messages.push(msg)
+      return
+    }
+    const steps = m.parts.filter((p) => p.type === "step-finish")
+    let finish = steps.length ? steps[steps.length - 1].reason : undefined
+    if (child && !finish) {
+      finish = i === lastAssistant ? "stop" : "tool-calls"
+      filled.n++
+    }
+    const msg: AssistantMessage = {
+      id,
+      sessionID,
+      role: "assistant",
+      time: { created: m.created, ...(m.completed !== undefined ? { completed: m.completed } : {}) },
+      ...(m.error ? { error: errorOf(m.error) } : {}),
+      parentID: user,
+      ...splitModel(m.model),
+      mode: m.agent,
+      agent: m.agent,
+      path: PATH,
+      cost: m.cost ?? 0,
+      tokens: m.tokens ?? ZERO,
+      ...(finish ? { finish } : {}),
+    }
+    messages.push(msg)
+  })
+  return { messages, parts }
+}
+
+const sourceOf = (b: Built): RingSource => ({ messages: b.messages, parts: (messageID) => b.parts.get(messageID) ?? [] })
+
+/** Full build, with extras the fixture test checks (every synthesized id and its original time; finish fill-ins). */
+export function buildM5(raw: M5Raw) {
+  const mk = idMaker()
+  const filled = { n: 0 }
+  const root = session(raw.session.id, raw.root, mk, false, filled)
+  const kids = new Map(raw.children.map((c) => [c.id, sourceOf(session(c.id, c.messages, mk, true, filled))]))
+  const input: RingIndexInput = { sessionID: raw.session.id, ...sourceOf(root), child: (sessionID) => kids.get(sessionID) }
+  return { input, keyframes: raw.keyframes, ids: mk.ids, filledFinish: filled.n, children: [...kids.keys()] }
+}
+
+export function loadM5Fixture(): { input: RingIndexInput; keyframes: { id: string; t: number; expect: string }[] } {
+  const b = buildM5(loadM5Raw())
+  return { input: b.input, keyframes: b.keyframes.map((k) => ({ id: k.id, t: k.t, expect: k.expect })) }
+}
