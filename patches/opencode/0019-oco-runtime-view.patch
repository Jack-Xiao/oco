+const refIds = (f: RingFrame) => ({
+  ...f,
+  stage: {
+    ...f.stage,
+    round: f.stage.round?.userMessageID,
+    request: f.stage.request?.messageID,
+    ask: f.stage.ask?.id,
+    dismissed: f.stage.dismissed?.id,
+  },
+})
+function expectNoLeak(input: RingIndexInput, points: readonly number[]) {
+  const full = buildRingIndex(input)
+  for (const t of points) {
+    const cut = buildRingIndex(truncateAt(input, t))
+    const A = refIds(frameAt(full, t, { reduced: false, wide: true })) as Record<string, unknown>
+    const B = refIds(frameAt(cut, t, { reduced: false, wide: true })) as Record<string, unknown>
+    for (const k of Object.keys(A)) expect({ t, k, v: B[k] }).toEqual({ t, k, v: A[k] })
+    expect(Object.keys(B).sort()).toEqual(Object.keys(A).sort())
+    const subs = full.subs.filter((s) => s.created <= t)
+    expect(cut.subs.map((s) => s.uid)).toEqual(subs.map((s) => s.uid))
+    subs.forEach((s, i) =>
+      expect({ t, uid: s.uid, d: subDetailAt(cut.subs[i], t, { narrow: false }) }).toEqual({
+        t,
+        uid: s.uid,
+        d: subDetailAt(s, t, { narrow: false }),
+      }),
+    )
+  }
+}
