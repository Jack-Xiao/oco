+        { messageID: a.id },
+      )
+    const perm = { id: "per_both", sessionID: "ses_both", permission: "bash", patterns: [], metadata: {}, always: [] } as any
+    const retry = { type: "retry", attempt: 3, message: "429", next: T0 + 9_000 } as const
+    const m = runtime({
+      messages: [u, a],
+      parts: { [a.id]: [task(T0 + 200, "ses_both"), task(T0 + 210, "ses_retry"), task(T0 + 220, "ses_busy")] },
+      busy: false,
+      input: {
+        permissions: [perm],
+        childStatus: (id) => {
+          if (id === "ses_both" || id === "ses_retry") return retry
+          if (id === "ses_busy") return { type: "busy" }
+          return undefined
+        },
+        childMessages: (id) =>
+          id === "ses_both" || id === "ses_retry" || id === "ses_busy" ? [assistant(u, T0 + 400, { sessionID: id })] : undefined,
+      },
+    })
+    expect(m.tools.map((t) => t.child?.lifecycle)).toEqual(["waiting-user", "retrying", "running"])
+  })
+
+  test("a cancelled request stays working while the session status is still busy", () => {
+    const a = assistant(u, T0 + 100, { error: { name: "MessageAbortedError", data: { message: "Aborted" } } })
+    const aborted = tool(
+      T0 + 200,
+      "bash",
+      {
+        status: "error",
+        input: { command: "sleep 100" },
+        error: "Tool execution aborted",
+        metadata: { interrupted: true },
+        time: { start: T0 + 200, end: T0 + 400 },
+      },
+      { messageID: a.id },
+    )
+    const m = runtime({
+      messages: [u, a],
+      parts: { [a.id]: [aborted] },
+      busy: true,
+      input: { status: { type: "busy" } },
+    })
+    expect(m.requests[0].cancelled).toBe(true)
+    expect(m.run.state).toBe("working")
+    expect(m.focus.kind).toBe("working")
+  })
+
+  test("each child session state follows that child's lifecycle and evidence", () => {
+    const a = assistant(u, T0 + 100)
+    const task = (ms: number, sid: string) =>
+      tool(
+        ms,
+        "task",
+        {
+          status: "completed",
+          input: { subagent_type: "explore", description: "d" },
+          output: "done",
+          title: "t",
+          metadata: { sessionId: sid },
+          time: { start: ms, end: ms + 10 },
+        },
+        { messageID: a.id },
+      )
+    const ids = ["ses_running", "ses_retry", "ses_wait", "ses_done", "ses_error", "ses_cancel", "ses_unknown"] as const
+    const perm = { id: "per_wait", sessionID: "ses_wait", permission: "bash", patterns: [], metadata: {}, always: [] } as any
+    const retry = { type: "retry", attempt: 1, message: "429", next: T0 + 9_000 } as const
+    const messages: Record<string, any[] | undefined> = {
+      ses_done: [assistant(u, T0 + 500, { sessionID: "ses_done" })],
+      ses_error: [assistant(u, T0 + 600, { sessionID: "ses_error", error: { name: "APIError", data: { message: "boom" } } })],
+      ses_cancel: [
+        assistant(u, T0 + 700, {
+          sessionID: "ses_cancel",
+          error: { name: "MessageAbortedError", data: { message: "Aborted" } },
+        }),
+      ],
+    }
+    const m = runtime({
+      messages: [u, a],
+      parts: { [a.id]: ids.map((sid, i) => task(T0 + 200 + i, sid)) },
+      busy: false,
+      input: {
+        permissions: [perm],
+        childStatus: (id) => {
+          if (id === "ses_running") return { type: "busy" }
+          if (id === "ses_retry") return retry
+          if (id === "ses_done" || id === "ses_error" || id === "ses_cancel" || id === "ses_unknown" || id === "ses_wait")
+            return { type: "idle" }
+          return undefined
+        },
+        childMessages: (id) => messages[id],
+      },
+    })
+    const child = (id: string) => m.sessions.find((s) => s.id === id)
+    expect(m.sessions[0]).toMatchObject({ id: "s", kind: "root", evidence: "inferred" })
+    expect(child("ses_running")).toMatchObject({ kind: "child", state: "working", evidence: "event" })
+    expect(child("ses_retry")).toMatchObject({ kind: "child", state: "retrying", evidence: "event" })
+    expect(child("ses_wait")).toMatchObject({ kind: "child", state: "waiting-user", evidence: "event" })
+    expect(child("ses_done")).toMatchObject({ kind: "child", state: "idle", evidence: "event" })
+    expect(child("ses_error")).toMatchObject({ kind: "child", state: "error", evidence: "event" })
+    expect(child("ses_cancel")).toMatchObject({ kind: "child", state: "idle", evidence: "event" })
+    expect(child("ses_unknown")).toMatchObject({ kind: "child", state: "unknown", evidence: "inferred" })
+  })
+
+  test("replay keeps lifecycle unknown and inferred, with an empty attention list", () => {
+    const a = assistant(u, T0 + 100)
+    const task = tool(
+      T0 + 200,
+      "task",
+      {
+        status: "completed",
+        input: { subagent_type: "explore", description: "find usages" },
+        output: "done",
+        title: "t",
+        metadata: { sessionId: "ses_child" },
+        time: { start: T0 + 200, end: T0 + 300 },
+      },
+      { messageID: a.id },
+    )
+    const perm = { id: "per_grand", sessionID: "ses_grand", permission: "bash", patterns: [], metadata: {}, always: [] } as any
+    const m = runtime({
+      messages: [u, a],
+      parts: { [a.id]: [task] },
+      input: {
+        mode: "replay",
+        permissions: [perm],
+        childStatus: (id) => (id === "ses_child" ? { type: "busy" } : undefined),
+        childMessages: (id) => (id === "ses_child" ? [assistant(u, T0 + 400, { sessionID: "ses_child" })] : undefined),
+        parentOf: (id) => (id === "ses_grand" ? "ses_child" : undefined),
+      },
+    })
+    expect(m.tools[0].child).toMatchObject({ lifecycle: "unknown", evidence: "inferred" })
+    expect(m.run.attention).toEqual([])
+  })
+})
+
+describe("runtime request metadata (Task 4b)", () => {
+  test("cost > 0 is preserved; cost === 0 does not appear in request", () => {
+    const aZeroCost = assistant(u, T0 + 100, { cost: 0 })
+    const aPositiveCost = assistant(u, T0 + 300, { cost: 0.042 })
+    const m = runtime({
+      messages: [u, aZeroCost, aPositiveCost],
+    })
+    expect(m.requests.length).toBe(2)
+    expect(m.requests[0].cost).toBeUndefined()
+    expect("cost" in m.requests[0]).toBe(false)
+    expect(m.requests[1].cost).toBe(0.042)
+  })
+
+  test("agent (assistant message mode) and model ({ providerID, modelID }) are populated on request", () => {
+    const a = assistant(u, T0 + 100, {
+      mode: "plan",
+      providerID: "anthropic",
+      modelID: "claude-3-7-sonnet",
+    })
+    const m = runtime({ messages: [u, a] })
+    expect(m.requests[0].agent).toBe("plan")
+    expect(m.requests[0].model).toEqual({ providerID: "anthropic", modelID: "claude-3-7-sonnet" })
+  })
+
+  test("replay and live yield consistent agent, model, and cost metadata from message itself", () => {
+    const a = assistant(u, T0 + 100, {
+      mode: "custom-agent",
+      providerID: "openai",
+      modelID: "o3-mini",
+      cost: 0.015,
+      time: { created: T0 + 100, completed: T0 + 200 },
+    })
+    const live = runtime({ messages: [u, a], input: { mode: "live" } })
+    const replay = runtime({ messages: [u, a], input: { mode: "replay" } })
+
+    expect(live.requests[0].agent).toBe("custom-agent")
+    expect(replay.requests[0].agent).toBe("custom-agent")
+    expect(live.requests[0].model).toEqual({ providerID: "openai", modelID: "o3-mini" })
+    expect(replay.requests[0].model).toEqual({ providerID: "openai", modelID: "o3-mini" })
+    expect(live.requests[0].cost).toBe(0.015)
+    expect(replay.requests[0].cost).toBe(0.015)
+  })
+})
