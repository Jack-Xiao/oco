+}
+
+export function RingView(props: RingViewProps): JSX.Element {
+  const text = props.text
+  const say = (p: string | Phrase | undefined) => (p === undefined ? "" : typeof p === "string" ? p : text.phrase(p))
+  const sep = () => text.t("ring.sep")
+  // UI state only (facts come from frame): stage size from the ResizeObserver, full-text overlay open
+  const [ui, setUi] = createStore({ W: 1200, H: 600, panel: "" as "" | "card" | "plan" })
+  let root: HTMLDivElement | undefined
+  let scroller: HTMLDivElement | undefined
+  let expandBtn: HTMLDivElement | undefined
+  let planBtn: HTMLButtonElement | undefined
+
+  onMount(() => {
+    const measure = (w: number, h: number) => {
+      if (!(w > 0) || !(h > 0)) return // no layout yet (or none at all, e.g. happy-dom): keep the last size
+      const s = stageSize(Math.round(w), Math.round(h))
+      if (s.W !== ui.W || s.H !== ui.H) setUi({ W: s.W, H: s.H })
+    }
+    if (!scroller) return
+    measure(scroller.clientWidth, scroller.clientHeight)
+    if (typeof ResizeObserver === "undefined") return
+    const ro = new ResizeObserver((entries) => {
+      const r = entries[0]?.contentRect
+      if (r) measure(r.width, r.height)
+    })
+    ro.observe(scroller)
+    onCleanup(() => ro.disconnect())
+  })
+
+  const f = props.frame
+  const reduced = () => props.reduced()
+  const st = createMemo(() => f().stage.st)
+  const ended = createMemo(() => st() === "end" || st() === "abort" || st() === "pre")
+  // geometry depends only on (W, H, k): k is rounded to the precision of data-oco-runtime-lane-k (D14)
+  const k3 = createMemo(() => Math.round(f().k * 1000) / 1000)
+  const dk3 = createMemo(() => Math.round(f().dk * 1000) / 1000)
+  const names = createMemo(() => {
+    const pills = {} as Record<PillId, string>
+    for (const id of PILL_IDS) pills[id] = text.t(`ring.pill.${id}` as const)
+    return { pills, next: `${pills.next} ↺` }
+  })
+  const geo = createMemo(() => geoOf(ui.W, ui.H, k3(), names().pills, names().next, dk3()))
+  createEffect(() => props.onGeo?.(geo()))
+  const wide = () => geo().mode === "wide"
+
+  // ---------- svg facts ----------
+  const wires = createMemo(() => wiresAt(geo(), f(), props.t(), reduced()))
+  const baseWires = keyed(() => wires().filter((w) => !w.top), (w) => w.id)
+  const topWires = keyed(() => wires().filter((w) => w.top), (w) => w.id)
+  const packets = createMemo(() => packetsAt(geo(), props.index(), f(), props.t(), reduced()))
+  const pk = keyed(packets, (p) => p.id)
+  const tok = createMemo(() => tokenAt(geo(), f().stage.round, props.t(), reduced()))
+  const m = () => f().stage.request?.m ?? 1
+  const base = () => 360 * (m() - 1) + 180
+  const cover = createMemo(() => {
+    const tk = tok()
+    if (!tk || ended() || tk.pos <= base()) return ""
+    return arcPath(geo(), base(), tk.pos, geo().R)
+  })
+  const reached = createMemo(() => {
+    const out = new Set<PillId>()
+    if (!f().stage.request || ended()) return out
+    const tk = tok()
+    const rel = (tk ? tk.tgt : base()) - 360 * (m() - 1)
+    for (const s of STATIONS) if ((s.a < 180 ? s.a + 360 : s.a) <= rel + 1) out.add(s.id)
+    return out
+  })
+  // breathing (geometry section): ended or pre and idle longer than IDLE_MS; reduced motion holds 0.6
+  const breathe = createMemo(() => {
