+// oco (patches/opencode/0019): replay playback rules (M4 batch 1).
+import { describe, expect, test } from "bun:test"
+import { nextSpeed, playbackKey, playFrom, playNext, stepBy, stepInterval } from "./session-runtime-playback"
+
+describe("playback pace", () => {
+  test("fixed step interval with a floor", () => {
+    expect(stepInterval(1)).toBe(600)
+    expect(stepInterval(2)).toBe(300)
+    expect(stepInterval(4)).toBe(300)
+  })
+  test("speed cycles 1 → 2 → 4 → 1", () => {
+    expect(nextSpeed(1)).toBe(2)
+    expect(nextSpeed(2)).toBe(4)
+    expect(nextSpeed(4)).toBe(1)
+  })
+})
+
+describe("playback position", () => {
+  test("play starts from the first step when live or parked on the newest step", () => {
+    expect(playFrom(-1, 10)).toBe(0)
+    expect(playFrom(9, 10)).toBe(0)
+    expect(playFrom(4, 10)).toBe(4)
+    expect(playFrom(-1, 0)).toBeUndefined()
+  })
+  test("playback stops at the end", () => {
+    expect(playNext(3, 10)).toBe(4)
+    expect(playNext(9, 10)).toBeUndefined()
+  })
+  test("single steps clamp to the timeline; a step back from live lands before the newest step", () => {
+    expect(stepBy(-1, 10, -1)).toBe(8)
+    expect(stepBy(-1, 10, 1)).toBe(9)
+    expect(stepBy(9, 10, 1)).toBe(9)
+    expect(stepBy(0, 10, -1)).toBe(0)
+    expect(stepBy(-1, 0, 1)).toBeUndefined()
+  })
+})
+
+describe("playback keys", () => {
+  const div = { tagName: "DIV" }
+  test("space, left and right drive playback", () => {
+    expect(playbackKey({ key: " ", target: div })).toBe("toggle")
+    expect(playbackKey({ key: "ArrowLeft", target: div })).toBe("back")
+    expect(playbackKey({ key: "ArrowRight", target: div })).toBe("forward")
+    expect(playbackKey({ key: "Enter", target: div })).toBeUndefined()
+  })
+  test("modifiers and editable targets keep their own keys", () => {
+    expect(playbackKey({ key: " ", ctrlKey: true, target: div })).toBeUndefined()
+    expect(playbackKey({ key: "ArrowLeft", metaKey: true, target: div })).toBeUndefined()
+    expect(playbackKey({ key: "ArrowRight", altKey: true, target: div })).toBeUndefined()
+    for (const tagName of ["TEXTAREA", "SELECT", "INPUT"]) expect(playbackKey({ key: " ", target: { tagName } })).toBeUndefined()
+    expect(playbackKey({ key: " ", target: { tagName: "DIV", isContentEditable: true } })).toBeUndefined()
+  })
+  test("a focused button keeps space but not the arrows", () => {
+    expect(playbackKey({ key: " ", target: { tagName: "BUTTON" } })).toBeUndefined()
+    expect(playbackKey({ key: "ArrowLeft", target: { tagName: "BUTTON" } })).toBe("back")
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-playback.ts b/packages/app/src/components/session/session-runtime-playback.ts
new file mode 100644
index 0000000..95daa7b
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-playback.ts
@@ -0,0 +1,57 @@
+// oco (patches/opencode/0019): replay playback rules for the runtime view (M4 batch 1). Pure so they unit-test
+// without a DOM; session-runtime.tsx owns the timer and the cursor signal.
+
+export const PLAYBACK_SPEEDS = [1, 2, 4] as const
+export type PlaybackSpeed = (typeof PLAYBACK_SPEEDS)[number]
+
+/** Base time per step. Steps advance at a fixed pace, not real time: gaps between steps can be minutes. */
+export const STEP_MS = 600
+/** Floor per tick: every step reassembles the root and each child model. */
+export const MIN_STEP_MS = 300
+
+export const stepInterval = (speed: PlaybackSpeed) => Math.max(MIN_STEP_MS, Math.round(STEP_MS / speed))
+
+export const nextSpeed = (speed: PlaybackSpeed): PlaybackSpeed =>
+  PLAYBACK_SPEEDS[(PLAYBACK_SPEEDS.indexOf(speed) + 1) % PLAYBACK_SPEEDS.length]
+
+/**
+ * Index playback starts from. Live (index -1) or parked on the last step restarts at the first step, so pressing
+ * play after "回放" (which parks on the newest step) actually plays something. Undefined when there is nothing to play.
+ */
+export function playFrom(index: number, total: number): number | undefined {
+  if (total <= 0) return undefined
+  if (index < 0 || index >= total - 1) return 0
+  return index
+}
+
+/** Next index during playback, or undefined at the end (playback stops and stays in replay). */
+export function playNext(index: number, total: number): number | undefined {
+  return index + 1 < total ? index + 1 : undefined
+}
+
+/** Single-step target, clamped to the timeline. From live (-1) a step back lands one before the newest step. */
+export function stepBy(index: number, total: number, delta: number): number | undefined {
+  if (total <= 0) return undefined
+  const from = index < 0 ? total - 1 : index
+  return Math.min(total - 1, Math.max(0, from + delta))
+}
+
+/** Space / ← / → drive playback unless the key belongs to an editable control or carries a modifier. */
+export function playbackKey(e: {
+  key: string
+  altKey?: boolean
+  ctrlKey?: boolean
+  metaKey?: boolean
+  target?: { tagName?: string; isContentEditable?: boolean; type?: string } | null
+}): "toggle" | "back" | "forward" | undefined {
+  if (e.altKey || e.ctrlKey || e.metaKey) return undefined
+  const tag = e.target?.tagName?.toUpperCase()
+  if (e.target?.isContentEditable || tag === "TEXTAREA" || tag === "SELECT") return undefined
+  // The timeline slider keeps its native arrow handling; other inputs keep everything.
+  if (tag === "INPUT") return undefined
+  if (tag === "BUTTON" && e.key === " ") return undefined
+  if (e.key === " ") return "toggle"
+  if (e.key === "ArrowLeft") return "back"
+  if (e.key === "ArrowRight") return "forward"
+  return undefined
+}
diff --git a/packages/app/src/components/session/session-runtime-reasoning.test.ts b/packages/app/src/components/session/session-runtime-reasoning.test.ts
