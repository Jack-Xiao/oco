+                          </Show>
+                        </div>
+                      }
+                    >
+                      <button
+                        type="button"
+                        class={`${BTN} self-start`}
+                        data-oco-runtime-child-toggle={id()}
+                        aria-expanded={props.childOpen?.(id()) ?? false}
