@@ -0,0 +1,825 @@
+// oco (patches/opencode/0019): M5 runtime ring — subagent dock (strip / cells), probe hit layer, detail and list panel.
+// View only: every fact comes from the frame or from subDetailAt / subListAt at t (session-runtime-ring-sub.ts), so the
+// panel never shows anything later than t. Look and navigate only: no reply, stop or cancel control (plan section
+// "子代理详情面板与收起条"). D13: cells, probes, rows and activity lines keep their DOM node per id; the panel stays one
+// node while it is open; closing it returns focus to the opener. D18: a dismissed / rejected call is neutral grey (⊘),
+// never the error colour. D19: more than 6 cells shows 5 and a "+N" button that opens the list.
+import { createEffect, createMemo, createUniqueId, For, on, Show, type Accessor, type JSX } from "solid-js"
+import { createStore } from "solid-js/store"
+import type { RuntimeText } from "./session-runtime-i18n"
+import { keyed } from "./session-runtime-keyed"
+import { subDetailAt, subListAt, subStateAt } from "./session-runtime-ring-sub"
+import { RING } from "./session-runtime-ring-types"
+import type {
+  Packet,
+  Phrase,
+  RingFrame,
+  RingGeo,
+  RingIndex,
+  RingSub,
+  RingSubAct,
+  RingSubCell,
+  RingSubDetail,
+  RingSubList,
+  SubState,
+} from "./session-runtime-ring-types"
+
+export type RingSubViewProps = {
+  geo: Accessor<RingGeo>; frame: Accessor<RingFrame>; index: Accessor<RingIndex>; t: Accessor<number>
+  packets: Accessor<Packet[]>; text: RuntimeText; reduced: Accessor<boolean>
+  mode: Accessor<"live" | "replay">   // passed to subDetailAt as opts.live (D2)
+  childLoad: (sessionID: string) => "ready" | "loading" | "failed"
+  onLoadChild: (sessionID: string) => void; onRetryChild: (sessionID: string) => void
+  onEnterChild: (sessionID: string) => void
+}
+
+type Declined = "rejected" | "dismissed"
+type Opener = { kind: "cell" | "probe" | "strip" | "more"; uid?: string }
+type ListRow = RingSubList["groups"][number]["rows"][number]
+
+/** State colour (status words, list borders). Declined (D18) is handled separately and is never --rt-err. */
+const STATE_C: Record<SubState, string> = {
+  queued: "var(--rt-faint)",
+  run: "var(--rt-sub)",
+  docked: "var(--rt-attn)",
+  done: "var(--rt-ok)",
+  err: "var(--rt-err)",
+}
+/** Cell border per state (mockup .cell.*); a queued cell is dashed. */
+const CELL_B: Record<SubState, string> = {
+  queued: "var(--rt-line)",
+  run: "var(--rt-sub)",
+  docked: "var(--rt-attn)",
+  done: "var(--rt-ok-deep)",
+  err: "var(--rt-err)",
+}
+const LIST_B: Record<SubState, string> = { ...STATE_C, queued: "var(--rt-line-strong)" }
+const NEUTRAL_B = "var(--rt-faint)"
+const NEUTRAL_T = "var(--rt-weak)"
+
+const FOCUS =
+  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[color:var(--rt-main)]"
+const HEAD_BTN = `flex-none h-6 px-1.5 rounded-[5px] border border-transparent bg-transparent cursor-pointer hover:border-[color:var(--rt-line-strong)] ${FOCUS}`
+
+const px = (n: number) => `${Math.round(n * 10) / 10}px`
+
+/** Enter / Space on a role=button that is not a native button (cells, probes, strip). */
+const activate: JSX.EventHandler<HTMLElement, KeyboardEvent> = (e) => {
+  if (e.key !== "Enter" && e.key !== " ") return
+  e.preventDefault()
+  e.currentTarget.click()
+}
+
+/** Keeps the last value while a keyed row is being disposed (ids and the lookup update in the same pass). */
+function rowOf<T>(get: (id: string) => T | undefined, id: string): Accessor<T> {
+  return createMemo<T>((prev) => get(id) ?? prev, get(id) as T)
+}
+
+function findBy(scope: ParentNode | undefined, attr: string, value: string): HTMLElement | null {
+  if (!scope) return null
+  for (const el of scope.querySelectorAll<HTMLElement>(`[${attr}]`)) if (el.getAttribute(attr) === value) return el
+  return null
+}
+
+export function RingSubView(props: RingSubViewProps): JSX.Element {
+  const text = props.text
+  const say = (p: Phrase | string | undefined) => (p === undefined ? "" : typeof p === "string" ? p : text.phrase(p))
+  const titleId = createUniqueId()
+
+  const [ui, setUi] = createStore<{
+    sel?: { uid: string; from: "cell" | "probe" | "list" | "strip" }
+    list: boolean
+    opener?: Opener
+  }>({ list: false })
+
+  let laneEl: HTMLDivElement | undefined
+  let moreEl: HTMLDivElement | undefined
+  let panelEl: HTMLDivElement | undefined
+  let bodyEl: HTMLDivElement | undefined
+  let closeEl: HTMLButtonElement | undefined
+
+  const narrow = () => props.geo().mode === "narrow"
+  const stripMode = () => props.frame().k < 0.5
+  const subBy = createMemo(() => new Map(props.index().subs.map((s) => [s.uid, s] as const)))
+  // D18: task calls whose permission was rejected or whose question was dismissed (from the parent's tool part)
+  const declinedBy = createMemo(() => {
+    const m = new Map<string, Declined>()
+    for (const r of props.index().rounds)
+      for (const q of r.requests) for (const tool of q.tools) if (tool.sub && tool.declined) m.set(tool.sub.uid, tool.declined)
+    return m
+  })
+  /** Declined only once the failure is a fact at t (the task part ended at or before t). */
+  const declinedAt = (uid: string, state: SubState | undefined): Declined | undefined => {
+    if (state !== "err") return undefined
+    const sub = subBy().get(uid)
+    const d = declinedBy().get(uid)
+    return d && sub?.end !== undefined && sub.end <= props.t() ? d : undefined
+  }
+  const stateWord = (state: SubState, declined?: Declined) =>
+    declined ? text.t(`ring.card.kind.${declined}`) : text.t(`ring.sub.state.${state}`)
+  const ariaOf = (num: number, name: string | undefined, state: SubState, declined?: Declined) =>
+    name
+      ? text.t("ring.sub.cell.aria", { num, name, state: stateWord(state, declined) })
+      : text.t("ring.sub.cell.aria.noname", { num, state: stateWord(state, declined) })
+
+  // ---------- selection ----------
+  const selUid = createMemo(() => ui.sel?.uid)
+  const panelMode = createMemo<"detail" | "list" | undefined>(() => (ui.sel ? "detail" : ui.list ? "list" : undefined))
+  const selSub = createMemo(() => {
+    const uid = selUid()
+    return uid ? subBy().get(uid) : undefined
+  })
+  const loadOf = (sub: RingSub | undefined) => {
+    const st = sub?.sessionID ? props.childLoad(sub.sessionID) : undefined
+    return st === "ready" ? undefined : st
+  }
+  const detail = createMemo<RingSubDetail | undefined>(() => {
+    const sub = selSub()
+    if (!sub || panelMode() !== "detail") return undefined
+    return subDetailAt(sub, props.t(), { narrow: narrow(), childLoad: loadOf(sub), live: props.mode() === "live" })
+  })
+  const list = createMemo<RingSubList | undefined>(() =>
+    panelMode() === "list" ? subListAt(props.index().subs, props.t(), props.frame().subs.round) : undefined,
+  )
+
+  function restore(op: Opener | undefined) {
+    const scope = laneEl?.parentElement ?? undefined
+    let el: HTMLElement | null = null
+    if (op?.kind === "strip") el = laneEl?.querySelector<HTMLElement>('[data-oco-runtime-subs-strip][role="button"]') ?? null
+    else if (op?.kind === "more") el = moreEl?.isConnected ? moreEl : null
+    else if (op?.uid) {
+      const first = op.kind === "probe" ? "data-oco-runtime-probe" : "data-oco-runtime-sub-cell"
+      const second = op.kind === "probe" ? "data-oco-runtime-sub-cell" : "data-oco-runtime-probe"
+      el = findBy(scope, first, op.uid) ?? findBy(scope, second, op.uid)
+    }
+    if (el && el.getAttribute("tabindex") === "-1") el = null
+    if (!el) el = laneEl?.closest<HTMLElement>("[data-oco-runtime]") ?? null
+    el?.focus({ preventScroll: true })
+  }
