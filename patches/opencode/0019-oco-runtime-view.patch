+// oco (patches/opencode/0019): M5 runtime ring — keyframe acceptance (Task 11). Each of the real fixture's 14 keyframes
+// is asserted against the mockup's own verdicts (fixtures/runtime-m5-oracle.json) over frameAt(buildRingIndex(fixture), t).
+// The mockup is the oracle except where the plan decided otherwise: D5 (any non-continue finish reason ends a round),
+// D16 (a sub-agent's state is time-gated by childDoneAt) and D18 (dismissed / rejected are not red). Every such
+// difference is asserted to have exactly that cause and is listed in the test output.
+import { afterAll, describe, expect, test } from "bun:test"
+import { runtimeText } from "./session-runtime-i18n"
+import { buildRingIndex, frameAt, trackInputOf } from "./session-runtime-ring"
+import { loadM5Fixture, loadM5Oracle, type M5OracleFrame } from "./session-runtime-ring.fixture"
