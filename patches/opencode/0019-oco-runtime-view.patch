+    expect(rows.length).toBe(2)
+    expect(rows.map((r) => r.name)).toEqual(["bash", "bash"])
+  })
+
+  test("k03: 6 sub-agents and 5 own tools", () => {
+    const f = frame("k03-r3-fanout")
+    expect(f.subs.cells.length).toBe(6)
+    expect(f.tools.rows.length).toBe(5)
+  })
+
+  test("k05: read failed with File not found", () => {
