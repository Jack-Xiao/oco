+
+// ---------- constants (mockup CV / STC / STATIONS / NUM / PLAN_G) ----------
+const TONE: Record<Tone, string> = {
+  faint: "var(--rt-faint)", main: "var(--rt-main)", sub: "var(--rt-sub)", tool: "var(--rt-tool)", acc: "var(--rt-accent)",
+  text: "var(--rt-text)", ok: "var(--rt-ok)", attn: "var(--rt-attn)", err: "var(--rt-err)",
+}
+const STAGE_TONE: Record<RingStageId, Tone> = {
+  pre: "faint", say: "main", asm: "main", fly: "main", think: "acc", out: "text",
+  call: "tool", wait: "sub", ask: "attn", next: "main", end: "ok", abort: "err",
+}
+type Station = Exclude<PillId, "next">
+const STATIONS: { id: Station; a: number; tone: Tone }[] = [
+  { id: "asm", a: 180, tone: "main" }, { id: "think", a: 240, tone: "acc" }, { id: "out", a: 300, tone: "text" },
+  { id: "call", a: 0, tone: "tool" }, { id: "wait", a: 60, tone: "sub" },
+]
+const PILL_IDS: PillId[] = ["asm", "think", "out", "call", "wait", "next"]
+const CHEVRONS = [210, 270, 330, 30, 90, 150]
+const NUM = ["①", "②", "③", "④", "⑤", "⑥", "⑦", "⑧", "⑨", "⑩"]
+const PLAN_G: Record<string, string> = { completed: "✓", in_progress: "●", pending: "○", cancelled: "✕" }
+const ROW_G: Record<RingToolRow["state"], string> = { pend: "…", run: "●", ok: "✓", err: "✗" }
+// D8: the full-text button is always mounted; enabled only for these kinds when there is a body
+const LH = 19
+const LANE_MIN_K = 0.02
+const NO_ROW: RingToolRow = { id: "", name: "", state: "pend", arg: "" }
+const NO_BOX: Box = { x: 0, y: 0, w: 0, h: 0 }
+
+const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v))
+const pts = (list: Pt[]) => list.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ")
+const place = (b: Box): JSX.CSSProperties => ({
+  position: "absolute", left: `${b.x}px`, top: `${b.y}px`, width: `${b.w}px`, height: `${b.h}px`,
+})
+const flat = (s: string) => s.replace(/\s+/g, " ").trim()
+const widthOf = (chars: string[], px: number) => chars.reduce((n, c) => n + textW(c, px), 0)
+
+/**
+ * Card body cut to capacity (mockup fitBody L1083-1103) without DOM measuring, so it is deterministic per (text, size):
+ * head keeps the start, tail keeps the end (streaming), mid keeps the last sentence and cuts the lead-in.
+ * `cap` is the usable text width in px summed over the available lines.
+ */
+function fitText(s: string, mode: RingCard["bodyMode"], cap: number, px: number): string {
+  const all = flat(s)
+  const chars = [...all]
+  if (widthOf(chars, px) <= cap) return all
+  const ell = textW("…", px)
+  const fromStart = (list: string[], budget: number) => {
+    let n = 0
+    let w = 0
+    while (n < list.length && w + textW(list[n], px) <= budget) w += textW(list[n++], px)
+    return n
+  }
+  const tail = () => {
+    const n = fromStart([...chars].reverse(), cap - ell)
+    return "…" + chars.slice(chars.length - n).join("")
+  }
+  if (mode === "tail") return tail()
+  if (mode === "mid") {
+    let k = -1
+    for (const m of all.matchAll(/[。！？!?；;]\s*/g)) if (m.index + m[0].length < all.length) k = m.index + m[0].length
+    if (k > 0) {
+      const last = [...all.slice(k)]
+      const room = cap - ell - widthOf(last, px)
+      if (room >= 0) return chars.slice(0, fromStart([...all.slice(0, k)], room)).join("") + "…" + last.join("")
+    }
+    return tail()
+  }
+  return chars.slice(0, fromStart(chars, cap - ell)).join("") + "…"
+}
+
+/** Plan items shown in `nr` lines (mockup planHtml L1075-1082): window around the first unfinished item, "N more". */
+function planWindow<T extends { status: string }>(items: T[], nr: number): { list: T[]; more: number } {
+  const n = items.length
+  if (n <= nr) return { list: items, more: 0 }
+  const a = Math.max(0, items.findIndex((o) => o.status !== "completed"))
+  const s0 = clamp(a - 1, 0, Math.max(0, n - (nr - 1)))
+  const list = items.slice(s0, s0 + Math.max(1, nr - 1))
+  return { list, more: n - list.length }
+}
+
+function WireEl(props: { wire: () => RingWire | undefined }) {
