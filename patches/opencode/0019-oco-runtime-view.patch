+  let pfNav = 0
+  const fixIds: string[] = []
+  let fixOpen = true
+  let fixRoot = 0
+  let fixNav = 0
+  let mi = 0
+  /** After each message: fin = its contribution is final, same = it equals its contribution in prev. */
+  const step = (id: string, fin: boolean, same: boolean) => {
+    if (pf && pfOk && mi < pf.ids.length) {
