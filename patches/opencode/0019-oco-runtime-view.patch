+        <div class="min-w-0 break-words whitespace-pre-wrap text-10-regular text-text-weak">
+          {slot().lastOutput}
+        </div>
+      </Show>
+
+      <Show when={slot().error}>
+        <div class="min-w-0 break-words text-10-regular" style={{ color: COLOR.error }}>
+          {slot().error}
+        </div>
+      </Show>
+
+      <Show when={props.isOpen}>
+        <div
+          id={`oco-runtime-tool-detail-${slot().toolID}`}
+          data-oco-runtime-tool-detail={slot().toolID}
+          class="flex flex-col gap-1 pt-1.5 border-t border-border-subtle text-10-regular text-text-weak font-mono"
+        >
+          <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5">
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.start")}:</span> {info().startText}
+            </span>
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.end")}:</span> {info().endText}
+            </span>
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.duration")}:</span> {info().durationText}
+            </span>
+            <Show when={info().evidence}>
+              {(ev) => (
+                <span>
+                  <span class="text-text-strong">{props.t("tool.detail.evidence")}:</span> {props.t(`evidence.${ev()}` as any) || ev()}
+                </span>
+              )}
+            </Show>
+          </div>
+          <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5">
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.call_id")}:</span> {info().callID}
+            </span>
+          </div>
+        </div>
+      </Show>
+    </div>
+  )
+}
+
+function MechanismChildSlot(props: {
+  slot: MechanismSlot
+  rawTool: Accessor<RuntimeTool | undefined>
+  isReplay: boolean
+  t: RuntimeText["t"]
+  copy?: RuntimeText
+  isOpen: boolean
+  onToggle: () => void
+  isChildOpen: boolean
+  onToggleChild: () => void
+  assembleChild?: (sessionID: string) => RuntimeModel
+  now?: Accessor<number>
+  onOpenSession?: (sessionID: string) => void
+}) {
+  const slot = () => props.slot
+  const glyph = () => slotGlyph(slot())
+  const rawChild = () => props.rawTool()?.child
+  const sessionID = () => rawChild()?.sessionID
+
+  const lifecycleText = () =>
+    props.isReplay
+      ? props.t("child.lifecycle.unknown")
+      : slot().lifecycle
+        ? props.t(`child.lifecycle.${slot().lifecycle}` as any)
+        : props.t("child.lifecycle.unknown")
+
+  const taskStatusText = () =>
+    slot().state === "running"
+      ? props.t("tool.state.running")
+      : slot().state === "completed"
+        ? props.t("tool.state.completed")
+        : slot().state === "error"
+          ? props.t("tool.state.error")
+          : props.t("tool.state.pending")
+
+  const info = createMemo(() => {
+    const raw = props.rawTool()
+    if (!raw) {
+      return {
+        startText: props.t("tool.detail.unknown"),
+        endText: props.t("tool.detail.unknown"),
+        durationText: props.t("tool.detail.unknown"),
+        evidence: undefined,
+        callID: slot().toolID,
+        sessionID: sessionID(),
+        error: slot().error,
+      }
+    }
+    return toolDetail(raw, props.t, props.copy?.intl())
+  })
+
+  return (
+    <div
+      data-oco-runtime-tool={slot().toolID}
+      data-oco-runtime-node={slot().toolID}
+      data-oco-runtime-node-kind="child"
+      node-kind="child"
+      class="flex flex-col gap-1.5 p-2 rounded bg-surface-inset-base font-mono text-11-regular border border-dashed min-w-0 break-words"
+      style={{
+        "border-color": COLOR.subagent,
+      }}
+    >
+      <button
+        type="button"
+        class={`w-full flex items-center gap-1.5 min-w-0 text-left bg-transparent border-0 p-0 ${FOCUS} rounded cursor-pointer font-mono`}
+        data-oco-runtime-tool-toggle={slot().toolID}
+        aria-expanded={props.isOpen}
+        aria-controls={`oco-runtime-tool-detail-${slot().toolID}`}
+        onClick={props.onToggle}
+      >
+        <span aria-hidden="true">{glyph()}</span>
+        <span class="text-12-medium text-text-strong break-words" style={{ color: COLOR.subagent }}>{slot().label}</span>
+        <span class="text-text-weak shrink-0">· {props.t("legend.child")}</span>
+        <span class="ml-auto shrink-0 text-text-weak">{taskStatusText()}</span>
+      </button>
+
+      <Show when={slot().description || slot().input}>
+        <div class="text-text-weak break-words font-mono">
+          {slot().description || slot().input}
+        </div>
+      </Show>
+
+      <div class="flex flex-wrap items-center gap-1.5 text-11-regular font-mono text-text-strong">
+        <span>{taskStatusText()}</span>
+        <span class="text-text-weak">·</span>
+        <span>{lifecycleText()}</span>
+        <Show when={slot().activity}>
+          <span class="text-text-weak">·</span>
+          <span>{slot().activity!.name}{slot().activity!.count > 1 ? ` ×${slot().activity!.count}` : ""}</span>
+        </Show>
+      </div>
+
+      <Show when={slot().activity}>
+        <div class="text-text-weak font-mono break-words text-10-regular">
+          └ {props.t("child.current_tool", { name: slot().activity!.name })}
+        </div>
+      </Show>
+
+      <Show when={slot().nested > 0}>
+        <div class="text-text-weak font-mono text-10-regular">
+          └ {props.t("child.nested_count", { count: slot().nested })}
+        </div>
+      </Show>
+
+      <Show when={sessionID()}>
+        {(sid) => (
+          <div class="mt-1">
+            <button
+              type="button"
+              class={`${BTN} self-start`}
+              data-oco-runtime-child-toggle={sid()}
+              aria-expanded={props.isChildOpen}
+              onClick={props.onToggleChild}
+            >
+              {props.isChildOpen ? props.t("child.collapse") : props.t("child.expand")}
+            </button>
+            <Show when={props.isChildOpen}>
+              <div class="mt-2">
+                <RuntimeChildPanel
+                  sessionID={sid()}
+                  lifecycle={props.isReplay ? "unknown" : (slot().lifecycle ?? "unknown")}
+                  model={createMemo(() =>
+                    props.assembleChild ? props.assembleChild(sid()) : ({} as RuntimeModel),
+                  )}
+                  now={props.now ?? (() => Date.now())}
+                  t={props.t}
+                  depth={1}
+                  ancestors={[sid()]}
+                  childOpen={() => props.isChildOpen}
+                  toggleChild={() => props.onToggleChild()}
+                  assembleChild={props.assembleChild}
+                  onOpen={props.onOpenSession}
+                />
+              </div>
+            </Show>
+          </div>
+        )}
+      </Show>
+
+      <Show when={props.isOpen}>
+        <div
+          id={`oco-runtime-tool-detail-${slot().toolID}`}
+          data-oco-runtime-tool-detail={slot().toolID}
+          class="flex flex-col gap-1 pt-1.5 border-t border-border-subtle text-10-regular text-text-weak font-mono"
+        >
+          <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5">
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.start")}:</span> {info().startText}
+            </span>
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.end")}:</span> {info().endText}
+            </span>
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.duration")}:</span> {info().durationText}
+            </span>
+            <Show when={info().evidence}>
+              {(ev) => (
+                <span>
+                  <span class="text-text-strong">{props.t("tool.detail.evidence")}:</span> {props.t(`evidence.${ev()}` as any) || ev()}
+                </span>
+              )}
+            </Show>
+          </div>
+          <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5">
+            <span>
+              <span class="text-text-strong">{props.t("tool.detail.call_id")}:</span> {info().callID}
+            </span>
+            <Show when={info().sessionID}>
+              {(id) => (
+                <span>
+                  <span class="text-text-strong">{props.t("tool.detail.session_id")}:</span> {id()}
+                </span>
+              )}
+            </Show>
+          </div>
+        </div>
+      </Show>
+    </div>
+  )
+}
+
+export function RuntimeMechanism(props: RuntimeMechanismProps) {
+  let rootRef: HTMLDivElement | undefined
+  const [internalNarrow, setInternalNarrow] = createSignal(false)
+
+  onMount(() => {
+    if (typeof ResizeObserver === "function" && rootRef) {
+      const ro = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          setInternalNarrow(entry.contentRect.width < 560)
+        }
+      })
+      ro.observe(rootRef)
+      setInternalNarrow(rootRef.clientWidth < 560)
+      onCleanup(() => ro.disconnect())
+    }
+  })
+
+  const isNarrow = () => props.narrow?.() ?? internalNarrow()
+  const mechanism = createMemo(() => mechanismOf(props.model(), props.childOf))
+  const isReplay = () => props.model().mode === "replay"
+
+  const [localOpenTools, setLocalOpenTools] = createSignal<ReadonlySet<string>>(new Set())
+  const isToolOpen = (id: string) => (props.isToolOpen ? props.isToolOpen(id) : localOpenTools().has(id))
+  const toggleTool = (id: string) => {
+    if (props.toggleTool) {
+      props.toggleTool(id)
+    } else {
+      setLocalOpenTools((prev) => {
+        const next = new Set(prev)
+        if (next.has(id)) next.delete(id)
+        else next.add(id)
+        return next
+      })
+    }
+  }
+
+  const [localOpenChildren, setLocalOpenChildren] = createSignal<ReadonlySet<string>>(new Set())
+  const isChildOpen = (id: string) => (props.childOpen ? props.childOpen(id) : localOpenChildren().has(id))
+  const toggleChild = (id: string) => {
+    if (props.toggleChild) {
+      props.toggleChild(id)
+    } else {
+      setLocalOpenChildren((prev) => {
+        const next = new Set(prev)
+        if (next.has(id)) next.delete(id)
+        else next.add(id)
+        return next
+      })
+    }
+  }
+
+  const allSlots = createMemo<MechanismSlot[]>(() => {
+    const m = mechanism()
+    return [...m.tools, ...m.children]
+  })
+
+  const rawToolMap = createMemo(() => {
+    const map = new Map<string, RuntimeTool>()
+    for (const tool of props.model().tools) {
+      map.set(tool.id, tool)
+    }
+    return map
+  })
+
+  const attentionMap = createMemo(() => {
+    const map = new Map<string, RuntimeAttention>()
+    const atts = props.model().run.attention
+    for (const att of atts) {
+      for (const tool of props.model().tools) {
+        if (tool.awaiting?.id === att.id || (att.toolRef && tool.messageID === att.toolRef.messageID && tool.callID === att.toolRef.callID)) {
+          map.set(tool.id, att)
+        }
+      }
+    }
+    return map
+  })
+
+  const mainAgent = () => mechanism().main.agent ?? props.t("mechanism.main")
+  const mainModel = () => mechanism().main.model ?? props.t("runtime.unknown")
+  const mainCost = () => {
+    const lastReq = props.model().requests[props.model().requests.length - 1]
+    return lastReq?.cost
+  }
+
+  const locale = () => props.copy?.intl() ?? "en"
+
+  const usageInputText = () => {
+    const u = props.model().usage.tokens
+    if (u) return countCompact(u.input, locale())
+    return props.model().usage.settled ? props.t("usage.unknown") : props.t("usage.counting")
+  }
+
+  const usageOutputText = () => {
+    const u = props.model().usage.tokens
+    if (u) return countCompact(u.output, locale())
+    return props.t("runtime.unsettled")
+  }
+
+  const usageContextText = () => {
+    const ctx = props.model().usage.context
+    if (ctx.used !== undefined) {
+      const used = countCompact(ctx.used, locale())
+      return ctx.limit ? `${used}/${countCompact(ctx.limit, locale())}` : used
+    }
+    return props.t("runtime.unknown")
+  }
+
+  return (
+    <div
+      ref={rootRef}
+      data-oco-runtime-mechanism="expanded"
+      class="flex flex-col gap-3 min-w-0 font-mono"
+    >
+      <style>{`
+        @keyframes oco-flow-down {
+          0% { transform: translateY(-100%); opacity: 0; }
+          50% { opacity: 1; }
+          100% { transform: translateY(100%); opacity: 0; }
+        }
+        @keyframes oco-flow-up {
+          0% { transform: translateY(100%); opacity: 0; }
+          50% { opacity: 1; }
+          100% { transform: translateY(-100%); opacity: 0; }
+        }
+        .oco-flow-dispatch {
+          animation: oco-flow-down 1.2s linear infinite;
+        }
+        .oco-flow-return {
+          animation: oco-flow-up 1.2s linear infinite;
+        }
+        @media (prefers-reduced-motion: reduce) {
+          .oco-flow-dispatch,
+          .oco-flow-return,
+          [data-oco-runtime-flow] {
+            animation-name: none !important;
+            animation: none !important;
+          }
+        }
+      `}</style>
+
+      {/* 3. Legend */}
+      <MechanismLegend t={props.t} />
+
+      {/* 4. Agent Tree */}
+      <div class="flex flex-col gap-3 min-w-0">
+        {/* Main Agent Node + Reasoning */}
+        <div
+          class="grid gap-3 items-start min-w-0"
+          classList={{
+            "grid-cols-1": isNarrow() || !props.reasoningElement,
+            "grid-cols-1 md:grid-cols-2": !isNarrow() && Boolean(props.reasoningElement),
+          }}
+        >
+          {/* Main Node */}
+          <div
+            data-oco-runtime-node="main"
+            data-oco-runtime-node-kind="main"
+            node-kind="main"
+            class="flex flex-col gap-1.5 p-2.5 rounded border border-dashed bg-surface-inset-base font-mono text-11-regular min-w-0 break-words"
+            style={{ "border-color": COLOR.model }}
+          >
+            <div class="flex flex-wrap items-center justify-between gap-2 min-w-0">
+              <div class="flex items-center gap-1.5 min-w-0 font-medium" style={{ color: COLOR.model }}>
+                <span>{mainAgent()}</span>
+                <span class="text-text-weak font-normal">· {props.t("legend.main")}</span>
+              </div>
+              <div class="text-11-regular text-text-weak shrink-0">
+                <span>{mainModel()}</span>
+                <span> · {props.t("runtime.request_num", { n: mechanism().main.request })}</span>
+              </div>
+            </div>
+
+            {/* Stage chips */}
+            <ol
+              aria-label={props.t("stage.label")}
+              data-oco-runtime-stage={props.model().stage}
+              class="m-0 p-0 list-none flex flex-wrap items-center gap-1.5 my-0.5"
+            >
+              <For each={STAGES}>
+                {(s) => {
+                  const isCurrent = () => props.model().stage === s
+                  return (
+                    <li
+                      aria-current={isCurrent() ? "step" : undefined}
+                      class="px-1.5 py-0.5 rounded text-10-regular border min-w-0"
+                      classList={{
+                        "border-solid bg-surface-base text-text-strong font-medium": isCurrent(),
+                        "border-border-subtle text-text-weak": !isCurrent(),
+                      }}
+                      style={{
+                        "border-color": isCurrent() ? COLOR.model : undefined,
+                        color: isCurrent() ? COLOR.model : undefined,
+                      }}
+                    >
+                      {props.t(`stage.${s}` as any)}
+                    </li>
+                  )
+                }}
+              </For>
+            </ol>
+
+            {/* Usage line */}
+            <div data-oco-runtime-usage class="text-11-regular text-text-weak font-mono flex flex-wrap items-center gap-x-2 gap-y-0.5">
+              <span>{props.t("runtime.usage.input", { value: usageInputText() })}</span>
+              <span>·</span>
+              <span>{props.t("runtime.usage.output", { value: usageOutputText() })}</span>
+              <span>·</span>
+              <span>{props.t("runtime.usage.context", { value: usageContextText() })}</span>
+              <Show when={mainCost() !== undefined && mainCost()! > 0}>
+                <span>·</span>
+                <span>{props.t("runtime.usage.cost", { value: String(mainCost()) })}</span>
+              </Show>
+            </div>
+          </div>
+
+          {/* Reasoning Side-Note */}
+          <Show when={props.reasoningElement}>
+            <div class="min-w-0">{props.reasoningElement}</div>
+          </Show>
+        </div>
+
+        {/* Dispatch Section */}
+        <div class="flex flex-col gap-1 min-w-0">
+          <div class="flex items-center justify-center gap-2 text-11-regular font-mono text-text-weak my-0.5">
+            <span>{props.t("mechanism.dispatch.parallel", { count: allSlots().length })}</span>
+            <Show when={mechanism().slotsFrom}>
+              {(n) => <span data-oco-runtime-slots-from={n()}>{props.t("mechanism.slots_from", { n: n() })}</span>}
+            </Show>
+          </div>
+
+          <Show
+            when={!mechanism().empty}
+            fallback={
+              <div class="text-11-regular text-text-weak py-3 text-center bg-surface-inset-base rounded border border-dashed border-border-subtle font-mono">
+                {props.t("mechanism.empty")}
+              </div>
+            }
+          >
+            {/* Slot Rail: narrow uses vertical track, wide uses grid */}
+            <div
+              class="min-w-0"
+              data-oco-runtime-rail={isNarrow() ? "vertical" : "grid"}
+              classList={{
+                "border-l border-dashed border-border-strong pl-3 ml-2 flex flex-col gap-3": isNarrow(),
+                "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3": !isNarrow(),
+              }}
+            >
+              <For each={allSlots()}>
+                {(slot) => {
+                  const rawTool = () => rawToolMap().get(slot.toolID)
+                  const att = () => attentionMap().get(slot.toolID)
+                  const isPending = () => Boolean(props.pending?.()[att()?.id ?? ""])
+                  const isFailed = () => Boolean(props.failed?.()[att()?.id ?? ""])
+                  const handleRespond = (reply: "once" | "always" | "reject") => {
+                    const a = att()
+                    if (a && props.respond) props.respond(() => a, reply)
+                  }
+
+                  return (
+                    <div class="flex flex-col gap-1 min-w-0">
+                      {/* Dispatch Edge */}
+                      <MechanismDispatchEdge
+                        slot={slot}
+                        isReplay={isReplay()}
+                        t={props.t}
+                      />
+
+                      {/* Slot Node */}
+                      <Show
+                        when={slot.kind === "child"}
+                        fallback={
+                          <MechanismToolSlot
+                            slot={slot}
+                            rawTool={rawTool}
+                            isReplay={isReplay()}
+                            t={props.t}
+                            copy={props.copy}
+                            isOpen={isToolOpen(slot.toolID)}
+                            onToggle={() => toggleTool(slot.toolID)}
+                            attention={att()}
+                            pending={isPending()}
+                            failed={isFailed()}
+                            onRespond={handleRespond}
+                            onView={props.onView}
+                          />
+                        }
+                      >
+                        <MechanismChildSlot
+                          slot={slot}
+                          rawTool={rawTool}
+                          isReplay={isReplay()}
+                          t={props.t}
+                          copy={props.copy}
+                          isOpen={isToolOpen(slot.toolID)}
+                          onToggle={() => toggleTool(slot.toolID)}
+                          isChildOpen={isChildOpen(rawTool()?.child?.sessionID ?? "")}
+                          onToggleChild={() => toggleChild(rawTool()?.child?.sessionID ?? "")}
+                          assembleChild={props.assembleChild}
+                          now={props.now}
+                          onOpenSession={props.onOpenSession}
+                        />
+                      </Show>
+
+                      {/* Return Edge */}
+                      <MechanismReturnEdge
+                        slot={slot}
+                        isReplay={isReplay()}
+                        t={props.t}
+                      />
+                    </div>
+                  )
+                }}
+              </For>
+
+              {/* Tools Overflow Node */}
+              <Show when={mechanism().toolsOverflow.total > 0}>
+                <div
+                  data-oco-runtime-overflow="tools"
+                  class="flex items-center justify-center p-2 rounded bg-surface-inset-base border border-dashed border-border-subtle text-11-regular text-text-weak font-mono text-center min-w-0"
+                >
+                  {props.t("mechanism.overflow", {
+                    total: mechanism().toolsOverflow.total,
+                    running: mechanism().toolsOverflow.running,
+                  })}
+                </div>
+              </Show>
+
+              {/* Children Overflow Node */}
+              <Show when={mechanism().childrenOverflow.total > 0}>
+                <div
+                  data-oco-runtime-overflow="children"
+                  class="flex items-center justify-center p-2 rounded bg-surface-inset-base border border-dashed border-border-subtle text-11-regular text-text-weak font-mono text-center min-w-0"
+                >
+                  {props.t("mechanism.overflow", {
+                    total: mechanism().childrenOverflow.total,
+                    running: mechanism().childrenOverflow.running,
+                  })}
+                </div>
+              </Show>
+            </div>
+          </Show>
+        </div>
+
+        {/* Return Status Line */}
+        <div class="flex items-center justify-center gap-2 text-11-regular font-mono text-text-weak my-0.5">
+          <span>
+            {props.model().stage === "fill"
+              ? props.t("mechanism.return.flowing")
+              : props.t("mechanism.return.idle")}
+          </span>
+        </div>
+
+        {/* Fill Node */}
+        <div class="flex justify-center min-w-0">
+          <div
+            data-oco-runtime-fill
+            class="flex flex-col items-center justify-center text-center px-4 py-2 rounded border border-dashed border-border-strong bg-surface-inset-base font-mono min-w-[240px] max-w-full"
+          >
+            <div class="text-12-medium text-text-strong break-words">
+              {props.t("mechanism.fill.target", { agent: mainAgent() })}
+            </div>
+            <div class="text-11-regular text-text-weak">
+              {props.t("mechanism.fill.progress", {
+                done: mechanism().fill.done,
+                total: mechanism().fill.total,
+              })}
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  )
+}
