+// ---------- tools ----------
+const TODO_STATUS = new Set<RingTodo["status"]>(["pending", "in_progress", "completed", "cancelled"])
+function todosOf(input: Record<string, unknown>): RingTodo[] {
+  const list = Array.isArray(input.todos) ? input.todos : []
+  return list.map((o) => {
