+              {fitText(toolsText(), geo().r * 2 - 12)}
+            </text>
+          </Show>
+          <Index each={Array.from({ length: runningTools() })}>
+            {(_, i) => (
+              <rect
+                data-oco-runtime-core-running
+                x={hub()[0] - runningTools() * 4 + i * 8 + 1}
+                y={hub()[1] + geo().r - 12}
+                width="5"
+                height="5"
+                fill="var(--rt-tool)"
+              />
+            )}
+          </Index>
+
+          {/* Overflow clusters */}
+          <For each={layout().clusters}>
+            {(c) => {
+              const xy = () => geo().slots[c.zone][c.slot]
+              return (
+                <g data-oco-runtime-probe-cluster={c.zone} transform={`translate(${xy()[0]},${xy()[1]})`}>
+                  <circle
+                    r={geo().probeR + 3}
+                    fill="var(--rt-inset)"
+                    stroke="var(--rt-line-strong)"
+                    stroke-dasharray="2 2"
+                  />
+                  <text text-anchor="middle" y="4" fill="var(--rt-text)">
+                    +{c.count}
+                  </text>
+                </g>
+              )
+            }}
+          </For>
+
+          {/* Probes: keyed by node so each keeps its element (and its position) as it moves between zones. */}
+          <For each={probeNodes()}>
+            {(node) => {
+              const initial = loop().probes.find((p) => p.node === node)!
+              const probe = () => loop().probes.find((p) => p.node === node) ?? initial
+              const id = () => probe().id
+              // A probe dispatched while the view is open travels hub → dispatch lane → its place, so the queued step
+              // shows even when the child session starts at once. Probes already out when the view opens go straight
+              // there. Data attributes keep the model's zone and slot throughout.
+              const [arrived, setArrived] = createSignal(false)
+              const [queued, setQueued] = createSignal(false)
+              onMount(() =>
+                requestAnimationFrame(() =>
+                  requestAnimationFrame(() => {
+                    const dwell =
+                      props.live() && ready && initial.stage !== "queued" && initial.stage !== "absorbed" && !reduced()
+                    if (!dwell) return setArrived(true)
+                    setQueued(true)
+                    const timer = setTimeout(() => {
+                      timers.delete(timer)
+                      // Arrive first: at() never falls back to the hub between the two steps.
+                      setArrived(true)
+                      setQueued(false)
+                    }, 1700)
+                    timers.add(timer)
+                  }),
+                ),
+              )
+              const queueSlot = () => geo().slots.queue[Math.max(0, probeNodes().indexOf(node)) % 4]
+              const at = (): At =>
+                arrived()
+                  ? placeOf(probe())
+                  : queued()
+                    ? { kind: "queue", xy: queueSlot(), shown: true }
+                    : { kind: "hub", xy: hub(), shown: false }
+              // Moves follow the lane (routeOf) with the Web Animations API; the style holds the resting place. A resize
+              // or a probe that was already out when the view opened jumps without a trip.
+              let elem: SVGGElement | undefined
+              let last: { at: At; geo: LoopGeometry } | undefined
+              createEffect(() => {
+                const next = at()
+                const g = geo()
+                const before = last
+                last = { at: next, geo: g }
+                if (!elem || !before || before.geo !== g || !ready || reduced() || typeof elem.animate !== "function")
+                  return
+                if (before.at.kind === next.kind && before.at.xy === next.xy) return
+                const path = tripOf(g, before.at, next, probe().background)
+                const dist: number[] = [0]
+                for (let i = 1; i < path.length; i++)
+                  dist.push(dist[i - 1] + Math.hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]))
+                const total = dist[dist.length - 1]
+                if (total < 1) return
+                const o0 = before.at.shown ? 1 : 0
+                const o1 = next.shown ? 1 : 0
+                const mid = Math.max(o0, o1, before.at.kind === "hub" || next.kind === "hub" ? 1 : 0)
+                elem.getAnimations().forEach((a) => a.cancel())
+                // Labels hide while a probe travels, so probes passing each other on the lane do not smear text.
+                const el = elem
+                el.setAttribute("data-oco-runtime-probe-moving", "")
+                const anim = el.animate(
+                  path.map((xy, i) => ({
+                    transform: `translate(${xy[0]}px, ${xy[1]}px)`,
+                    opacity: i === 0 ? o0 : i === path.length - 1 ? o1 : mid,
+                    offset: dist[i] / total,
+                  })),
+                  { duration: clamp(total * 1.6, 450, 3200), easing: "ease-in-out" },
+                )
+                const done = () => {
+                  if (!el.getAnimations().some((a) => a !== anim && a.playState === "running"))
+                    el.removeAttribute("data-oco-runtime-probe-moving")
+                }
+                anim.onfinish = done
+                anim.oncancel = done
+              })
+              const color = () => probeColor(probe())
+              const isSelected = () => props.selected() === id()
+              const label = () => probe().description || probe().agent
+              const place = () => layout().places[id()]
+              const pr = () => geo().probeR
+              return (
+                <g
+                  data-oco-runtime-probe={id()}
+                  data-oco-runtime-probe-stage={probe().stage}
+                  data-oco-runtime-probe-flag={probe().flag ?? ""}
+                  data-oco-runtime-probe-zone={place()?.zone ?? ""}
+                  data-oco-runtime-probe-slot={place()?.slot ?? ""}
+                  data-oco-runtime-probe-visible={at().shown ? "true" : "false"}
+                  data-oco-runtime-probe-selected={isSelected() ? "true" : "false"}
+                  ref={elem}
+                  class="oco-loop-move cursor-pointer"
+                  style={{ transform: `translate(${at().xy[0]}px, ${at().xy[1]}px)`, opacity: at().shown ? 1 : 0 }}
+                  // SVG <g>: Solid does not apply the tabIndex prop here, so set the attribute (keyboard users Tab to probes).
+                  tabindex={at().shown ? 0 : -1}
+                  role="button"
+                  aria-pressed={isSelected()}
+                  aria-label={`${label()} · ${probe().agent} · ${stageText(probe())}`}
+                  onClick={() => props.onSelect(isSelected() ? undefined : id())}
+                  onKeyDown={(e) => {
+                    if (e.key === "Enter" || e.key === " ") {
+                      e.preventDefault()
+                      props.onSelect(isSelected() ? undefined : id())
+                    }
+                  }}
+                >
+                  <title>{`${label()} · ${probe().agent}`}</title>
+                  <Show when={probe().stage === "docked" || probe().flag}>
+                    <circle
+                      data-oco-runtime-probe-beacon
+                      class="oco-loop-blink oco-loop-anim"
+                      r={pr() + 4}
+                      fill="none"
+                      stroke={color()}
+                      stroke-width="1.5"
+                    />
+                  </Show>
+                  {/* At most 12 rings turn at once: the core plus the first 11 work slots. */}
+                  <Show when={probe().stage === "running" && !probe().flag && at().shown && (place()?.slot ?? 99) < 11}>
+                    <circle
+                      data-oco-runtime-probe-orbit
+                      class="oco-loop-spin oco-loop-anim"
+                      style={{ "--oco-spin": "3s" }}
+                      r={pr() + 5}
+                      fill="none"
+                      stroke={color()}
+                      stroke-width="1"
+                      stroke-dasharray="4 5"
+                    />
+                  </Show>
+                  <Show when={isSelected()}>
+                    <circle
+                      r={pr() + 9}
+                      fill="none"
+                      stroke="var(--rt-text)"
+                      stroke-width="1.2"
+                      stroke-dasharray="2 3"
+                    />
+                  </Show>
+                  <circle r={pr()} fill="var(--rt-panel)" stroke={color()} stroke-width="1.8" />
+                  <text text-anchor="middle" y="4" fill={color()}>
+                    {glyphOf(probe())}
+                  </text>
+                  <text text-anchor="middle" y={geo().labelY} fill="var(--rt-text)">
+                    {fitText(label(), place() ? geo().labelPx[place()!.zone] : 0)}
+                  </text>
+                </g>
+              )
+            }}
+          </For>
+        </svg>
+      </div>
+
+      {/* Handoff detail: fixed height so the frame never grows; full text opens over the lane. */}
+      <div
+        data-oco-runtime-handoff={selectedProbe()?.id ?? (props.selected() ? "missing" : "none")}
+        data-oco-runtime-handoff-shown={shownKind()}
+        class="shrink-0 h-[56px] rounded-sm px-4 py-1.5 text-12-regular flex flex-col justify-center gap-1 min-w-0 select-text"
+        style={{ background: "var(--rt-panel)", border: "1px solid var(--rt-line)", color: "var(--rt-weak)" }}
+      >
+        <Show
+          when={shownProbe()}
+          fallback={
+            <Show
+              when={shownTool()}
+              fallback={
+                <span class="ell" style={{ color: "var(--rt-faint)" }}>
+                  {props.selected()
+                    ? props.live()
+                      ? t("handoff.hint")
+                      : t("handoff.not_dispatched")
+                    : t("handoff.empty")}
+                </span>
+              }
+            >
+              {(x) => (
+                <>
+                  <div class="flex items-center gap-2 min-w-0 text-12-regular">
+                    <span class="shrink-0" style={{ color: "var(--rt-faint)" }}>
+                      {t("handoff.last_tool")}
+                    </span>
+                    <span class="shrink-0" style={{ color: "var(--rt-tool)" }}>
+                      · {x().name}
+                    </span>
+                    <span class="shrink-0" style={{ color: toolStateColor(x()) }}>
+                      · {toolStateText(x())}
+                    </span>
+                    <span class="ml-auto shrink-0" style={{ color: "var(--rt-faint)" }}>
+                      {x().start !== undefined ? formatElapsed(x().start!, x().end, props.now()) : ""}
+                    </span>
+                  </div>
+                  <div class="flex items-center gap-4 min-w-0 text-12-regular">
+                    <span class="ell min-w-0 flex-1" title={x().input}>
+                      <span style={{ color: "var(--rt-accent)" }}>↓ {t("handoff.input")}</span>{" "}
+                      <span style={{ color: "var(--rt-text)" }}>{x().input || "—"}</span>
+                    </span>
+                    <span class="ell min-w-0 flex-1" title={x().lastOutput}>
+                      <span style={{ color: "var(--rt-ok)" }}>↑ {t("handoff.output")}</span>{" "}
+                      {x().lastOutput || t("handoff.not_returned")}
+                    </span>
+                  </div>
+                </>
+              )}
+            </Show>
+          }
+        >
+          {(p) => (
+            <>
+              <div class="flex items-center gap-2 min-w-0 text-12-regular">
+                <Show when={!selectedProbe()}>
+                  <span data-oco-runtime-handoff-latest class="shrink-0" style={{ color: "var(--rt-faint)" }}>
+                    {t("handoff.latest")} ·
+                  </span>
+                </Show>
+                <span class="ell min-w-0" style={{ color: "var(--rt-text)" }}>
+                  {p().description || p().agent}
+                </span>
+                <span class="shrink-0" style={{ color: "var(--rt-sub)" }}>
