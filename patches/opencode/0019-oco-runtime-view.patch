+// oco (patches/opencode/0019): runtime view data model. Pure functions over the sync store's data; no network,
+// no Solid. Contract and rules: docs/superpowers/specs/2026-10-02-runtime-dashboard-design.md (sections 1, 4).
+import type { Message, Part, PermissionRequest, QuestionRequest, Session, SessionStatus, ToolPart } from "@opencode-ai/sdk/v2/client"
+import { idTime, oneLine, subagentOf, type TrajectoryRequest } from "./session-trajectory-model"
+
+export type Evidence = "event" | "inferred"
+export type RunState = "working" | "waiting-user" | "retrying" | "idle" | "error" | "unknown"
+export type Stage = "prepare" | "model" | "tools" | "fill" | "idle"
+export type ToolRef = { messageID: string; callID: string }
+
+export type RuntimeAttention =
+  | { kind: "permission"; id: string; sessionID: string; permission: string; patterns: string[]; toolRef?: ToolRef }
+  | { kind: "question"; id: string; sessionID: string; text: string; toolRef?: ToolRef }
+
+export type RuntimeRun = {
+  state: RunState
+  evidence: Evidence
+  retry?: { attempt: number; message: string; next: number }
+  attention: RuntimeAttention[]
+  /** false in replay: history does not record approval waits, so an empty list proves nothing. */
+  attentionKnown: boolean
+}
+
+export type RuntimeInput = {
+  mode: "live" | "replay"
+  sessionID: string
+  parts: (messageID: string) => Part[]
+  /** The sync store's session_status entry; undefined = no entry (OpenCode treats that as idle). */
+  status: SessionStatus | undefined
+  /** Pending permission requests of the root session AND all its descendant sessions. */
+  permissions: PermissionRequest[]
+  /** Pending question requests of the root session AND all its descendant sessions. */
+  questions: QuestionRequest[]
+  childStatus: (sessionID: string) => SessionStatus | undefined
+  /** `buildTrajectory(...).requests`: one assistant message = one request. */
+  requests: TrajectoryRequest[]
+  /** Arrival time of the newest event the view saw for this session (recorded in-app). */
+  lastEventAt?: number
+  /** Context window of the last request's model, when known. */
+  contextLimit?: number
+  /** Loaded child-session messages. Undefined (or a missing function) means not loaded. */
+  childMessages?: (sessionID: string) => Message[] | undefined
+  /** Parent session of `sessionID`, when known. Used to walk a grandchild's pending item up to a direct child. */
+  parentOf?: (sessionID: string) => string | undefined
+  /** The session's messages (replay: the snapshot at the cursor). Read for user messages: where the current round
+   *  starts, and background-task notices. Optional; without it the round starts at request 0 and no notice is known. */
+  messages?: readonly Message[]
+}
+
+export type ChildLifecycle = "running" | "retrying" | "waiting-user" | "done" | "error" | "cancelled" | "unknown"
+export type BackgroundNotice = "done" | "error" | "cancelled"
+export type RuntimeChild = {
+  sessionID?: string
+  agent: string
+  description: string
+  background: boolean
+  lifecycle: ChildLifecycle
+  evidence: Evidence
+  /** oh-my-openagent background task id (`bg_…`): `state.metadata.backgroundTaskId`. */
+  backgroundTaskId?: string
+  /** A completed `background_output` call for this task in this session: the request it ran in, and when it ended. */
+  retrieved?: { request: number; at: number }
+  /** Latest `[BACKGROUND TASK …]` notice for this task injected into this session. */
+  notice?: BackgroundNotice
+  /** The prompt the task was given, when recorded (`input.prompt`). */
+  prompt?: string
+  /** What came back: a sync task's `<task_result>`, or the output of the completed `background_output` call. */
+  result?: string
+}
+export type RuntimeTool = {
+  id: string            // part id; stable identity across updates
+  callID: string
+  messageID: string
+  request: number       // index in RuntimeModel.requests
+  name: string
+  state: "pending" | "running" | "completed" | "error"
+  /** Inferred: tool was still pending or running when its request was interrupted. */
+  interrupted: boolean
+  /** Error state whose own signal is an abort: error text "Tool execution aborted", or metadata.interrupted. */
+  cancelled: boolean
+  /** Error state that is the user's own answer, not a failure: a rejected permission or a dismissed question. */
+  declined?: "rejected" | "dismissed"
+  input: string         // one-line summary
+  lastOutput?: string   // last non-empty line; never set for task (subagent) rows
+  start?: number
+  end?: number
+  awaiting?: { kind: "permission" | "question"; id: string }
+  child?: RuntimeChild
+  /** `background_output` / `background_cancel`: the background task it acts on. Not a tool of the main agent. */
+  retrieves?: { taskId: string; agent?: string; description?: string }
+}
+
+export type RuntimeTokens = { input: number; output: number; reasoning: number; cacheRead: number; cacheWrite: number }
+export type RuntimeRequest = {
+  index: number
+  messageID: string
+  turn: number
+  start: number
+  firstToken?: number
+  end?: number
+  status: "running" | "done" | "error" | "interrupted"
+  /** Raw message.error.name === "MessageAbortedError". Independent of trajectory status. */
+  cancelled: boolean
+  evidence: Evidence            // "inferred" only for interrupted
+  error?: string
+  settled: boolean              // done or error
+  known: boolean                // settled and token total > 0 (raw message tokens, NOT the trajectory's 0-filled copy)
+  tokens?: RuntimeTokens        // only when known
+  agent?: string
+  model?: { providerID: string; modelID: string }
+  cost?: number
+}
+export type RuntimeUsage = {
+  requests: number
+  knownRequests: number
+  settled: boolean              // every request settled
+  tokens?: RuntimeTokens        // sum over known requests only; undefined when none is known
+  context: { used?: number; limit?: number }   // used = last known request's input + cacheRead + cacheWrite
+}
+
+export type RuntimeFocus =
+  | { kind: "attention"; attention: RuntimeAttention }
+  | { kind: "retry"; attempt: number; message: string; next: number }
+  | { kind: "error"; message: string }
+  | { kind: "cancelled" }
+  | { kind: "working"; stage: Stage; tool?: RuntimeTool }
+  | { kind: "interrupted" }
+  | { kind: "done" }
+  | { kind: "idle" }
+export type RuntimeEvent = {
+  id: string
+  at: number
+  role: "model" | "tool" | "subagent"
+  kind:
+    | "request.start" | "request.end" | "request.error" | "request.cancelled"
+    | "tool.start" | "tool.end" | "tool.error" | "tool.rejected" | "tool.dismissed"
+  label: string            // tool name, or subagent agent; "" for model events
+  request: number
+}
+export type RuntimeFreshness = {
+  observedAt: number
+  /** Newest of: arrival time recorded in-app, newest data timestamp. Always inferred. Undefined in replay. */
+  lastEventAt?: number
+  lastEventSource?: "arrival" | "data"
+  evidence: "inferred"
+}
+export type RuntimeSession = { id: string; kind: "root" | "child"; agent?: string; state: RunState; evidence: Evidence }
+
+export type RuntimeModel = {
+  mode: "live" | "replay"
+  freshness: RuntimeFreshness
+  run: RuntimeRun
+  stage: Stage
+  focus: RuntimeFocus
+  sessions: RuntimeSession[]
+  requests: RuntimeRequest[]
+  tools: RuntimeTool[]
+  events: RuntimeEvent[]
+  usage: RuntimeUsage
+  /** Index of the first request of the current round: the requests answering the last real user message. Background
+   *  notices are user messages too; they do not start a round. */
+  roundStart: number
+}
+
+const attentionOf = (input: RuntimeInput): RuntimeAttention[] => {
+  if (input.mode !== "live") return []
+  const permissions = input.permissions.map<RuntimeAttention>((p) => ({
+    kind: "permission",
+    id: p.id,
+    sessionID: p.sessionID,
+    permission: p.permission,
+    patterns: p.patterns,
+    toolRef: p.tool ? { messageID: p.tool.messageID, callID: p.tool.callID } : undefined,
+  }))
+  const questions = input.questions.map<RuntimeAttention>((q) => ({
+    kind: "question",
+    id: q.id,
+    sessionID: q.sessionID,
+    text: q.questions[0]?.question ?? "",
+    toolRef: q.tool ? { messageID: q.tool.messageID, callID: q.tool.callID } : undefined,
+  }))
+  return [...permissions, ...questions]
+}
+
+const messageAborted = (message: { error?: { name: string } | undefined }) => message.error?.name === "MessageAbortedError"
+
+const runOf = (input: RuntimeInput): RuntimeRun => {
+  if (input.mode === "replay") {
+    const working = input.requests.some((r) => r.status === "running")
+    return { state: working ? "working" : "idle", evidence: "inferred", attention: [], attentionKnown: false }
+  }
+  const status = input.status
+  const attention = attentionOf(input)
+  const retry =
+    status?.type === "retry" ? { attempt: status.attempt, message: status.message, next: status.next } : undefined
+  const last = input.requests[input.requests.length - 1]
+  const lastCancelled = !!last && messageAborted(last.message)
+  const state: RunState = attention.length
+    ? "waiting-user"
+    : retry
+      ? "retrying"
+      : status?.type === "busy"
+        ? "working"
+        : lastCancelled
+          ? "idle"
+          : last?.status === "error"
+            ? "error"
+            : "idle"
+  return { state, evidence: status ? "event" : "inferred", retry, attention, attentionKnown: true }
+}
+
+export function lastLine(text: string | undefined): string | undefined {
+  if (!text) return undefined
+  let end = text.length
+  while (end > 0) {
+    const prevNewline = text.lastIndexOf("\n", end - 1)
+    const line = text.slice(prevNewline + 1, end).trim()
+    if (line.length > 0) {
+      return oneLine(line, 160)
+    }
+    if (prevNewline === -1) break
+    end = prevNewline
+  }
+  return undefined
+}
+
+const SUMMARY_KEYS = ["command", "filePath", "path", "pattern", "query", "url", "description", "prompt"]
+
+export function toolInputSummary(part: ToolPart): string {
+  const input = part.state.input
+  const picked = SUMMARY_KEYS.map((k) => input[k]).find((v) => typeof v === "string" && v)
+  return oneLine(typeof picked === "string" ? picked : (JSON.stringify(input) ?? ""), 120)
+}
+
+const lastOutputOf = (part: ToolPart) => {
+  const s = part.state
+  if (s.status === "completed") return lastLine(s.output)
+  if (s.status === "error") return lastLine(s.error)
+  if (s.status === "running") {
+    const out = s.metadata?.output
+    return typeof out === "string" ? lastLine(out) : undefined
+  }
+  return undefined
+}
+
+const sameCall = (ref: { messageID: string; callID: string } | undefined, part: ToolPart) =>
+  !!ref && ref.messageID === part.messageID && ref.callID === part.callID
+
+/** True when `sessionID` is `target` or a descendant of it, walking `parentOf`. */
+const ascendsTo = (sessionID: string, target: string, parentOf: RuntimeInput["parentOf"]): boolean => {
+  const seen = new Set<string>()
+  let current: string | undefined = sessionID
+  while (current && !seen.has(current)) {
+    if (current === target) return true
+    seen.add(current)
+    current = parentOf?.(current)
+  }
+  return false
+}
+
+/** Live only. Replay is always unknown. A task part's own state is not an input. */
+const childLifecycleOf = (
+  sessionID: string | undefined,
+  input: RuntimeInput,
+): { lifecycle: ChildLifecycle; evidence: Evidence } => {
+  if (input.mode !== "live" || !sessionID) return { lifecycle: "unknown", evidence: "inferred" }
+  const pending = (id: string) => ascendsTo(id, sessionID, input.parentOf)
+  if (input.permissions.some((p) => pending(p.sessionID)) || input.questions.some((q) => pending(q.sessionID)))
+    return { lifecycle: "waiting-user", evidence: "event" }
+  const status = input.childStatus(sessionID)
+  if (status?.type === "retry") return { lifecycle: "retrying", evidence: "event" }
+  if (status?.type === "busy") return { lifecycle: "running", evidence: "event" }
+  const messages = input.childMessages?.(sessionID)
+  if (messages === undefined) return { lifecycle: "unknown", evidence: "inferred" }
+  let last: Extract<Message, { role: "assistant" }> | undefined
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const message = messages[i]
+    if (message.role === "assistant") {
+      last = message
+      break
+    }
+  }
+  if (!last) return { lifecycle: "unknown", evidence: "inferred" }
+  if (messageAborted(last)) return { lifecycle: "cancelled", evidence: "event" }
+  if (last.error) return { lifecycle: "error", evidence: "event" }
+  if (last.time.completed !== undefined) return { lifecycle: "done", evidence: "event" }
+  return { lifecycle: "unknown", evidence: "inferred" }
+}
+
+const str = (v: unknown): string | undefined => (typeof v === "string" && v ? v : undefined)
+const metaOf = (part: ToolPart): Record<string, unknown> | undefined =>
+  "metadata" in part.state ? (part.state.metadata as Record<string, unknown> | undefined) : undefined
+
+/** `subagentOf` plus oh-my-openagent's forms: a category dispatch has no `subagent_type` (the agent is only in
+ *  `metadata.agent`), and the child session id may be only in the output's `session_id:` line. */
+export function runtimeSubagentOf(part: ToolPart): { agent: string; description: string; session?: string } | undefined {
+  if (part.tool !== "task") return undefined
+  const sub = subagentOf(part)
+  const input = (part.state.input ?? {}) as Record<string, unknown>
+  const meta = metaOf(part)
+  const agent = sub?.agent ?? str(meta?.agent) ?? str(input.category)
+  if (!agent) return undefined
+  const output = part.state.status === "completed" ? part.state.output : undefined
+  const fromOutput = output ? /^session_id:\s*(ses_[\w-]+)/m.exec(output)?.[1] : undefined
+  return {
+    agent,
+    description: sub?.description || str(input.description) || str(meta?.description) || "",
+    session: sub?.session ?? str(meta?.sessionId) ?? fromOutput,
+  }
+}
+
+const RETRIEVAL_TOOLS = new Set(["background_output", "background_cancel"])
+/** The `bg_…` id a background `task` dispatch got, or the id a `background_output` / `background_cancel` call names. */
+export function backgroundIdOf(part: ToolPart): string | undefined {
+  if (part.tool === "task") {
+    const fromMeta = str(metaOf(part)?.backgroundTaskId)
+    if (fromMeta) return fromMeta
+    const output = part.state.status === "completed" ? part.state.output : undefined
+    return output ? /^background_task_id:\s*(bg_[\w-]+)/m.exec(output)?.[1] : undefined
+  }
+  if (RETRIEVAL_TOOLS.has(part.tool)) return str((part.state.input as Record<string, unknown> | undefined)?.task_id)
+  return undefined
+}
+
+/** Only a call that got the result counts: one made while the task still ran returns a status report instead
+ *  ("Task Status …"); a finished task's output starts with "Task Result", or with "# Full Session Output" and a
+ *  "Status: completed" line when called with `full_session`. */
+const resultKindOf = (part: ToolPart): "plain" | "full" | undefined => {
+  if (part.tool !== "background_output" || part.state.status !== "completed") return undefined
+  const out = part.state.output
+  if (/^\s*Task Result/i.test(out)) return "plain"
+  if (/^\s*# Full Session Output/i.test(out) && /^Status:\s*completed\s*$/im.test(out)) return "full"
+  return undefined
+}
+
+/** A `background_output` / `background_cancel` call and whether it retrieved the task's result. Undefined for other
+ *  tools and for a call that names no task. */
+export function retrievalOf(part: ToolPart): { taskId: string; retrieved: boolean } | undefined {
+  if (!RETRIEVAL_TOOLS.has(part.tool)) return undefined
+  const taskId = backgroundIdOf(part)
+  return taskId ? { taskId, retrieved: resultKindOf(part) !== undefined } : undefined
+}
+
+const noticeOfStatus = (status: string | undefined): BackgroundNotice | undefined => {
+  if (!status || status === "COMPLETED" || status === "RESULT READY") return "done"
+  if (status === "CANCELLED" || status === "INTERRUPTED") return "cancelled"
+  if (status.startsWith("RETRY")) return undefined
+  return "error"
+}
+
+/** One task's notice changed by a message; `notice` undefined: cleared by a RETRY status. */
+export type BackgroundNoticeChange = { id: string; notice?: BackgroundNotice }
+
+/** Applies one message's background-task notices to `state` in place (set, or delete on RETRY) and returns the
+ *  tasks whose notice it really changed, compared with `state` before the message. Non-user messages: `[]`.
+ *  Single form: `[BACKGROUND TASK RESULT READY|ERROR|CANCELLED|INTERRUPTED]` + `**ID:** \`bg_…\``.
+ *  Summary form: `[ALL BACKGROUND TASKS …]` + lines `- \`bg_…\`: desc [STATUS]`. Retry notices clear the task. */
+export function applyBackgroundNotices(
+  state: Map<string, BackgroundNotice>,
+  message: Message,
+  parts: RuntimeInput["parts"],
+): BackgroundNoticeChange[] {
+  if (message.role !== "user") return []
+  const before = new Map<string, BackgroundNotice | undefined>()
+  const put = (id: string, notice: BackgroundNotice | undefined) => {
+    if (!before.has(id)) before.set(id, state.get(id))
+    if (notice) state.set(id, notice)
+    else state.delete(id)
+  }
+  for (const p of parts(message.id)) {
+    if (p.type !== "text" || !p.text.includes("BACKGROUND TASK")) continue
+    const header = /\[BACKGROUND TASK ([A-Z ]+)\]/.exec(p.text)?.[1]
+    const single = /\*\*ID:\*\*\s*`(bg_[\w-]+)`/.exec(p.text)?.[1]
+    if (single && header) put(single, noticeOfStatus(header))
+    for (const line of p.text.matchAll(/^- `(bg_[\w-]+)`:[^\n]*?(?:\s\[([A-Z_]+)\](?: - [^\n]*)?)?$/gm)) {
+      put(line[1], noticeOfStatus(line[2]))
+    }
+  }
+  const changes: BackgroundNoticeChange[] = []
+  for (const [id, was] of before) {
+    const notice = state.get(id)
+    if (notice !== was) changes.push(notice ? { id, notice } : { id })
+  }
+  return changes
+}
+
+/** Background-task notices in user messages, oldest first; a later notice for the same task wins
+ *  (see `applyBackgroundNotices`). */
+export function backgroundNoticesOf(messages: readonly Message[] | undefined, parts: RuntimeInput["parts"]): Map<string, BackgroundNotice> {
+  const out = new Map<string, BackgroundNotice>()
+  if (!messages) return out
+  for (const m of messages) applyBackgroundNotices(out, m, parts)
+  return out
+}
+
+const INTERNAL_MARKER = "OMO_INTERNAL_INITIATOR"
+/** A user message typed by the person: not synthetic-only, not an agent-injected notice. */
+export function isRealUserMessage(messageID: string, parts: RuntimeInput["parts"]): boolean {
+  const texts = parts(messageID).filter((p): p is Extract<Part, { type: "text" }> => p.type === "text")
+  if (texts.some((p) => p.text.includes(INTERNAL_MARKER))) return false
+  if (texts.length && texts.every((p) => p.synthetic)) return false
+  return true
+}
+
+/** First request answering the last real user message (requests carry `message.parentID`). */
+export function roundStartOf(input: Pick<RuntimeInput, "requests" | "parts" | "messages">): number {
+  const users = new Map<string, boolean>()
+  const isReal = (id: string) => {
+    if (!users.has(id)) users.set(id, isRealUserMessage(id, input.parts))
+    return users.get(id)!
+  }
+  // Without messages, every parent counts as real (the old behaviour: the round is the last turn).
+  const known = input.messages ? new Set(input.messages.filter((m) => m.role === "user").map((m) => m.id)) : undefined
+  const requests = input.requests
+  for (let i = requests.length - 1; i >= 0; i--) {
+    const parent = requests[i].message.parentID
+    if (known && known.has(parent) && !isReal(parent)) continue
+    let start = i
+    while (start > 0 && requests[start - 1].message.parentID === parent) start--
+    return requests[start].index
+  }
+  return requests[0]?.index ?? 0
+}
+
+const toolOf = (
+  part: ToolPart,
+  request: number,
+  input: RuntimeInput,
+  requestStatus: TrajectoryRequest["status"] | undefined,
+  assignSession: boolean,
+): RuntimeTool => {
+  const s = part.state
+  const sub = runtimeSubagentOf(part)
+  const live = input.mode === "live"
+  const session = sub?.session
+  // Several task rows can name one child session. Session-id fallback belongs to the last row only.
+  // An exact {messageID, callID} match stays on the row it names.
+  const permission = live
+    ? (input.permissions.find((p) => sameCall(p.tool, part)) ??
+      (assignSession && session ? input.permissions.find((p) => ascendsTo(p.sessionID, session, input.parentOf)) : undefined))
+    : undefined
+  const question = live
+    ? (input.questions.find((q) => sameCall(q.tool, part)) ??
+      (assignSession && session ? input.questions.find((q) => ascendsTo(q.sessionID, session, input.parentOf)) : undefined))
+    : undefined
+  const reqStatus = requestStatus ?? (input.requests.find((r) => r.index === request) ?? input.requests[request])?.status
+  // Inferred: tool was still pending or running when its request was interrupted.
+  const interrupted = (s.status === "pending" || s.status === "running") && reqStatus === "interrupted"
+  const cancelled = s.status === "error" && (s.error === "Tool execution aborted" || s.metadata?.interrupted === true)
+  const declined =
+    s.status !== "error"
+      ? undefined
+      : s.error.startsWith("The user rejected permission")
+        ? ("rejected" as const)
+        : s.error.startsWith("The user dismissed this question")
+          ? ("dismissed" as const)
+          : undefined
+  const replayRunning = !live && s.status === "running"
+  return {
+    id: part.id,
+    callID: part.callID,
+    messageID: part.messageID,
+    request,
+    name: part.tool,
+    state: s.status,
+    interrupted,
+    cancelled,
+    ...(declined ? { declined } : {}),
+    input: toolInputSummary(part),
+    lastOutput: sub || replayRunning ? undefined : lastOutputOf(part),
+    start: s.status === "pending" ? undefined : s.time.start,
+    end: s.status === "completed" || s.status === "error" ? s.time.end : undefined,
+    awaiting: permission
+      ? { kind: "permission", id: permission.id }
+      : question
+        ? { kind: "question", id: question.id }
+        : undefined,
+    child: sub ? childOf(part, sub, input) : undefined,
+    ...(RETRIEVAL_TOOLS.has(part.tool) && backgroundIdOf(part)
+      ? {
+          retrieves: {
+            taskId: backgroundIdOf(part)!,
+            ...(str(metaOf(part)?.agent) ? { agent: str(metaOf(part)?.agent) } : {}),
+            ...(str(metaOf(part)?.description) ? { description: str(metaOf(part)?.description) } : {}),
+          },
+        }
+      : {}),
+  }
+}
+
+const childOf = (part: ToolPart, sub: NonNullable<ReturnType<typeof runtimeSubagentOf>>, input: RuntimeInput): RuntimeChild => {
+  const raw = (part.state.input ?? {}) as Record<string, unknown>
+  const backgroundTaskId = backgroundIdOf(part)
+  const prompt = str(raw.prompt) ?? str(metaOf(part)?.prompt)
+  const background = !!backgroundTaskId || raw.run_in_background === true || raw.background === true
+  // A background task's own output is only the launch receipt; its result comes from background_output.
+  const result =
+    !background && part.state.status === "completed"
+      ? (/<task_result>([\s\S]*?)<\/task_result>/.exec(part.state.output)?.[1]?.trim() ?? part.state.output.trim())
+      : undefined
+  return {
+    sessionID: sub.session,
+    agent: sub.agent,
+    description: sub.description,
+    background,
+    ...childLifecycleOf(sub.session, input),
+    ...(backgroundTaskId ? { backgroundTaskId } : {}),
+    ...(prompt ? { prompt } : {}),
+    ...(result ? { result } : {}),
+  }
+}
+
+const toolsOf = (input: RuntimeInput): RuntimeTool[] => {
+  const rows: { part: ToolPart; request: number; status: TrajectoryRequest["status"] }[] = []
+  for (const r of input.requests) {
+    for (const part of input.parts(r.message.id)) {
+      if (part.type === "tool") rows.push({ part, request: r.index, status: r.status })
+    }
+  }
+  const lastForSession = new Map<string, number>()
+  for (let index = 0; index < rows.length; index++) {
+    const session = runtimeSubagentOf(rows[index].part)?.session
+    if (session) lastForSession.set(session, index)
+  }
+  const tools = rows.map((row, index) => {
+    const session = runtimeSubagentOf(row.part)?.session
+    return toolOf(row.part, row.request, input, row.status, !!session && lastForSession.get(session) === index)
+  })
+  return linkBackground(tools, rows.map((r) => r.part), backgroundNoticesOf(input.messages, input.parts))
+}
+
+/** Joins background dispatches with their `background_output` calls and notices, by `bg_…` id.
+ *  A retry runs the same task in a new child session: the newest session id seen for the id wins. */
+const linkBackground = (tools: RuntimeTool[], parts: ToolPart[], notices: Map<string, BackgroundNotice>): RuntimeTool[] => {
+  const retrieved = new Map<string, { request: number; at: number }>()
+  const results = new Map<string, string>()
+  const latestSession = new Map<string, string>()
+  const agentOf = new Map<string, { agent: string; description: string }>()
+  tools.forEach((t, i) => {
+    const id = t.child?.backgroundTaskId ?? t.retrieves?.taskId
+    if (!id) return
+    const session = str(metaOf(parts[i])?.sessionId) ?? t.child?.sessionID
+    if (session) latestSession.set(id, session)
+    if (t.child) agentOf.set(id, { agent: t.child.agent, description: t.child.description })
+    // The first call that got the result counts (see `retrievalOf`).
+    const s = parts[i].state
+    if (t.retrieves && retrievalOf(parts[i])?.retrieved && s.status === "completed" && !retrieved.has(id)) {
+      const out = s.output
+      const plain = resultKindOf(parts[i]) === "plain"
+      retrieved.set(id, { request: t.request, at: s.time.end })
+      // Drop the heading (and oh-my-openagent's metadata lines up to the first blank line / the "## Messages" title).
+      const body = plain
+        ? out.replace(/^\s*Task Result[^\n]*\n(?:[^\n]+\n)*?\s*\n/i, "")
+        : out.replace(/^[\s\S]*?^## Messages[^\n]*\n/im, "")
+      results.set(id, body.trim() || out.trim())
+    }
+  })
+  return tools.map((t) => {
+    if (t.retrieves) {
+      const owner = agentOf.get(t.retrieves.taskId)
+      const retrieves = owner && !t.retrieves.agent ? { ...t.retrieves, agent: owner.agent, description: owner.description } : t.retrieves
+      // The raw input is `{ task_id, … }`; the task's description says more.
+      return { ...t, retrieves, input: retrieves.description || retrieves.taskId }
+    }
+    const id = t.child?.backgroundTaskId
+    if (!t.child || !id) return t
+    const session = latestSession.get(id)
+    const got = retrieved.get(id)
+    const notice = notices.get(id)
+    const result = results.get(id)
+    if (session === t.child.sessionID && !got && !notice) return t
+    return {
+      ...t,
+      child: {
+        ...t.child,
+        ...(session ? { sessionID: session } : {}),
+        ...(got ? { retrieved: got } : {}),
+        ...(notice ? { notice } : {}),
+        ...(result ? { result } : {}),
+      },
+    }
+  })
+}
+
+const rawTokens = (r: TrajectoryRequest): RuntimeTokens => {
+  const t = r.message.tokens
+  return {
+    input: t?.input ?? 0,
+    output: t?.output ?? 0,
+    reasoning: t?.reasoning ?? 0,
+    cacheRead: t?.cache?.read ?? 0,
+    cacheWrite: t?.cache?.write ?? 0,
+  }
+}
+const tokenTotal = (t: RuntimeTokens) => t.input + t.output + t.reasoning + t.cacheRead + t.cacheWrite
+
+const requestOf = (r: TrajectoryRequest): RuntimeRequest => {
+  const cancelled = messageAborted(r.message)
+  const settled = r.status === "done" || r.status === "error"
+  const raw = rawTokens(r)
+  const known = settled && tokenTotal(raw) > 0
+  const agent = r.message.mode || undefined
+  const model =
+    r.message.providerID && r.message.modelID
+      ? { providerID: r.message.providerID, modelID: r.message.modelID }
+      : undefined
+  const cost = typeof r.message.cost === "number" && r.message.cost > 0 ? r.message.cost : undefined
+  return {
+    index: r.index,
+    messageID: r.message.id,
+    turn: r.turn,
+    start: r.start,
+    firstToken: r.firstToken,
+    end: r.end,
+    status: r.status,
+    cancelled,
+    evidence: r.status === "interrupted" ? "inferred" : "event",
+    error: r.error,
+    settled,
+    known,
+    tokens: known ? raw : undefined,
+    ...(agent !== undefined ? { agent } : {}),
+    ...(model !== undefined ? { model } : {}),
+    ...(cost !== undefined ? { cost } : {}),
+  }
+}
+
+const usageOf = (requests: RuntimeRequest[], limit: number | undefined): RuntimeUsage => {
+  const known = requests.filter((r) => r.known)
+  const sum = known.reduce<RuntimeTokens>(
+    (a, r) => ({
+      input: a.input + r.tokens!.input,
+      output: a.output + r.tokens!.output,
+      reasoning: a.reasoning + r.tokens!.reasoning,
+      cacheRead: a.cacheRead + r.tokens!.cacheRead,
+      cacheWrite: a.cacheWrite + r.tokens!.cacheWrite,
+    }),
+    { input: 0, output: 0, reasoning: 0, cacheRead: 0, cacheWrite: 0 },
+  )
+  const last = known[known.length - 1]?.tokens
+  return {
+    requests: requests.length,
+    knownRequests: known.length,
+    settled: requests.every((r) => r.settled),
+    tokens: known.length ? sum : undefined,
+    context: { used: last ? last.input + last.cacheRead + last.cacheWrite : undefined, limit },
+  }
+}
+
+const stageOf = (run: RuntimeRun, requests: RuntimeRequest[], tools: RuntimeTool[]): Stage => {
+  if (run.state === "idle" || run.state === "error" || run.state === "unknown") return "idle"
+  const last = requests[requests.length - 1]
+  if (!last) return "prepare"
+  if (tools.some((t) => t.request === last.index && (t.state === "pending" || t.state === "running"))) return "tools"
+  if (last.status === "running") return last.firstToken !== undefined ? "model" : "prepare"
+  return tools.some((t) => t.request === last.index) ? "fill" : "prepare"
+}
+
+const focusOf = (run: RuntimeRun, stage: Stage, requests: RuntimeRequest[], tools: RuntimeTool[]): RuntimeFocus => {
+  if (run.attention.length) return { kind: "attention", attention: run.attention[0] }
+  if (run.retry) return { kind: "retry", ...run.retry }
+  const last = requests[requests.length - 1]
+  if (last?.cancelled && run.state === "idle") return { kind: "cancelled" }
+  if (run.state === "error" || (run.state === "idle" && last?.status === "error"))
+    return { kind: "error", message: last?.error ?? "" }
+  if (run.state === "working") {
+    const active = tools.filter((t) => !t.interrupted && (t.state === "pending" || t.state === "running"))
+    return { kind: "working", stage, tool: active[active.length - 1] }
+  }
+  if (last?.status === "interrupted") return { kind: "interrupted" }
+  return last ? { kind: "done" } : { kind: "idle" }
+}
+
+const eventsOf = (requests: RuntimeRequest[], tools: RuntimeTool[]): RuntimeEvent[] => {
+  const list: RuntimeEvent[] = []
+  for (const r of requests) {
+    list.push({ id: `${r.messageID}:start`, at: r.start, role: "model", kind: "request.start", label: "", request: r.index })
+    if (r.end !== undefined && r.settled)
+      list.push({
+        id: `${r.messageID}:end`,
+        at: r.end,
+        role: "model",
+        kind: r.status === "error" ? (r.cancelled ? "request.cancelled" : "request.error") : "request.end",
+        label: "",
+        request: r.index,
+      })
+  }
+  for (const t of tools) {
+    const role = t.child || t.retrieves?.agent ? "subagent" : "tool"
+    const label = t.child ? t.child.agent : (t.retrieves?.agent ?? t.name)
+    if (t.start !== undefined)
+      list.push({ id: `${t.id}:start`, at: t.start, role, kind: "tool.start", label, request: t.request })
+    if (t.end !== undefined)
+      list.push({ id: `${t.id}:end`, at: t.end, role, kind: t.declined ? (`tool.${t.declined}` as const) : t.state === "error" ? "tool.error" : "tool.end", label, request: t.request })
+  }
+  return list
+    .map((e, i) => ({ e, i }))
+    .sort((a, b) => a.e.at - b.e.at || a.i - b.i)
+    .map((x) => x.e)
+}
+
+const freshnessOf = (input: RuntimeInput, events: RuntimeEvent[], now: number): RuntimeFreshness => {
+  if (input.mode === "replay") return { observedAt: now, evidence: "inferred" }
+  const data = events.length ? events[events.length - 1].at : undefined
+  const arrival = input.lastEventAt
+  if (arrival === undefined && data === undefined) return { observedAt: now, evidence: "inferred" }
+  const useArrival = arrival !== undefined && (data === undefined || arrival >= data)
+  return {
+    observedAt: now,
+    lastEventAt: useArrival ? arrival : data,
+    lastEventSource: useArrival ? "arrival" : "data",
+    evidence: "inferred",
+  }
+}
+
+/** Merges freshness from data events with arrival time recorded in-app. Undefined in replay. */
+export function mergeFreshness(
+  freshness: RuntimeFreshness,
+  arrivedAt: number | undefined,
+  mode: "live" | "replay",
+): RuntimeFreshness {
+  if (mode === "replay") return { observedAt: freshness.observedAt, evidence: "inferred" }
+  const data = freshness.lastEventAt
+  if (arrivedAt === undefined && data === undefined) return { observedAt: freshness.observedAt, evidence: "inferred" }
+  const useArrival = arrivedAt !== undefined && (data === undefined || arrivedAt >= data)
+  return {
+    observedAt: freshness.observedAt,
+    lastEventAt: useArrival ? arrivedAt : data,
+    lastEventSource: useArrival ? "arrival" : "data",
+    evidence: "inferred",
+  }
+}
+
+const childSessionState = (lifecycle: ChildLifecycle): RunState => {
+  switch (lifecycle) {
+    case "running":
+      return "working"
+    case "retrying":
+      return "retrying"
+    case "waiting-user":
+      return "waiting-user"
+    case "done":
+    case "cancelled":
+      return "idle"
+    case "error":
+      return "error"
+    case "unknown":
+      return "unknown"
+  }
+}
+
+const sessionsOf = (input: RuntimeInput, run: RuntimeRun, tools: RuntimeTool[]): RuntimeSession[] => {
+  const list: RuntimeSession[] = [{ id: input.sessionID, kind: "root", state: run.state, evidence: run.evidence }]
+  const seen = new Set<string>([input.sessionID])
+  for (const t of tools) {
+    const c = t.child
+    if (!c?.sessionID || seen.has(c.sessionID)) continue
+    seen.add(c.sessionID)
+    list.push({
+      id: c.sessionID,
+      kind: "child",
+      agent: c.agent,
+      state: childSessionState(c.lifecycle),
+      evidence: c.evidence,
+    })
+  }
+  return list
+}
+
+/** Session an event belongs to: session.status / message.part.delta carry `sessionID`, message.updated carries
+ *  `info.sessionID`, message.part.updated carries `part.sessionID`. Events without one (heartbeats) are ignored. */
+export function eventSessionID(details: unknown): string | undefined {
+  const p = (details as { properties?: Record<string, any> } | undefined)?.properties
+  const id = p?.sessionID ?? p?.info?.sessionID ?? p?.part?.sessionID
+  return typeof id === "string" ? id : undefined
+}
+
+/** Descendant session IDs of `sessionID`, walking `sessions` by `parentID`. Root is included in the returned set. */
+export function treeSessionIDs(sessionID: string, sessions: Session[]): Set<string> {
+  const map = new Map<string, string[]>()
+  for (const item of sessions) {
+    if (!item.parentID) continue
+    const list = map.get(item.parentID)
+    if (list) list.push(item.id)
+    else map.set(item.parentID, [item.id])
+  }
+  const ids = [sessionID]
+  const seen = new Set(ids)
+  for (const id of ids) {
+    const list = map.get(id)
+    if (!list) continue
+    for (const child of list) {
+      if (seen.has(child)) continue
+      seen.add(child)
+      ids.push(child)
+    }
+  }
+  return seen
+}
+
+/** Collects pending permissions and questions for a root session and all its descendant sessions. */
+export function collectTreeRequests(
+  sessionID: string,
+  sessions: Session[],
+  permissionMap: Record<string, PermissionRequest[] | undefined>,
+  questionMap: Record<string, QuestionRequest[] | undefined>,
+): { permissions: PermissionRequest[]; questions: QuestionRequest[] } {
+  const ids = treeSessionIDs(sessionID, sessions)
+  const permissions: PermissionRequest[] = []
+  const questions: QuestionRequest[] = []
+  for (const id of ids) {
+    const p = permissionMap[id]
+    if (p) permissions.push(...p)
+    const q = questionMap[id]
+    if (q) questions.push(...q)
+  }
+  return { permissions, questions }
+}
+
+export function buildRuntime(input: RuntimeInput, now: number): RuntimeModel {
+  const requests = input.requests.map(requestOf)
+  const tools = toolsOf(input)
+  const run = runOf(input)
+  const stage = stageOf(run, requests, tools)
+  const events = eventsOf(requests, tools)
+  return {
+    mode: input.mode,
+    freshness: freshnessOf(input, events, now),
+    run,
+    stage,
+    focus: focusOf(run, stage, requests, tools),
+    sessions: sessionsOf(input, run, tools),
+    requests,
+    tools,
+    events,
+    usage: usageOf(requests, input.contextLimit),
+    roundStart: roundStartOf(input),
+  }
+}
+
+const partStart = (part: Part, fallback: number): number => {
+  if (part.type === "tool") {
+    return part.state.status === "pending" ? (idTime(part.id, fallback) ?? fallback) : part.state.time.start
+  }
+  const start = (part as { time?: { start?: number } }).time?.start
+  return start ?? idTime(part.id, fallback) ?? fallback
+}
+
+const rewind = (part: Part, cursor: number): Part => {
+  if (part.type !== "tool") return part
+  const s = part.state
+  if ((s.status === "completed" || s.status === "error") && s.time.end > cursor) {
+    const meta = "metadata" in s ? (s.metadata as Record<string, unknown> | undefined) : undefined
+    // Keep what identifies a subagent row (child session, background task, agent); drop the rest of the result.
+    const kept: Record<string, unknown> = {}
+    for (const key of ["sessionId", "backgroundTaskId", "agent", "description"])
+      if (typeof meta?.[key] === "string") kept[key] = meta[key]
+    return {
+      ...part,
+      state: {
+        status: "running",
+        input: s.input,
+        time: { start: s.time.start },
+        ...(Object.keys(kept).length ? { metadata: kept } : {}),
+      },
+    }
+  }
+  return part
+}
+
+/** The session as it was at `cursor`: nothing created after it is visible, and anything that finished after it is
+ *  shown still running. Items without a start time use the id's embedded time, then their message's.
+ *  inFlightMessageID: optional ID of a live in-flight assistant message. When present in the snapshot (created <= cursor)
+ *  and lacking time.completed, busy is true (it is open at the cursor). Pure and testable; replay never reads busy() itself. */
+export function snapshotAt(
+  messages: Message[],
+  parts: (messageID: string) => Part[],
+  cursor: number,
+  inFlightMessageID?: string,
+) {
+  const kept: Message[] = []
+  const visible = new Map<string, Part[]>()
+  let busy = false
+  for (const m of messages) {
+    if (m.time.created > cursor) continue
+    if (m.role === "assistant" && m.time.completed !== undefined && m.time.completed > cursor) {
+      kept.push({ ...m, time: { created: m.time.created }, finish: undefined, error: undefined } as Message)
+      busy = true
+    } else {
+      kept.push(m)
+      if (
+        inFlightMessageID !== undefined &&
+        m.id === inFlightMessageID &&
+        m.role === "assistant" &&
+        m.time.completed === undefined
+      ) {
+        busy = true
+      }
+    }
+    const list: Part[] = []
+    for (const p of parts(m.id)) {
+      if (partStart(p, m.time.created) > cursor) continue
+      list.push(rewind(p, cursor))
+    }
+    visible.set(m.id, list)
+  }
+  return { messages: kept, parts: (messageID: string) => visible.get(messageID) ?? [], busy }
+}
+
+/** Id of the live in-flight assistant message. Only the last assistant message counts:
+ *  it must have no time.completed, and the session must be busy. An earlier unfinished
+ *  assistant is not in flight once a later assistant has completed. */
+export function inFlightOf(messages: readonly Message[], busy: boolean): string | undefined {
+  if (!busy) return undefined
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const message = messages[i]
+    if (message.role !== "assistant") continue
+    return message.time.completed === undefined ? message.id : undefined
+  }
+  return undefined
+}
