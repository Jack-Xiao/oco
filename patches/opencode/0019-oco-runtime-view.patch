+    if (fixOpen && fin) {
+      fixIds.push(id)
+      fixRoot = rootTimes.length
+      fixNav = navTools.length
+    } else fixOpen = false
+    mi++
+  }
+
+  for (const m of sortedMessages(input.messages)) {
+    const created = m.time.created
+    if (m.role === "user") {
+      raw(created)
+      for (const c of applyBackgroundNotices(noticeState, m, parts)) {
+        let list = notices.get(c.id)
+        if (!list) notices.set(c.id, (list = []))
+        list.push({ at: created, kind: c.notice ?? "cleared" })
+      }
+      if (!isRealUserMessage(m.id, parts)) {
+        step(m.id, true, true)
+        continue
+      }
+      const texts = parts(m.id).filter((p): p is Extract<Part, { type: "text" }> => p.type === "text")
+      const text = (texts.find((p) => !p.synthetic) ?? texts[0])?.text ?? ""
+      const prevRound = rounds[rounds.length - 1]
+      round = {
+        n: ++realUsers,
+        userMessageID: m.id,
+        start: created,
+        text,
+        agent: display(m.agent),
+        requests: [],
+        prevHadTask: prevRound?.firstTask !== undefined,
+        changes: [],
+      }
+      rounds.push(round)
+      roundTasks = 0
+      step(m.id, true, true)
+      continue
+    }
+    if (!round) {
+      step(m.id, true, true)
+      continue
+    }
+    const a = m as AssistantMessage
+    const r = round
+    const old = settled.get(a.id)
+    const st: RingStepTimes | undefined = input.steps?.(a.id)
+    const kept = old && REQ_AUX.get(old)
+    const same =
+      !!old &&
+      !!kept &&
+      old.round === r.n &&
+      old.m === r.requests.length + 1 &&
+      old.created === created &&
+      old.completed === a.time.completed &&
+      !!old.error === !!a.error &&
+      kept.agent === a.agent &&
+      kept.roundAgent === r.agent &&
+      kept.provider === a.providerID &&
+      kept.model === a.modelID &&
+      kept.parts === parts(a.id).length &&
+      kept.steps === stepCount(st)
+    if (old && kept && same && kept.reuse) {
+      rootTimes.push(...kept.times)
+      if (kept.lo !== undefined && (firstAt === undefined || kept.lo < firstAt)) firstAt = kept.lo
+      if (kept.hi !== undefined && (lastAt === undefined || kept.hi > lastAt)) lastAt = kept.hi
+      for (const [id, end] of kept.got) {
+        const was = retrieved.get(id)
+        if (was === undefined || end < was) retrieved.set(id, end)
+      }
+      r.requests.push(old)
+      for (const x of old.tools) {
+        if (x.start !== undefined) navTools.push(x.start)
+        if (x.end !== undefined) navTools.push(x.end)
+      }
+      step(a.id, true, true)
+      continue
+    }
+    const t0 = rootTimes.length
+    reqLo = reqHi = undefined
+    const gots: ReqAux["got"] = []
+    const req: RingRequest = {
+      messageID: a.id,
+      round: r.n,
+      m: r.requests.length + 1,
+      created,
+      agent: display(a.agent || r.agent),
+      model: `${a.providerID}/${a.modelID}`,
+      think: [],
+      texts: [],
+      tools: [],
+    }
+    raw(created)
+    if (a.time.completed !== undefined) {
+      req.completed = a.time.completed
+      raw(a.time.completed)
+    }
+    if (a.error) {
+      const data = (a.error as { data?: { message?: unknown } }).data
+      req.error = { name: a.error.name, message: str(data?.message) ?? "" }
+    }
+    const ps = parts(a.id)
+    const ats = ps.map((p) => partAt(p, created))
+    const later = laterMin(ats)
+    let own = 0
+    ps.forEach((p, i) => {
+      const pat = ats[i]
+      if (p.type === "step-start") {
+        if (req.stepStart === undefined) req.stepStart = pat
+        raw(pat)
+      } else if (p.type === "reasoning" || p.type === "text") {
+        const span: RingSpan = { partID: p.id, start: pat, text: p.text }
+        const end = spanEnd(p, later[i], a.time.completed)
+        if (end !== undefined) span.end = end
+        ;(p.type === "text" ? req.texts : req.think).push(span)
+        raw(pat)
+        raw(span.end)
+      } else if (p.type === "tool") {
+        const tool = toolOf(p, a.id, pat)
+        raw(pat)
+        raw(tool.start)
+        raw(tool.end)
+        rootTimes.push(pat + RING.EMIT_MS)
+        if (tool.start !== undefined) rootTimes.push(tool.start + RING.EMIT_MS)
+        if (tool.kind === "tool") tool.slot = own++
+        if (tool.kind === "task") {
+          tool.slot = roundTasks++
+          if (r.firstTask === undefined || pat < r.firstTask) r.firstTask = pat
+          const sub = subOf(p, tool, r.n, req.m, req.agent)
+          if (sub.sessionID) {
+            const child = childFor(sub.sessionID)
+            if (child) sub.child = child
+          }
+          const taskId = backgroundIdOf(p)
+          if (taskId) bgSubs.push({ sub, taskId })
+          tool.sub = sub
+          subs.push(sub)
+        }
+        if (tool.name === "todowrite") plans.push(tool)
+        const got = retrievalOf(p)
+        if (got?.retrieved && tool.end !== undefined) {
+          const was = retrieved.get(got.taskId)
+          if (was === undefined || tool.end < was) retrieved.set(got.taskId, tool.end)
+          gots.push([got.taskId, tool.end])
+        }
+        req.tools.push(tool)
+      } else if (p.type === "step-finish") {
+        req.finish = finishOf(pat, p.reason, p.cost, p.tokens)
+        raw(pat)
+      }
+    })
+    // D21: the app's sync layer drops step-start / step-finish parts (SKIP_PARTS); their times reach the ring through
+    // the side table (input.steps), recorded at the drop points for live events and REST history alike, so a reopened
+    // session reads the same as live. Sent = the earliest known of: a step-start part, the side-table start, the first
+    // part of any kind (upstream processor.ts may run a tool before start-step). The minimum over times <= t is the same
+    // for every cut that holds the earliest one, so the frame at t comes from data <= t. Receipt: a step-finish part,
+    // else the side table's last step-finish, else the message's own receipt once it completed (at = completed).
+    if (st) {
+      if (st.start !== undefined) {
+        const s = snapStepTime(st.start, created)
+        raw(s)
+        if (req.stepStart === undefined || s < req.stepStart) req.stepStart = s
+      }
+      for (const f of st.finishes) raw(snapStepTime(f.at, created))
+      const f = lastStepFinish(st)
+      if (!req.finish && f) req.finish = finishOf(snapStepTime(f.at, created), f.reason, f.cost, f.tokens)
+    }
+    if (ats.length) {
+      const first = ats.reduce((x, y) => Math.min(x, y))
+      if (req.stepStart === undefined || first < req.stepStart) req.stepStart = first
+    }
+    if (!req.finish && a.finish !== undefined && a.time.completed !== undefined)
+      req.finish = finishOf(a.time.completed, a.finish, a.cost, a.tokens)
+    if (
+      req.completed !== undefined &&
+      req.finish !== undefined &&
+      req.tools.every((x) => x.end !== undefined) &&
+      req.think.every((x) => x.end !== undefined) &&
+      req.texts.every((x) => x.end !== undefined)
+    )
+      REQ_AUX.set(req, {
+        reuse: !req.tools.some((x) => x.kind === "task" || x.name === "todowrite"),
+        parts: ps.length,
+        steps: stepCount(st),
+        agent: a.agent,
+        roundAgent: r.agent,
+        provider: a.providerID,
+        model: a.modelID,
+        times: rootTimes.slice(t0),
+        lo: reqLo,
+        hi: reqHi,
+        got: gots,
+      })
+    r.requests.push(req)
+    for (const x of req.tools) {
+      if (x.start !== undefined) navTools.push(x.start)
+      if (x.end !== undefined) navTools.push(x.end)
+    }
+    step(a.id, REQ_AUX.has(req), same)
+  }
+
+  for (const { sub, taskId } of bgSubs) {
+    const bg: NonNullable<RingSub["background"]> = { taskId, notices: [...(notices.get(taskId) ?? [])] }
+    const got = retrieved.get(taskId)
+    if (got !== undefined) bg.retrievedAt = got
+    sub.background = bg
+  }
+  subs.sort((a, b) => a.created - b.created)
+  plans.sort((a, b) => a.created - b.created)
+  plans.forEach((x, i) => (x.planVersion = i + 1))
+  const before = new Map<string, { round: RingRound; lim: number }>()
+  prev?.rounds.forEach((r, i, all) => before.set(r.userMessageID, { round: r, lim: all[i + 1]?.start ?? Infinity }))
+  rounds.forEach((r, i) => (r.changes = changesOf(r, rounds[i + 1], before.get(r.userMessageID))))
+
+  // the leading final run is sorted once and carried to the next rebuild (FIX); only the rest is sorted here
+  const usePf = !!pf && pfOk && fixIds.length >= pf.ids.length
+  const fix = {
+    ids: fixIds,
+    root: usePf ? mergeIn(pf.root, uniqueSorted(rootTimes.slice(pfRoot, fixRoot))) : uniqueSorted(rootTimes.slice(0, fixRoot)),
+    nav: usePf ? mergeIn(pf.nav, uniqueSorted(navTools.slice(pfNav, fixNav))) : uniqueSorted(navTools.slice(0, fixNav)),
+  }
+  const root = mergeIn(fix.root, uniqueSorted(rootTimes.slice(fixRoot)))
+  const index: RingIndex = {
+    sessionID: input.sessionID,
+    rounds,
+    subs,
+    plans,
+    times: mergeSorted(root, subTimes(subs)),
+    nav: mergeSorted(changeTimes(rounds), mergeIn(fix.nav, uniqueSorted(navTools.slice(fixNav)))),
+  }
+  if (firstAt !== undefined) index.firstAt = firstAt
+  if (lastAt !== undefined) index.lastAt = lastAt
+  ROOT_TIMES.set(index, root)
+  FIX.set(index, fix)
+  return index
+}
+
+function subTimes(subs: readonly RingSub[]) {
+  const out: number[] = []
+  for (const s of subs) {
+    if (s.child) childTimes(s.child, out)
+    if (s.background) {
+      for (const n of s.background.notices) out.push(n.at)
+      if (s.background.retrievedAt !== undefined) out.push(s.background.retrievedAt)
+    }
+  }
+  return uniqueSorted(out)
+}
+
+/** Change times of all rounds: ascending already (each round's points lie in [start, next start)), checked. */
+function changeTimes(rounds: readonly RingRound[]) {
+  const out: number[] = []
+  for (const r of rounds) for (const c of r.changes) out.push(c.t)
+  for (let i = 1; i < out.length; i++) if (!(out[i] > out[i - 1])) return uniqueSorted(out)
+  return out
+}
+
+/** Root unchanged (not in dirty): only the dirty children are rebuilt; the path to each changed sub is copied. */
+function patchChildren(input: RingIndexInput, prev: RingIndex, rootTimes: readonly number[]): RingIndex {
+  const dirty = input.dirty!
+  const swap = new Map<RingSub, RingSub>()
+  const rebuilt = new Map<string, RingChild | undefined>()
+  for (const s of prev.subs) {
+    if (!s.sessionID || !dirty.has(s.sessionID)) continue
+    if (!rebuilt.has(s.sessionID)) {
+      const src = input.child(s.sessionID)
+      rebuilt.set(s.sessionID, src ? childOf(src) : undefined)
+    }
+    const child = rebuilt.get(s.sessionID)
+    const { child: _old, ...rest } = s
+    swap.set(s, child ? { ...rest, child } : rest)
+  }
+  if (!swap.size) return prev
+  const rounds = prev.rounds.slice()
+  for (const [old, next] of swap) {
+    const ri = old.round - 1
+    const r = rounds[ri]
+    const qi = old.request - 1
+    const q = r.requests[qi]
+    const tools = q.tools.map((x) => (x.sub === old ? { ...x, sub: next } : x))
+    const requests = r.requests.slice()
+    const copy = { ...q, tools }
+    const aux = REQ_AUX.get(q)
+    if (aux) REQ_AUX.set(copy, aux) // same message and times; a task request is never reused as an object
+    requests[qi] = copy
+    rounds[ri] = { ...r, requests }
+  }
+  const subs = prev.subs.map((s) => swap.get(s) ?? s)
+  const index: RingIndex = { ...prev, rounds, subs, times: mergeSorted(rootTimes, subTimes(subs)) }
+  ROOT_TIMES.set(index, rootTimes)
+  const fix = FIX.get(prev)
+  if (fix) FIX.set(index, fix) // root messages unchanged
+  return index
+}
+
+// ---------- stage (D5, D15; mockup L519-555) ----------
+const ANG: Partial<Record<RingStageId, number>> = {
+  say: 180,
+  asm: 180,
+  fly: 212,
+  think: 240,
+  out: 300,
+  call: 360,
+  wait: 420,
+  ask: 420,
+  next: 480,
+}
+
+/** The latest request of the round created at or before t. */
+function latestRequest(round: RingRound, t: number): RingRequest | undefined {
+  const i = lastLE(round.requests, t, (q) => q.created)
+  return i < 0 ? undefined : round.requests[i]
+}
+
+/** Stage inside one round given its latest request q (created <= t). D5 judges only q; live fallback only with live. */
+function evalStage(round: RingRound, q: RingRequest | undefined, t: number, live?: RingLiveInput): RingStage {
+  if (!q) return { st: "say", round }
+  if (q.error && at(q.completed, t)) return { st: "abort", round, request: q, endAt: q.completed, why: "abort" }
+  const dq = q.tools.find((x) => x.kind === "question" && declinedAt(x, t) === "dismissed")
+  if (dq) return { st: "end", round, request: q, endAt: dq.end, why: "dismiss", dismissed: dq }
+  const f = q.finish
+  if (f && f.at <= t && !LOOP_CONTINUE.includes(f.reason))
+    return { st: "end", round, request: q, endAt: at(q.completed, t) ? q.completed : f.at, why: "finish", reason: f.reason }
+  const s = runningStage(round, q, t, live)
+  if (
+    live &&
+    live.run === "idle" &&
+    !live.permissions.length &&
+    at(q.completed, t) &&
+    !q.tools.some((x) => x.created <= t && !at(x.end, t))
+  )
+    return { st: "end", round, request: q, endAt: q.completed, why: "idle" }
+  return s
+}
+
+function runningStage(round: RingRound, q: RingRequest, t: number, live?: RingLiveInput): RingStage {
+  if (q.finish && q.finish.at <= t) return { st: "next", round, request: q }
+  if (q.stepStart === undefined || t < q.stepStart) return { st: "asm", round, request: q }
+  const ask = q.tools.find((x) => x.kind === "question" && at(x.start, t) && !at(x.end, t))
+  if (ask) return { st: "ask", round, request: q, ask }
+  if (live?.permissions.length)
+    for (const x of q.tools) {
+      if (!at(x.start, t) || at(x.end, t)) continue
+      const permission = live.permissions.find((p) => p.callID === x.callID)
+      if (permission) return { st: "ask", round, request: q, permission }
+    }
+  let made = 0
+  let pending = false
+  let lastEmit = -Infinity
+  for (const x of q.tools) {
+    if (x.created > t) continue
+    made++
+    lastEmit = Math.max(lastEmit, x.created)
+    if (at(x.start, t)) lastEmit = Math.max(lastEmit, x.start)
+    else pending = true
+  }
+  if (pending || (made && t - lastEmit < RING.EMIT_MS)) return { st: "call", round, request: q }
+  if (q.think.some((x) => x.start <= t && !at(x.end, t))) return { st: "think", round, request: q }
+  if (q.texts.some((x) => x.start <= t && !at(x.end, t))) return { st: "out", round, request: q }
+  if (made) return { st: "wait", round, request: q }
+  let lt = -Infinity
+  let lx = -Infinity
+  for (const x of q.think) if (x.start <= t) lt = Math.max(lt, x.start)
+  for (const x of q.texts) if (x.start <= t) lx = Math.max(lx, x.start)
+  if (lx > -Infinity && lx >= lt) return { st: "out", round, request: q }
+  if (lt > -Infinity) return { st: "think", round, request: q }
+  return { st: "fly", round, request: q }
+}
+
+/** Stage-relevant facts of a request: two requests with equal keys have the same stage at every t. */
+const stageKey = (q: RingRequest) =>
+  JSON.stringify([
+    q.messageID, q.m, q.created, q.completed, q.stepStart, !!q.error, q.finish?.at, q.finish?.reason,
+    q.tools.map((x) => [x.kind, x.callID, x.created, x.start, x.end, x.declined]),
+    q.think.map((x) => [x.start, x.end]),
+    q.texts.map((x) => [x.start, x.end]),
+  ])
+const sameStage = (a: RingRequest, b: RingRequest) =>
+  a === b || (a.messageID === b.messageID && stageKey(a) === stageKey(b))
+
+/** Stage change points of one round: one sweep over the round's event times with a forward-only request cursor,
+ *  each point judged by the same request-local evaluator as stageAt (no live input; mockup L557-583).
+ *  With `was` (the same round in prev, D11): below `cut` the latest request is one whose stage facts did not change,
+ *  so prev's change points below `cut` are kept and the sweep resumes at `cut` from the last kept point (its st|ang
+ *  is the dedup key, its ang the running maximum), over the requests that can be latest at or after `cut`. Every
+ *  breakpoint of the stage at or after `cut` belongs to one of those requests, and a point that is not a breakpoint
+ *  never adds a change, so the result equals a full sweep. */
+function changesOf(round: RingRound, next: RingRound | undefined, was?: { round: RingRound; lim: number }): RingRound["changes"] {
+  const lim = next ? next.start : Infinity
+  const reqs = round.requests
+  const out: RingRound["changes"] = []
+  let prev = ""
+  let maxA = 180
+  let lo = round.start
+  let from = 0
+  if (was && was.round.start === round.start) {
+    const old = was.round.requests
+    let k = 0
+    while (k < reqs.length && k < old.length && sameStage(reqs[k], old[k])) k++
+    const cut = Math.min(reqs[k]?.created ?? Infinity, old[k]?.created ?? Infinity, lim, was.lim)
+    for (const c of was.round.changes) {
+      if (c.t >= cut) break
+      out.push(c)
+    }
+    const last = out[out.length - 1]
+    if (last) {
+      prev = last.st + "|" + last.ang
+      maxA = last.ang
+      lo = cut
+      from = Math.max(0, lastLE(reqs, cut, (q) => q.created))
+    }
+  }
+  const B: number[] = [lo]
+  for (let i = from; i < reqs.length; i++) {
+    const q = reqs[i]
+    B.push(q.created)
+    if (q.stepStart !== undefined) B.push(q.stepStart)
+    if (q.completed !== undefined) B.push(q.completed)
+    if (q.finish) B.push(q.finish.at)
+    for (const s of q.think) B.push(s.start, s.end ?? NaN)
+    for (const s of q.texts) B.push(s.start, s.end ?? NaN)
+    for (const x of q.tools) {
+      B.push(x.created, x.created + RING.EMIT_MS)
+      if (x.start !== undefined) B.push(x.start, x.start + RING.EMIT_MS)
+      if (x.end !== undefined) B.push(x.end)
+    }
+  }
+  const times = uniqueSorted(B).filter((v) => v >= lo && v < lim)
+  let j = from - 1
+  for (const b of times) {
+    while (j + 1 < reqs.length && reqs[j + 1].created <= b) j++
+    const S = evalStage(round, j >= 0 ? reqs[j] : undefined, b)
+    const fin = S.st === "end" || S.st === "abort"
+    const a = fin ? maxA : Math.max(maxA, 360 * ((S.request?.m ?? 1) - 1) + (ANG[S.st] ?? 180))
+    maxA = a
+    const key = S.st + "|" + a
+    if (key !== prev) {
+      out.push({ t: b, st: S.st, ang: a })
+      prev = key
+    }
+  }
+  return out
+}
+
+export function roundAt(index: RingIndex, t: number): RingRound | undefined {
+  const i = lastLE(index.rounds, t, (r) => r.start)
+  return i < 0 ? undefined : index.rounds[i]
+}
+
+export function stageAt(index: RingIndex, t: number, live?: RingLiveInput): RingStage {
+  const round = roundAt(index, t)
+  if (!round) return { st: "pre" }
+  return evalStage(round, latestRequest(round, t), t, live)
+}
+
+/** Lane openness k (mockup laneOpen L507-516): open from the start when the previous round had subagents, closes
+ *  over LANE_MS once this round starts, opens over LANE_MS from this round's first task call; smoothstep. */
+export function laneOpen(index: RingIndex, t: number, reduced: boolean): number {
+  const r = roundAt(index, t)
+  if (!r) return 0
+  const ft = at(r.firstTask, t) ? r.firstTask : undefined
+  if (reduced) return ft !== undefined ? 1 : 0
+  let v = r.prevHadTask ? 1 : 0
+  v = Math.max(0, v - ((ft ?? t) - r.start) / RING.LANE_MS)
+  if (ft !== undefined) v = Math.min(1, v + (t - ft) / RING.LANE_MS)
+  return v * v * (3 - 2 * v)
+}
+
+/** Tools dock openness (0 = header strip only). Round-scoped so it does not flap between requests: opens over LANE_MS
+ *  from the round's first tool call, closes over LANE_MS once the latest request has finished without calling any tool
+ *  (the round's final answer). A round that never calls a tool keeps the dock closed; smoothstep. */
+export function dockOpen(index: RingIndex, t: number, reduced: boolean): number {
+  const r = roundAt(index, t)
+  if (!r) return 0
+  const ft = r.requests.flatMap((q) => q.tools).reduce((min, x) => (x.created <= t && x.created < min ? x.created : min), Infinity)
+  if (ft === Infinity) return 0
+  const q = latestRequest(r, t)
+  const closeAt = q && q.created > ft && at(q.finish?.at, t) && !q.tools.some((x) => x.created <= t) ? q.finish!.at : undefined
+  if (reduced) return closeAt === undefined ? 1 : 0
+  const v = closeAt === undefined ? Math.min(1, (t - ft) / RING.LANE_MS) : Math.max(0, 1 - (t - closeAt) / RING.LANE_MS)
+  return v * v * (3 - 2 * v)
+}
+
+const planCount = (todos: readonly RingTodo[]) => ({
+  done: todos.filter((o) => o.status === "completed").length,
+  inProgress: todos.filter((o) => o.status === "in_progress").length,
+  total: todos.length,
+})
+
+/** D3: the plan at t is the latest todowrite whose arguments were written (start <= t). */
+export function planAt(
+  index: RingIndex,
+  t: number,
+): { tool: RingTool; done: number; inProgress: number; total: number } | undefined {
+  let best: RingTool | undefined
+  for (const x of index.plans) if (at(x.start, t) && (!best || x.start! >= best.start!)) best = x
+  return best ? { tool: best, ...planCount(best.todos ?? []) } : undefined
+}
+
+// ---------- per-index lookup tables (derived, kept out of the contract type) ----------
+type RoundAux = { finAt: number[]; finCost: number[]; questions: RingTool[]; tasks: RingTool[] }
+type Aux = { finAt: number[]; finTotal: number[]; rounds: RoundAux[] }
+const AUX = new WeakMap<RingIndex, Aux>()
+function auxOf(index: RingIndex): Aux {
+  const hit = AUX.get(index)
+  if (hit) return hit
+  const all: { at: number; total: number }[] = []
+  const rounds = index.rounds.map((r): RoundAux => {
+    const fins: { at: number; cost: number }[] = []
+    const questions: RingTool[] = []
+    const tasks: RingTool[] = []
+    for (const q of r.requests) {
+      if (q.finish) {
+        fins.push({ at: q.finish.at, cost: q.finish.cost })
+        all.push({ at: q.finish.at, total: q.finish.tokens.total })
+      }
+      for (const x of q.tools) {
+        if (x.kind === "question") questions.push(x)
+        else if (x.kind === "task") tasks.push(x)
+      }
+    }
+    fins.sort((a, b) => a.at - b.at)
+    let sum = 0
+    tasks.sort((a, b) => a.created - b.created)
+    return {
+      finAt: fins.map((f) => f.at),
+      finCost: fins.map((f) => (sum += f.cost)),
+      questions,
+      tasks,
+    }
+  })
+  all.sort((a, b) => a.at - b.at)
+  const aux: Aux = { finAt: all.map((f) => f.at), finTotal: all.map((f) => f.total), rounds }
+  AUX.set(index, aux)
+  return aux
+}
+
+// ---------- frame ----------
+type Facts = {
+  r?: RingRound
+  ri: number
+  q?: RingRequest
+  ended: boolean
+  endAt?: number
+  idle: number
+  ctx?: number
+  agent: string
+  own: RingTool[]
+  tc: Record<ToolRowState, number>
+  rejected: number
+  qsubs: RingTool[]
+  qsc: Record<SubState, number>
+  made: RingTool[]
+  nQ: number
+  nCall: number
+  rsubs: RingTool[]
+  sc: Record<SubState, number>
+  think?: RingSpan
+  text?: RingSpan
+  ask?: { x: RingTool; state: "writing" | "pending" | "dismissed" | "answered" }
+}
+const zeroTools = (): Record<ToolRowState, number> => ({ pend: 0, run: 0, ok: 0, err: 0 })
+const zeroSubs = (): Record<SubState, number> => ({ queued: 0, run: 0, docked: 0, done: 0, err: 0 })
+
+function factsOf(index: RingIndex, S: RingStage, t: number): Facts {
+  const aux = auxOf(index)
+  const r = S.round
+  const ri = r ? lastLE(index.rounds, t, (x) => x.start) : -1
+  const q = S.request
+  const ended = S.st === "end" || S.st === "abort"
+  const fi = lastLE(aux.finAt, t, (v) => v)
+  const F: Facts = {
+    r,
+    ri,
+    q,
+    ended,
+    endAt: S.endAt,
+    idle: ended && S.endAt !== undefined ? t - S.endAt : 0,
+    ctx: fi >= 0 ? aux.finTotal[fi] : undefined,
+    agent: r?.agent ?? "",
+    own: [],
+    tc: zeroTools(),
+    rejected: 0,
+    qsubs: [],
+    qsc: zeroSubs(),
+    made: [],
+    nQ: 0,
+    nCall: 0,
+    rsubs: [],
+    sc: zeroSubs(),
+  }
+  if (r && ri >= 0) {
+    const tasks = aux.rounds[ri].tasks
+    F.rsubs = tasks.slice(0, lastLE(tasks, t, (x) => x.created) + 1)
+    for (const x of F.rsubs) F.sc[subStateAt(x.sub!, t)!]++
+  }
+  if (q) {
+    for (const x of q.tools) {
+      if (x.created > t) continue
+      F.made.push(x)
+      if (x.kind === "question") F.nQ++
+      if (x.kind === "tool") {
+        F.own.push(x)
+        const s = toolStateAt(x, t)!
+        if (s === "err" && declinedAt(x, t)) F.rejected++
+        else F.tc[s]++
+      } else if (x.kind === "task") {
+        F.qsubs.push(x)
+        F.qsc[subStateAt(x.sub!, t)!]++
+      }
+    }
+    F.nCall = F.made.length - F.nQ
+    for (const s of q.think) if (s.start <= t) F.think = s
+    for (const s of q.texts) if (s.start <= t) F.text = s
+    const qx = q.tools.find((x) => x.kind === "question" && x.created <= t)
+    if (qx)
+      F.ask = {
+        x: qx,
+        state: !at(qx.start, t)
+          ? "writing"
+          : at(qx.end, t)
+            ? declinedAt(qx, t) === "dismissed"
+              ? "dismissed"
+              : "answered"
+            : "pending",
+      }
+  }
+  return F
+}
+
+/** D2: a span's text at t. Replay: nothing while it streams. Live: what has arrived. */
+function shownSpan(span: RingSpan, t: number, live: boolean) {
+  const ended = at(span.end, t)
+  return { text: ended || live ? span.text : "", streaming: !ended, ended }
+}
+
+function carriedOf(F: Facts, t: number) {
+  const q = F.q!
+  if (q.m === 1 || !F.r) return { kind: "msg" as const, n: 0, phrase: ph("ring.pill.sub.msg") }
+  const p = F.r.requests[q.m - 2]
+  const tools = p.tools.filter((x) => x.created <= t)
+  const subs = tools.filter((x) => x.kind === "task")
+  const glyph = (x: RingTool) =>
+    !at(x.end, t) ? "…" : declinedAt(x, t) ? "⊘" : x.status === "error" ? "✗" : "✓"
+  const list = tools
+    .filter((x) => x.kind === "tool")
+    .map((x) => `${x.name} ${glyph(x)}`)
+    .join(" · ")
+  const subsPhrase = subs.length
+    ? ph(subs.every((x) => glyph(x) !== "✗") ? "ring.card.req.subsOk" : "ring.card.req.subsErr", { n: subs.length })
+    : undefined
+  return { kind: "res" as const, n: tools.length, phrase: ph("ring.pill.sub.res", { n: tools.length }), list, subsPhrase }
+}
+const madeOf = (F: Facts) =>
+  F.nCall && F.nQ
+    ? ph("ring.pill.sub.mixed", { calls: F.nCall, asks: F.nQ })
+    : F.nQ
+      ? ph("ring.pill.sub.asks", { n: F.nQ })
+      : ph("ring.pill.sub.calls", { n: F.nCall })
+const ctxPhrase = (F: Facts) =>
+  F.ctx !== undefined ? ph("ring.model.ctx", { tok: { tok: F.ctx } }) : ph("ring.model.ctx.unknown")
+function waitBits(F: Facts): Phrase[] {
+  const own = F.own.length
+  const sub = F.qsubs.length
+  const back = F.tc.ok + F.tc.err + F.rejected
+  const got = F.qsc.done + F.qsc.err
+  const left = own - back + (sub - got)
+  const bits = [left > 0 ? ph("ring.wait.left", { n: left }) : ph("ring.wait.all")]
+  if (own)
+    bits.push(
+      F.tc.err
+        ? ph("ring.wait.tools.err", { back, all: own, err: F.tc.err })
+        : ph("ring.wait.tools", { back, all: own }),
+    )
+  if (sub) bits.push(ph("ring.wait.subs", { got, all: sub }))
+  return bits
+}
+function newestDone(q: RingRequest, t: number) {
+  let best: RingTool | undefined
+  for (const x of q.tools)
+    // a background task's own end only hands back its task id; it is not a return (D16)
+    if (x.kind !== "question" && !x.sub?.background && at(x.end, t) && (!best || x.end >= best.end!)) best = x
+  return best && t - best.end! < RING.RECENT_MS ? best : undefined
+}
+const STATION: Partial<Record<RingStageId, PillId>> = {
+  say: "asm",
+  asm: "asm",
+  think: "think",
+  out: "out",
+  call: "call",
+  wait: "wait",
+  ask: "wait",
+  next: "next",
+}
+
+function statusOf(S: RingStage, live?: RingLiveInput): RingFrame["status"] {
+  const derived =
+    S.st === "pre" || S.st === "end" || S.st === "abort" ? "idle" : S.st === "ask" ? "waiting-user" : "working"
+  const state = live ? live.run : derived
+  if (live?.permissions.length) return { word: ph("ring.status.permission"), tone: "attn", state }
+  if (live?.run === "retrying") return { word: ph("state.retrying"), tone: "attn", state }
+  if (S.st === "pre") return { word: ph("state.idle"), tone: "faint", state }
+  if (S.st === "ask") return { word: ph("ring.status.ask"), tone: "attn", state }
+  if (S.st === "end") return { word: ph("ring.status.end"), tone: "ok", state }
+  if (S.st === "abort") return { word: ph("ring.status.abort"), tone: "err", state }
+  return { word: ph("ring.status.running"), tone: "sub", state }
+}
+
+function pillsOf(S: RingStage, F: Facts, t: number, live: boolean): RingPills {
+  const lit = STATION[S.st]
+  const pills: RingPills = {
+    asm: { lit: lit === "asm" },
+    think: { lit: lit === "think" },
+    out: { lit: lit === "out" },
+    call: { lit: lit === "call" },
+    wait: { lit: lit === "wait" },
+    next: { lit: lit === "next" },
+  }
+  const q = F.q
+  if (!q || F.ended) return pills
+  pills.asm.sub = carriedOf(F, t).phrase
+  if (F.think) pills.think.sub = ph("ring.pill.sub.waited", { dur: ms(Math.min(t, F.think.end ?? t) - F.think.start) })
+  if (F.text) {
+    const s = shownSpan(F.text, t, live)
+    if (s.ended || live) pills.out.sub = ph("ring.pill.sub.chars", { n: codePoints(s.text) })
+  }
+  if (F.made.length) pills.call.sub = F.nCall ? madeOf(F) : ph("ring.pill.sub.asks", { n: F.nQ })
+  if (S.st === "ask" && S.ask) pills.wait.sub = ph("ring.pill.sub.waited", { dur: ms(t - S.ask.start!) })
+  else if (F.made.length && (S.st === "wait" || S.st === "call" || S.st === "next"))
+    pills.wait.sub = ph("ring.pill.sub.flow", {
+      run: F.tc.run + F.qsc.run + F.qsc.docked,
+      back: F.tc.ok + F.tc.err + F.rejected + F.qsc.done + F.qsc.err,
+    })
+  return pills
+}
+
+const PIPS = 10
+function counterOf(index: RingIndex, S: RingStage, F: Facts, t: number): RingCounter {
+  const p = planAt(index, t)
+  const plan = p
+    ? { done: p.done, inProgress: p.inProgress, total: p.total, items: (p.tool.todos ?? []).map((o) => ({ text: o.text, status: o.status })) }
+    : undefined
+  const r = F.r
+  if (!r) return { agent: F.agent, ended: false, requests: [], ...(plan ? { plan } : {}) }
+  const m = F.q?.m
+  const n = F.q ? F.q.m : 0
+  // only the newest PIPS requests (the view draws "…" when requests[0].m > 1); frameAt never walks the round
+  const requests = r.requests.slice(Math.max(0, n - PIPS), n).map((x) => ({
+    m: x.m,
+    state: (x.error && at(x.completed, t) ? "bad" : x.m === m && !F.ended ? "cur" : "done") as "done" | "cur" | "bad",
+  }))
+  const out: RingCounter = { agent: F.agent, round: r.n, ended: F.ended, requests }
+  if (m !== undefined) out.m = m
+  if (plan) out.plan = plan
+  return out
+}
+
+function modelOf(S: RingStage, F: Facts, t: number, live: boolean): RingModelBox {
+  const q = F.q
+  const got = !!q?.finish && q.finish.at <= t
+  const ctx = got ? ph("ring.model.ctx.above") : ctxPhrase(F)
+  const box = (line: Phrase, tone: Tone): RingModelBox => {
+    const out: RingModelBox = {
+      model: q?.model ?? "",
+      line,
+      tone,
+      ctx,
+      lit: S.st === "fly" || S.st === "think" || S.st === "out" || S.st === "call",
+    }
+    if (q) {
+      out.m = q.m
+      out.carry = carriedOf(F, t).phrase // the view composes ring.model.carry with ctx
+    }
+    return out
+  }
+  if (!q) return box(ph("ring.model.waiting"), "faint")
+  switch (S.st) {
+    case "asm":
+      return box(ph("ring.model.asm", { m: q.m }), "faint")
+    case "fly":
+      return box(ph("ring.model.fly", { dur: ms(t - (q.stepStart ?? t)) }), "main")
+    case "think":
+      return box(ph("ring.model.think", { dur: ms(t - (F.think?.start ?? t)) }), "acc")
+    case "out": {
+      const s = F.text ? shownSpan(F.text, t, live) : undefined
+      return s && (s.ended || live)
+        ? box(ph("ring.model.out", { n: codePoints(s.text) }), "text")
+        : box(ph("ring.model.out.dur", { dur: ms(t - (F.text?.start ?? t)) }), "text")
+    }
+    case "call":
+      return F.nCall ? box(ph("ring.model.call", { made: madeOf(F) }), "tool") : box(ph("ring.model.call.ask"), "attn")
+    case "wait":
+      return box(ph("ring.model.wait"), "faint")
+    case "ask":
+      return box(ph("ring.model.ask"), "attn")
+    case "next":
+    case "end": {
+      const f = q.finish
+      if (!f || f.at > t) return box(ph("ring.model.done"), "faint")
+      return box(
+        ph("ring.model.receipt", {
+          total: { tok: f.tokens.total },
+          in: { tok: f.tokens.input + f.tokens.cacheRead + f.tokens.cacheWrite },
+          out: { tok: f.tokens.output + f.tokens.reasoning },
+          cost: { usd: f.cost },
+        }),
+        "faint",
+      )
+    }
+    case "abort":
+      return box(ph("ring.model.aborted", { m: q.m }), "err")
+  }
+  return box(ph("ring.model.waiting"), "faint")
+}
+
+function card(kind: RingCard["kind"], tone: Tone, from: RingCard["from"], to: RingCard["to"], extra: Partial<RingCard> = {}): RingCard {
+  return { kind, tone, from, to, body: "", bodyMode: "head", mono: false, streaming: false, meta: [], ...extra }
+}
+const latin = (s: string) => {
+  const a = [...s.slice(0, 240)]
+  return a.length > 0 && a.filter((c) => c.codePointAt(0)! < 0x2e80).length > a.length * 0.85
+}
+/** D8: kinds whose body can open the full-text overlay. */
+const FULL = new Set<RingCard["kind"]>(["think", "output", "result", "failed", "return", "handoff", "ask", "permission"])
+
+function planCardOf(S: RingStage, F: Facts, t: number, live: boolean): RingCard | undefined {
+  const q = F.q
+  if (!q) return undefined
+  let x: RingTool | undefined
+  let via: "cur" | "carry" | undefined
+  if (S.st === "call" || S.st === "wait" || S.st === "next") {
+    const last = F.made[F.made.length - 1]
+    if (last?.name === "todowrite") (x = last), (via = "cur")
+  }
+  if (!x && (S.st === "asm" || S.st === "fly") && q.m > 1 && F.r) {
+    const p = F.r.requests[q.m - 2]
+    const last = p.tools[p.tools.length - 1]
+    if (last?.name === "todowrite" && at(last.end, t)) (x = last), (via = "carry")
+  }
+  if (!x) return undefined
+  const v = x.planVersion ?? 1
+  const writing = !at(x.start, t)
+  // While its arguments stream, the plan's items are not known yet (D2 reasoning): replay shows none; live shows
+  // whatever input has arrived.
+  const todos = writing ? (live ? (x.todos ?? []) : []) : (x.todos ?? [])
+  const c = planCount(todos)
+  const items = todos.map((o) => ({ text: o.text, status: o.status, partial: writing }))
+  const meta = writing
+    ? ph("ring.card.plan.writing", { v, n: 0 })
+    : via === "carry"
+      ? ph("ring.card.plan.carry", { v, m: q.m, done: c.done, total: c.total })
+      : ph("ring.card.plan.meta", { v, done: c.done, doing: c.inProgress, todo: c.total - c.done - c.inProgress })
+  return card("plan", "main", F.agent, ph("ring.card.who.plan"), {
+    plan: { items },
+    meta: [meta],
+    streaming: writing,
+    age: writing ? ago(t - x.created) : ph("ring.plan.chip", { done: c.done, total: c.total }),
+  })
+}
+
+function cardOf(S: RingStage, F: Facts, t: number, opts: { live?: RingLiveInput; wide: boolean }): RingCard {
+  const live = !!opts.live
+  const out = cardBody(S, F, t, opts, live)
+  if (FULL.has(out.kind) && out.body) out.full = out.body
+  return out
+}
+
+function cardBody(S: RingStage, F: Facts, t: number, opts: { wide: boolean }, live: boolean): RingCard {
+  const r = F.r
+  const q = F.q
+  const ag = F.agent
+  const plan = planCardOf(S, F, t, live)
+  if (plan) return plan
+  const who = (k: RuntimeKey) => ph(k)
+  switch (S.st) {
+    case "pre":
+      return card("idle", "faint", ag, "", live ? {} : { pre: ph("ring.card.idle.body", { n: 1 }) })
+    case "say":
+      return card("message", "main", who("ring.card.who.you"), ag, {
+        body: r!.text,
+        meta: [ph("ring.card.say.meta", { n: r!.n, at: { at: r!.start } })],
+        age: ago(t - r!.start),
+      })
+    case "asm":
+    case "fly": {
+      const cr = carriedOf(F, t)
+      const ctx = ctxPhrase(F)
+      const meta =
+        S.st === "asm"
+          ? ph("ring.card.asm.meta", { ctx })
+          : ph("ring.card.fly.meta", { dur: ms(t - (q!.stepStart ?? t)), ctx })
+      const extra: Partial<RingCard> = {
+        meta: [meta],
+        age: ago(S.st === "asm" ? t - q!.created : t - (q!.stepStart ?? t)),
+      }
+      if (cr.kind === "msg") Object.assign(extra, { pre: ph("ring.card.req.msg"), body: r!.text })
+      else Object.assign(extra, { pre: ph("ring.card.req.res", { n: cr.n }), body: cr.list }, cr.subsPhrase ? { post: cr.subsPhrase } : {})
+      return card("request", "main", ag, who("ring.card.who.model"), extra)
+    }
+    case "think": {
+      const s = F.think ? shownSpan(F.think, t, live) : { text: "", streaming: true }
+      return card("think", "acc", who("ring.card.who.model"), ag, {
+        body: s.text,
+        bodyMode: "tail",
+        mono: latin(s.text),
+        streaming: s.streaming,
+        meta: [ph("ring.card.think.meta", { dur: ms(t - (F.think?.start ?? t)), carry: carriedOf(F, t).phrase })],
+        age: ago(t - (F.think?.start ?? t)),
+      })
+    }
+    case "out": {
+      const s = F.text ? shownSpan(F.text, t, live) : { text: "", streaming: true, ended: false }
+      const counted = s.ended || live
+      return card("output", "text", who("ring.card.who.model"), who("ring.card.who.chat"), {
+        body: s.text,
+        bodyMode: "tail",
+        streaming: s.streaming,
+        meta: [
+          counted
+            ? ph("ring.card.out.meta", { n: codePoints(s.text) })
+            : ph("ring.card.out.meta.dur", { dur: ms(t - (F.text?.start ?? t)) }),
+        ],
+        age: ago(t - (F.text?.start ?? t)),
+      })
+    }
+    case "call": {
+      const x = F.made[F.made.length - 1]
+      const started = at(x.start, t)
+      const meta = [ph("ring.card.call.meta", { made: madeOf(F), run: F.tc.run + F.qsc.run })]
+      if (x.kind === "question")
+        return card("call", "attn", ag, who("ring.card.who.you"), { pre: ph("ring.card.call.ask"), meta, age: ago(t - x.created) })
+      if (x.kind === "task") {
+        const sub = x.sub!
+        const to = ph("ring.card.who.sub", { n: sub.num, name: started ? sub.name : "" })
+        return started
+          ? card("handoff", "sub", ag, to, { body: sub.prompt, ...(sub.type ? { post: sub.type } : {}), meta, age: ago(t - x.start!) })
+          : card("call", "sub", ag, to, { pre: ph("ring.card.call.task"), meta, age: ago(t - x.created) })
+      }
+      return started
+        ? card("call", "tool", ag, x.name, { body: x.arg, mono: true, meta, age: ago(t - x.start!) })
+        : card("call", "tool", ag, x.name, { pre: ph("ring.card.call.tool", { tool: x.name }), meta, age: ago(t - x.created) })
+    }
+    case "wait": {
+      const x = newestDone(q!, t)
+      const meta = waitBits(F)
+      if (x?.kind === "task") {
+        const sub = x.sub!
+        const result = sub.result ?? ""
+        return card("return", "ok", ph("ring.card.who.sub", { n: sub.num, name: sub.name }), ag, {
+          body: result,
+          meta: [...meta, ph("ring.card.return.chars", { n: codePoints(result) })],
+          age: ago(t - x.end!),
+        })
+      }
+      if (x && declinedAt(x, t) === "rejected")
+        return card("rejected", "faint", who("ring.card.who.you"), ag, {
+          pre: ph("ring.card.rejected.body", { tool: x.name }),
+          meta,
+          age: ago(t - x.end!),
+        })
+      if (x && x.status === "error")
+        return card("failed", "err", x.name, ag, {
+          body: x.error ?? "",
+          mono: true,
+          post: `${x.name} ${cut(x.arg, 60)}`,
+          meta,
+          age: ago(t - x.end!),
+        })
+      if (x) {
+        const res = stripTags(x.output)
+        return card("result", "ok", x.name, ag, {
+          body: res,
+          mono: true,
+          ...(res ? {} : { pre: ph("ring.card.noOutput") }),
+          post: `${x.name} ${cut(x.arg, 60)}`,
+          meta: [...meta, ph("ring.card.chars", { n: x.chars }), ph("ring.card.took", { dur: ms(x.end! - (x.start ?? x.end!)) })],
+          age: ago(t - x.end!),
+        })
+      }
+      const runs = F.made.filter((y) =>
+        y.kind === "task"
+          ? (() => {
+              const s = subStateAt(y.sub!, t)
+              return s === "run" || s === "docked"
+            })()
+          : y.kind === "tool" && toolStateAt(y, t) === "run",
+      )
+      return card("waiting", "sub", who("ring.card.who.toolsSubs"), ag, {
+        pre: ph("ring.card.waiting.pre", { n: runs.length }),
+        body: runs.map((y) => (y.kind === "task" ? "#" + y.sub!.num : y.name)).join(" · "),
+        meta,
+      })
+    }
+    case "ask": {
+      if (S.permission) {
+        const body = [S.permission.permission, ...S.permission.patterns].join("\n")
+        return card("permission", "attn", ag, who("ring.card.who.you"), { body, meta: [ph("ring.card.permission.meta")] })
+      }
+      const x = S.ask!
+      const qq = x.question
+      const n = qq?.options.length ?? 0
+      return card("ask", "attn", ag, who("ring.card.who.you"), {
+        body: qq?.question ?? "",
+        bodyMode: "mid",
+        meta: [opts.wide ? ph("ring.card.ask.wide", { n }) : ph("ring.card.ask.narrow", { n })],
+        age: ph("ring.card.age.waited", { dur: ms(t - x.start!) }),
+      })
+    }
+    case "next": {
+      const f = q!.finish!
+      const n = F.made.length
+      return card("receipt", "main", who("ring.card.who.model"), ag, {
+        pre: ph("ring.card.receipt.body", {
+          m: q!.m,
+          total: { tok: f.tokens.total },
+          in: { tok: f.tokens.input + f.tokens.cacheRead + f.tokens.cacheWrite },
+          out: { tok: f.tokens.output + f.tokens.reasoning },
+          cost: { usd: f.cost },
+        }),
+        post: ph("ring.card.receipt.post", { n, next: q!.m + 1 }),
+        meta: [ph("ring.card.receipt.meta", { tok: { tok: f.tokens.total } })],
+        age: ago(t - f.at),
+      })
+    }
+    case "end": {
+      if (S.why === "dismiss" && S.dismissed) {
+        const x = S.dismissed
+        return card("dismissed", "faint", who("ring.card.who.you"), ag, {
+          pre: ph("ring.card.dismissed.body", { header: x.question?.header ?? "", n: r!.n }),
+          meta: [
+            ph("ring.card.dismissed.meta", { at: { at: x.end! }, dur: ms(x.end! - (x.start ?? x.end!)), idle: ms(F.idle) }),
+          ],
+        })
+      }
+      const tx = q!.texts.filter((s) => s.start <= t).pop()
+      const s = tx ? shownSpan(tx, t, live) : undefined
+      const meta = [ph("ring.card.end.meta", { at: { at: S.endAt! }, dur: ms(F.idle) })]
+      if (S.why === "finish" && S.reason !== undefined && S.reason !== "stop")
+        meta.push(ph("ring.card.end.reason", { reason: S.reason }))
+      return card("round-end", "ok", ag, who("ring.card.who.you"), {
+        body: s?.text ?? "",
+        streaming: s?.streaming ?? false,
+        meta,
+      })
+    }
+    case "abort": {
+      const th = q!.think.filter((s) => s.start <= t).pop()
+      const thText = th && at(th.end, t) ? th.text : ""
+      return card("aborted", "err", ag, who("ring.card.who.model"), {
+        pre: ph("ring.card.aborted.body", { m: q!.m, name: q!.error?.name ?? "", message: q!.error?.message ?? "" }),
+        ...(thText ? { post: ph("ring.card.aborted.post", { text: cut(thText, 90) }) } : {}),
+        meta: [ph("ring.card.end.meta", { at: { at: S.endAt! }, dur: ms(F.idle) })],
+      })
+    }
+  }
+  return card("idle", "faint", ag, "")
+}
+
+function youOf(S: RingStage, F: Facts, t: number): RingYou {
+  const r = F.r
+  const round = r ? { round: { n: r.n, agent: r.agent, text: r.text } } : {}
+  if (S.permission)
+    return {
+      state: "permission",
+      status: ph("ring.you.permission", { permission: S.permission.permission }),
+      ...round,
+      permission: { permission: S.permission.permission, patterns: [...S.permission.patterns] },
+    }
+  if (!r) return { state: "pre", status: ph("ring.you.idle") }
+  const ask =
+    F.ask && (S.st === "ask" || S.st === "end" || S.st === "call" || S.st === "wait" || S.st === "next") ? F.ask : undefined
+  if (ask?.state === "pending") {
+    const x = ask.x
+    const qq = x.question
+    return {
+      state: "need",
+      status: ph("ring.you.need", { dur: ms(t - x.start!) }),
+      ...round,
+      ask: {
+        header: qq?.header ?? "",
+        question: qq?.question ?? "",
+        options: (qq?.options ?? []).map((o) => ({ label: o.label, description: o.description })),
+        waitedMs: t - x.start!,
+      },
+    }
+  }
+  if (ask?.state === "dismissed") {
+    const x = ask.x
+    return {
+      state: "dismissed",
+      status: ph("ring.you.dismissed", { at: { at: x.end! } }),
+      ...round,
+      dismissed: {
+        header: x.question?.header ?? "",
+        options: (x.question?.options ?? []).map((o) => o.label),
+        waitedMs: x.end! - (x.start ?? x.end!),
+        at: x.end!,
+      },
+    }
+  }
+  if (ask?.state === "writing") return { state: "writing", status: ph("ring.you.writing", { agent: F.agent }), ...round }
+  if (!F.ended && t - r.start < 3000)
+    return { state: "sent", status: ph("ring.you.sent", { dur: ms(t - r.start) }), ...round }
+  return { state: "idle", status: ph("ring.you.idle"), ...round }
+}
+
+function toolsOf(F: Facts, t: number): RingToolsDock {
+  const q = F.q
+  const rows: RingToolRow[] = F.own.map((x) => {
+    const state = toolStateAt(x, t)!
+    const row: RingToolRow = { id: x.id, name: x.name, state, arg: state === "pend" ? "" : x.arg }
+    if (state === "run") row.durMs = t - x.start!
+    if (state === "ok" || state === "err") row.durMs = x.end! - x.start!
+    if (state !== "pend") {
+      // same command: only calls whose arguments are written at t (the key comes from the arguments)
+      const same = F.own.filter((y) => y.key === x.key && at(y.start, t))
+      if (same.length > 1) row.same = [same.indexOf(x) + 1, same.length]
+    }
+    if (state === "ok") {
+      row.chars = x.chars
+      row.head = cut(stripTags(x.output), 60)
+    }
+    if (state === "err") {
+      if (declinedAt(x, t) === "rejected") row.rejected = true
+      else row.error = cut(x.error, 70)
+    }
+    return row
+  })
+  const dock: RingToolsDock = { rows, counts: { ...F.tc } }
+  if (q) dock.m = q.m
+  if (!rows.length) {
+    const prev = q && q.m > 1 && F.r ? F.r.requests[q.m - 2].tools.filter((x) => x.created <= t).length : 0
+    dock.empty = !q
+      ? F.r
+        ? ph("ring.tools.empty.idle", { agent: F.agent })
+        : ph("state.idle")
+      : F.nQ
+        ? ph("ring.tools.empty.ask", { m: q.m })
+        : (q.finish && q.finish.at <= t) || F.ended
+          ? ph("ring.tools.empty.none", { m: q.m })
+          : ph("ring.tools.empty.yet", { m: q.m })
+    if (q && !F.nQ && prev && !F.ended) dock.emptyNote = ph("ring.tools.empty.carried", { n: prev })
+  }
+  return dock
+}
+
+function subFin(sub: RingSub, state: SubState, t: number): number | undefined {
+  if (state === "done") return sub.background ? sub.background.retrievedAt : sub.end
+  if (state !== "err") return undefined
+  if (!sub.background || (at(sub.end, t) && sub.failed)) return sub.end
+  let fin: number | undefined
+  for (const n of sub.background.notices) if (n.at <= t && (n.kind === "error" || n.kind === "cancelled")) fin = n.at
+  return fin
+}
+
+function subsOf(index: RingIndex, F: Facts, t: number, live?: RingLiveInput): RingSubsDock {
+  const r = F.r
+  const cells: RingSubCell[] = F.rsubs.map((x) => {
+    const sub = x.sub!
+    const state = subStateAt(sub, t)!
+    const cell: RingSubCell = { uid: sub.uid, num: sub.num, slot: x.slot, state }
+    const begin = sub.start ?? sub.created
+    if (at(sub.start, t)) {
+      cell.name = sub.name
+      if (sub.type) cell.type = sub.type
+    }
+    if (state === "run" || state === "docked") cell.elapsedMs = t - begin
+    const fin = subFin(sub, state, t)
+    if (fin !== undefined) cell.tookMs = fin - begin
+    if (state === "err") cell.flag = "error"
+    else if (live && sub.sessionID && at(sub.start, t) && live.childAttention.has(sub.sessionID)) cell.flag = "ask"
+    return cell
+  })
+  const total = lastLE(index.subs, t, (s) => s.created) + 1
+  const stripWhat = !r
+    ? ph("ring.sub.strip.pre")
+    : cells.length
+      ? ph("ring.sub.strip.sent", { n: r.n, m: cells.length })
+      : F.ended
+        ? ph("ring.sub.strip.none", { n: r.n })
+        : ph("ring.sub.strip.yet", { n: r.n })
+  const dock: RingSubsDock = {
+    cells,
+    counts: { ...F.sc },
+    total,
+    stripWhat,
+    stripSession: total ? ph("ring.sub.session", { n: total }) : ph("ring.sub.session.none"),
+    stripButton: total > 0,
+  }
+  if (r) dock.round = r.n
+  return dock
+}
+
+function captionOf(S: RingStage, F: Facts, t: number, live: boolean): Phrase {
+  const r = F.r
+  const q = F.q
+  const agent = F.agent
+  switch (S.st) {
+    case "pre":
+      return ph("state.idle")
+    case "say":
+      return ph("ring.cap.say", { n: r!.n, agent })
+    case "asm":
+      return ph("ring.cap.asm", { agent, m: q!.m, carry: carriedOf(F, t).phrase })
+    case "fly":
+      return ph("ring.cap.fly", { m: q!.m, dur: ms(t - (q!.stepStart ?? t)) })
+    case "think":
+      return ph("ring.cap.think", { dur: ms(t - (F.think?.start ?? t)), carry: carriedOf(F, t).phrase })
+    case "out": {
+      const s = F.text ? shownSpan(F.text, t, live) : undefined
+      return s && (s.ended || live)
+        ? ph("ring.cap.out", { n: codePoints(s.text) })
+        : ph("ring.cap.out.dur", { dur: ms(t - (F.text?.start ?? t)) })
+    }
+    case "call": {
+      const lx = F.made[F.made.length - 1]
+      if (lx?.name === "todowrite") {
+        const v = lx.planVersion ?? 1
+        if (!at(lx.start, t)) return ph("ring.cap.plan.writing", { v })
+        const c = planCount(lx.todos ?? [])
+        return ph("ring.cap.plan", { agent, v, done: c.done, total: c.total })
+      }
+      if (!F.nCall) return ph("ring.cap.call.ask")
+      const run = F.tc.run + F.qsc.run
+      return run
+        ? ph("ring.cap.call.running", { made: madeOf(F), tools: F.tc.run, subs: F.qsc.run })
+        : ph("ring.cap.call", { made: madeOf(F) })
+    }
+    case "wait":
+      return ph("ring.cap.wait", { phrase: joinPhrases(waitBits(F)) })
+    case "ask":
+      if (S.permission) return ph("ring.cap.permission", { agent, permission: S.permission.permission })
+      return ph("ring.cap.ask", { agent, header: S.ask?.question?.header ?? "", dur: ms(t - (S.ask?.start ?? t)) })
+    case "next":
+      return ph("ring.cap.next", { m: q!.m, n: F.made.length, next: q!.m + 1 })
+    case "end":
+      return S.why === "dismiss"
+        ? ph("ring.cap.end.dismiss", { n: r!.n, agent, dur: ms(F.idle) })
+        : ph("ring.cap.end", { n: r!.n, agent, dur: ms(F.idle) })
+    case "abort":
+      return ph("ring.cap.abort", { n: r!.n, m: q!.m, name: q!.error?.name ?? "", agent, dur: ms(F.idle) })
+  }
+  return ph("state.idle")
+}
+
+function liveOf(S: RingStage, F: Facts): Phrase {
+  const r = F.r
+  if (!r) return ph("state.idle")
+  if (S.st === "ask") return S.permission ? ph("ring.live.permission", { agent: F.agent }) : ph("ring.live.ask", { agent: F.agent })
+  if (S.st === "end") return ph("ring.live.end", { n: r.n })
+  if (S.st === "abort") return ph("ring.live.abort", { n: r.n })
+  return ph("ring.live.run", { agent: F.agent, n: r.n, m: F.q?.m ?? 1 })
+}
+
+function barOf(index: RingIndex, F: Facts, t: number): RingFrame["bar"] {
+  const bar: RingFrame["bar"] = { waitMs: 0 }
+  if (F.ctx !== undefined) bar.ctx = F.ctx
+  const r = F.r
+  if (!r || F.ri < 0) return bar
+  const ra = auxOf(index).rounds[F.ri]
+  bar.round = r.n
+  bar.durMs = (F.endAt ?? t) - r.start
+  for (const y of ra.questions) if (at(y.start, t)) bar.waitMs += Math.min(y.end ?? t, t) - y.start
+  if (F.ended) bar.idleMs = F.idle
+  const fi = lastLE(ra.finAt, t, (v) => v)
+  let cost = fi >= 0 ? ra.finCost[fi] : 0
+  for (const x of ra.tasks) {
+    const child = x.sub?.child
+    if (!child || x.created > t) continue
+    for (const m of child.messages) if (at(m.completed, t)) cost += m.cost || 0
+  }
+  bar.costUsd = cost
+  return bar
+}
+
+export function frameAt(
+  index: RingIndex,
+  t: number,
+  opts: { live?: RingLiveInput; reduced: boolean; wide: boolean },
+): RingFrame {
+  const stage = stageAt(index, t, opts.live)
+  const F = factsOf(index, stage, t)
+  const live = !!opts.live
+  return {
+    t,
+    stage,
+    status: statusOf(stage, opts.live),
+    counter: counterOf(index, stage, F, t),
+    model: modelOf(stage, F, t, live),
+    card: cardOf(stage, F, t, opts),
+    pills: pillsOf(stage, F, t, live),
+    you: youOf(stage, F, t),
+    tools: toolsOf(F, t),
+    subs: subsOf(index, F, t, opts.live),
+    k: laneOpen(index, t, opts.reduced),
+    dk: dockOpen(index, t, opts.reduced),
+    caption: captionOf(stage, F, t, live),
+    live: liveOf(stage, F),
+    bar: barOf(index, F, t),
+  }
+}
+
+// ---------- track input (Task 7 consumes it) ----------
+export function trackInputOf(index: RingIndex, t1: number): TrackInput {
+  const first = index.rounds[0]
+  const out: TrackInput = { t0: (first ? first.start : t1) - RING.LEAD_MS, t1, rounds: [], waits: [], ticks: [] }
+  for (const r of index.rounds) {
+    if (r.start > t1) break
+    const q = latestRequest(r, t1)
+    const S = evalStage(r, q, t1)
+    const row: TrackInput["rounds"][number] = { n: r.n, start: r.start }
+    if ((S.st === "end" || S.st === "abort") && S.endAt !== undefined) row.endAt = S.endAt
+    out.rounds.push(row)
+    out.ticks.push({ t: r.start, cls: "r" })
+    for (const x of r.requests) {
+      if (x.created > t1) break
+      out.ticks.push({ t: x.created, cls: "" })
+      if (x.error && at(x.completed, t1)) out.ticks.push({ t: x.completed, cls: "e" })
+      for (const y of x.tools) {
+        if (y.created > t1) continue
+        if (at(y.end, t1) && y.status === "error" && !y.declined) out.ticks.push({ t: y.end, cls: "e" })
+        if (y.kind === "question" && at(y.start, t1)) {
+          out.ticks.push({ t: y.start, cls: "a" })
+          out.waits.push(at(y.end, t1) ? { start: y.start, end: y.end } : { start: y.start })
+        }
+      }
+    }
+  }
+  return out
+}
+
+/** D11: live t = wall + skew; skew only grows, so a server clock ahead of this machine never hides new events. */
+export function liveTime(wall: number, lastAt: number | undefined, skew: number): { t: number; skew: number } {
+  const next = Math.max(skew, lastAt !== undefined ? lastAt - wall : 0, 0)
+  return { t: wall + next, skew: next }
+}
+
+// ---------- truncation (tests only) ----------
+const ZERO_TOKENS: AssistantMessage["tokens"] = { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } }
+function truncTool(p: ToolPart, t: number): ToolPart {
+  const s = p.state
+  if (s.status === "pending" || s.time.start > t) return { ...p, state: { status: "pending", input: {}, raw: "" } }
+  if (s.status === "running") return p
+  if (s.time.end <= t) return p
+  return {
+    ...p,
+    state: {
+      status: "running",
+      input: s.input,
+      ...("title" in s && s.title !== undefined ? { title: s.title } : {}),
+      ...(s.metadata !== undefined ? { metadata: s.metadata } : {}),
+      time: { start: s.time.start },
+    },
+  }
+}
+function truncSource(src: RingSource, t: number): RingSource {
+  const messages: Message[] = []
+  const parts = new Map<string, Part[]>()
+  const steps = new Map<string, RingStepTimes>()
+  for (const m of src.messages) {
+    if (m.time.created > t) continue
+    const ps = src.parts(m.id)
+    if (m.role === "user") {
+      messages.push(m)
+      parts.set(m.id, [...ps])
+      continue
+    }
+    const completed = m.time.completed
+    if (at(completed, t)) messages.push(m)
+    else {
+      const { error: _e, finish: _f, ...rest } = m
+      messages.push({ ...rest, time: { created: m.time.created }, cost: 0, tokens: ZERO_TOKENS })
+    }
+    const ats = ps.map((p) => partAt(p, m.time.created))
+    const later = laterMin(ats)
+    const out: Part[] = []
+    ps.forEach((p, i) => {
+      if (ats[i] > t) return
+      if (p.type === "tool") out.push(truncTool(p, t))
+      else if (p.type === "text" || p.type === "reasoning") {
+        const end = spanEnd(p, later[i], completed)
+        out.push(end !== undefined && end <= t ? p : ({ ...p, text: "", time: { start: ats[i] } } as Part))
+      } else out.push(p)
+    })
+    parts.set(m.id, out)
+    // D21 side table: only step times <= t (read near created, as the index does)
+    const st = src.steps?.(m.id)
+    if (st) {
+      const c = m.time.created
+      const cut: RingStepTimes = { finishes: st.finishes.filter((f) => snapStepTime(f.at, c) <= t) }
+      if (st.start !== undefined && snapStepTime(st.start, c) <= t) cut.start = st.start
+      steps.set(m.id, cut)
+    }
+  }
+  return { messages, parts: (id) => parts.get(id) ?? [], ...(src.steps ? { steps: (id: string) => steps.get(id) } : {}) }
+}
+
+export function truncateAt(input: RingIndexInput, t: number): RingIndexInput { // tests only: data as it existed at t
+  const root = truncSource(input, t)
+  const kids = new Map<string, RingSource | undefined>()
+  return {
+    sessionID: input.sessionID,
+    messages: root.messages,
+    parts: root.parts,
+    ...(root.steps ? { steps: root.steps } : {}),
+    child: (id) => {
+      if (!kids.has(id)) {
+        const src = input.child(id)
+        kids.set(id, src ? truncSource(src, t) : undefined)
+      }
+      return kids.get(id)
+    },
+  }
+}
diff --git a/packages/app/src/components/session/session-runtime-step-times.test.ts b/packages/app/src/components/session/session-runtime-step-times.test.ts
