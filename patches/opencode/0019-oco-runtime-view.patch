index 0000000..c9d9635
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-sub.ts
@@ -0,0 +1,295 @@
+// oco (patches/opencode/0019): M5 runtime ring — subagent state, detail panel and list as pure functions of t.
+// Every query reads only facts at or before t (D16, D2): a field whose time is later than t is never looked at,
+// so the result equals the one computed from data truncated at t. No geometry, no copy (keys only).
+import { LOOP_CONTINUE } from "./session-runtime-ring-types"
+import type {
+  Phrase,
+  PhraseParam,
+  RingChild,
+  RingSub,
+  RingSubAct,
+  RingSubDetail,
+  RingSubList,
+  RingTool,
+  SubState,
+} from "./session-runtime-ring-types"
+import type { RuntimeKey } from "./session-runtime-i18n"
+
+const ph = (key: RuntimeKey, params?: Record<string, PhraseParam>): Phrase => (params ? { key, params } : { key })
+const at = (v: number | undefined, t: number): v is number => v !== undefined && v <= t
+
+/** One-line preview: only whitespace is merged; `**` and backticks stay (mockup cutRaw L1172). */
+const cutRaw = (s: string | undefined, n: number) => {
+  const a = [
+    ...String(s ?? "")
+      .replace(/\s+/g, " ")
+      .trim(),
+  ]
+  return a.length > n ? a.slice(0, n - 1).join("") + "…" : a.join("")
+}
+const stripTags = (s: string | undefined) =>
+  String(s ?? "")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/\s+/g, " ")
+    .trim()
+
+/** The child's newest assistant message created at or before t. */
+function latestMessage(child: RingChild, t: number) {
+  let best: RingChild["messages"][number] | undefined
+  for (const m of child.messages) if (m.created <= t && (!best || m.created >= best.created)) best = m
+  return best
+}
+
+/** D16: when the child session finished, judged only from data at or before t. The newest child request created
+ *  at or before t must have completed by t, and either failed or ended the loop (`finish` not in LOOP_CONTINUE,
+ *  the same predicate as D5). Between steps (`tool-calls`) and with the child not loaded: undefined. */
+export function childDoneAt(sub: RingSub, t: number): number | undefined {
+  if (!sub.child) return undefined
+  const c = latestMessage(sub.child, t)
+  if (!c || !at(c.completed, t)) return undefined
+  if (c.error) return c.completed
+  if (c.finish !== undefined && !LOOP_CONTINUE.includes(c.finish)) return c.completed
+  return undefined
+}
+
+type Phase = {
+  state: SubState
+  /** docked: when the child finished (childDoneAt, else the latest done notice) */
+  dock?: number
+  /** done / err: when it was collected or failed */
+  fin?: number
+}
+
+/** Latest background notice at or before t (a `cleared` one resets the state to running). */
+function noticeAt(sub: RingSub, t: number) {
+  let last: NonNullable<RingSub["background"]>["notices"][number] | undefined
+  for (const n of sub.background?.notices ?? []) if (n.at <= t) last = n
+  return last
+}
+
+function phaseAt(sub: RingSub, t: number): Phase | undefined {
+  if (sub.created > t) return undefined
+  const bg = sub.background
+  if (!bg) {
+    if (at(sub.end, t)) return { state: sub.failed ? "err" : "done", fin: sub.end }
+    if (!at(sub.start, t)) return { state: "queued" }
+    const dock = childDoneAt(sub, t)
+    return dock !== undefined ? { state: "docked", dock } : { state: "run" }
+  }
+  // Background: the task part ends as soon as it hands back the task id; that end is not a pickup.
+  if (at(sub.end, t) && sub.failed) return { state: "err", fin: sub.end }
+  if (at(bg.retrievedAt, t)) return { state: "done", fin: bg.retrievedAt }
+  const last = noticeAt(sub, t)
+  if (last && (last.kind === "error" || last.kind === "cancelled")) return { state: "err", fin: last.at }
+  if (!at(sub.start, t)) return { state: "queued" }
+  const done = childDoneAt(sub, t)
+  const cleared = last?.kind === "cleared" ? last.at : undefined
+  if (done !== undefined && (cleared === undefined || done >= cleared)) return { state: "docked", dock: done }
+  if (last?.kind === "done") return { state: "docked", dock: last.at }
+  return { state: "run" }
+}
+
+/** D16 state at t; undefined while the task call is not created yet. */
+export function subStateAt(sub: RingSub, t: number): SubState | undefined {
+  return phaseAt(sub, t)?.state
+}
+
+/** Probe stage names kept from M4 for E2E: done/err are both absorbed (err additionally carries flag=error). */
+export function probeStageOfSub(state: SubState): "queued" | "running" | "docked" | "absorbed" {
+  if (state === "queued") return "queued"
+  if (state === "run") return "running"
+  if (state === "docked") return "docked"
+  return "absorbed"
+}
+
+/** Name, @type and handoff come from the task call's arguments: shown only once they are written (t >= start). */
+const argsIn = (sub: RingSub, t: number) => at(sub.start, t)
+const begin = (sub: RingSub) => sub.start ?? sub.created
+const took = (sub: RingSub, fin: number) => fin - begin(sub)
+
+function stateLineOf(sub: RingSub, p: Phase, t: number): Phrase {
+  switch (p.state) {
+    case "queued":
+      return ph("ring.sub.queued.line", { dur: { ms: t - sub.created }, agent: sub.agent })
+    case "run":
+      // No duration-only key exists yet; the cell's own wording is reused (see the Task 6 report).
+      return ph("ring.sub.cell.run", { dur: { ms: t - begin(sub) } })
+    case "docked": {
+      const dock = p.dock ?? t
+      return ph("ring.sub.docked.line", {
+        dur: { ms: t - begin(sub) },
+        done: { ms: dock - begin(sub) },
+        wait: { ms: t - dock },
+      })
+    }
+    case "done":
+      return ph("ring.sub.took", { dur: { ms: took(sub, p.fin ?? t) }, at: { at: p.fin ?? t } })
+    case "err":
+      return ph("ring.sub.tookErr", { dur: { ms: took(sub, p.fin ?? t) }, at: { at: p.fin ?? t } })
+  }
+}
+
+/** Second status line: origin, then the child's model / request count / cost at t; empty parts are omitted. */
+function secondOf(sub: RingSub, t: number): Phrase[] {
+  const out: Phrase[] = [ph("ring.sub.origin", { r: sub.round, q: sub.request, at: { at: sub.created } })]
+  const child = sub.child
+  if (!child) return out
+  const model = latestMessage(child, t)?.model
+  if (model) out.push(ph("ring.sub.model", { model }))
+  const n = child.messages.reduce((s, m) => s + (m.created <= t ? 1 : 0), 0)
+  if (n) out.push(ph("ring.sub.requests", { n }))
+  const cost = child.messages.reduce((s, m) => s + (at(m.completed, t) ? m.cost || 0 : 0), 0)
+  if (cost) out.push(ph("ring.sub.cost", { cost: { usd: cost } }))
+  return out
+}
+
+/** A child tool call as a panel row: pend while its arguments stream, run, then ok / err once it ended. */
+function toolAct(tool: RingTool, t: number): RingSubAct {
+  if (at(tool.end, t)) {
+    const durMs = tool.end - (tool.start ?? tool.created)
+    const arg = tool.arg
+    if (tool.declined) {
+      // D18: a declined permission / dismissed question is not a failure: ⊘ on a faint outline, neutral text
+      // (你已拒绝授权 / 已忽略), never ✗, the err border or the raw error.
+      const line2 = tool.declined === "rejected" ? ph("ring.tools.row.rejected") : ph("ring.card.kind.dismissed")
+      return { kind: "tool", id: tool.id, glyph: "⊘", name: tool.name, arg, durMs, line2, border: "faint" }
+    }
+    if (tool.status === "error")
+      return {
+        kind: "tool",
+        id: tool.id,
+        glyph: "✗",
+        name: tool.name,
+        arg,
+        durMs,
+        line2: ph("ring.tools.row.err", { error: cutRaw(tool.error, 90) }),
+        border: "err",
+      }
+    const head = cutRaw(stripTags(tool.output), 80)
+    return {
+      kind: "tool",
+      id: tool.id,
+      glyph: "✓",
+      name: tool.name,
+      arg,
+      durMs,
+      line2: ph("ring.tools.row.ok", { n: tool.chars, head: head || ph("ring.tools.row.empty") }),
+      border: "ok",
+    }
+  }
+  if (at(tool.start, t)) {
+    const durMs = t - tool.start
+    return {
+      kind: "tool",
+      id: tool.id,
+      glyph: "●",
+      name: tool.name,
+      arg: tool.arg,
+      durMs,
+      line2: ph("ring.tools.row.run", { dur: { ms: durMs } }),
+      border: "sub",
+    }
+  }
+  // arguments still streaming: the view shows ring.tools.args.pending for the empty arg
+  return {
+    kind: "tool",
+    id: tool.id,
+    glyph: "…",
+    name: tool.name,
+    arg: "",
+    line2: ph("ring.tools.row.pend"),
+    border: "line-strong",
+  }
+}
+
+/** Detail panel content at t (D16, D2). Undefined while the task call is not created yet (the panel closes). */
+export function subDetailAt(
+  sub: RingSub,
+  t: number,
+  opts: { narrow: boolean; childLoad?: "loading" | "failed"; live?: boolean },
+): RingSubDetail | undefined {
+  const p = phaseAt(sub, t)
+  if (!p) return undefined
+  const ain = argsIn(sub, t)
+  const child = sub.child
+
+  // its own activity: tool calls and text, verbatim, newest last
+  const shown = child ? child.acts.filter((a) => a.at <= t) : []
+  const max = opts.narrow ? 4 : 6
+  const more = Math.max(0, shown.length - max)
+  const items: RingSubAct[] = shown.slice(more).map((a) => {
+    if (a.kind === "tool") return toolAct(a.tool, t)
+    const ended = at(a.span.end, t)
+    // D2: replay shows nothing of a span still streaming at t; live shows what has arrived, with a caret.
+    if (opts.live) return { kind: "text", id: a.span.partID, text: a.span.text, streaming: !ended }
+    return { kind: "text", id: a.span.partID, text: ended ? a.span.text : "", streaming: !ended }
+  })
+  const think = p.state === "run" && child ? child.thinks.find((k) => k.start <= t && !at(k.end, t)) : undefined
+  const acts: RingSubDetail["acts"] = { more, items }
+  if (think) acts.thinkingMs = t - think.start
+  if (opts.childLoad) acts.loading = opts.childLoad
+  if (!items.length && !think) {
+    acts.empty =
+      !child && opts.childLoad === "loading"
+        ? ph("child.loading")
+        : !child && opts.childLoad === "failed"
+          ? ph("child.sync_failed")
+          : p.state === "queued"
+            ? ph("ring.sub.acts.notStarted")
+            : p.state === "run"
+              ? ph("ring.sub.acts.noneYet")
+              : ph("ring.sub.acts.none")
+  }
+
+  const result: RingSubDetail["result"] =
+    p.state === "done"
+      ? { text: sub.result ?? "" }
+      : p.state === "err"
+        ? { error: sub.error ?? "" }
+        : p.state === "docked"
+          ? { note: ph("ring.sub.result.docked", { agent: sub.agent }) }
+          : { note: ph("ring.sub.result.wait") }
+
+  const canOpen = ain && !!sub.sessionID
+  const detail: RingSubDetail = {
+    uid: sub.uid,
+    num: sub.num,
+    state: p.state,
+    stateLine: stateLineOf(sub, p, t),
+    second: secondOf(sub, t),
+    handoff: ain ? { text: sub.prompt } : { pending: ph("ring.sub.handoff.pending", { agent: sub.agent }) },
+    acts,
+    result,
+    open: canOpen
+      ? { enabled: true, note: ph("ring.sub.open.note", { id: sub.sessionID! }) }
+      : { enabled: false, note: ph("ring.sub.open.disabled") },
+  }
+  if (ain) detail.name = sub.name
+  if (ain && sub.type) detail.type = sub.type
+  return detail
+}
+
+/** "Subagents in this session" list at t: task calls created at or before t, grouped by round ascending. */
+export function subListAt(subs: readonly RingSub[], t: number, currentRound?: number): RingSubList {
+  const groups = new Map<number, RingSubList["groups"][number]>()
+  let total = 0
+  for (const sub of subs) {
+    const p = phaseAt(sub, t)
+    if (!p) continue
+    total++
+    let g = groups.get(sub.round)
+    if (!g) {
+      g = { round: sub.round, current: sub.round === currentRound, rows: [] }
+      groups.set(sub.round, g)
+    }
+    const row: RingSubList["groups"][number]["rows"][number] = { uid: sub.uid, num: sub.num, state: p.state }
+    if (argsIn(sub, t)) {
+      row.name = sub.name
+      if (sub.type) row.type = sub.type
+    }
+    if (p.state === "run") row.ms = t - begin(sub)
+    else if ((p.state === "done" || p.state === "err") && p.fin !== undefined) row.ms = took(sub, p.fin)
+    g.rows.push(row)
+  }
+  return { total, groups: [...groups.values()].sort((a, b) => a.round - b.round) }
+}
diff --git a/packages/app/src/components/session/session-runtime-ring-track-view.tsx b/packages/app/src/components/session/session-runtime-ring-track-view.tsx
new file mode 100644
index 0000000..28f11a8
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-track-view.tsx
@@ -0,0 +1,152 @@
+// oco (patches/opencode/0019): M5 replay timeline (D6). A drawn track (rail, played fill, ticks, ≈ fold marks, labels)
+// with a transparent native range on top, so pointer drag and arrow keys (1 s of track per step) stay native.
+// Ticks, fold marks and labels after t are not in the DOM at all. Rules live in session-runtime-ring-track.ts.
+import { createMemo, createSignal, Index, onCleanup, onMount, type Accessor, type JSX } from "solid-js"
+import type { RuntimeText } from "./session-runtime-i18n"
+import type { Phrase, TrackInput, TrackMap } from "./session-runtime-ring-types"
+import {
+  foldElapsed,
+  foldVisible,
+  textWidth,
+  ticksAt,
+  TRACK_LABEL_PX,
+  trackLabelsAt,
+  trackRoundAt,
+} from "./session-runtime-ring-track"
+
+/** Native range step in track ms: arrow keys move 1 s of folded track. */
+const STEP = 1000
+
+const TICK: Record<TrackInput["ticks"][number]["cls"], JSX.CSSProperties> = {
+  "": { top: "5px", height: "12px", background: "var(--rt-line-strong)" },
+  r: { top: "4px", height: "14px", background: "var(--rt-main)" },
+  e: { top: "5px", height: "12px", background: "var(--rt-err)" },
+  a: { top: "5px", height: "12px", background: "var(--rt-attn)" },
+}
+
+export function RingTrack(props: {
+  map: Accessor<TrackMap>
+  input: Accessor<TrackInput>
+  t: Accessor<number>
+  /** Drawn the same in both modes: live has t = t1, so the playhead sits at the right end. */
+  mode: Accessor<"live" | "replay">
+  text: RuntimeText
+  onSeek(t: number): void
+}): JSX.Element {
+  let host: HTMLDivElement | undefined
+  const [width, setWidth] = createSignal(300)
+  onMount(() => {
+    const el = host
+    if (!el) return
+    const read = () => setWidth(el.clientWidth || 300)
+    read()
+    if (typeof ResizeObserver === "undefined") return
+    const observer = new ResizeObserver(read)
+    observer.observe(el)
+    onCleanup(() => observer.disconnect())
+  })
+
+  const pct = (v: number) => {
+    const total = props.map().total
+    return total > 0 ? Math.min(100, Math.max(0, (v / total) * 100)) : 100
+  }
+  const head = () => pct(props.map().vOf(props.t()))
+  const ticks = createMemo(() => ticksAt(props.input(), props.t()))
+  const folds = createMemo(() => props.map().segs.filter((s) => s.fold && foldVisible(s.fold, props.t())))
+  const measure = (p: Phrase) => textWidth(props.text.phrase(p), TRACK_LABEL_PX)
+  const labels = createMemo(() => trackLabelsAt(props.map(), props.input(), props.t(), width(), measure))
+  // Before round 1 there is no round number: the value text is the clock alone.
+  const valueText = () => {
+    const at = props.text.clock(props.t())
+    const round = trackRoundAt(props.input(), props.t())
+    return round ? props.text.t("ring.track.valuetext", { at, n: round.n }) : at
+  }
+  // max rounds up to a whole step so a drag to the right edge reaches t1 (tOf clamps v to total)
+  const max = () => Math.max(STEP, Math.ceil(props.map().total / STEP) * STEP)
+
+  return (
+    <div
+      ref={host}
+      data-oco-runtime-replay
+      data-oco-runtime-replay-t={Math.round(props.t())}
+      class="relative h-[30px] min-w-0 select-none rounded-sm has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-1 has-[:focus-visible]:outline-border-focus"
+      style={{ "touch-action": "none" }}
+    >
+      <div
+        aria-hidden="true"
+        class="absolute left-0 right-0 top-[9px] h-1 rounded-sm pointer-events-none"
+        style={{ background: "var(--rt-line)" }}
+      />
+      <div
+        aria-hidden="true"
+        class="absolute left-0 top-[9px] h-1 rounded-sm pointer-events-none"
+        style={{ background: "var(--rt-sub)", width: `${head()}%` }}
+      />
+      <Index each={ticks()}>
+        {(tick) => (
+          <div
+            aria-hidden="true"
+            class="absolute w-0.5 -ml-px rounded-[1px] pointer-events-none"
+            style={{ ...TICK[tick().cls], left: `${pct(props.map().vOf(tick().t))}%` }}
+          />
+        )}
+      </Index>
+      <Index each={folds()}>
+        {(seg) => (
+          <div
+            aria-hidden="true"
+            data-oco-runtime-fold={seg().fold!.kind}
+            data-oco-runtime-fold-ms={Math.round(foldElapsed(seg().fold!, props.t()))}
+            class="absolute top-[3px] h-4 w-3.5 -ml-[7px] text-center pointer-events-none"
+            style={{
+              left: `${pct(seg().v0 + seg().c / 2)}%`,
+              font: "12px/16px var(--font-family-mono)",
+              color: "var(--rt-weak)",
+              background: "var(--rt-bg)",
+            }}
+          >
+            ≈
+          </div>
+        )}
+      </Index>
+      <Index each={labels()}>
+        {(label) => (
+          <div
+            aria-hidden="true"
+            class="absolute top-[17px] whitespace-nowrap pointer-events-none"
+            style={{
+              left: `${label().x.toFixed(1)}px`,
+              font: `${TRACK_LABEL_PX}px/12px var(--font-family-mono)`,
+              color: label().cls === "r" ? "var(--rt-main)" : "var(--rt-weak)",
+            }}
+          >
+            {props.text.phrase(label().text)}
+          </div>
+        )}
+      </Index>
+      <div
+        aria-hidden="true"
+        class="absolute top-[5px] w-3 h-3 -ml-1.5 rounded-full pointer-events-none"
+        style={{
+          left: `${head()}%`,
+          background: "var(--rt-text)",
+          border: "2px solid var(--rt-sub)",
+        }}
+      />
+      <input
+        type="range"
+        min={0}
+        max={max()}
+        step={STEP}
+        value={props.map().vOf(props.t())}
+        aria-label={props.text.t("ring.track.aria")}
+        aria-valuetext={valueText()}
+        class="absolute inset-0 w-full h-full m-0 p-0 opacity-0 cursor-pointer"
+        onInput={(e) => {
+          const map = props.map()
+          props.onSeek(map.tOf(Math.min(map.total, Number(e.currentTarget.value))))
+        }}
+      />
+    </div>
+  )
+}
diff --git a/packages/app/src/components/session/session-runtime-ring-track.test.ts b/packages/app/src/components/session/session-runtime-ring-track.test.ts
new file mode 100644
index 0000000..2265f84
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-track.test.ts
@@ -0,0 +1,292 @@
+// oco (patches/opencode/0019): M5 replay timeline — folds, v <-> t, labels that never reveal the future, navigation.
+import { describe, expect, test } from "bun:test"
+import { runtimeText } from "./session-runtime-i18n"
+import { RING, type Phrase, type PhraseParam, type TrackInput } from "./session-runtime-ring-types"
+import {
+  foldElapsed,
+  foldsOf,
+  foldVisible,
+  navStep,
+  textWidth,
+  ticksAt,
+  TRACK_LABEL_PX,
+  trackLabelsAt,
+  trackMap,
+  trackRoundAt,
+} from "./session-runtime-ring-track"
+
+// Real session times (epoch ms) from the M5 timeline export (rounds 1-4). Task 4's fixture adapter and Task 5's
+// trackInputOf land in parallel, so the TrackInput is built here from the same constants; Task 11 checks the chain.
+const START = [1791104995369, 1791105736816, 1791119285329, 1791119355114]
+const END = [
+  1791105119024, // r1: finish stop (completed)
+  1791105780460, // r2: finish stop (completed)
+  1791119343457, // r3: aborted (error completion)
+  1791119427857, // r4: question dismissed (tool end)
+]
+const ASK = { start: 1791119398585, end: 1791119427857 }
+const KEY = { j04: 1791113400000, k08: 1791119405000, k09: 1791119428200, k10: 1791121200000 }
+const T0 = START[0] - RING.LEAD_MS
+
+const fixture = (t1 = KEY.k10): TrackInput => ({
+  t0: T0,
+  t1,
+  rounds: START.map((start, i) => ({ n: i + 1, start, endAt: END[i] })),
+  waits: [ASK],
+  ticks: [
+    ...START.map((t) => ({ t, cls: "r" as const })),
+    { t: 1791104995471, cls: "" },
+    { t: 1791105736865, cls: "" },
+    { t: 1791119285387, cls: "" },
+    { t: 1791119341683, cls: "" },
+    { t: 1791119343457, cls: "e" },
+    { t: 1791119387720, cls: "" },
+    { t: ASK.start, cls: "a" },
+  ],
+})
+
+const zh = runtimeText({ locale: () => "zh", intl: () => "zh-CN" })
+const en = runtimeText({ locale: () => "en", intl: () => "en-US" })
+const measureWith = (text: typeof zh) => (p: Phrase) => textWidth(text.phrase(p), TRACK_LABEL_PX)
+
+// every duration param inside a phrase, nested phrases included
+function durations(p: Phrase): number[] {
+  const out: number[] = []
+  const walk = (v: PhraseParam) => {
+    if (typeof v !== "object") return
+    if ("key" in v) Object.values(v.params ?? {}).forEach(walk)
+    else if ("ms" in v) out.push(v.ms)
+  }
+  walk(p)
+  return out
+}
+
+// deterministic PRNG so failures reproduce
+function rng(seed: number) {
+  let s = seed >>> 0
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0
+    return s / 2 ** 32
+  }
+}
+
+describe("v <-> t", () => {
+  test("vOf(tOf(v)) round-trips within 1 ms at 1000 random points", () => {
+    const map = trackMap(fixture())
+    const r = rng(7)
+    let worst = 0
+    for (let i = 0; i < 1000; i++) {
+      const v = r() * map.total
+      worst = Math.max(worst, Math.abs(map.vOf(map.tOf(v)) - v))
+    }
+    expect(worst).toBeLessThanOrEqual(1)
+  })
+  test("ends map to ends, both directions clamp, and the map is monotonic", () => {
+    const input = fixture()
+    const map = trackMap(input)
+    expect(map.vOf(T0)).toBe(0)
+    expect(map.vOf(KEY.k10)).toBeCloseTo(map.total, 6)
+    expect(map.vOf(T0 - 5000)).toBe(0)
+    expect(map.vOf(KEY.k10 + 5000)).toBeCloseTo(map.total, 6)
+    expect(map.tOf(-1)).toBe(T0)
+    expect(map.tOf(map.total + 1)).toBeCloseTo(KEY.k10, 3)
+    let prev = -1
+    for (let t = T0; t <= KEY.k10; t += 7919) {
+      const v = map.vOf(t)
+      expect(v).toBeGreaterThanOrEqual(prev)
+      prev = v
+    }
+  })
+  test("each fold takes FOLD_LEN; the rest keeps real length", () => {
+    const map = trackMap(fixture())
+    const folded = map.folds.reduce((n, f) => n + (f.b - f.a), 0)
+    expect(map.total).toBeCloseTo(KEY.k10 - T0 - folded + map.folds.length * RING.FOLD_LEN, 3)
+    for (const s of map.segs) if (s.fold) expect(s.c).toBe(RING.FOLD_LEN)
+  })
+})
+
+describe("folds on the real session", () => {
+  test("idle after each finished round, the long question wait, and an open idle at the end", () => {
+    const folds = foldsOf(fixture())
+    expect(folds.map((f) => [f.kind, f.from, f.to])).toEqual([
+      ["idle", END[0], START[1]],
+      ["idle", END[1], START[2]],
+      ["idle", END[2], START[3]], // the 11.7 s gap after the abort is over FOLD_MIN
+      ["wait", ASK.start, ASK.end],
+      ["idle", END[3], undefined],
+    ])
+  })
+  test("round 2's idle folds [end + 2600, next start − 1200]", () => {
+    const f = foldsOf(fixture()).find((f) => f.kind === "idle" && f.from === END[1])!
+    expect(f).toBeDefined()
+    expect([f.a, f.b]).toEqual([END[1] + 2600, START[2] - 1200])
+  })
+  test("k08's question wait has a wait fold [start + 2500, end − 600], shown only after 10 s of waiting", () => {
+    const f = foldsOf(fixture()).find((f) => f.kind === "wait")!
+    expect([f.a, f.b, f.from, f.to]).toEqual([ASK.start + 2500, ASK.end - 600, ASK.start, ASK.end])
+    expect(ASK.end - ASK.start).toBeGreaterThan(RING.FOLD_MIN)
+    expect(foldVisible(f, KEY.k08)).toBe(false) // 6.4 s into the wait
+    expect(foldVisible(f, ASK.start + RING.FOLD_MIN)).toBe(true)
+    expect(foldVisible(f, KEY.k09)).toBe(true)
+  })
+  test("gaps up to FOLD_MIN do not fold", () => {
+    const input: TrackInput = {
+      t0: 0,
+      t1: 100_000,
+      rounds: [
+        { n: 1, start: 1200, endAt: 20_000 },
+        { n: 2, start: 30_000, endAt: 40_000 }, // exactly FOLD_MIN after round 1
+        { n: 3, start: 45_000, endAt: 90_000 },
+      ],
+      waits: [{ start: 50_000, end: 59_000 }],
+      ticks: [],
+    }
+    expect(foldsOf(input)).toEqual([])
+  })
+})
+
+describe("live", () => {
+  const live = (t1: number): TrackInput => ({
+    t0: T0,
+    t1,
+    rounds: START.map((start, i) => ({ n: i + 1, start, endAt: END[i] })),
+    waits: [ASK],
+    ticks: [],
+  })
+  test("the trailing idle is an open fold whose b grows with t1", () => {
+    const a = foldsOf(live(END[3] + 20_000)).at(-1)!
+    const b = foldsOf(live(END[3] + 90_000)).at(-1)!
+    expect([a.kind, a.to, b.kind, b.to]).toEqual(["idle", undefined, "idle", undefined])
+    expect(a.a).toBe(b.a)
+    expect(a.b).toBe(END[3] + 20_000 - 1200)
+    expect(b.b).toBe(END[3] + 90_000 - 1200)
+    expect(trackMap(live(END[3] + 90_000)).total).toBe(trackMap(live(END[3] + 20_000)).total)
+  })
+  test("no trailing fold until the idle passes FOLD_MIN", () => {
+    expect(foldsOf(live(END[3] + RING.FOLD_MIN)).some((f) => f.from === END[3])).toBe(false)
+    expect(foldsOf(live(END[3] + RING.FOLD_MIN + 1)).some((f) => f.from === END[3])).toBe(true)
+  })
+  test("a question still waiting at t1 is an open wait fold; later data counts as not happened", () => {
+    const t1 = ASK.start + 15_000
+    const input: TrackInput = { t0: T0, t1, rounds: [{ n: 4, start: START[3] }], waits: [{ start: ASK.start }], ticks: [] }
+    expect(foldsOf(input)).toEqual([{ a: ASK.start + 2500, b: t1 - 600, kind: "wait", from: ASK.start, to: undefined }])
+    // in replay the index can hold data newer than t1: an end after t1 is still open at t1
+    expect(foldsOf({ ...input, waits: [ASK] })).toEqual(foldsOf(input))
+  })
+  test("open fold labels show the time passed so far", () => {
+    const t1 = END[3] + 600_000
+    const input = live(t1)
+    const map = trackMap(input)
+    const open = map.folds.at(-1)!
+    expect(foldElapsed(open, t1)).toBe(600_000)
+    const labels = trackLabelsAt(map, input, t1, 900, measureWith(zh))
+    expect(labels.flatMap((l) => durations(l.text))).toContain(600_000)
+  })
+})
+
+describe("fold marks", () => {
+  test("foldVisible is false at from + 9999 and true at from + 10000", () => {
+    const f = foldsOf(fixture())[0]
+    expect(foldVisible(f, f.from + 9999)).toBe(false)
+    expect(foldVisible(f, f.from + 10_000)).toBe(true)
+  })
+})
+
+describe("labels never reveal the future", () => {
+  test("j04 (19:30): the idle label shows the time passed (about 2 h 6 min), not the whole gap", () => {
+    const input = fixture()
+    const map = trackMap(input)
+    const labels = trackLabelsAt(map, input, KEY.j04, 900, measureWith(zh))
+    const ms = labels.flatMap((l) => durations(l.text))
+    const passed = KEY.j04 - END[1]
+    expect(ms).toContain(passed)
+    expect(Math.abs(passed - (2 * 3600 + 6 * 60) * 1000)).toBeLessThan(60_000 + 60_000)
+    expect(ms).not.toContain(START[2] - END[1]) // the whole gap (about 3 h 45 min) is only known when round 3 starts
+    const text = labels.map((l) => zh.phrase(l.text)).join(" | ")
+    expect(text).toContain("≈ 空闲 2 小时 6 分")
+    expect(text).not.toContain("3 小时 45 分")
+    expect(labels.map((l) => en.phrase(l.text)).join(" | ")).toContain("≈ idle 2 h 6 min")
+  })
+  test("only started rounds get labels; a round right after an idle gap shares its label", () => {
+    const input = fixture()
+    const map = trackMap(input)
+    const at = (t: number) => trackLabelsAt(map, input, t, 2000, measureWith(zh)).map((l) => zh.phrase(l.text))
+    expect(at(KEY.j04).filter((s) => s.includes("第3轮"))).toEqual([])
+    expect(at(KEY.j04)).toContain("≈ 空闲 10 分 17 秒 · 第2轮") // round 2 follows round 1's idle: one shared label
+    const k08 = at(KEY.k08)
+    expect(k08.some((s) => s.includes("≈ 空闲 3 小时 45 分 · 第3轮"))).toBe(true)
+    expect(k08.some((s) => s.startsWith("≈ 等你"))).toBe(false) // only 6.4 s into the wait
+    expect(at(KEY.k09).some((s) => s.startsWith("≈ 等你"))).toBe(true)
+  })
+  test("labels stay inside the track and never overlap; narrow tracks fall back to short forms or drop labels", () => {
+    const input = fixture()
+    const map = trackMap(input)
+    for (const width of [80, 160, 300, 560, 1100]) {
+      for (const t of [KEY.j04, KEY.k08, KEY.k09, KEY.k10]) {
+        const measure = measureWith(zh)
+        const spans = trackLabelsAt(map, input, t, width, measure)
+          .map((l) => [l.x, l.x + measure(l.text) + 2] as const)
+          .sort((a, b) => a[0] - b[0])
+        for (const [x0, x1] of spans) {
+          expect(x0).toBeGreaterThanOrEqual(0)
+          expect(x1).toBeLessThanOrEqual(width + 1e-6)
+        }
+        for (let i = 1; i < spans.length; i++) expect(spans[i][0]).toBeGreaterThanOrEqual(spans[i - 1][1] + 6 - 1e-6)
+      }
+    }
+    const narrow = trackLabelsAt(map, input, KEY.k10, 160, measureWith(zh)).map((l) => l.text.key)
+    expect(narrow.length).toBeGreaterThan(0)
+    expect(narrow.some((k) => k.endsWith(".short") || k === "ring.track.round")).toBe(true)
+  })
+  test("long gaps keep an hour tier in the short form", () => {
+    const input = fixture()
+    const map = trackMap(input)
+    // 90 px: the long idle label (about 106 px) does not fit, the short one (about 72 px) does
+    const labels = trackLabelsAt(map, input, KEY.j04, 90, measureWith(zh))
+    const short = labels.find((l) => l.text.key === "ring.fold.idle.short")
+    expect(short).toBeDefined()
+    expect(zh.phrase(short!.text)).toBe("≈2 小时 6 分")
+  })
+})
+
+describe("ticks", () => {
+  test("no tick after t", () => {
+    const input = fixture()
+    for (const t of [T0, KEY.j04, KEY.k08, KEY.k09, KEY.k10]) {
+      const shown = ticksAt(input, t)
+      expect(shown.every((k) => k.t <= t)).toBe(true)
+      expect(shown.length).toBe(input.ticks.filter((k) => k.t <= t).length)
+    }
+    expect(ticksAt(input, KEY.j04).map((k) => k.t)).not.toContain(START[2])
+    expect(ticksAt(input, ASK.start - 1).some((k) => k.cls === "a")).toBe(false)
+    expect(ticksAt(input, KEY.k08).some((k) => k.cls === "a")).toBe(true)
+  })
+  test("the playhead's round is the last one started", () => {
+    const input = fixture()
+    expect(trackRoundAt(input, T0)).toBeUndefined()
+    expect(trackRoundAt(input, KEY.j04)?.n).toBe(2)
+    expect(trackRoundAt(input, KEY.k08)?.n).toBe(4)
+  })
+})
+
+describe("navStep", () => {
+  const nav = [100, 200, 300]
+  test("strictly before / after t", () => {
+    expect(navStep(nav, 250, -1, 0, 1000)).toBe(200)
+    expect(navStep(nav, 250, 1, 0, 1000)).toBe(300)
+    expect(navStep(nav, 200, -1, 0, 1000)).toBe(100)
+    expect(navStep(nav, 200, 1, 0, 1000)).toBe(300)
+  })
+  test("past either end it stops at t0 / t1", () => {
+    expect(navStep(nav, 100, -1, 0, 1000)).toBe(0)
+    expect(navStep(nav, 50, -1, 0, 1000)).toBe(0)
+    expect(navStep(nav, 300, 1, 0, 1000)).toBe(1000)
+    expect(navStep(nav, 999, 1, 0, 1000)).toBe(1000)
+    expect(navStep([], 500, -1, 0, 1000)).toBe(0)
+    expect(navStep([], 500, 1, 0, 1000)).toBe(1000)
+  })
+  test("targets outside [t0, t1] are clamped", () => {
+    expect(navStep([10, 2000], 500, 1, 100, 1000)).toBe(1000)
+    expect(navStep([10, 2000], 500, -1, 100, 1000)).toBe(100)
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-ring-track.ts b/packages/app/src/components/session/session-runtime-ring-track.ts
new file mode 100644
index 0000000..ac7355b
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-track.ts
@@ -0,0 +1,252 @@
+// oco (patches/opencode/0019): M5 replay timeline. Long question waits and idle gaps fold to FOLD_LEN of track
+// (mockup L672-681); vOf / tOf map real time t <-> track position v. Nothing after t is revealed: ticks, fold marks
+// and fold labels only exist once they have happened (labels: mockup L1576-1618). Pure, so it unit-tests without a DOM.
+import {
+  RING,
+  type Fold,
+  type Phrase,
+  type PhraseParam,
+  type TrackInput,
+  type TrackLabel,
+  type TrackMap,
+  type TrackSeg,
+} from "./session-runtime-ring-types"
+
+// fold edges keep a little real time on each side so the moments around the gap stay scrubbable (mockup L675-677)
+const WAIT_IN = 2500
+const WAIT_OUT = 600
+const IDLE_IN = 2600
+const IDLE_OUT = 1200
+/** Label font size in px (mockup .track .lb). */
+export const TRACK_LABEL_PX = 10.5
+/** Minimum horizontal gap between two labels, px. */
+const LABEL_GAP = 6
+const HOUR = 3_600_000
+
+/**
+ * Folds over [t0, t1]. Geometry may use the whole history (round endAt), but anything later than t1 is treated as not
+ * happened yet: a question still waiting at t1 and the idle after the last round are open folds (`to` undefined) whose
+ * `b` follows t1.
+ */
+export function foldsOf(input: TrackInput): Fold[] {
+  const { t0 } = input
+  const t1 = Math.max(input.t1, t0)
+  const out: Fold[] = []
+  for (const w of input.waits) {
+    if (w.start > t1) continue
+    const to = w.end !== undefined && w.end <= t1 ? w.end : undefined
+    if ((to ?? t1) - w.start > RING.FOLD_MIN)
+      out.push({ a: w.start + WAIT_IN, b: (to ?? t1) - WAIT_OUT, kind: "wait", from: w.start, to })
+  }
+  const rounds = input.rounds.filter((r) => r.start <= t1).sort((x, y) => x.start - y.start)
+  rounds.forEach((r, i) => {
+    if (r.endAt === undefined || r.endAt > t1) return
+    const to = rounds[i + 1]?.start
+    if ((to ?? t1) - r.endAt > RING.FOLD_MIN)
+      out.push({ a: r.endAt + IDLE_IN, b: (to ?? t1) - IDLE_OUT, kind: "idle", from: r.endAt, to })
+  })
+  out.sort((x, y) => x.a - y.a)
+  const kept: Fold[] = []
+  for (const f of out) {
+    if (f.a < t0 || f.b > t1 || f.b <= f.a) continue
+    const prev = kept[kept.length - 1]
+    if (prev && f.a < prev.b) continue
+    kept.push(f)
+  }
+  return kept
+}
+
+/** Piecewise-linear track: real segments keep their length, each fold takes FOLD_LEN. vOf and tOf are inverses. */
+export function trackMap(input: TrackInput): TrackMap {
+  const t0 = input.t0
+  const t1 = Math.max(input.t1, t0)
+  const folds = foldsOf(input)
+  const segs: TrackSeg[] = []
+  let a = t0
+  let total = 0
+  const push = (b: number, c: number, fold?: Fold) => {
+    const seg: TrackSeg = { a, b, c, v0: total }
+    if (fold) seg.fold = fold
+    segs.push(seg)
+    total += c
+    a = b
+  }
+  for (const f of folds) {
+    push(f.a, f.a - a)
+    push(f.b, RING.FOLD_LEN, f)
+  }
+  push(t1, t1 - a)
+  // first segment whose upper bound (t: b, v: v0 + c) is >= x; segments are ascending in both t and v
+  const find = (x: number, top: (s: TrackSeg) => number) => {
+    let lo = 0
+    let hi = segs.length - 1
+    while (lo < hi) {
+      const mid = (lo + hi) >> 1
+      if (top(segs[mid]) >= x) hi = mid
+      else lo = mid + 1
+    }
+    return segs[lo]
+  }
+  const vOf = (t: number) => {
+    const x = Math.min(t1, Math.max(t0, t))
+    const s = find(x, (s) => s.b)
+    return s.v0 + (s.b > s.a ? ((x - s.a) / (s.b - s.a)) * s.c : 0)
+  }
+  const tOf = (v: number) => {
+    const x = Math.min(total, Math.max(0, v))
+    const s = find(x, (s) => s.v0 + s.c)
+    return s.a + (s.c > 0 ? ((x - s.v0) / s.c) * (s.b - s.a) : 0)
+  }
+  return { segs, total, folds, vOf, tOf }
+}
+
+/** A fold is only known to be a long gap once FOLD_MIN of it has passed; before that its ≈ mark stays hidden. */
+export function foldVisible(f: Fold, t: number): boolean {
+  return t >= f.from + RING.FOLD_MIN
+}
+
+/** Real time of the gap that has passed by t (never the whole span while t is inside it). */
+export function foldElapsed(f: Fold, t: number): number {
+  return Math.max(0, Math.min(t, f.to ?? t) - f.from)
+}
+
+/** Ticks at or before t; later ticks are not drawn at all. */
+export function ticksAt(input: TrackInput, t: number): TrackInput["ticks"] {
+  return input.ticks.filter((k) => k.t <= t)
+}
+
+/** The round the playhead is in: the last one started at or before t. */
+export function trackRoundAt(input: TrackInput, t: number): TrackInput["rounds"][number] | undefined {
+  let cur: TrackInput["rounds"][number] | undefined
+  for (const r of input.rounds) if (r.start <= t && (!cur || r.start >= cur.start)) cur = r
+  return cur
+}
+
+/** Width estimate for the track font (mockup textW L394): CJK and wider glyphs one em, the rest 0.61 em. */
+export function textWidth(s: string, px: number): number {
+  let n = 0
+  for (const ch of s) n += (ch.codePointAt(0) ?? 0) >= 0x2e80 ? px : px * 0.61
+  return n
+}
+
+// short labels: the short duration has no hour tier, so long gaps switch to the long form (a size rule, not a locale rule)
+const shortDur = (ms: number): PhraseParam => (ms >= HOUR ? { ms, long: true } : { ms })
+
+type Cand = { x: number; text: Phrase; start?: true }
+type Item = { c: Cand[]; cls: "" | "r"; pri: number; at: number }
+
+/**
+ * Labels at t, placed by priority (mockup L1586-1618): the ongoing wait / idle, then the current round, then past
+ * gaps of this round, other rounds, older gaps. Each candidate has long → short forms; a label that fits in none is
+ * dropped. A round right after an idle gap shares one label with it. `x` is the label's left edge in px.
+ */
+export function trackLabelsAt(
+  map: TrackMap,
+  input: TrackInput,
+  t: number,
+  width: number,
+  measure: (p: Phrase) => number,
+): TrackLabel[] {
+  const W = width
+  const px = (v: number) => (map.total > 0 ? (v / map.total) * W : 0)
+  const foldText = (s: TrackSeg, f: Fold) => {
+    const el = foldElapsed(f, t)
+    const wait = f.kind === "wait"
+    const long: Phrase = { key: wait ? "ring.fold.wait" : "ring.fold.idle", params: { dur: { ms: el, long: true } } }
+    const short: Phrase = { key: wait ? "ring.fold.wait.short" : "ring.fold.idle.short", params: { dur: shortDur(el) } }
+    return { mid: px(s.v0 + s.c / 2), long, short }
+  }
+  const started = input.rounds.filter((r) => r.start <= t).sort((x, y) => x.start - y.start)
+  const cur = started[started.length - 1]
+  const items: Item[] = []
+  const glued = new Set<TrackSeg>()
+  for (const r of started) {
+    const round: Phrase = { key: "ring.track.round", params: { n: r.n } }
+    const c: Cand[] = []
+    const s = map.segs.find((x) => x.fold?.kind === "idle" && x.fold.to === r.start)
+    if (s?.fold && foldVisible(s.fold, t)) {
+      glued.add(s)
+      const ft = foldText(s, s.fold)
+      c.push(
+        { x: ft.mid, text: { key: "ring.fold.glued", params: { fold: ft.long, round } } },
+        { x: ft.mid, text: { key: "ring.fold.glued.short", params: { fold: ft.short, round } } },
+      )
+    }
+    c.push({ x: px(map.vOf(r.start)), text: round, start: true })
+    items.push({ c, cls: "r", pri: r === cur ? 1 : 3, at: r.start })
+  }
+  for (const s of map.segs) {
+    const f = s.fold
+    if (!f || glued.has(s) || !foldVisible(f, t)) continue
+    const ft = foldText(s, f)
+    const ongoing = f.to === undefined || t < f.to
+    items.push({
+      c: [
+        { x: ft.mid, text: ft.long },
+        { x: ft.mid, text: ft.short },
+      ],
+      cls: "",
+      pri: ongoing ? 0 : cur && f.from >= cur.start ? 2 : 4,
+      at: f.from,
+    })
+  }
+  items.sort((a, b) => a.pri - b.pri || b.at - a.at)
+
+  const span = (c: Cand): [number, number] | undefined => {
+    const w = measure(c.text) + 2
+    if (w > W) return undefined
+    const x0 = Math.max(0, Math.min(c.start ? c.x : c.x - w / 2, W - w))
+    return [x0, x0 + w]
+  }
+  const free = (sp: [number, number], used: [number, number][]) =>
+    !used.some((u) => sp[0] < u[1] + LABEL_GAP && sp[1] > u[0] - LABEL_GAP)
+  const used: [number, number][] = []
+  const pick = new Map<Item, { c: Cand; sp: [number, number] }>()
+  // the first two (ongoing gap, current round) choose their forms together so both fit when possible
+  if (items.length > 1) {
+    outer: for (const c0 of items[0].c)
+      for (const c1 of items[1].c) {
+        const a = span(c0)
+        const b = span(c1)
+        if (a && b && free(a, [b])) {
+          pick.set(items[0], { c: c0, sp: a })
+          pick.set(items[1], { c: c1, sp: b })
+          used.push(a, b)
+          break outer
+        }
+      }
+  }
+  const out: TrackLabel[] = []
+  for (const item of items) {
+    let hit = pick.get(item)
+    if (!hit) {
+      for (const c of item.c) {
+        const sp = span(c)
+        if (sp && free(sp, used)) {
+          hit = { c, sp }
+          break
+        }
+      }
+      if (!hit) continue
+      used.push(hit.sp)
+    }
+    const label: TrackLabel = { x: hit.sp[0], text: hit.c.text, cls: item.cls }
+    if (hit.c.start) label.start = true
+    out.push(label)
+  }
+  return out
+}
+
+/** ←/→: the nearest nav point strictly before (after) t; past either end, t0 / t1. `nav` is ascending. */
+export function navStep(nav: readonly number[], t: number, dir: -1 | 1, t0: number, t1: number): number {
+  // first index whose value is >= t (dir -1) or > t (dir 1)
+  let lo = 0
+  let hi = nav.length
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1
+    if (dir < 0 ? nav[mid] < t : nav[mid] <= t) lo = mid + 1
+    else hi = mid
+  }
+  const hit = dir < 0 ? (lo > 0 ? nav[lo - 1] : undefined) : lo < nav.length ? nav[lo] : undefined
+  return Math.min(t1, Math.max(t0, hit ?? (dir < 0 ? t0 : t1)))
+}
