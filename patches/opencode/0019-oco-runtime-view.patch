+                  </button>
+                </Show>
+              </div>
+              <div class="flex items-center gap-4 min-w-0 text-12-regular">
+                <span class="ell min-w-0 flex-1">
+                  <span style={{ color: "var(--rt-accent)" }}>↓ {t("handoff.given")}</span>
+                  <span style={{ color: "var(--rt-text)" }}> #{p().dispatchRequest + 1} </span>
+                  {(p().prompt ?? p().description).replace(/\s+/g, " ")}
+                </span>
+                <span class="ell min-w-0 flex-1">
+                  <span style={{ color: "var(--rt-ok)" }}>↑ {t("handoff.returned")}</span>{" "}
+                  <Show when={p().retrieveRequest !== undefined && p().background}>
+                    <span style={{ color: "var(--rt-text)" }}>#{p().retrieveRequest! + 1} </span>
+                  </Show>
+                  {p().result
+                    ? `${t("handoff.size", { n: p().result!.length })} · ${p().result!.replace(/\s+/g, " ")}`
+                    : t("handoff.not_returned")}
+                </span>
+                <span class="shrink-0" style={{ color: "var(--rt-faint)" }}>
+                  {[
+                    p().childTools !== undefined ? t("handoff.tools", { n: p().childTools! }) : "",
+                    p().start !== undefined ? formatElapsed(p().start!, p().end, props.now()) : "",
+                  ]
+                    .filter(Boolean)
+                    .join(" · ")}
+                </span>
+              </div>
+            </>
+          )}
+        </Show>
+      </div>
+
+      <Show when={expanded() && shownProbe()}>
+        {(p) => (
+          <div
+            data-oco-runtime-handoff-panel
+            role="dialog"
+            aria-label={p().description || p().agent}
+            class="absolute inset-0 z-20 flex flex-col rounded-sm px-4 py-3 select-text"
+            style={{ background: "var(--rt-inset)", border: "1px solid var(--rt-line-strong)" }}
+            onKeyDown={(e) => {
+              if (e.key === "Escape") {
+                e.preventDefault()
+                e.stopPropagation()
+                setExpanded(false)
+              }
+            }}
+          >
+            <div class="flex items-center gap-2 shrink-0">
+              <span class="text-12-bold font-bold" style={{ color: "var(--rt-sub)" }}>
+                {p().agent}
+              </span>
+              <span class="ell text-12-regular" style={{ color: "var(--rt-text)" }}>
+                {p().description}
+              </span>
+              <button
+                type="button"
+                ref={(el) => queueMicrotask(() => el.focus())}
+                class={`ml-auto px-2 rounded bg-transparent border-0 cursor-pointer text-12-regular font-mono ${FOCUS}`}
+                style={{ color: "var(--rt-weak)" }}
+                onClick={() => setExpanded(false)}
+              >
+                {t("think.close")}
+              </button>
+            </div>
+            <div
+              class="overflow-y-auto min-h-0 flex-1 mt-2 text-12-regular leading-relaxed whitespace-pre-wrap break-words"
+              style={{ color: "var(--rt-text)" }}
+            >
+              <div style={{ color: "var(--rt-accent)" }}>{t("handoff.given")}</div>
+              <div class="mb-3">{p().prompt ?? "—"}</div>
+              <div style={{ color: "var(--rt-ok)" }}>{t("handoff.returned")}</div>
+              <div>{p().result ?? t("handoff.not_returned")}</div>
+            </div>
+          </div>
+        )}
+      </Show>
+    </div>
+  )
+}
