+test("15 root rebuild reuses settled requests from prev by messageID (D11); chained over the fixture it equals a fresh build", () => {
+  const { input } = loadM5Fixture()
+  const all = buildRingIndex(input)
+  const kids = all.subs.flatMap((s) => (s.sessionID ? [s.sessionID] : []))
+  const ts = [0.08, 0.2, 0.33, 0.47, 0.6, 0.74, 0.87, 1].map((f) => all.times[Math.round(f * (all.times.length - 1))])
+  const requests = (x: RingIndex) => x.rounds.flatMap((r) => r.requests)
+  let prevInput = truncateAt(input, ts[0])
+  let prev = buildRingIndex(prevInput)
+  let reused = 0
+  let rounds = prev.rounds.length
+  for (const t of ts.slice(1)) {
+    const cur = truncateAt(input, t)
+    const next = buildRingIndex({ ...cur, dirty: new Set([cur.sessionID, ...kids]) }, prev)
+    expect(next).toStrictEqual(buildRingIndex(cur))
+    expect(prev).toStrictEqual(buildRingIndex(prevInput)) // prev is never mutated
+    const old = new Map(requests(prev).map((q) => [q.messageID, q]))
+    for (const q of requests(next)) {
+      const o = old.get(q.messageID)
+      if (o !== q) continue
+      reused++
+      expect(o.completed! <= t).toBe(true)
+      expect(o.tools.some((x) => x.kind === "task" || x.name === "todowrite")).toBe(false)
+    }
+    // a request that was still running in prev is rebuilt
+    for (const o of requests(prev)) if (o.completed === undefined) expect(requests(next)).not.toContain(o)
+    prev = next
+    prevInput = cur
+  }
+  expect(prev.rounds.length).toBeGreaterThan(rounds)
+  expect(reused).toBeGreaterThan(0)
+  // the whole chain ends at the full data
+  expect(prev).toStrictEqual(all)
+})
