+// oco (patches/opencode/0019): keyed projection tests.
+import { describe, expect, test } from "bun:test"
+import { sameIds } from "./session-runtime-keyed"
+
+describe("sameIds", () => {
+  test("equal sequences match", () => {
+    expect(sameIds(["a", "b"], ["a", "b"])).toBe(true)
+    expect(sameIds([], [])).toBe(true)
+  })
+
+  test("different lengths do not match", () => {
+    expect(sameIds(["a"], ["a", "b"])).toBe(false)
+    expect(sameIds(["a", "b"], ["a"])).toBe(false)
+  })
+
+  test("a different order does not match", () => {
+    expect(sameIds(["a", "b"], ["b", "a"])).toBe(false)
+  })
+})
