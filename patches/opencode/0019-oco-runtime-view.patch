+// oco (patches/opencode/0019): branch coverage for runtime action predicates.
+import { describe, expect, test } from "bun:test"
+import {
+  actionsVisible,
+  autoSyncTargets,
+  cancelLabel,
+  failureVisible,
+  lastChildToolIds,
+  pinDiff,
+  pinTargets,
+  retryWait,
+  stopClickExpired,
+  stopClickedAt,
+  toolDetail,
+  treeNodes,
+  treePinTargets,
+  treeSyncTargets,
+  type ActionRunState,
+  type RuntimeMode,
+  type TreeNode,
+} from "./session-runtime-actions"
+import type { ChildLifecycle, RuntimeModel, RuntimeTool } from "./session-runtime-model"
+
+const STATES: ActionRunState[] = ["working", "waiting-user", "retrying", "idle", "error", "unknown"]
+const MODES: RuntimeMode[] = ["live", "replay"]
+
+describe("actionsVisible", () => {
+  test("live, busy, and an in-progress state shows the stop control", () => {
+    expect(actionsVisible("live", "working", true)).toBe(true)
+    expect(actionsVisible("live", "retrying", true)).toBe(true)
+    expect(actionsVisible("live", "waiting-user", true)).toBe(true)
+  })
+
+  test("live, busy, and a settled state hides it", () => {
+    expect(actionsVisible("live", "idle", true)).toBe(false)
+    expect(actionsVisible("live", "error", true)).toBe(false)
+    expect(actionsVisible("live", "unknown", true)).toBe(false)
+  })
+
+  test("an idle root session hides it even when run state is in-progress", () => {
+    expect(actionsVisible("live", "waiting-user", false)).toBe(false)
+    expect(actionsVisible("live", "working", false)).toBe(false)
+    expect(actionsVisible("live", "retrying", false)).toBe(false)
+    expect(actionsVisible("live", "idle", false)).toBe(false)
+  })
+
+  test("replay hides it for every run state and busy value", () => {
+    for (const state of STATES) {
+      expect(actionsVisible("replay", state, true)).toBe(false)
+      expect(actionsVisible("replay", state, false)).toBe(false)
+    }
+  })
+
+  test("every mode, state, and busy triplet is decided", () => {
+    const shown = MODES.flatMap((mode) =>
+      STATES.flatMap((state) =>
+        [true, false].map((busy) => [mode, state, busy, actionsVisible(mode, state, busy)] as const),
+      ),
+    )
+    expect(shown.filter(([, , , on]) => on).map(([mode, state, busy]) => `${mode}:${state}:${busy}`)).toEqual([
+      "live:working:true",
+      "live:waiting-user:true",
+      "live:retrying:true",
+    ])
+  })
+})
+
+describe("cancelLabel", () => {
+  test("a cancelled focus is cancelled even without a click", () => {
+    expect(cancelLabel(undefined, false, "cancelled", undefined)).toBe("cancelled")
+  })
+
+  test("a cancelled focus stays cancelled after a newer request and while busy", () => {
+    expect(cancelLabel(1_000, true, "cancelled", 5_000)).toBe("cancelled")
+  })
+
+  test("a click while busy with no later request is requested", () => {
+    expect(cancelLabel(1_000, true, "working", undefined)).toBe("requested")
+    expect(cancelLabel(1_000, true, "retry", 1_000)).toBe("requested")
+    expect(cancelLabel(1_000, true, "working", 999)).toBe("requested")
+  })
+
+  test("no click, a finished run, or a request that started after the click is unlabeled", () => {
+    expect(cancelLabel(undefined, true, "working", 1)).toBeUndefined()
+    expect(cancelLabel(1_000, false, "idle", 500)).toBeUndefined()
+    expect(cancelLabel(1_000, true, "working", 1_001)).toBeUndefined()
+    expect(cancelLabel(undefined, false, "done", undefined)).toBeUndefined()
+  })
+
+  test("replay does not return requested; a cancelled focus still does", () => {
+    expect(cancelLabel(1_000, true, "working", 500, "replay")).toBeUndefined()
+    expect(cancelLabel(1_000, true, "working", undefined, "replay")).toBeUndefined()
+    expect(cancelLabel(1_000, true, "cancelled", 5_000, "replay")).toBe("cancelled")
+    expect(cancelLabel(undefined, false, "cancelled", undefined, "replay")).toBe("cancelled")
+  })
+})
+
+describe("stopClickExpired", () => {
+  test("an idle live run or a later live request expires the click", () => {
+    expect(stopClickExpired(1_000, false, 500)).toBe(true)
+    expect(stopClickExpired(1_000, true, 1_001)).toBe(true)
+  })
+
+  test("a busy live run whose last request started at or before the click keeps it", () => {
+    expect(stopClickExpired(1_000, true, 1_000)).toBe(false)
+    expect(stopClickExpired(1_000, true, 999)).toBe(false)
+    expect(stopClickExpired(1_000, true, undefined)).toBe(false)
+  })
+})
+
+describe("failureVisible", () => {
+  test("only an id still in the live attention list is marked failed", () => {
+    expect(failureVisible("req", ["req", "other"])).toBe(true)
+    expect(failureVisible("gone", ["req"])).toBe(false)
+    expect(failureVisible("gone", [])).toBe(false)
+  })
+})
+
+describe("stopClickedAt", () => {
+  test("no stop handler means no click timestamp", () => {
+    expect(stopClickedAt(false, 1_000)).toBeUndefined()
+    expect(stopClickedAt(true, 1_000)).toBe(1_000)
+  })
+})
+
+describe("autoSyncTargets", () => {
+  const turn = (sessionID: string | undefined, n: number) => ({ sessionID, turn: n })
+
+  test("only the current turn, skipping ids with no session and ids already requested", () => {
+    const already = new Set(["seen"])
+    expect(
+      autoSyncTargets(
+        [turn(undefined, 2), turn("", 2), turn("seen", 2), turn("old", 1), turn("now", 2), turn("other", 3)],
+        2,
+        already,
+      ),
+    ).toEqual(["now"])
+    expect([...already]).toEqual(["seen"])
+  })
+
+  test("duplicates count once and the list stops at the limit", () => {
+    const tools = ["a", "a", "b", "c", "d", "e", "f", "g", "h", "i"].map((sessionID) => turn(sessionID, 0))
+    expect(autoSyncTargets(tools, 0, new Set(), 8)).toEqual(["a", "b", "c", "d", "e", "f", "g", "h"])
+  })
+
+  test("the cap is the turn's total: a second call only gets what the first left", () => {
+    const tools = Array.from({ length: 20 }, (_, i) => turn(`c${i}`, 4))
+    const already = new Set<string>()
+    const first = autoSyncTargets(tools, 4, already)
+    expect(first).toHaveLength(8)
+    first.forEach((id) => already.add(id))
+    expect(autoSyncTargets(tools, 4, already, 8, first.length)).toEqual([])
+    expect(autoSyncTargets(tools, 4, already, 8, 5)).toEqual(["c8", "c9", "c10"])
+  })
+
+  test("no current turn or a non-positive limit syncs nothing", () => {
+    expect(autoSyncTargets([turn("a", 0)], undefined, new Set())).toEqual([])
+    expect(autoSyncTargets([turn("a", 0)], 0, new Set(), 0)).toEqual([])
+  })
+})
+
+describe("pinTargets", () => {
+  test("pins expanded sessions and in-progress children, once each", () => {
+    const expanded = new Set(["open-done"])
+    expect(
+      pinTargets(
+        [
+          { sessionID: "run", lifecycle: "running" },
+          { sessionID: "run", lifecycle: "running" },
+          { sessionID: "retry", lifecycle: "retrying" },
+          { sessionID: "wait", lifecycle: "waiting-user" },
+          { sessionID: "open-done", lifecycle: "done" },
+          { sessionID: "done", lifecycle: "done" },
+          { sessionID: "err", lifecycle: "error" },
+          { sessionID: undefined, lifecycle: "running" },
+          { lifecycle: "running" },
+        ],
+        expanded,
+      ),
+    ).toEqual(["open-done", "run", "retry", "wait"])
+  })
+
+  test("a collapsed terminal child is not pinned", () => {
+    expect(pinTargets([{ sessionID: "done", lifecycle: "done" }], new Set())).toEqual([])
+    expect(pinTargets([{ sessionID: "x", lifecycle: "unknown" }], new Set())).toEqual([])
+  })
+})
+
+describe("retryWait", () => {
+  test("a future next counts up in whole seconds", () => {
+    expect(retryWait(10_500, 10_000)).toEqual({ due: false, seconds: 1 })
+    expect(retryWait(12_000, 10_000)).toEqual({ due: false, seconds: 2 })
+  })
+
+  test("next at or before now is due", () => {
+    expect(retryWait(10_000, 10_000)).toEqual({ due: true, seconds: 0 })
+    expect(retryWait(9_000, 10_000)).toEqual({ due: true, seconds: 0 })
+  })
+})
+
+describe("pinDiff", () => {
+  test("calculates newly added and removed session IDs", () => {
+    const diff = pinDiff(["a", "b"], ["b", "c"])
+    expect(diff).toEqual({ pin: ["c"], unpin: ["a"] })
+  })
+
+  test("handles empty previous set (initial pin)", () => {
+    const diff = pinDiff([], ["a", "b"])
+    expect(diff).toEqual({ pin: ["a", "b"], unpin: [] })
+  })
+
+  test("handles empty next set (cleanup unpin)", () => {
+    const diff = pinDiff(["a", "b"], [])
+    expect(diff).toEqual({ pin: [], unpin: ["a", "b"] })
+  })
+
+  test("returns empty arrays when sets are identical", () => {
+    const diff = pinDiff(["a", "b"], ["a", "b"])
+    expect(diff).toEqual({ pin: [], unpin: [] })
+  })
+
+  test("works with Sets and deduplicates inputs", () => {
+    const diff = pinDiff(new Set(["a", "b"]), ["b", "b", "c"])
+    expect(diff).toEqual({ pin: ["c"], unpin: ["a"] })
+  })
+})
+
+describe("lastChildToolIds", () => {
+  test("returns only the last tool id when multiple task rows reference the same child session", () => {
+    const tools = [
+      { id: "tool-1", child: { sessionID: "child-s1" } },
+      { id: "tool-2", child: { sessionID: "child-s2" } },
+      { id: "tool-3", child: { sessionID: "child-s1" } },
+    ]
+    const lastIds = lastChildToolIds(tools)
+    expect(lastIds).toEqual(new Set(["tool-2", "tool-3"]))
+    expect(lastIds.has("tool-1")).toBe(false)
+  })
+
+  test("ignores tools without child or with undefined sessionID", () => {
+    const tools = [
+      { id: "tool-1" },
+      { id: "tool-2", child: {} },
+      { id: "tool-3", child: { sessionID: "child-s1" } },
+    ]
+    expect(lastChildToolIds(tools)).toEqual(new Set(["tool-3"]))
+  })
+
+  test("handles empty tools list", () => {
+    expect(lastChildToolIds([])).toEqual(new Set())
+  })
+})
+
+describe("treeNodes", () => {
+  const tool = (
+    id: string,
+    request: number,
+    childSessionID?: string,
+    lifecycle: ChildLifecycle = "done",
+  ): RuntimeTool => ({
+    id,
+    callID: `call_${id}`,
+    messageID: `msg_${id}`,
+    request,
+    name: childSessionID ? "task" : "bash",
+    state: lifecycle === "running" ? "running" : "completed",
+    interrupted: false,
+    cancelled: false,
+    input: "{}",
+    child: childSessionID
+      ? {
+          sessionID: childSessionID,
+          agent: `agent_${childSessionID}`,
+          description: "subagent",
+          background: false,
+          lifecycle,
+          evidence: "event",
+        }
+      : undefined,
+  })
+
+  const model = (sessionID: string, requests: number[], tools: RuntimeTool[]): RuntimeModel => ({
+    mode: "live",
+    stage: "idle",
+    run: { state: "idle", evidence: "event", attention: [], attentionKnown: true },
+    focus: { kind: "idle" },
+    sessions: [{ id: sessionID, kind: "child", state: "idle", evidence: "event" }],
+    requests: requests.map((index) => ({
+      index,
+      messageID: `msg_req_${index}`,
+      turn: index,
+      start: 1000 + index * 100,
+      status: "done",
+      cancelled: false,
+      evidence: "event",
+      settled: true,
+      known: true,
+    })),
+    tools,
+    events: [],
+    usage: { requests: requests.length, knownRequests: requests.length, settled: true, context: {} },
+    freshness: { observedAt: 1000, evidence: "inferred" },
+  })
+
+  test("depth 3 tree discovers nodes in root-proximate order (near-root first)", () => {
+    // Root has child1, child2
+    const rootTools = [
+      tool("r_bash", 0),
+      tool("r_c1", 0, "child1", "done"),
+      tool("r_c2", 0, "child2", "running"),
+    ]
+
+    // child1 has g1, g2
+    const child1Model = model("child1", [0], [
+      tool("c1_g1", 0, "g1", "done"),
+      tool("c1_g2", 0, "g2", "done"),
+    ])
+
+    // child2 has g3
+    const child2Model = model("child2", [0], [
+      tool("c2_g3", 0, "g3", "running"),
+    ])
+
+    // g1 has gg1 (depth 3)
+    const g1Model = model("g1", [0], [
+      tool("g1_gg1", 0, "gg1", "done"),
+    ])
+
+    const childModels: Record<string, RuntimeModel> = {
+      child1: child1Model,
+      child2: child2Model,
+      g1: g1Model,
+    }
+
+    const nodes = treeNodes(rootTools, (id) => childModels[id])
+
+    // Expected depth order: depth 1 (child1, child2), depth 2 (g1, g2, g3), depth 3 (gg1)
+    expect(nodes.map((n) => ({ id: n.sessionID, depth: n.depth, order: n.order, parent: n.parent }))).toEqual([
+      { id: "child1", depth: 1, order: 0, parent: "" },
+      { id: "child2", depth: 1, order: 1, parent: "" },
+      { id: "g1", depth: 2, order: 0, parent: "child1" },
+      { id: "g2", depth: 2, order: 1, parent: "child1" },
+      { id: "g3", depth: 2, order: 2, parent: "child2" },
+      { id: "gg1", depth: 3, order: 0, parent: "g1" },
+    ])
+  })
+
+  test("truncates when depth exceeds maxDepth (default 8)", () => {
+    // Create a 10-level chain: level1 -> level2 -> ... -> level10
+    const models: Record<string, RuntimeModel> = {}
+    for (let i = 1; i < 10; i++) {
+      models[`level${i}`] = model(`level${i}`, [0], [
+        tool(`t_level${i}`, 0, `level${i + 1}`, "running"),
+      ])
+    }
+    const rootTools = [tool("r_l1", 0, "level1", "running")]
+
+    const nodes = treeNodes(rootTools, (id) => models[id], 8)
+    expect(nodes).toHaveLength(8)
+    expect(nodes.map((n) => n.sessionID)).toEqual([
+      "level1",
+      "level2",
+      "level3",
+      "level4",
+      "level5",
+      "level6",
+      "level7",
+      "level8",
+    ])
+    expect(nodes.find((n) => n.sessionID === "level9")).toBeUndefined()
+    expect(nodes.find((n) => n.sessionID === "level10")).toBeUndefined()
+  })
+
+  test("terminates without infinite loop when parentOf / task references form a cycle", () => {
+    // A -> B -> A cycle
+    const models: Record<string, RuntimeModel> = {
+      A: model("A", [0], [tool("t_a_b", 0, "B", "running")]),
+      B: model("B", [0], [tool("t_b_a", 0, "A", "running")]),
+    }
+    const rootTools = [tool("r_a", 0, "A", "running")]
+
+    const nodes = treeNodes(rootTools, (id) => models[id])
+    expect(nodes.map((n) => n.sessionID)).toEqual(["A", "B"])
+  })
+
+  test("determines current based on last request or in-progress lifecycle", () => {
+    // Root has 2 requests: 0 and 1
+    const rootTools = [
+      tool("r_old_done", 0, "old_done", "done"),
+      tool("r_old_running", 0, "old_running", "running"),
+      tool("r_now_done", 1, "now_done", "done"),
+      tool("r_now_error", 1, "now_error", "error"),
+    ]
+
+    const nodes = treeNodes(rootTools, () => undefined)
+    const map = new Map(nodes.map((n) => [n.sessionID, n.current]))
+    expect(map.get("old_done")).toBe(false)
+    expect(map.get("old_running")).toBe(true) // running in old request is current
+    expect(map.get("now_done")).toBe(true) // done in latest request is current
+    expect(map.get("now_error")).toBe(true) // error in latest request is current
+  })
+
+  test("uses the last tool row when multiple task rows reference the same child session", () => {
+    const rootTools = [
+      tool("t1", 0, "child1", "running"),
+      tool("t2", 1, "child1", "done"),
+    ]
+    const nodes = treeNodes(rootTools, () => undefined)
+    expect(nodes).toHaveLength(1)
+    expect(nodes[0].sessionID).toBe("child1")
+    expect(nodes[0].lifecycle).toBe("done")
+    expect(nodes[0].current).toBe(true) // request 1 is the last request
+  })
+})
+
+describe("treeSyncTargets", () => {
+  const node = (
+    sessionID: string,
+    depth: number,
+    order: number,
+    current = true,
+    lifecycle: ChildLifecycle = "done",
+  ): TreeNode => ({
+    sessionID,
+    parent: "",
+    depth,
+    order,
+    current,
+    lifecycle,
+  })
+
+  test("depth 3 tree targets near root first and order ascending", () => {
+    const nodes = [
+      node("c2", 1, 1),
+      node("g1", 2, 0),
+      node("c1", 1, 0),
+      node("gg1", 3, 0),
+      node("g2", 2, 1),
+    ]
+    expect(treeSyncTargets(nodes, new Set())).toEqual(["c1", "c2", "g1", "g2", "gg1"])
+  })
+
+  test("caps targets at limit (default 8)", () => {
+    const nodes = Array.from({ length: 12 }, (_, i) => node(`s${i}`, 1, i))
+    expect(treeSyncTargets(nodes, new Set(), 8)).toEqual([
+      "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
+    ])
+  })
+
+  test("skips targets already in done set and non-current nodes", () => {
+    const nodes = [
+      node("s1", 1, 0, true),
+      node("s2", 1, 1, false), // not current
+      node("s3", 1, 2, true),
+      node("s4", 1, 3, true),
+    ]
+    const done = new Set(["s1", "other"])
+    expect(treeSyncTargets(nodes, done)).toEqual(["s3", "s4"])
+  })
+
+  test("returns empty array for non-positive limit or empty nodes", () => {
+    expect(treeSyncTargets([node("s1", 1, 0)], new Set(), 0)).toEqual([])
+    expect(treeSyncTargets([], new Set())).toEqual([])
+  })
+})
+
+describe("treePinTargets", () => {
+  const node = (sessionID: string, lifecycle: ChildLifecycle): TreeNode => ({
+    sessionID,
+    parent: "",
+    depth: 1,
+    order: 0,
+    current: true,
+    lifecycle,
+  })
+
+  test("running, retrying, and waiting-user grandchildren enter pin targets", () => {
+    const nodes = [
+      node("g_run", "running"),
+      node("g_retry", "retrying"),
+      node("g_wait", "waiting-user"),
+      node("g_done", "done"),
+      node("g_err", "error"),
+    ]
+    expect(treePinTargets(nodes, new Set())).toEqual(["g_run", "g_retry", "g_wait"])
+  })
+
+  test("pins expanded sessions even if completed, and dedupes with running sessions", () => {
+    const nodes = [
+      node("g_run", "running"),
+      node("g_done", "done"),
+    ]
+    const open = new Set(["g_done", "g_run", "external_open"])
+    expect(treePinTargets(nodes, open)).toEqual(["g_done", "g_run", "external_open"])
+  })
+
+  test("unpinned when grandchild ends and is not expanded", () => {
+    const runningNodes = [node("g_run", "running")]
+    expect(treePinTargets(runningNodes, new Set())).toEqual(["g_run"])
+
+    const doneNodes = [node("g_run", "done")]
+    expect(treePinTargets(doneNodes, new Set())).toEqual([])
+  })
+})
+
+describe("toolDetail", () => {
+  const baseTool: RuntimeTool = {
+    id: "tool_1",
+    callID: "call_abc",
+    messageID: "msg_1",
+    request: 0,
+    name: "bash",
+    state: "completed",
+    interrupted: false,
+    cancelled: false,
+    input: "echo hi",
+  }
+
+  test("missing start and end yields unknown text for start, end, and duration", () => {
+    const d = toolDetail(baseTool)
+    expect(d.startText).toBe("未知")
+    expect(d.endText).toBe("未知")
+    expect(d.durationText).toBe("未知")
+    expect(d.duration).toBeUndefined()
+    expect(d.callID).toBe("call_abc")
+  })
+
+  test("t helper provides localized unknown text", () => {
+    const t = (k: string) => (k === "tool.detail.unknown" ? "Unknown" : "")
+    const d = toolDetail(baseTool, t)
+    expect(d.startText).toBe("Unknown")
+    expect(d.endText).toBe("Unknown")
+    expect(d.durationText).toBe("Unknown")
+  })
+
+  test("running tool with start only has formatted start and unknown end/duration", () => {
+    const running: RuntimeTool = { ...baseTool, state: "running", start: 1700000000000 }
+    const d = toolDetail(running)
+    expect(d.startText).not.toBe("未知")
+    expect(d.endText).toBe("未知")
+    expect(d.durationText).toBe("未知")
+  })
+
+  test("completed tool calculates duration in ms or s", () => {
+    const subSec: RuntimeTool = { ...baseTool, start: 1000, end: 1450 }
+    const d1 = toolDetail(subSec)
+    expect(d1.duration).toBe(450)
+    expect(d1.durationText).toBe("450 ms")
+
+    const multiSec: RuntimeTool = { ...baseTool, start: 1000, end: 3500 }
+    const d2 = toolDetail(multiSec)
+    expect(d2.duration).toBe(2500)
+    expect(d2.durationText).toBe("2.5 s")
+  })
+
+  test("reports error text when state is error", () => {
+    const errTool: RuntimeTool = {
+      ...baseTool,
+      state: "error",
+      lastOutput: "Command failed with exit code 1",
+    }
+    const d = toolDetail(errTool)
+    expect(d.error).toBe("Command failed with exit code 1")
+
+    const cancelledTool: RuntimeTool = {
+      ...baseTool,
+      state: "error",
+      cancelled: true,
+    }
+    const d2 = toolDetail(cancelledTool)
+    expect(d2.error).toBe("Cancelled")
+  })
+
+  test("includes sessionID and evidence for subagent or interrupted tools", () => {
+    const childTool: RuntimeTool = {
+      ...baseTool,
+      child: {
+        agent: "coder",
+        description: "writing code",
+        background: false,
+        lifecycle: "running",
+        evidence: "event",
+        sessionID: "ses_child_42",
+      },
+    }
+    const d = toolDetail(childTool)
+    expect(d.sessionID).toBe("ses_child_42")
+    expect(d.evidence).toBe("event")
+
+    const interruptedTool: RuntimeTool = {
+      ...baseTool,
+      interrupted: true,
+    }
+    const d2 = toolDetail(interruptedTool)
+    expect(d2.evidence).toBe("inferred")
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-actions.ts b/packages/app/src/components/session/session-runtime-actions.ts
new file mode 100644
index 0000000..f39ed15
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-actions.ts
@@ -0,0 +1,397 @@
+// oco (patches/opencode/0019): pure predicates for runtime-view actions.
+// "requested" is click state only. "cancelled" is focus data only (MessageAbortedError).
+import type { ChildLifecycle, Evidence, RuntimeModel, RuntimeTool } from "./session-runtime-model"
+
+export type RuntimeMode = "live" | "replay"
+export type ActionRunState = "working" | "waiting-user" | "retrying" | "idle" | "error" | "unknown"
+export type CancelLabel = "requested" | "cancelled"
+
+const STOP_STATES: ReadonlySet<ActionRunState> = new Set(["working", "retrying", "waiting-user"])
+
+/** Stop renders only while live, root session is busy, and the run is still in progress (including a user wait or a retry). */
+export function actionsVisible(mode: RuntimeMode, runState: ActionRunState, busy: boolean): boolean {
+  return mode === "live" && busy && STOP_STATES.has(runState)
+}
+
+/**
+ * Label for data-oco-runtime-cancel.
+ * cancelled wins: it comes from focus, never from the click, including during replay.
+ * requested is this view's click and only while following live (a replay snapshot must not say "requested").
+ * While live, requested holds only when the click still covers this busy stretch (no later request has started).
+ */
+export function cancelLabel(
+  clickedAt: number | undefined,
+  busy: boolean,
+  focusKind: string,
+  lastRequestStart: number | undefined,
+  mode: RuntimeMode = "live",
+): CancelLabel | undefined {
+  if (focusKind === "cancelled") return "cancelled"
+  if (mode !== "live") return undefined
+  if (clickedAt !== undefined && busy && (lastRequestStart === undefined || lastRequestStart <= clickedAt)) return "requested"
+  return undefined
+}
+
+/**
+ * Forget a stop click once the live session is idle or a later live request has started.
+ * `liveLastStart` must be the live run's last request start, never a replay snapshot.
+ */
+export function stopClickExpired(clickedAt: number, busy: boolean, liveLastStart: number | undefined): boolean {
+  return !busy || (liveLastStart !== undefined && liveLastStart > clickedAt)
+}
+
+/** A failed reply stays visible only while that request is still in the live attention list. */
+export function failureVisible(id: string, attentionIds: readonly string[]): boolean {
+  return attentionIds.includes(id)
+}
+
+/** Arm "cancel requested" only when the page actually provided a stop handler. */
+export function stopClickedAt(hasHandler: boolean, now: number): number | undefined {
+  return hasHandler ? now : undefined
+}
+
+export type AutoSyncTool = { sessionID?: string; turn: number }
+
+/**
+ * Child sessions to `sync` for the current turn.
+ * Skips a missing session id, other turns, and ids already requested. Caps the turn's total at `limit` (default 8):
+ * `autoSynced` is how many this turn has already auto-synced, so repeated calls never exceed the cap.
+ * Does not mutate `already`.
+ */
+export function autoSyncTargets(
+  tools: readonly AutoSyncTool[],
+  lastTurn: number | undefined,
+  already: ReadonlySet<string>,
+  limit = 8,
+  autoSynced = 0,
+): string[] {
+  limit -= autoSynced
+  if (lastTurn === undefined || limit <= 0) return []
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const tool of tools) {
+    if (out.length >= limit) break
+    const id = tool.sessionID
+    if (!id || tool.turn !== lastTurn) continue
+    if (already.has(id) || seen.has(id)) continue
+    seen.add(id)
+    out.push(id)
+  }
+  return out
+}
+
+/** In-progress child lifecycles. A collapsed child in one of these stays pinned; terminal ones do not. */
+const PIN_LIFECYCLE: ReadonlySet<string> = new Set(["running", "retrying", "waiting-user"])
+
+export type PinTool = { sessionID?: string; lifecycle: string }
+
+/** Sessions to pin: every expanded id, plus in-progress children. Deduped. No id means skip. */
+export function pinTargets(tools: readonly PinTool[], expanded: ReadonlySet<string>): string[] {
+  const out: string[] = []
+  const seen = new Set<string>()
+  const add = (id: string | undefined) => {
+    if (!id || seen.has(id)) return
+    seen.add(id)
+    out.push(id)
+  }
+  for (const id of expanded) add(id)
+  for (const tool of tools) if (PIN_LIFECYCLE.has(tool.lifecycle)) add(tool.sessionID)
+  return out
+}
+
+/** Countdown for a retry `next` timestamp. due when next - now <= 0; otherwise whole seconds, rounded up. */
+export function retryWait(next: number, now: number): { due: boolean; seconds: number } {
+  const delta = next - now
+  if (delta <= 0) return { due: true, seconds: 0 }
+  return { due: false, seconds: Math.ceil(delta / 1000) }
+}
+
+export type PinDiff = {
+  pin: string[]
+  unpin: string[]
+}
+
+/**
+ * Computes incremental diff between previous and next sets of pinned session IDs.
+ * - `pin`: IDs in next but not in prev
+ * - `unpin`: IDs in prev but not in next
+ */
+export function pinDiff(prev: Iterable<string>, next: Iterable<string>): PinDiff {
+  const prevSet = prev instanceof Set ? (prev as Set<string>) : new Set(prev)
+  const nextSet = next instanceof Set ? (next as Set<string>) : new Set(next)
+  const pin: string[] = []
+  const unpin: string[] = []
+  for (const id of nextSet) {
+    if (!prevSet.has(id)) pin.push(id)
+  }
+  for (const id of prevSet) {
+    if (!nextSet.has(id)) unpin.push(id)
+  }
+  return { pin, unpin }
+}
+
+export type ChildToolLike = { id: string; child?: { sessionID?: string } }
+
+/**
+ * Computes the set of tool IDs that are the last row referencing each child session.
+ * When multiple task rows reference the same child session, only the last row renders
+ * the expand/collapse toggle and the expanded child panel.
+ */
+export function lastChildToolIds(tools: readonly ChildToolLike[]): Set<string> {
+  const lastForSession = new Map<string, string>()
+  for (const tool of tools) {
+    const sessionID = tool.child?.sessionID
+    if (sessionID) {
+      lastForSession.set(sessionID, tool.id)
+    }
+  }
+  return new Set(lastForSession.values())
+}
+
+export type TreeNode = {
+  sessionID: string
+  parent: string
+  depth: number
+  order: number
+  current: boolean
+  lifecycle: ChildLifecycle
+}
+
+/**
+ * Builds a breadth-first list of descendant session tree nodes starting from the root tools.
+ * Traverses loaded child models up to maxDepth (default 8).
+ * Avoids cycles by tracking the ancestor chain and terminates on any duplicate/cycle.
+ * "current" is determined by Ruling 7: task tool belongs to parent's last request or lifecycle is running|retrying|waiting-user.
+ */
+export function treeNodes(
+  rootTools: RuntimeTool[],
+  childModel: (sessionID: string) => RuntimeModel | undefined,
+  maxDepth = 8,
+): TreeNode[] {
+  if (maxDepth < 1) return []
+
+  const result: TreeNode[] = []
+  const depthOrder = new Map<number, number>()
+  const allVisited = new Set<string>()
+
+  const extractChildTools = (tools: readonly RuntimeTool[]): RuntimeTool[] => {
+    const lastForSession = new Map<string, RuntimeTool>()
+    for (const tool of tools) {
+      const sessionID = tool.child?.sessionID
+      if (sessionID) {
+        lastForSession.set(sessionID, tool)
+      }
+    }
+    const out: RuntimeTool[] = []
+    const seen = new Set<string>()
+    for (const tool of tools) {
+      const sessionID = tool.child?.sessionID
+      if (sessionID && !seen.has(sessionID) && lastForSession.get(sessionID) === tool) {
+        seen.add(sessionID)
+        out.push(tool)
+      }
+    }
+    return out
+  }
+
+  const rootLastReq = rootTools.length > 0 ? Math.max(...rootTools.map((t) => t.request)) : -1
+
+  type QueueItem = {
+    sessionID: string
+    parent: string
+    depth: number
+    tool: RuntimeTool
+    ancestors: Set<string>
+  }
+
+  const queue: QueueItem[] = []
+
+  const rootChildTools = extractChildTools(rootTools)
+  for (const tool of rootChildTools) {
+    const sessionID = tool.child!.sessionID!
+    if (allVisited.has(sessionID)) continue
+    allVisited.add(sessionID)
+    queue.push({
+      sessionID,
+      parent: "",
+      depth: 1,
+      tool,
+      ancestors: new Set([sessionID]),
+    })
+  }
+
+  while (queue.length > 0) {
+    const item = queue.shift()!
+    const order = depthOrder.get(item.depth) ?? 0
+    depthOrder.set(item.depth, order + 1)
+
+    const lifecycle = item.tool.child?.lifecycle ?? "unknown"
+    let isCurrent = PIN_LIFECYCLE.has(lifecycle)
+    if (!isCurrent) {
+      if (item.depth === 1) {
+        isCurrent = rootLastReq >= 0 && item.tool.request === rootLastReq
+      } else {
+        const parentM = childModel(item.parent)
+        if (parentM) {
+          const parentLastReq =
+            parentM.requests.length > 0
+              ? parentM.requests[parentM.requests.length - 1].index
+              : parentM.tools.length > 0
+                ? Math.max(...parentM.tools.map((t) => t.request))
+                : -1
+          isCurrent = parentLastReq >= 0 && item.tool.request === parentLastReq
+        }
+      }
+    }
+
+    result.push({
+      sessionID: item.sessionID,
+      parent: item.parent,
+      depth: item.depth,
+      order,
+      current: isCurrent,
+      lifecycle,
+    })
+
+    if (item.depth < maxDepth) {
+      const model = childModel(item.sessionID)
+      if (model) {
+        const childTools = extractChildTools(model.tools)
+        for (const childTool of childTools) {
+          const cID = childTool.child!.sessionID!
+          if (item.ancestors.has(cID) || allVisited.has(cID)) {
+            continue
+          }
+          allVisited.add(cID)
+          const nextAncestors = new Set(item.ancestors)
+          nextAncestors.add(cID)
+          queue.push({
+            sessionID: cID,
+            parent: item.sessionID,
+            depth: item.depth + 1,
+            tool: childTool,
+            ancestors: nextAncestors,
+          })
+        }
+      }
+    }
+  }
+
+  return result
+}
+
+/**
+ * Targets to auto-sync for the current turn across the whole session tree.
+ * Filters for current and not yet done, sorted by depth ascending, then order ascending (near-root first).
+ * Caps at limit (default 8).
+ */
+export function treeSyncTargets(nodes: readonly TreeNode[], done: ReadonlySet<string>, limit = 8): string[] {
+  if (limit <= 0) return []
+  const filtered = nodes.filter((n) => n.current && !done.has(n.sessionID))
+  filtered.sort((a, b) => a.depth - b.depth || a.order - b.order)
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const node of filtered) {
+    if (out.length >= limit) break
+    if (!seen.has(node.sessionID)) {
+      seen.add(node.sessionID)
+      out.push(node.sessionID)
+    }
+  }
+  return out
+}
+
+/**
+ * Sessions to pin across the entire tree: every expanded session plus any descendant
+ * with in-progress lifecycle (running | retrying | waiting-user). Deduped.
+ */
+export function treePinTargets(nodes: readonly TreeNode[], open: ReadonlySet<string>): string[] {
+  const out: string[] = []
+  const seen = new Set<string>()
+  const add = (id: string | undefined) => {
+    if (!id || seen.has(id)) return
+    seen.add(id)
+    out.push(id)
+  }
+  for (const id of open) add(id)
+  for (const node of nodes) {
+    if (PIN_LIFECYCLE.has(node.lifecycle)) {
+      add(node.sessionID)
+    }
+  }
+  return out
+}
+
+export const FOCUS =
+  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-border-focus"
+
+export const BTN = `h-6 px-2 rounded-[5px] text-12-medium bg-surface-inset-base text-text-base disabled:opacity-50 ${FOCUS}`
+
+export type ToolDetailInfo = {
+  callID: string
+  start?: number
+  end?: number
+  duration?: number
+  startText: string
+  endText: string
+  durationText: string
+  evidence?: Evidence
+  error?: string
+  sessionID?: string
+}
+
+export function toolDetail(
+  tool: RuntimeTool,
+  t?: (key: any, params?: any) => string,
+  locale?: string,
+): ToolDetailInfo {
+  const unknown = t ? t("tool.detail.unknown") : "未知"
+  const start = tool.start
+  const end = tool.end
+  const hasStart = typeof start === "number" && !isNaN(start)
+  const hasEnd = typeof end === "number" && !isNaN(end)
+  const duration = hasStart && hasEnd ? Math.max(0, end - start) : undefined
+
+  const formatTime = (ts: number) => {
+    try {
+      return new Date(ts).toLocaleTimeString(locale)
+    } catch {
+      return new Date(ts).toISOString()
+    }
+  }
+
+  const formatDur = (ms: number) => {
+    if (ms < 1000) return `${ms} ms`
+    const sec = (ms / 1000).toFixed(1)
+    const cleanSec = sec.endsWith(".0") ? sec.slice(0, -2) : sec
+    return t ? t("ago.seconds", { value: cleanSec }) : `${cleanSec} s`
+  }
+
+  const startText = hasStart ? formatTime(start!) : unknown
+  const endText = hasEnd ? formatTime(end!) : unknown
+  const durationText = duration !== undefined ? formatDur(duration) : unknown
+
+  const evidence = tool.child?.evidence ?? (tool.interrupted ? "inferred" : undefined)
+
+  let error: string | undefined
+  if (tool.state === "error") {
+    error =
+      tool.lastOutput ||
+      (tool.cancelled ? (t ? t("tool.cancelled") : "Cancelled") : t ? t("tool.state.error") : "Failed")
+  }
+
+  const sessionID = tool.child?.sessionID
+
+  return {
+    callID: tool.callID,
+    start,
+    end,
+    duration,
+    startText,
+    endText,
+    durationText,
+    evidence,
+    error,
+    sessionID,
+  }
+}
diff --git a/packages/app/src/components/session/session-runtime-child-sync.ts b/packages/app/src/components/session/session-runtime-child-sync.ts
new file mode 100644
index 0000000..3768196
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-child-sync.ts
@@ -0,0 +1,109 @@
+// oco (patches/opencode/0019): reactive wiring for whole-tree child auto-sync and pinning.
+import type { Accessor } from "solid-js"
+import { createEffect, createMemo, onCleanup, untrack } from "solid-js"
+import { pinDiff, treeNodes, treePinTargets, treeSyncTargets } from "./session-runtime-actions"
+import type { RuntimeModel, RuntimeTool } from "./session-runtime-model"
+
+export type ChildSyncDeps = {
+  sync: (sessionID: string) => Promise<unknown>
+  pin: (sessionID: string) => void
+  unpin: (sessionID: string) => void
+  childModel: (sessionID: string) => RuntimeModel | undefined
+  turn: Accessor<number | undefined>
+  open: Accessor<ReadonlySet<string>>
+  tools: Accessor<RuntimeTool[]>
+  limit?: number
+}
+
+export type ChildSync = {
+  requestSync: (sessionID: string) => void
+  synced: ReadonlySet<string>
+  failed: ReadonlySet<string>
+  pinned: Accessor<string[]>
+}
+
+export function createChildSync(deps: ChildSyncDeps): ChildSync {
+  const synced = new Set<string>()
+  const failed = new Set<string>()
+
+  const requestSync = (id: string) => {
+    synced.add(id)
+    failed.delete(id)
+    void Promise.resolve(deps.sync(id)).catch(() => {
+      failed.add(id)
+    })
+  }
+
+  let autoTurn: number | undefined
+  let autoCount = 0
+
+  createEffect(() => {
+    const currentTurn = deps.turn()
+    if (currentTurn !== autoTurn) {
+      autoTurn = currentTurn
+      autoCount = 0
+    }
+    if (currentTurn === undefined) return
+
+    const rootTools = deps.tools()
+    const nodes = treeNodes(rootTools, deps.childModel)
+    const remainingLimit = (deps.limit ?? 8) - autoCount
+    if (remainingLimit > 0) {
+      const targets = treeSyncTargets(nodes, synced, remainingLimit)
+      autoCount += targets.length
+      untrack(() => {
+        for (const id of targets) {
+          requestSync(id)
+        }
+      })
+    }
+  })
+
+  let prevOpen = new Set<string>()
+  createEffect(() => {
+    const currentOpen = deps.open()
+    for (const id of currentOpen) {
+      if (!prevOpen.has(id)) {
+        if (!synced.has(id) || failed.has(id) || deps.childModel(id) === undefined) {
+          requestSync(id)
+        }
+      }
+    }
+    prevOpen = new Set(currentOpen)
+  })
+
+  const pinned = createMemo(
+    () => {
+      const rootTools = deps.tools()
+      const nodes = treeNodes(rootTools, deps.childModel)
+      return treePinTargets(nodes, deps.open())
+    },
+    [] as string[],
+    { equals: (prev, next) => prev.length === next.length && prev.every((id, index) => id === next[index]) },
+  )
+
+  let lastPinned = new Set<string>()
+  createEffect(() => {
+    const nextIds = pinned()
+    untrack(() => {
+      const { pin, unpin } = pinDiff(lastPinned, nextIds)
+      for (const id of unpin) deps.unpin(id)
+      for (const id of pin) deps.pin(id)
+      lastPinned = new Set(nextIds)
+    })
+  })
+
+  onCleanup(() => {
+    untrack(() => {
+      for (const id of lastPinned) deps.unpin(id)
+      lastPinned.clear()
+    })
+  })
+
+  return {
+    requestSync,
+    synced,
+    failed,
+    pinned,
+  }
+}
diff --git a/packages/app/src/components/session/session-runtime-child.tsx b/packages/app/src/components/session/session-runtime-child.tsx
new file mode 100644
index 0000000..e903521
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-child.tsx
@@ -0,0 +1,322 @@
+import type { Accessor } from "solid-js"
+import { createMemo, createSignal, For, Show } from "solid-js"
+import { BTN, FOCUS, lastChildToolIds, retryWait, toolDetail } from "./session-runtime-actions"
+import { keyed } from "./session-runtime-keyed"
+import type { RuntimeText } from "./session-runtime-i18n"
+import type { ChildLifecycle, RuntimeModel, RuntimeTool, Stage } from "./session-runtime-model"
+
+const GLYPH = { pending: "○", running: "◐", completed: "✓", error: "✕" } as const
+const COLOR = {
+  model: "var(--syntax-property)",
+  tool: "var(--syntax-warning)",
+  subagent: "var(--syntax-keyword)",
+  attention: "var(--syntax-info)",
+  error: "var(--syntax-critical)",
+  ok: "var(--syntax-success)",
+} as const
+
+const stageKey = (s: Stage): Exclude<Stage, "idle"> => (s === "idle" ? "prepare" : s)
+const lifecycleKey = (lifecycle: ChildLifecycle) => `child.lifecycle.${lifecycle}` as "child.lifecycle.running"
+
+const focusLine = (m: RuntimeModel, t: RuntimeText["t"], now: number) => {
+  const focus = m.focus
+  switch (focus.kind) {
+    case "attention":
+      return focus.attention.kind === "permission"
+        ? t("focus.attention.permission", { what: [focus.attention.permission, ...focus.attention.patterns].join(" ") })
+        : t("focus.attention.question", { what: focus.attention.text })
+    case "retry": {
+      const wait = retryWait(focus.next, now)
+      return wait.due ? t("retry.soon") : t("retry.countdown", { attempt: focus.attempt, seconds: wait.seconds })
+    }
+    case "error":
+      return focus.message ? t("focus.error", { message: focus.message }) : t("focus.error.unknown")
+    case "working":
+      return focus.tool
+        ? t("focus.working.tool", { tool: focus.tool.child?.agent ?? focus.tool.name, input: focus.tool.input })
+        : t(`stage.${stageKey(focus.stage)}`)
+    case "interrupted":
+      return t("focus.interrupted")
+    case "cancelled":
+      return t("focus.cancelled")
+    case "done":
+      return t("focus.done")
+    default:
+      return t("focus.idle")
+  }
+}
+
+export type RuntimeChildPanelProps = {
+  sessionID: string
+  lifecycle: ChildLifecycle
+  model: Accessor<RuntimeModel>
+  now: Accessor<number>
+  t: RuntimeText["t"]
+  depth?: number
+  ancestors?: readonly string[]
+  childOpen?: (sessionID: string) => boolean
+  toggleChild?: (sessionID: string) => void
+  assembleChild?: (sessionID: string) => RuntimeModel
+  onOpen?: (sessionID: string) => void
+}
+
+export function RuntimeChildPanel(props: RuntimeChildPanelProps) {
+  const depth = () => props.depth ?? 1
+  const ancestors = () => props.ancestors ?? [props.sessionID]
+  const isSubagent = (x: RuntimeTool) => x.child !== undefined
+
+  // Active tools: pending/running tools plus any subagent tools
+  const visibleTools = createMemo(() =>
+    props.model().tools.filter(
+      (x) => (!x.interrupted && (x.state === "pending" || x.state === "running")) || isSubagent(x),
+    ),
+  )
+  const toolKeys = keyed(visibleTools, (x) => x.id)
+  const lastChildTools = createMemo(() => lastChildToolIds(props.model().tools))
+  const [openTools, setOpenTools] = createSignal<ReadonlySet<string>>(new Set())
+  const isToolOpen = (id: string) => openTools().has(id)
+  const toggleTool = (id: string) => {
+    setOpenTools((prev) => {
+      const next = new Set(prev)
+      if (next.has(id)) next.delete(id)
+      else next.add(id)
+      return next
+    })
+  }
+
+  const toolRow = (x: Accessor<RuntimeTool>) => {
+    const child = () => x().child
+    const isLastChild = () => lastChildTools().has(x().id)
+    const info = createMemo(() => toolDetail(x(), props.t))
+    const statusText = () =>
+      x().cancelled ? props.t("tool.cancelled") : props.t(`tool.state.${x().state}`)
+
+    return (
+      <Show
+        when={child()}
+        fallback={
+          <div
+            data-oco-runtime-tool={x().id}
+            class="flex flex-col gap-1 rounded p-2 bg-surface-inset-base border border-dashed border-border-subtle font-mono text-11-regular min-w-0 break-words"
+            style={{ "border-color": COLOR.tool }}
+          >
+            <button
+              type="button"
+              class={`w-full flex items-center gap-2 min-w-0 text-left bg-transparent border-0 p-0 ${FOCUS} rounded-[3px] cursor-pointer font-mono`}
+              data-oco-runtime-tool-toggle={x().id}
+              aria-expanded={isToolOpen(x().id)}
+              aria-controls={`oco-runtime-tool-detail-${x().id}`}
+              onClick={() => toggleTool(x().id)}
+            >
+              <span aria-hidden="true">{x().cancelled ? "⊘" : GLYPH[x().state]}</span>
+              <span class="text-12-medium text-text-strong shrink-0">{x().name}</span>
+              <span class="min-w-0 break-words text-11-regular text-text-weak">{x().input}</span>
+              <span class="ml-auto shrink-0 text-11-regular text-text-weak">
+                {statusText()}
+              </span>
+            </button>
+            <Show when={x().lastOutput}>
+              <div class="min-w-0 break-words whitespace-pre-wrap text-11-regular font-mono text-text-weak">{x().lastOutput}</div>
+            </Show>
+            <Show when={isToolOpen(x().id)}>
+              <div
+                id={`oco-runtime-tool-detail-${x().id}`}
+                data-oco-runtime-tool-detail={x().id}
