+// oco (patches/opencode/0019): M5 runtime ring — synthetic SDK-shaped sessions for the ring unit tests and the
+// performance scales A / B (Task 5; Task 11's per-frame budget test imports bigSession). Test-only: nothing in the
+// app bundle imports this file. Ids encode their creation time the way idTime decodes them (fact 3).
+import type { AssistantMessage, Message, Part, ToolPart, UserMessage } from "@opencode-ai/sdk/v2/client"
+import type { RingIndexInput, RingSource } from "./session-runtime-ring-types"
+
+let seq = 0
+/** `${prefix}_` + 12 hex digits of (ms * 0x1000 + counter) mod 2^48, then a unique suffix. */
+export function synthId(prefix: string, ms: number) {
+  const n = seq++
+  const hex = ((ms * 0x1000 + (n % 0x1000)) % 2 ** 48).toString(16).padStart(12, "0")
+  return `${prefix}_${hex}${n.toString(36).padStart(10, "0")}`
+}
+
+const PATH = { cwd: "/synthetic", root: "/synthetic" }
+const zero = () => ({ input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } })
+
+export type ToolSpec = {
+  start?: number
+  end?: number
+  input?: Record<string, unknown>
+  output?: string
+  error?: string
+  metadata?: Record<string, unknown>
+}
+
+export class SessionBuilder {
+  readonly messages: Message[] = []
+  readonly parts = new Map<string, Part[]>()
+  private lastUser = ""
+  constructor(readonly sessionID: string) {}
+
+  user(at: number, text: string, o: { agent?: string; synthetic?: boolean } = {}) {
+    const id = synthId("msg", at)
+    const msg: UserMessage = {
+      id,
+      sessionID: this.sessionID,
+      role: "user",
+      time: { created: at },
+      agent: o.agent ?? "build",
+      model: { providerID: "prov", modelID: "model-x" },
+    }
+    this.messages.push(msg)
+    const part: Part = { id: synthId("prt", at), sessionID: this.sessionID, messageID: id, type: "text", text }
+    if (o.synthetic) part.synthetic = true
+    this.parts.set(id, [part])
+    this.lastUser = id
+    return id
+  }
+
+  assistant(at: number, o: { agent?: string; model?: string } = {}) {
+    const id = synthId("msg", at)
+    const [providerID, modelID] = (o.model ?? "prov/model-x").split("/")
+    const msg: AssistantMessage = {
+      id,
+      sessionID: this.sessionID,
+      role: "assistant",
+      time: { created: at },
+      parentID: this.lastUser,
+      providerID,
+      modelID,
+      mode: o.agent ?? "build",
+      agent: o.agent ?? "build",
+      path: PATH,
+      cost: 0,
+      tokens: zero(),
+    }
+    this.messages.push(msg)
+    this.parts.set(id, [])
+    return new Turn(this, msg)
+  }
+
+  source(): RingSource {
+    return { messages: this.messages, parts: (id) => this.parts.get(id) ?? [] }
+  }
+
+  input(children: ReadonlyMap<string, SessionBuilder> = new Map()): RingIndexInput {
+    return { sessionID: this.sessionID, ...this.source(), child: (id) => children.get(id)?.source() }
+  }
+}
+
+export class Turn {
+  constructor(
+    readonly b: SessionBuilder,
+    readonly msg: AssistantMessage,
+  ) {}
+  get id() {
+    return this.msg.id
+  }
+  private base(at: number) {
+    return { id: synthId("prt", at), sessionID: this.b.sessionID, messageID: this.msg.id }
+  }
+  private push<P extends Part>(p: P): P {
+    this.b.parts.get(this.msg.id)!.push(p)
+    return p
+  }
+  stepStart(at: number) {
+    this.push({ ...this.base(at), type: "step-start" })
+    return this
+  }
+  text(start: number, text: string, end?: number) {
+    this.push({ ...this.base(start), type: "text", text, time: end === undefined ? { start } : { start, end } })
+    return this
+  }
+  reasoning(start: number, text: string, end?: number) {
+    this.push({ ...this.base(start), type: "reasoning", text, time: end === undefined ? { start } : { start, end } })
+    return this
+  }
+  /** Adds a tool part (chainable); status follows the times given (pending / running / completed or error). */
+  tool(created: number, name: string, o: ToolSpec = {}) {
+    this.call(created, name, o)
+    return this
+  }
+  /** Same as tool(), returning the part (for its callID). */
+  call(created: number, name: string, o: ToolSpec = {}): ToolPart {
+    const input = o.input ?? {}
+    const metadata = o.metadata ?? {}
+    const state: ToolPart["state"] =
+      o.start === undefined
+        ? { status: "pending", input, raw: "" }
+        : o.end === undefined
+          ? { status: "running", input, metadata, time: { start: o.start } }
+          : o.error !== undefined
+            ? { status: "error", input, error: o.error, metadata, time: { start: o.start, end: o.end } }
+            : { status: "completed", input, output: o.output ?? "", title: "", metadata, time: { start: o.start, end: o.end } }
+    return this.push({ ...this.base(created), type: "tool", callID: synthId("call", created), tool: name, state })
+  }
+  stepFinish(at: number, reason: string, o: { cost?: number; total?: number; input?: number; output?: number } = {}) {
+    const input = o.input ?? Math.round((o.total ?? 0) * 0.8)
+    const output = o.output ?? (o.total ?? 0) - input
+    this.push({
+      ...this.base(at),
+      type: "step-finish",
+      reason,
+      cost: o.cost ?? 0,
+      tokens: { total: o.total ?? input + output, input, output, reasoning: 0, cache: { read: 0, write: 0 } },
+    })
+    return this
+  }
+  complete(at: number, o: { error?: { name: "UnknownError" | "MessageAbortedError"; message: string }; finish?: string; cost?: number } = {}) {
+    this.msg.time.completed = at
+    if (o.error) this.msg.error = { name: o.error.name, data: { message: o.error.message } }
+    if (o.finish) this.msg.finish = o.finish
+    if (o.cost !== undefined) this.msg.cost = o.cost
+    return this
+  }
+}
+
+// ---------- performance scales (D11 budgets) ----------
+export type BigOpts = {
+  requests: number
+  tools: number // tool calls per request (a task replaces one of them)
+  tasks: number // task calls spread over the round; every other one is a background task
+  children: number // loaded child sessions (<= tasks)
+  childMessages: number
+  childTools: number
+  notices: number // background-notice user messages (synthetic, so they open no round)
+  reasoning: number // requests that carry a reasoning part
+}
+/** A: 200 requests x 3 tools with one task, plus 100 reasoning increments. */
+export const SCALE_A: BigOpts = { requests: 200, tools: 3, tasks: 1, children: 1, childMessages: 4, childTools: 2, notices: 0, reasoning: 100 }
+/** B: one round of 1500 requests x 2 tools, 8 loaded children (20 assistant messages x 2 tools), 100 notices. */
+export const SCALE_B: BigOpts = { requests: 1500, tools: 2, tasks: 8, children: 8, childMessages: 20, childTools: 2, notices: 100, reasoning: 0 }
+
+export const BIG_T = 1_791_000_000_000
+
+export function bigSession(opts: BigOpts) {
+  const root = new SessionBuilder("ses_big_root")
+  const kids = new Map<string, SessionBuilder>()
+  const T = BIG_T
+  root.user(T, "run the whole batch", { agent: "Sisyphus - ultraworker" })
+  const taskAt = new Map<number, number>()
+  for (let j = 0; j < opts.tasks; j++) taskAt.set(Math.floor(((j + 1) * opts.requests) / (opts.tasks + 1)), j)
+  const noticeEvery = opts.notices ? Math.max(1, Math.floor(opts.requests / opts.notices)) : 0
+  let notices = 0
+  let last = T
+  for (let i = 0; i < opts.requests; i++) {
+    const c = T + 1000 + i * 2000
+    const turn = root.assistant(c, { agent: "Sisyphus - ultraworker", model: "prov/model-x" }).stepStart(c + 50)
+    if (i < opts.reasoning) turn.reasoning(c + 60, `thinking about step ${i}`, c + 250)
+    turn.text(c + 300, `step ${i}`, c + 450)
+    for (let k = 0; k < opts.tools; k++) {
+      const j = k === 0 ? taskAt.get(i) : undefined
+      if (j !== undefined) {
+        const sid = `ses_big_kid${j}`
+        const bg = j % 2 === 1
+        turn.tool(c + 500 + k * 20, "task", {
+          start: c + 600,
+          end: bg ? c + 650 : c + 900,
+          input: { description: `Subagent ${j + 1} part ${j}`, subagent_type: "explore", prompt: `do part ${j}` },
+          metadata: bg ? { sessionId: sid, backgroundTaskId: `bg_${j}` } : { sessionId: sid },
+          output: bg ? `background_task_id: bg_${j}` : `<task_result>part ${j} done</task_result>`,
+        })
+        if (j < opts.children) {
+          const kid = new SessionBuilder(sid)
+          kid.user(c + 605, `do part ${j}`)
+          for (let m = 0; m < opts.childMessages; m++) {
+            const a = c + 610 + m * 12
+            const t = kid.assistant(a).stepStart(a + 1)
+            for (let n = 0; n < opts.childTools; n++)
+              t.tool(a + 2 + n, "bash", { start: a + 4 + n, end: a + 8 + n, input: { command: `ls ${m}-${n}` }, output: "ok" })
+            t.stepFinish(a + 10, m === opts.childMessages - 1 ? "stop" : "tool-calls", { cost: 0.0001, total: 100 })
+            t.complete(a + 11)
+          }
+          kids.set(sid, kid)
+        }
+        continue
+      }
+      turn.tool(c + 500 + k * 20, "bash", {
+        start: c + 600 + k * 5,
+        end: c + 900 + k * 5,
+        input: { command: `echo ${i}-${k}` },
+        output: `out ${i}-${k}`,
+      })
+    }
+    turn.stepFinish(c + 950, i === opts.requests - 1 ? "stop" : "tool-calls", { cost: 0.001, total: 1000 + i })
+    turn.complete(c + 960)
+    last = c + 960
+    if (noticeEvery && notices < opts.notices && i % noticeEvery === noticeEvery - 1) {
+      const id = `bg_${(notices * 2 + 1) % Math.max(1, opts.tasks)}`
+      root.user(c + 1500, `[BACKGROUND TASK RESULT READY]\n**ID:** \`${id}\``, { synthetic: true })
+      notices++
+    }
+  }
+  return { input: root.input(kids), root, kids, childIDs: [...kids.keys()], t0: T - 1200, t1: last + 500 }
+}
diff --git a/packages/app/src/components/session/session-runtime-ring-perf.test.ts b/packages/app/src/components/session/session-runtime-ring-perf.test.ts
new file mode 100644
index 0000000..31101e5
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-perf.test.ts
@@ -0,0 +1,95 @@
+// oco (patches/opencode/0019): M5 runtime ring — rebuild and frame budgets (Task 5 test 16, D11). Prints p95s.
+import { describe, expect, test } from "bun:test"
+import { buildRingIndex, frameAt, truncateAt } from "./session-runtime-ring"
+import { bigSession, SCALE_A, SCALE_B } from "./session-runtime-ring-perf.fixture"
+
+const p95 = (xs: number[]) => {
+  const s = [...xs].sort((a, b) => a - b)
+  return s[Math.min(s.length - 1, Math.ceil(s.length * 0.95) - 1)]
+}
+function bench(fn: () => unknown, n = 50, warm = 10) {
+  // start from a collected heap: garbage left by earlier test files must not land in this measurement
+  Bun.gc(true)
+  for (let i = 0; i < warm; i++) fn()
+  const xs: number[] = []
+  for (let i = 0; i < n; i++) {
+    const a = performance.now()
+    fn()
+    xs.push(performance.now() - a)
+  }
+  return p95(xs)
+}
+function framesP95(index: ReturnType<typeof buildRingIndex>, t0: number, t1: number, n = 300) {
+  const ts = Array.from({ length: n }, (_, i) => Math.round(t0 + ((t1 - t0) * (i + 0.5)) / n))
+  frameAt(index, ts[0], { reduced: false, wide: true }) // builds the per-index lookup tables once
+  Bun.gc(true)
+  const xs = ts.map((t) => {
+    const a = performance.now()
+    frameAt(index, t, { reduced: false, wide: true })
+    return performance.now() - a
+  })
+  return p95(xs)
+}
+const fmt = (v: number) => v.toFixed(3) + " ms"
+/** prev as the live view holds it while the last request still runs (its first tool started, the second pending). */
+function inFlight(input: Parameters<typeof truncateAt>[0], full: ReturnType<typeof buildRingIndex>) {
+  const reqs = full.rounds[full.rounds.length - 1].requests
+  const last = reqs[reqs.length - 1]
+  const live = buildRingIndex(truncateAt(input, last.tools[0].start! + 1))
+  const was = live.rounds[live.rounds.length - 1].requests
+  expect(was[was.length - 1].completed).toBeUndefined()
+  // D11 second layer: the rebuild equals a fresh build and takes every settled request without a task or todowrite
+  // call from prev by identity
+  const next = buildRingIndex({ ...input, dirty: new Set([input.sessionID]) }, live)
+  expect(next).toEqual(full)
+  const kept = next.rounds.flatMap((r) => r.requests).filter((q, i) => q === live.rounds.flatMap((r) => r.requests)[i])
+  const expected = reqs.filter((q) => q !== last && !q.tools.some((x) => x.kind === "task" || x.name === "todowrite"))
+  expect(kept.length).toBe(expected.length)
+  return live
+}
+
+// Budgets (D22, main thread 2026-10-08): test limits are 2x the unloaded p95 so parallel test load (1.3-1.6x) does not
+// flake them. The D11 target (live rebuild <= 4 ms) is met by the recorded numbers (root-dirty with prev 2.7-2.9 ms),
+// not by these assertions. Cold full builds happen once per session open, so they get 8 / 32 ms.
+describe("16 performance (p95 of 50 runs; frameAt over 300 sample points)", () => {
+  test("16 A: 200 requests x 3 tools, 1 task, 100 reasoning: full rebuild <= 8 ms, root-dirty rebuilds with prev <= 8 ms, child-dirty <= 4 ms, frameAt <= 1 ms", () => {
+    const s = bigSession(SCALE_A)
+    const full = bench(() => buildRingIndex(s.input))
+    const index = buildRingIndex(s.input)
+    const inc = bench(() => buildRingIndex({ ...s.input, dirty: new Set([s.childIDs[0]]) }, index))
+    const live = inFlight(s.input, index)
+    const incRoot = bench(() => buildRingIndex({ ...s.input, dirty: new Set([s.input.sessionID]) }, live))
+    const frame = framesP95(index, s.t0, s.t1)
+    console.log(
+      `[ring-perf] A full=${fmt(full)} incremental(1 child dirty)=${fmt(inc)} rebuild(root dirty, prev with the last request in flight)=${fmt(incRoot)} frameAt=${fmt(frame)} requests=${index.rounds[0].requests.length}`,
+    )
+    expect(full).toBeLessThanOrEqual(8)
+    expect(inc).toBeLessThanOrEqual(4)
+    expect(incRoot).toBeLessThanOrEqual(8)
+    expect(frame).toBeLessThanOrEqual(1)
+  })
+
+  test("16 B: 1500 requests x 2 tools, 8 children, 100 notices: full <= 32 ms, root-dirty rebuilds with prev <= 8 ms, child-dirty <= 4 ms, frameAt <= 1 ms", () => {
+    const s = bigSession(SCALE_B)
+    const full = bench(() => buildRingIndex(s.input))
+    const prev = buildRingIndex(s.input)
+    expect(prev.rounds.length).toBe(1)
+    expect(prev.rounds[0].requests.length).toBe(1500)
+    expect(prev.subs.filter((x) => x.child).length).toBe(8)
+    const dirty = new Set([s.childIDs[0]])
+    const inc = bench(() => buildRingIndex({ ...s.input, dirty }, prev))
+    const rootDirty = new Set([s.input.sessionID])
+    const incRoot = bench(() => buildRingIndex({ ...s.input, dirty: rootDirty }, prev))
+    const live = inFlight(s.input, prev)
+    const incLive = bench(() => buildRingIndex({ ...s.input, dirty: rootDirty }, live))
+    const frame = framesP95(prev, s.t0, s.t1)
+    console.log(
+      `[ring-perf] B full=${fmt(full)} incremental(1 child dirty)=${fmt(inc)} rebuild(root dirty, prev settled)=${fmt(incRoot)} rebuild(root dirty, prev with the last request in flight)=${fmt(incLive)} frameAt=${fmt(frame)} times=${prev.times.length}`,
+    )
+    expect(full).toBeLessThanOrEqual(32)
+    expect(inc).toBeLessThanOrEqual(4)
+    expect(incRoot).toBeLessThanOrEqual(8)
+    expect(incLive).toBeLessThanOrEqual(8)
+    expect(frame).toBeLessThanOrEqual(1)
+  })
+})
