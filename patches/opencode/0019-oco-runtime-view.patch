diff --git a/packages/app/test-browser/session-runtime-child-sync.test.ts b/packages/app/test-browser/session-runtime-child-sync.test.ts
new file mode 100644
index 0000000..fa6849a
--- /dev/null
+++ b/packages/app/test-browser/session-runtime-child-sync.test.ts
@@ -0,0 +1,264 @@
+import { describe, expect, test } from "bun:test"
+import { createRoot, createSignal } from "solid-js"
+import { createChildSync } from "@/components/session/session-runtime-child-sync"
+import type { ChildLifecycle, RuntimeModel, RuntimeTool } from "@/components/session/session-runtime-model"
+
+const tool = (
+  id: string,
+  request: number,
+  childSessionID?: string,
+  lifecycle: ChildLifecycle = "done",
+): RuntimeTool => ({
+  id,
+  callID: `call_${id}`,
+  messageID: `msg_${id}`,
+  request,
+  name: childSessionID ? "task" : "bash",
+  state: lifecycle === "running" ? "running" : "completed",
+  interrupted: false,
+  cancelled: false,
+  input: "{}",
+  child: childSessionID
+    ? {
+        sessionID: childSessionID,
+        agent: `agent_${childSessionID}`,
+        description: "subagent",
+        background: false,
+        lifecycle,
+        evidence: "event",
+      }
+    : undefined,
+})
+
+const model = (sessionID: string, requests: number[], tools: RuntimeTool[]): RuntimeModel => ({
+  mode: "live",
+  stage: "idle",
+  run: { state: "idle", evidence: "event", attention: [], attentionKnown: true },
+  focus: { kind: "idle" },
+  sessions: [{ id: sessionID, kind: "child", state: "idle", evidence: "event" }],
+  requests: requests.map((index) => ({
+    index,
+    messageID: `msg_req_${index}`,
+    turn: index,
+    start: 1000 + index * 100,
+    status: "done",
+    cancelled: false,
+    evidence: "event",
+    settled: true,
+    known: true,
+  })),
+  tools,
+  events: [],
+  usage: { requests: requests.length, knownRequests: requests.length, settled: true, context: {} },
+  freshness: { observedAt: 1000, evidence: "inferred" },
+})
+
+function createSyncFixture() {
+  const syncCalls: string[] = []
+  const pinCalls: string[] = []
+  const unpinCalls: string[] = []
+  const deferred = new Map<string, PromiseWithResolvers<unknown>>()
+
+  const sync = (id: string) => {
+    syncCalls.push(id)
+    const entry = deferred.get(id) ?? Promise.withResolvers<unknown>()
+    deferred.set(id, entry)
+    return entry.promise
+  }
+
+  const pin = (id: string) => {
+    pinCalls.push(id)
+  }
+
+  const unpin = (id: string) => {
+    unpinCalls.push(id)
+  }
+
+  const settle = (id: string) => {
+    const entry = deferred.get(id)
+    if (entry) {
+      entry.resolve(undefined)
+      deferred.delete(id)
+    }
+  }
+
+  const reject = (id: string, error: unknown = new Error("sync failed")) => {
+    const entry = deferred.get(id)
+    if (entry) {
+      entry.reject(error)
+      deferred.delete(id)
+    }
+  }
+
+  return { syncCalls, pinCalls, unpinCalls, sync, pin, unpin, settle, reject }
+}
+
+const flush = async () => {
+  await Promise.resolve()
+  await Promise.resolve()
+}
+
+describe("createChildSync", () => {
+  test("(a) 计数按根 turn 重置", async () => {
+    await createRoot(async (dispose) => {
+      const fixture = createSyncFixture()
+      const [turn, setTurn] = createSignal<number | undefined>(0)
+      const [open, setOpen] = createSignal<ReadonlySet<string>>(new Set())
+      const [tools, setTools] = createSignal<RuntimeTool[]>(
+        Array.from({ length: 12 }, (_, i) => tool(`t${i}`, 0, `child_${i}`, "running")),
+      )
+      const [models, setModels] = createSignal<Record<string, RuntimeModel | undefined>>({})
+
+      createChildSync({
+        sync: fixture.sync,
+        pin: fixture.pin,
+        unpin: fixture.unpin,
+        childModel: (id) => models()[id],
+        turn,
+        open,
+        tools,
+        limit: 8,
+      })
+
+      await flush()
+      // Initial turn 0 capped at 8
+      expect(fixture.syncCalls).toHaveLength(8)
+      expect(fixture.syncCalls).toEqual([
+        "child_0", "child_1", "child_2", "child_3",
+        "child_4", "child_5", "child_6", "child_7",
+      ])
+
+      // Advance turn to 1 with new tools
+      setTools(Array.from({ length: 12 }, (_, i) => tool(`t_turn1_${i}`, 1, `child_turn1_${i}`, "running")))
+      setTurn(1)
+      await flush()
+
+      // Count resets for turn 1, auto-syncing another 8
+      expect(fixture.syncCalls).toHaveLength(16)
+      expect(fixture.syncCalls.slice(8)).toEqual([
+        "child_turn1_0", "child_turn1_1", "child_turn1_2", "child_turn1_3",
+        "child_turn1_4", "child_turn1_5", "child_turn1_6", "child_turn1_7",
+      ])
+
+      dispose()
+    })
+  })
+
+  test("(b) sync reject 后展开时重试", async () => {
+    await createRoot(async (dispose) => {
+      const fixture = createSyncFixture()
+      const [turn, setTurn] = createSignal<number | undefined>(0)
+      const [open, setOpen] = createSignal<ReadonlySet<string>>(new Set())
+      const [tools, setTools] = createSignal<RuntimeTool[]>([tool("t1", 0, "child_fail", "running")])
+      const [models, setModels] = createSignal<Record<string, RuntimeModel | undefined>>({})
+
+      createChildSync({
+        sync: fixture.sync,
+        pin: fixture.pin,
+        unpin: fixture.unpin,
+        childModel: (id) => models()[id],
+        turn,
+        open,
+        tools,
+      })
+
+      await flush()
+      expect(fixture.syncCalls).toEqual(["child_fail"])
+
+      // Simulate failure of the initial sync
+      fixture.reject("child_fail")
+      await flush()
+
+      // Ensure no automatic retry while still collapsed
+      expect(fixture.syncCalls).toEqual(["child_fail"])
+
+      // User expands the child session -> triggers retry
+      setOpen(new Set(["child_fail"]))
+      await flush()
+
+      expect(fixture.syncCalls).toEqual(["child_fail", "child_fail"])
+
+      dispose()
+    })
+  })
+
+  test("(c) 驱逐后展开触发重新拉取", async () => {
+    await createRoot(async (dispose) => {
+      const fixture = createSyncFixture()
+      const [turn, setTurn] = createSignal<number | undefined>(0)
+      const [open, setOpen] = createSignal<ReadonlySet<string>>(new Set())
+      const [tools, setTools] = createSignal<RuntimeTool[]>([tool("t1", 0, "child_evict", "running")])
+      const [models, setModels] = createSignal<Record<string, RuntimeModel | undefined>>({})
+
+      createChildSync({
+        sync: fixture.sync,
+        pin: fixture.pin,
+        unpin: fixture.unpin,
+        childModel: (id) => models()[id],
+        turn,
+        open,
+        tools,
+      })
+
+      await flush()
+      expect(fixture.syncCalls).toEqual(["child_evict"])
+      fixture.settle("child_evict")
+
+      // Model is loaded into fake store
+      setModels({ child_evict: model("child_evict", [0], []) })
+      await flush()
+
+      // Eviction: fake store deletes message data -> childModel returns undefined
+      setModels({})
+      await flush()
+
+      // Expanding the child session triggers re-fetch because model is missing/undefined
+      setOpen(new Set(["child_evict"]))
+      await flush()
+
+      expect(fixture.syncCalls).toEqual(["child_evict", "child_evict"])
+
+      dispose()
+    })
+  })
+
+  test("(d) 运行中的孙会话被 pin，结束且未展开后 unpin", async () => {
+    await createRoot(async (dispose) => {
+      const fixture = createSyncFixture()
+      const [turn, setTurn] = createSignal<number | undefined>(0)
+      const [open, setOpen] = createSignal<ReadonlySet<string>>(new Set())
+      const [tools, setTools] = createSignal<RuntimeTool[]>([tool("r_c1", 0, "child_1", "done")])
+
+      // child_1 has grandchild g1 which is running
+      const [models, setModels] = createSignal<Record<string, RuntimeModel | undefined>>({
+        child_1: model("child_1", [0], [tool("c1_g1", 0, "grandchild_1", "running")]),
+      })
+
+      createChildSync({
+        sync: fixture.sync,
+        pin: fixture.pin,
+        unpin: fixture.unpin,
+        childModel: (id) => models()[id],
+        turn,
+        open,
+        tools,
+      })
+
+      await flush()
+      // grandchild_1 is running -> pinned!
+      expect(fixture.pinCalls).toContain("grandchild_1")
+      expect(fixture.unpinCalls).not.toContain("grandchild_1")
+
+      // Now grandchild_1 finishes (lifecycle -> "done") and is not in open
+      setModels({
+        child_1: model("child_1", [0], [tool("c1_g1", 0, "grandchild_1", "done")]),
+      })
+      await flush()
+
+      // grandchild_1 ended and collapsed -> unpinned!
+      expect(fixture.unpinCalls).toContain("grandchild_1")
+
+      dispose()
+    })
+  })
+})
diff --git a/packages/app/test-browser/session-runtime-keyed.test.ts b/packages/app/test-browser/session-runtime-keyed.test.ts
new file mode 100644
index 0000000..0528d23
--- /dev/null
+++ b/packages/app/test-browser/session-runtime-keyed.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, test } from "bun:test"
+import { createEffect, createRoot, createSignal } from "solid-js"
+import { keyed } from "@/components/session/session-runtime-keyed"
+
+type Item = { id: string; value: number }
+
+describe("keyed", () => {
+  test("same id sequence keeps the ids reference and does not rerun an effect", () => {
+    let runs = 0
+    let ids: () => string[] = () => []
+    let setItems: (next: Item[]) => void = () => {}
+    let dispose = () => {}
+    createRoot((done: () => void) => {
+      dispose = done
+      const [items, set] = createSignal<Item[]>([
+        { id: "a", value: 1 },
+        { id: "b", value: 2 },
+      ])
+      setItems = set
