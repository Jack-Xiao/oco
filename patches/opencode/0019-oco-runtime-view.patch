+      const dock = g.subBack(SLOT).at(hold)
+      const early = packetsAt(g, EMPTY_INDEX, frame, D + 100, false).find((p) => p.id === `sub-back:${sub.uid}`)!
+      expect(early.tone).toBe("err")
+      expect(early.probe?.stage).toBe("absorbed")
+      const past = packetsAt(g, EMPTY_INDEX, frame, D + tOf(hold) + 100, false).find((p) => p.id === `sub-back:${sub.uid}`)!
+      expect(past.parked).toBe(false)
+      expect(dist(past.at, dock)).toBeGreaterThan(10)
+      expect(packetsAt(g, EMPTY_INDEX, frame, D + 60_000, false).some((p) => p.id.startsWith("sub-back"))).toBe(false)
+    })
+
+    test("6b. a retry notice clears the done state (back to running, no return trip)", () => {
+      const sub = bg({ retrievedAt: undefined, notices: [{ at: D, kind: "done" }, { at: 6000, kind: "cleared" }] }, { child: undefined })
+      const pk = packetsAt(g, EMPTY_INDEX, stage(sub), 7000, false)
+      expect(pk.some((p) => p.id.startsWith("sub-back"))).toBe(false)
+      expect(pk.find((p) => p.id === `sub-out:${sub.uid}`)?.probe?.stage).toBe("running")
+    })
+
+    test("a queued subagent (start not written yet) has no packet", () => {
+      const sub = subOf({ start: undefined, end: undefined })
+      expect(packetsAt(g, EMPTY_INDEX, stage(sub), 5000, false)).toEqual([])
+    })
+
+    test("cell index is capped at the last cell for slots beyond six", () => {
+      const sub = subOf({ start: 100, end: undefined })
+      const pk = packetsAt(g, EMPTY_INDEX, stage(sub, 9), 5000, false).find((p) => p.id.startsWith("sub-out"))!
+      const path = g.subOut(RING.SUB_CELLS - 1)
+      expect(dist(pk.at, path.at(path.L))).toBeLessThan(1e-6)
+    })
+  })
+
+  test("labels: at most the two newest moving packets carry one; the newest may carry the long form", () => {
+    const a = toolOf({ id: "prt_a", slot: 0, start: 1000, status: "running" })
+    const b = toolOf({ id: "prt_b", slot: 1, start: 1010, status: "running" })
+    const c = toolOf({ id: "prt_c", slot: 2, start: 1020, status: "running" })
+    const pk = packetsAt(g, EMPTY_INDEX, frameWith([a, b, c], { st: "call" }), 1100, false)
+    const labelled = pk.filter((p) => p.label !== undefined)
+    expect(labelled.length).toBeLessThanOrEqual(2)
+    expect(labelled.map((p) => p.id)).toEqual(expect.arrayContaining(["out:prt_c", "out:prt_b"]))
+    expect(pk.find((p) => p.id === "out:prt_c")!.long).toBe("→ bash ls -la")
+    expect(pk.find((p) => p.id === "out:prt_b")!.long).toBeUndefined()
+    // parked packets drop their label
+    const later = packetsAt(g, EMPTY_INDEX, frameWith([a, b, c], { st: "call" }), 30_000, false)
+    expect(later.filter((p) => p.label !== undefined)).toEqual([])
+    // no round -> no packets
+    expect(packetsAt(g, EMPTY_INDEX, frameOf({ st: "pre" }), 5000, false)).toEqual([])
+  })
+
+  test("the you-packet fades after LINGER_MS + FADE_MS, and is skipped when reduced", () => {
+    const frame = frameWith([], { st: "say" })
+    const L = g.pYou.L
+    const tArr = tOf(L)
+    expect(packetsAt(g, EMPTY_INDEX, frame, 10, false).find((p) => p.id === "you")?.label).toEqual({ key: "ring.pkt.you" })
+    expect(packetsAt(g, EMPTY_INDEX, frame, tArr + RING.LINGER_MS + RING.FADE_MS + 5, false).some((p) => p.id === "you")).toBe(false)
+    expect(packetsAt(g, EMPTY_INDEX, frame, 10, true).some((p) => p.id === "you")).toBe(false)
+  })
+})
+
+// ---------- 7: labels ----------
+describe("placeLabels", () => {
+  test("7. placed labels never overlap each other or the obstacles and stay inside the stage", () => {
+    for (const [w, h] of [[1100, 720], [560, 720], [1600, 470]] as const) {
+      const g = geo(w, h, 0.5)
+      const items = []
+      for (let i = 0; i < 40; i++) {
+        const a = (i * 29) % 360
+        const p = { x: g.cx + g.R * Math.cos((a * Math.PI) / 180), y: g.cy + g.R * Math.sin((a * Math.PI) / 180) }
+        items.push({ at: p, text: i % 3 ? `→ tool${i}` : "#2 returned a result", tone: "tool" as const, dx: i % 2 ? 0 : 1, dy: i % 2 ? 1 : 0 })
+      }
+      const extra = [stationSubBox(g, "think", "12.3s"), stationSubBox(g, "wait", "Waited 5.0s")]
+      const placed = placeLabels(g, items, extra)
+      expect(placed.length).toBeGreaterThan(0)
+      for (let i = 0; i < placed.length; i++) {
+        const b = placed[i].box
+        expect(b.x).toBeGreaterThanOrEqual(2)
+        expect(b.y).toBeGreaterThanOrEqual(2)
+        expect(b.x + b.w).toBeLessThanOrEqual(g.W - 2)
+        expect(b.y + b.h).toBeLessThanOrEqual(g.H - 2)
+        for (const o of g.obst.concat(extra)) expect(hit(b, o), `${w}x${h} #${i}`).toBe(false)
+        for (let j = i + 1; j < placed.length; j++) expect(hit(b, placed[j].box), `${w}x${h} ${i}/${j}`).toBe(false)
+        expect(placed[i].lead.y).toBeCloseTo(b.y + b.h / 2, 6)
+      }
+    }
+  })
+  test("7b. a crowded non-fixed label is dropped, a fixed one is still placed", () => {
+    const g = geo(1100, 720, 0)
+    const at = { x: g.you.x + g.you.w / 2, y: g.you.y + g.you.h / 2 } // middle of the "you" box: every candidate hits it
+    expect(placeLabels(g, [{ at, text: "x", tone: "err" }])).toEqual([])
+    const fixed = placeLabels(g, [{ at, text: "■", tone: "err", fixed: true }])
+    expect(fixed).toHaveLength(1)
+    expect(fixed[0].box.x).toBe(at.x + 12)
+  })
+})
