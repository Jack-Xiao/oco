+// oco (patches/opencode/0019): unit tests for mechanismOf pure projection.
+// Test cases 1-9 per docs/superpowers/plans/2026-10-03-runtime-dashboard-m3.md (Task 2).
+import { describe, expect, test } from "bun:test"
+import { mechanismOf, mechanismView, type Mechanism } from "./session-runtime-mechanism"
+import type { RuntimeModel, RuntimeRequest, RuntimeTool, Stage } from "./session-runtime-model"
+
+function createMockModel(overrides: Partial<RuntimeModel> = {}): RuntimeModel {
