+    const g = geo()
+    return CHEVRONS.map((a) => {
+      const p = ringPt(g, a)
+      const k = ((a + 90) * Math.PI) / 180
+      const n = (a * Math.PI) / 180
+      const ux = Math.cos(k) * 5
+      const uy = Math.sin(k) * 5
+      const nx = Math.cos(n) * 4
+      const ny = Math.sin(n) * 4
+      return `M${(p.x - ux + nx).toFixed(1)},${(p.y - uy + ny).toFixed(1)} L${(p.x + ux).toFixed(1)},${(p.y + uy).toFixed(1)} L${(p.x - ux - nx).toFixed(1)},${(p.y - uy - ny).toFixed(1)}`
+    })
+  })
+  const stationSub = (id: PillId) => say(f().pills[id].sub)
+  const labels = createMemo(() => {
+    const g = geo()
+    const items: LabelItem[] = []
+    const tk = tok()
+    if (tk && st() === "fly") items.push({ at: ringPt(g, tk.pos), text: text.t("ring.next.req", { m: m() }), tone: "main" })
+    if (tk && st() === "abort") items.push({ at: ringPt(g, tk.pos), text: text.t("ring.aborted"), tone: "err", fixed: true })
+    for (const p of packets()) {
+      const l = p.long ?? p.label
+      if (l !== undefined) items.push({ at: p.at, text: say(l), tone: p.tone, dx: p.dx, dy: p.dy, fixed: p.fixed })
+    }
+    const extra: Box[] = []
+    for (const s of STATIONS) {
+      const sub = stationSub(s.id)
+      if (sub) extra.push(stationSubBox(g, s.id, sub))
+    }
+    return placeLabels(g, items, extra)
+  })
+  const laneDrawn = () => geo().k > LANE_MIN_K && geo().botY - geo().topY > 2 * LANE_RX
+  const laneLit = () => f().subs.cells.some((c) => c.state === "queued" || c.state === "run" || c.state === "docked")
+  const laneOp = () => (laneLit() ? 0.8 : f().subs.cells.length ? 0.35 : 0.18) * geo().k
+  const flow = () => (reduced() ? undefined : (Math.round((-(props.t() * 0.03) % 12) * 10) / 10 || 0))
+
+  // ---------- card ----------
+  const card = () => f().card
+  // the whole card opens the full-content overlay whenever it shows any text (running or not)
+  const canExpand = createMemo(() => {
+    const c = card()
+    return !!(c.body || c.full || c.pre || c.post || c.plan?.items.length)
+  })
+  const body = createMemo(() => {
+    const c = card()
+    const p = geo().pay
+    // the meta line lives in the overlay and the bottom caption, not in the card: its height goes to the body
+    const postH = c.post ? LH : 0
+    const lines = Math.max(1, Math.floor((p.h - 18 - 20 - 4 - postH) / LH))
+    const innerW = Math.max(40, p.w - 22)
+    const plan = c.plan ? planWindow(c.plan.items, Math.max(1, Math.floor((lines * LH) / 14))) : undefined
+    const preW = c.pre ? textW(say(c.pre), 10.5) + 16 : 0
+    const cap = Math.max(innerW * 0.5, lines * innerW * 0.92 - preW)
+    return { lines, plan, text: c.body ? fitText(c.body, c.bodyMode, cap, c.mono ? 12 : 12.5) : "" }
+  })
+  const closePanel = () => {
+    const opener = ui.panel === "plan" ? planBtn : expandBtn
+    setUi("panel", "")
+    // D13: focus back to the opener; a disabled or unmounted opener cannot take focus
+    if (opener && opener.isConnected && opener.getAttribute("aria-disabled") !== "true" && !(opener as HTMLButtonElement).disabled) opener.focus()
+    else root?.focus()
+  }
+  createEffect(() => {
+    if ((ui.panel === "card" && !canExpand()) || (ui.panel === "plan" && !ctr().plan)) closePanel()
+  })
+
+  // ---------- counter ----------
+  const ctr = () => f().counter
+  const planChip = () => {
+    const p = ctr().plan
+    return p ? text.t("ring.plan.chip", { done: p.done, total: p.total }) : ""
+  }
+  const ctrLine = createMemo(() => {
+    const c = ctr()
+    const n = c.round ?? 0
+    const req = c.requests.length
+    const round = text.t("ring.ctr.round", { n })
+    const main = c.ended ? text.t("ring.ctr.ended.total", { n: req }) : text.t("ring.ctr.request", { m: c.m ?? 1 })
+    const short = c.ended ? text.t("ring.ctr.ended") : text.t("ring.ctr.request.short", { m: c.m ?? 1 })
+    const chip = planChip()
+    const chipW = chip ? textW(chip, 11) + 16 + 7 : 0
+    const variants: [number, string, boolean][] = [[10, main, true], [6, main, true], [0, main, true], [6, short, true], [0, short, true], [0, short, false]]
+    for (const [np, second, who] of variants) {
