+              assembleChild={assembleChild}
+              onOpenSession={props.onOpenSession}
+              now={wall}
+              pending={pending}
+              failed={failed}
+              respond={respond}
+              onView={props.onView}
+              enteredStack={enteredStack}
+              onEnterChild={onEnterChild}
+              onNavigateCrumb={onNavigateCrumb}
+              openDetailId={openDetailId}
+              onToggleDetail={onToggleDetail}
+              otherAttentionTools={otherAttentionTools}
+              reasoningFor={reasoningFor}
+            />
+          </section>
+        </div>
+
+        {/* Row 3: 会话日志 (Session Log) */}
+        <div
+          data-oco-runtime-events
+          class="box rounded-lg p-4 flex flex-col gap-2.5 overflow-hidden shrink-0"
+          style={{
+            background: "var(--rt-panel)",
+            border: "1px solid var(--rt-line)",
+            height: isStack() ? "176px" : "clamp(104px, 16vh, 176px)",
+          }}
+        >
+          <h3 class="m-0 text-12-bold tracking-wider shrink-0 font-bold" style={{ color: "var(--rt-weak)" }}>
+            {t("runtime.log_title")}
+          </h3>
+          <div class="overflow-y-auto flex flex-col gap-1 text-12-regular leading-relaxed min-h-0 flex-1">
+            <Show
+              when={model().events.length > 0}
+              fallback={<div class="text-12-regular" style={{ color: "var(--rt-weak)" }}>{t("events.none")}</div>}
+            >
+              <For each={[...eventKeys.ids()].reverse()}>
+                {(id) => {
+                  const ev = () => eventKeys.get(id)!
+                  const isCurrent = () => cursor() !== undefined && ev().at === cursor()
+                  return eventRow(ev, isCurrent)
+                }}
+              </For>
+            </Show>
+          </div>
+        </div>
+
+        {/* Row 4: 状态栏 (Bottom Summary) */}
+        <div
+          data-oco-runtime-summary
+          class="flex items-center gap-8 text-12-regular whitespace-nowrap overflow-hidden px-1 shrink-0 font-mono"
+          style={{ color: "var(--rt-weak)" }}
+        >
+          <span>
+            <b style={{ color: "var(--rt-main)" }}>{summaryAgent()}</b> · {summaryModel()}
+          </span>
+          <span>{summaryChildren()}</span>
+          <span>{summaryTools()}</span>
+          <span>{summaryRequest()}</span>
+          <span data-oco-runtime-usage>{summaryUsage()}</span>
+          <Show when={summaryContext()}>
+            <span>{summaryContext()}</span>
+          </Show>
+          <Show when={summaryCost()}>
+            <span>{summaryCost()}</span>
+          </Show>
+          {/* Legend (moved from the top bar so the top bar stays on one line) */}
+            <div data-oco-runtime-legend class="ml-auto flex items-center gap-4 text-12-regular whitespace-nowrap" style={{ color: "var(--rt-weak)" }}>
+              <span class="flex items-center gap-1.5">
+                <i class="inline-block w-2.5 h-2.5 rounded-sm" style={{ background: "var(--rt-main)" }}></i>
+                {t("legend.main")}
+              </span>
+              <span class="flex items-center gap-1.5">
+                <i class="inline-block w-2.5 h-2.5 rounded-sm" style={{ background: "var(--rt-sub)" }}></i>
+                {t("legend.child")}
+              </span>
+              <span class="flex items-center gap-1.5">
+                <i class="inline-block w-2.5 h-2.5 rounded-sm" style={{ background: "var(--rt-tool)" }}></i>
+                {t("legend.tool")}
+              </span>
+              <span class="flex items-center gap-1.5">
+                <i class="inline-block w-2.5 h-2.5 rounded-sm" style={{ background: "var(--rt-attn)" }}></i>
+                {t("legend.attention")}
+              </span>
+              <span class="flex items-center gap-1.5">
+                <span>··●</span>
+                <span>{t("legend.flow")}</span>
+              </span>
+            </div>
+
+        </div>
+      </div>
+
+      {/* Screen-reader mirror: run state + one focus sentence only */}
+      <div class="sr-only" aria-live="polite" data-oco-runtime-live>
+        {liveSentence()}
+      </div>
+    </div>
+  )
+}
