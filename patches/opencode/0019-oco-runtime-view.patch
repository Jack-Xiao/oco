index 0000000..03f37bd
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-perf.test.ts
@@ -0,0 +1,161 @@
+// oco (patches/opencode/0019): runtime view performance measurement.
+// Pure function measurement of assemble (buildTrajectory + buildRuntime) over 200 requests (3 tools each, 1 task)
+// plus an in-flight assistant message with 100 reasoning deltas.
+import { describe, expect, test } from "bun:test"
+import type { Message, Part } from "@opencode-ai/sdk/v2/client"
+import { buildTrajectory } from "./session-trajectory-model"
+import { trajectoryText } from "./session-trajectory-i18n"
+import { buildRuntime, type RuntimeInput } from "./session-runtime-model"
+
+const language = trajectoryText({ locale: () => "en", intl: () => "en" })
+const T0 = 1_790_000_000_000
+
+const id = (prefix: string, ms: number, counter = 0) =>
+  `${prefix}_${((BigInt(ms) * 4096n + BigInt(counter)) % 2n ** 48n).toString(16).padStart(12, "0")}AbCdEfGhIjKlMn`
+
+const user = (ms: number) =>
+  ({ id: id("msg", ms), sessionID: "s", role: "user", time: { created: ms }, agent: "build", model: {} }) as any
+
+const assistant = (parent: any, ms: number, extra: Record<string, unknown> = {}) =>
+  ({
+    id: id("msg", ms),
+    sessionID: "s",
+    role: "assistant",
+    parentID: parent.id,
+    time: { created: ms, completed: ms + 1500 },
+    modelID: "m",
+    providerID: "p",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/", root: "/" },
+    cost: 0,
+    tokens: { input: 100, output: 50, reasoning: 0, cache: { read: 900, write: 0 } },
+    ...extra,
+  }) as any
+
+const tool = (ms: number, name: string, state: Record<string, unknown>, extra: Record<string, unknown> = {}) =>
+  ({ id: id("prt", ms), sessionID: "s", messageID: "", type: "tool", tool: name, callID: `c${ms}`, state, ...extra }) as any
+
+function assemble(
+  view: { messages: Message[]; parts: (id: string) => Part[]; busy?: boolean },
+  mode: "live" | "replay",
+  at: number,
+) {
+  const built = buildTrajectory({
+    messages: view.messages,
+    parts: view.parts,
+    now: at,
+    busy: mode === "live" ? true : (view.busy ?? false),
+    language,
+  })
+  return buildRuntime(
+    {
+      mode,
+      sessionID: "s",
+      parts: view.parts,
+      status: { type: "busy" } as any,
+      permissions: [],
+      questions: [],
+      childStatus: () => undefined,
+      requests: built.requests,
+    },
+    at,
+  )
+}
+
+describe("session runtime performance", () => {
+  test("measures 200 requests x 3 tools with 100 reasoning deltas across 5 rounds", () => {
+    const u = user(T0)
+    const messages: Message[] = [u]
+    const partsByMsg = new Map<string, Part[]>()
+
+    // 200 requests (assistant messages), each with 3 tools (including 1 task)
+    for (let i = 0; i < 200; i++) {
+      const reqTime = T0 + 1000 + i * 2000
+      const a = assistant(u, reqTime)
+      messages.push(a)
+
+      const t1 = tool(reqTime + 10, "bash", {
+        status: "completed",
+        input: { command: `echo ${i}` },
+        output: `${i}`,
+        time: { start: reqTime + 10, end: reqTime + 20 },
+      })
+      const t2 = tool(reqTime + 30, "read", {
+        status: "completed",
+        input: { filePath: `/file_${i}.txt` },
+        output: "ok",
+        time: { start: reqTime + 30, end: reqTime + 40 },
+      })
+      const t3 = tool(reqTime + 50, "task", {
+        status: "completed",
+        input: { subagent_type: "worker", description: `worker ${i}` },
+        output: "<task_result>ok</task_result>",
+        metadata: { sessionId: `sub_${i}` },
+        time: { start: reqTime + 50, end: reqTime + 100 },
+      })
+      partsByMsg.set(a.id, [t1, t2, t3])
+    }
+
+    // In-flight assistant message at the end
+    const inFlightTime = T0 + 1000 + 200 * 2000
+    const inFlight = assistant(u, inFlightTime, { time: { created: inFlightTime } }) // no completed
+    messages.push(inFlight)
+
+    const reasoningPart: Part = {
+      id: id("prt", inFlightTime + 1),
+      sessionID: "s",
+      messageID: inFlight.id,
+      type: "reasoning",
+      text: "",
+      time: { start: inFlightTime + 1 },
+    } as any
+
+    partsByMsg.set(inFlight.id, [reasoningPart])
+
+    const parts = (msgId: string) => partsByMsg.get(msgId) ?? []
+
+    const roundMedians: number[] = []
+    const roundP95s: number[] = []
+    const triggersPerDelta = 1 // In unbatched architecture, each store delta triggers assemble
+
+    const ROUNDS = 5
+    const DELTAS = 100
+
+    for (let round = 0; round < ROUNDS; round++) {
+      ;(reasoningPart as any).text = ""
+      const durations: number[] = []
+
+      for (let d = 0; d < DELTAS; d++) {
+        ;(reasoningPart as any).text += ` delta_${d}: thinking about step ${d}... `
+        const now = inFlightTime + 10 + d * 50
+        const start = performance.now()
+        const model = assemble({ messages, parts }, "live", now)
+        const duration = performance.now() - start
+        durations.push(duration)
+        expect(model.requests.length).toBeGreaterThan(0)
+      }
+
+      durations.sort((a, b) => a - b)
+      const median = durations[Math.floor(durations.length / 2)]!
+      const p95 = durations[Math.floor(durations.length * 0.95)]!
+      roundMedians.push(median)
+      roundP95s.push(p95)
+    }
+
+    roundMedians.sort((a, b) => a - b)
+    roundP95s.sort((a, b) => a - b)
+
+    const finalMedian = roundMedians[Math.floor(roundMedians.length / 2)]!
+    const finalP95 = roundP95s[Math.floor(roundP95s.length / 2)]!
+
+    console.log(
+      `[session-runtime-perf] 5 rounds median assemble time: ${finalMedian.toFixed(2)} ms, p95: ${finalP95.toFixed(2)} ms, triggers per delta: ${triggersPerDelta}`,
+    )
+    console.log(`[session-runtime-perf] round medians: [${roundMedians.map((m) => m.toFixed(2)).join(", ")}] ms`)
+    console.log(`[session-runtime-perf] round p95s: [${roundP95s.map((p) => p.toFixed(2)).join(", ")}] ms`)
+
+    expect(finalMedian).toBeGreaterThan(0)
+    expect(finalP95).toBeGreaterThan(0)
+  })
+})
