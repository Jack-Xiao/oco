+    expect(subDetailAt(s, 999, { narrow: false })).toBeUndefined()
+    expect(subDetailAt(sub({ sessionID: undefined }), 3000, { narrow: false })!.open.enabled).toBe(false)
+  })
+
+  const acts = () => {
+    const extra = [0, 1, 2, 3, 4].map((i) =>
+      tool({
