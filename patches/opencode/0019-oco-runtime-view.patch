+// oco (patches/opencode/0019): M5 test fixture adapter. A real session (rounds 1-4, sanitized and slimmed) is
+// read at runtime (not imported: the composite tsconfig would reject a .json import) and mapped to SDK shapes.
+// Test-only; nothing in the app bundle imports this file.
+import { readFileSync } from "node:fs"
+import type {
+  AssistantMessage,
+  Message,
+  Part,
+  ReasoningPart,
+  StepFinishPart,
+  StepStartPart,
