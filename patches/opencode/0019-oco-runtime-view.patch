@@ -0,0 +1,838 @@
+// oco (patches/opencode/0019): M5 runtime ring — geometry, bus wires, packets and the token as pure functions of
+// (stage width, height, k, t). Ported from the approved mockup (L686-832 geometry, L868-890 token, L1364-1555 wires,
+// packets, labels). No DOM access; no copy except i18n Phrase keys (`ring.pkt.*`) and raw glyph + tool name labels.
+import { RING } from "./session-runtime-ring-types"
+import type {
+  Box,
+  Packet,
+  Phrase,
+  PillId,
+  Poly,
+  Pt,
+  RingFrame,
+  RingGeo,
+  RingIndex,
+  RingRound,
+  RingStageId,
+  RingSub,
+  RingTool,
+  Tone,
+  Wire,
+} from "./session-runtime-ring-types"
+import { childDoneAt, probeStageOfSub, subStateAt } from "./session-runtime-ring-sub"
+
+// ---------- extensions (all optional or additive; every RingGeo / Wire / Packet consumer keeps working) ----------
+/** `dock(k)` is the k-th "awaiting pickup" berth on the return lane edge; the view draws a dot there. */
+export type RingGeoX = RingGeo & {
+  dock(k: number): Pt
+  /** Where each station sits on the ring. `pill[id].cx` is the box centre, which differs when a wide label pushes the pill sideways. */
+  anchor: Record<PillId, Pt>
+}
+/** Wire layer: base wires sit under the ring and card, `top` wires are drawn over them (mockup layer `f`). */
+export type RingWire = Wire & { top?: true }
+/** Packet extras: tangent at the packet (label side), trail start (moving tail) and "place even when crowded". */
+export type RingPacket = Packet & { dx?: number; dy?: number; trail?: Pt; fixed?: boolean }
+export type LabelItem = { at: Pt; text: string; tone: Tone; dx?: number; dy?: number; fixed?: boolean }
+export type PlacedLabel = { box: Box; text: string; tone: Tone; at: Pt; lead: Pt }
+
+/** Corner radius of the expanded subagent lane outline (the view draws the outline from sx0/sx1/topY/botY). */
+export const LANE_RX = 16
+const PILL_FS = 12
+const LANE_MIN_K = 0.02
+
+const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v))
+const lerp = (a: number, b: number, k: number) => a + (b - a) * k
+const P = (x: number, y: number): Pt => ({ x, y })
+const at = (v: number | undefined, t: number): v is number => v !== undefined && v <= t
+
+/** CJK characters count a full em, the rest 0.61 em (mockup L394): no DOM measuring, so tests can reproduce it. */
+export function textW(s: string, px: number): number {
+  let n = 0
+  for (const ch of String(s)) n += (ch.codePointAt(0) ?? 0) >= 0x2e80 ? px : px * 0.61
+  return n
+}
+
+export function poly(pts: Pt[]): Poly {
+  const cum = [0]
+  for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y))
+  const L = cum[cum.length - 1]
+  const at = (d: number) => {
+    if (pts.length < 2) return { x: pts[0]?.x ?? 0, y: pts[0]?.y ?? 0, dx: 0, dy: 0 }
+    d = clamp(d, 0, L)
+    let i = 1
+    while (i < cum.length - 1 && cum[i] < d) i++
+    const s = cum[i] - cum[i - 1] || 1
+    const k = (d - cum[i - 1]) / s
+    return {
+      x: pts[i - 1].x + (pts[i].x - pts[i - 1].x) * k,
+      y: pts[i - 1].y + (pts[i].y - pts[i - 1].y) * k,
+      dx: pts[i].x - pts[i - 1].x,
+      dy: pts[i].y - pts[i - 1].y,
+    }
+  }
+  return { pts, L, at }
+}
+
+export function stageSize(w: number, h: number): { W: number; H: number; wide: boolean } {
+  const wide = w >= RING.WIDE_MIN
+  return { W: w, H: Math.max(h, wide ? RING.MIN_H_WIDE : RING.MIN_H_NARROW), wide }
+}
+
+// ---------- stations ----------
+type Station = Exclude<PillId, "next">
+const STATIONS: { k: Station; a: number }[] = [
+  { k: "asm", a: 180 },
+  { k: "think", a: 240 },
+  { k: "out", a: 300 },
+  { k: "call", a: 0 },
+  { k: "wait", a: 60 },
+]
+const NEXT_ANGLE = 120
+/** Ring angle (deg, unwrapped over one request) of the stage a token parks at (mockup ANG L556). */
+const ANG: Partial<Record<RingStageId, number>> = {
+  say: 180, asm: 180, fly: 212, think: 240, out: 300, call: 360, wait: 420, ask: 420, next: 480,
+}
+/** Which side of the pill the token parks on: +1 after the pill (exit side), -1 before it (entry side). */
+const SIDE: Partial<Record<PillId, number>> = { asm: 1, think: 1, out: -1, call: -1, wait: -1, next: 1 }
+/** Stage tone (mockup STC): the colour of the lit station, the model channel and the token. */
+const STAGE_TONE: Record<RingStageId, Tone> = {
+  pre: "faint", say: "main", asm: "main", fly: "main", think: "acc", out: "text", call: "tool",
+  wait: "sub", ask: "attn", next: "main", end: "ok", abort: "err",
+}
+
+// ---------- label-aware pill spread ----------
+/** Clearance kept between neighbouring boxes: `obst` grows every box by 3 px per side, so 7 px keeps the grown boxes apart. */
+const GAP = 7
+/** Ring angle (deg) of each pill's anchor; `next` is the "bring results back" pill. */
+const PILL_ANGLE: Record<PillId, number> = { asm: 180, think: 240, out: 300, call: 0, wait: 60, next: NEXT_ANGLE }
+
+type Spread = {
+  /** Sideways shift of each pill from its ring anchor (0 whenever the labels fit, which is the mockup layout). */
+  dx: Record<PillId, number>
+  /** Half width of the counter box inside the ring (narrow only). */
+  ctrHalf: number
+  /** Distance from the ring centre to the leftmost / rightmost pill edge. */
+  left: number
+  right: number
+}
+
+/**
+ * Pills are centred on their ring points, exactly like the mockup, while the labels fit. Long labels (English) are moved
+ * sideways only as far as needed: the top pair (think / out) and the bottom pair (next / wait) move apart, and in the narrow
+ * layout asm / call move outward so the counter box keeps at least half the ring radius either side of the centre.
+ * Every pill keeps its ring point under it (the shift never exceeds half the width minus 10 px).
+ */
+function spread(R: number, pw: Record<PillId, number>, side: boolean): Spread {
+  const room = (w: number) => Math.max(0, w / 2 - 10)
+  const dx: Record<PillId, number> = { asm: 0, think: 0, out: 0, call: 0, wait: 0, next: 0 }
+  const ax = (id: PillId) => R * Math.cos((PILL_ANGLE[id] * Math.PI) / 180)
+  let ctrHalf = 0.56 * R
+  if (side) {
+    const want = 0.5 * R + GAP
+    const asm = Math.min(room(pw.asm), Math.max(0, want - (R - pw.asm / 2)))
+    const call = Math.min(room(pw.call), Math.max(0, want - (R - pw.call / 2)))
+    dx.asm = -asm
+    dx.call = call
+    ctrHalf = clamp(Math.min(R - pw.asm / 2 + asm, R - pw.call / 2 + call) - GAP, 6, 0.56 * R)
+  }
+  const pair = (a: PillId, b: PillId) => {
+    const s = Math.min(room(pw[a]), room(pw[b]), Math.max(0, ((pw[a] + pw[b]) / 2 + GAP - (ax(b) - ax(a))) / 2))
+    dx[a] = -s
+    dx[b] = s
+  }
+  pair("think", "out")
+  pair("next", "wait")
+  let left = 0
+  let right = 0
+  for (const id of Object.keys(pw) as PillId[]) {
+    left = Math.max(left, pw[id] / 2 - (ax(id) + dx[id]))
+    right = Math.max(right, ax(id) + dx[id] + pw[id] / 2)
+  }
+  return { dx, ctrHalf, left, right }
+}
+
+type Base = {
+  mode: "wide" | "narrow"; k: number; W: number; H: number; R: number; cx: number; cy: number; pad: number
+  busO: number; busB: number
+  you: Box; model: Box; ctr: Box; pay: Box; tools: Box; lane: Box
+  rows: Box[]; toolCap: number
+  laneCols: number; laneRows: number
+  ringBot?: number
+}
+
+function baseWide(W: number, H: number, k: number, sideHalf: number, dk: number): Base {
+  const pad = 14
+  // lane collapsed (k=0): the right column is only the tools dock, so it narrows and the ring takes the width
+  const youW = clamp(W * 0.19, 190, 290)
+  const dockW = Math.round(lerp(clamp(W * 0.24, 262, 400), clamp(W * 0.28, 300, 470), k))
+  const dockX = W - pad - dockW
+  const busX = dockX - 20
+  const x0 = pad + youW + 26
+  const x1 = busX - 30
+  const R = Math.max(118, Math.min((x1 - x0 - 124) / 2, (H - 112) / 2, lerp(258, 236, k)))
+  const cx = x0 + R + 42 + Math.max(0, (x1 - x0 - (2 * R + 84)) / 2)
+  const cy = clamp(H / 2 + 6, R + 68, H - R - 44)
+  const yh = Math.min(H - 2 * pad, 330)
+  const you = { x: pad, y: clamp(cy - yh / 2, pad, H - pad - yh), w: youW, h: yh }
+  const mw = Math.min(1.95 * R, 360)
+  const model = { x: cx - mw / 2, y: cy - R - 66, w: mw, h: 58 }
+  // payload card: geometric centre = ring centre; the width clears the left/right stations
+  // Label-aware: 44 clears the zh/zht station pills (identical to the mockup); a wider label (en) pushes the card edge in.
+  const pw = Math.round(2 * (R - Math.max(44, sideHalf + 10)))
+  const pay = { x: cx - pw / 2, y: cy - RING.PAY_H / 2, w: pw, h: RING.PAY_H }
+  // counter row sits between the card top and the upper ring; no wider than the chord at that height
+  const ly = pay.y - 8 - RING.CTR_H
+  const half = Math.sqrt(Math.max(0, R * R - (cy - ly) ** 2)) - 18
+  const ctr = { x: cx - half, y: ly, w: 2 * half, h: RING.CTR_H }
+  const compact = H < 440
+  const rowH = compact ? 22 : 32
+  const nRows = 5
+  // dk = 0: the dock is only its 30 px header strip (no tools this round, or the round ended on a tool-less request)
+  const th = Math.round(lerp(30, 24 + nRows * (rowH + 4) + 4, dk))
+  const lh = lerp(RING.STRIP_H, clamp(H - 2 * pad - th - 12, 130, 180), k)
+  const gap = lerp(8, 12, k)
+  const dy = clamp(cy - (th + gap + lh) / 2, pad, H - pad - (th + gap + lh))
+  const tools = { x: dockX, y: dy, w: dockW, h: th }
+  const rows: Box[] = []
+  for (let i = 0; i < nRows; i++) rows.push({ x: dockX + 8, y: dy + 27 + i * (rowH + 4), w: dockW - 16, h: rowH })
+  const lane = { x: dockX, y: dy + th + gap, w: dockW, h: lh }
+  return {
+    mode: "wide", k, W, H, R, cx, cy, pad, busO: busX - 4, busB: busX + 4,
+    you, model, ctr, pay, tools, lane, rows, toolCap: nRows, laneCols: 3, laneRows: 2,
+  }
+}
+
+function baseNarrow(W: number, H: number, k: number, pw: Record<PillId, number>): Base {
+  const pad = 8
+  const you = { x: pad, y: pad, w: W - 2 * pad, h: 70 }
+  const ringTop = you.y + you.h + 10
+  const dockH = clamp(H - pad - ringTop - 8 - (72 + 2 * 100), 168, 196)
+  const zoneH = H - pad - dockH - 8 - ringTop
+  // Label-aware: the mockup puts the ring centre 58 px + R from the left and the spine 44 px past the ring. Wider labels
+  // (English) push both out; the ring then shrinks (never below 70) until the payload column is back to the mockup's 198 px.
+  const cxOf = (R: number, sp: Spread) => Math.max(pad + 58 + R, pad + 24 + sp.left)
+  const spineOf = (R: number, sp: Spread) => cxOf(R, sp) + Math.max(R + 44, sp.right + 16)
+  let R = clamp(Math.min((W - 330) / 2, (zoneH - 72) / 2), 70, 100)
+  let sp = spread(R, pw, true)
+  while (R > 70 && W - pad - spineOf(R, sp) - 14 < 198) {
+    R = Math.max(70, R - 1)
+    sp = spread(R, pw, true)
+  }
+  const cx = cxOf(R, sp)
+  const cy = ringTop + 36 + 12 + R
+  const spine = spineOf(R, sp)
+  const mw = 2 * R + 64
+  const model = { x: clamp(cx - mw / 2, pad + 16, spine - 10 - mw), y: ringTop, w: mw, h: 36 }
+  const ringBot = cy + R + 24
+  // lane collapsed (k=0): the lower right is a single line, the freed height goes to the payload card
+  const pay = { x: spine + 14, y: ringTop, w: W - pad - spine - 14, h: lerp(zoneH + dockH - RING.STRIP_H, zoneH, k) }
+  const ctr = { x: cx - sp.ctrHalf, y: cy - 0.6 * R, w: 2 * sp.ctrHalf, h: 1.16 * R }
+  const dockY = ringTop + zoneH + 8
+  const rowH = 23
+  const tools = { x: pad, y: dockY, w: spine - 12 - pad, h: dockH }
+  const toolCap = clamp(Math.floor((dockH - 26) / (rowH + 3)), 4, 6)
+  const rows: Box[] = []
+  for (let i = 0; i < toolCap; i++) rows.push({ x: pad + 6, y: dockY + 23 + i * (rowH + 3), w: tools.w - 12, h: rowH })
+  const lane = { x: spine + 12, y: dockY + lerp(dockH - RING.STRIP_H, 0, k), w: W - pad - spine - 12, h: lerp(RING.STRIP_H, dockH, k) }
+  return {
+    mode: "narrow", k, W, H, R, cx, cy, pad, busO: spine - 4, busB: spine + 4,
+    you, model, ctr, pay, tools, lane, rows, toolCap, laneCols: 2, laneRows: 3, ringBot,
+  }
+}
+
+const ringPoint = (cx: number, cy: number, a: number, r: number): Pt => {
+  const k = (a * Math.PI) / 180
+  return P(cx + r * Math.cos(k), cy + r * Math.sin(k))
+}
+
+/** Point on the ring (or a concentric circle of radius r) at angle a degrees. */
+export function ringPt(g: Pick<RingGeo, "cx" | "cy" | "R">, a: number, r: number = g.R): Pt {
+  return ringPoint(g.cx, g.cy, a, r)
+}
+
+/** `pillLabels` size the five station pills, `nextLabel` sizes the "bring results back" pill (pillLabels.next is unused). */
+export function geoOf(
+  W: number,
+  H: number,
+  k: number,
+  pillLabels: Record<PillId, string>,
+  nextLabel: string,
+  dk = 1,
+): RingGeoX {
+  const pillW = (n: string) => Math.round(textW(n, PILL_FS) + 20)
+  const pw: Record<PillId, number> = {
+    asm: pillW(pillLabels.asm), think: pillW(pillLabels.think), out: pillW(pillLabels.out),
+    call: pillW(pillLabels.call), wait: pillW(pillLabels.wait), next: pillW(nextLabel),
+  }
+  // half-width of the widest pill sitting on the horizontal axis (asm left, call right)
+  const sideHalf = Math.max(pw.asm, pw.call) / 2
+  const b = W >= RING.WIDE_MIN ? baseWide(W, H, k, sideHalf, dk) : baseNarrow(W, H, k, pw)
+  const { cx, cy, R, busO, busB, mode } = b
+  const wide = mode === "wide"
+
+  // pills sit on their ring points, moved sideways only when the labels would otherwise touch (see `spread`)
+  const sp = spread(R, pw, !wide)
+  const pill = {} as RingGeo["pill"]
+  const anchor = {} as Record<PillId, Pt>
+  for (const s of STATIONS) {
+    const c = ringPoint(cx, cy, s.a, R)
+    const w = pw[s.k]
+    anchor[s.k] = c
+    pill[s.k] = { x: c.x + sp.dx[s.k] - w / 2, y: c.y - 11, w, h: 22, cx: c.x + sp.dx[s.k], cy: c.y }
+  }
+  const wp = ringPoint(cx, cy, NEXT_ANGLE, R)
+  const ww = pw.next
+  anchor.next = wp
+  pill.next = { x: wp.x + sp.dx.next - ww / 2, y: wp.y - 10, w: ww, h: 20, cx: wp.x + sp.dx.next, cy: wp.y }
+  const callR = P(pill.call.x + pill.call.w, cy)
+  const waitR = P(pill.wait.x + pill.wait.w, pill.wait.cy)
+  const asmL = P(pill.asm.x, cy)
+
+  // ----- subagent lane: dispatch lane (top edge) -> work area (cells) -> return lane (bottom edge) -> berths -----
+  const sx0 = b.lane.x + 8
+  const sx1 = b.lane.x + b.lane.w - 8
+  const topY = b.lane.y + (wide ? 40 : 38)
+  const botY = b.lane.y + b.lane.h - (wide ? 20 : 18)
+  const gx = 6
+  const gy = wide ? 9 : 8
+  const cx0 = sx0 + 12
+  const cx1 = sx1 - 12
+  const cy0 = topY + 9
+  const cy1 = botY - 8
+  const cw = (cx1 - cx0 - gx * (b.laneCols - 1)) / b.laneCols
+  const ch = Math.max(0, (cy1 - cy0 - gy * (b.laneRows - 1)) / b.laneRows)
+  const cells: (Box & { row: number })[] = []
+  for (let i = 0; i < RING.SUB_CELLS; i++) {
+    const c = i % b.laneCols
+    const rr = Math.floor(i / b.laneCols)
+    cells.push({ x: cx0 + c * (cw + gx), y: cy0 + rr * (ch + gy), w: cw, h: ch, row: rr })
+  }
+  const dock = (i: number) => P(sx0 + 22 + i * 10, botY)
+  // the probe parks on the cell's top-right border (the first row of a cell keeps that corner free of text)
+  const park = (c: Box) => P(c.x + c.w - 4, c.y - 3)
+  const gapX = (c: Box) => Math.min(c.x + c.w + gx / 2, sx1 - 5)
+
+  const rowMid = (i: number) => b.rows[i].y + b.rows[i].h / 2
+  const off = wide ? 4 : 3
+  // a tool probe stops at the door of its row: left of the row (wide) or right of it (narrow)
+  const doorX = (i: number) => (wide ? b.rows[i].x - 4 : b.rows[i].x + b.rows[i].w + 4)
+  const toolOut = (i: number) => {
+    const y = rowMid(i) - off
+    return poly([callR, P(busO, cy), P(busO, y), P(doorX(i), y)])
+  }
+  const toolBack = (i: number) => {
+    const y = rowMid(i) + off
+    return poly([P(doorX(i), y), P(busB, y), P(busB, waitR.y), waitR])
+  }
+  const subOut = (i: number) => {
+    const c = cells[i]
+    const p = park(c)
+    const x = gapX(c)
+    return poly(
+      c.row === 0
+        ? [callR, P(busO, cy), P(busO, topY), P(p.x, topY), p]
+        : [callR, P(busO, cy), P(busO, topY), P(x, topY), P(x, p.y), p],
+    )
+  }
+  // return trip: work area -> column gap -> return lane -> berth (waits for pickup) -> bus -> "await results"
+  const subBack = (i: number) => {
+    const c = cells[i]
+    const p = park(c)
+    const x = gapX(c)
+    const home = poly([p, P(x, p.y), P(x, botY), dock(i)])
+    const pp = poly(home.pts.concat([P(busB, botY), P(busB, waitR.y), waitR]))
+    pp.hold = home.L
+    return pp
+  }
+
+  // ----- you <-> assemble, and the "waiting for your answer" arc -----
+  let pYou: Poly
+  let askArc: Pt[]
+  if (wide) {
+    pYou = poly([P(b.you.x + b.you.w, cy), asmL])
+    // leaves the right edge of "await results", circles outside the ring (past the small text under the pill) to "you"
+    const pw = pill.wait
+    askArc = [P(pw.x + pw.w - 2, pw.cy + 6)]
+    for (let a = 50; a <= 162; a += 4) askArc.push(ringPoint(cx, cy, a, R + 38))
+    askArc.push(P(b.you.x + b.you.w, askArc[askArc.length - 1].y))
+  } else {
+    const rail = b.pad + 6
+    pYou = poly([P(rail, b.you.y + b.you.h), P(rail, cy), asmL])
+    const ax = pill.wait.x - 4 // down the left of the pill, clear of the small text under it
+    const ringBot = b.ringBot ?? cy + R + 24
+    askArc = [P(pill.wait.x, pill.wait.cy), P(ax, pill.wait.cy), P(ax, ringBot - 6), P(rail, ringBot - 6), P(rail, b.you.y + b.you.h)]
+  }
+  const pAsk = poly(askArc)
+  const pAskBack = poly(askArc.slice().reverse())
+
+  // ----- subagent detail panel: covers the ring area, not the tools dock or the lane -----
+  let sd: Box
+  if (wide) {
+    const x0 = b.you.x + b.you.w + 14
+    const x1 = busO - 14
+    const w = Math.min(x1 - x0, 520)
+    const h = Math.min(b.H - 2 * b.pad, Math.max(360, 2 * R + 60))
+    sd = { x: clamp(cx - w / 2, x0, x1 - w), y: clamp(cy - h / 2, b.pad, b.H - b.pad - h), w, h }
+  } else {
+    const y = b.you.y + b.you.h + 10
+    sd = { x: b.pad, y, w: b.W - 2 * b.pad, h: b.tools.y - 8 - y }
+  }
+  // label avoidance: card, stations, tools dock, lane
+  const obst = [b.you, b.model, b.pay, b.ctr, b.tools, b.lane, ...Object.values(pill)].map((o) => ({
+    x: o.x - 3,
+    y: o.y - 3,
+    w: o.w + 6,
+    h: o.h + 6,
+  }))
+
+  return {
+    mode, k: b.k, W: b.W, H: b.H, R, cx, cy, pad: b.pad, busO, busB,
+    you: b.you, model: b.model, ctr: b.ctr, pay: b.pay, tools: b.tools, lane: b.lane, sd,
+    rows: b.rows, toolCap: b.toolCap, cells,
+    topY, botY, sx0, sx1,
+    pill, callR, waitR, asmL,
+    pYou, pAsk, pAskBack,
+    toolOut, toolBack, subOut, subBack,
+    obst,
+    dock,
+    anchor,
+  }
+}
+
+// ---------- token (mockup L868-890) ----------
+const toDeg = 180 / Math.PI
+
+/** Angular offset that parks the token beside the pill (clear of the small text under it). */
+function parkOff(g: RingGeo, st: RingStageId): number {
+  const key: PillId | undefined = st === "say" ? "asm" : st === "ask" ? "wait" : (st as PillId)
+  if (!key || !(key in SIDE)) return 0
+  const p = g.pill[key]
+  const ang = ((ANG[key as RingStageId] ?? 0) % 360) * (Math.PI / 180)
+  const s = Math.abs(Math.sin(ang))
+  const c = Math.abs(Math.cos(ang))
+  const d = Math.min(s > 0.01 ? p.w / 2 / s : 1e9, c > 0.01 ? p.h / 2 / c : 1e9) + 10
+  return ((SIDE[key] ?? 0) * d) / g.R * toDeg
+}
+
+/** Token angle: only moves forward at the packet speed V, at most LAG behind its target; `reduced` jumps to the target. */
+export function tokenAt(
+  g: RingGeo,
+  round: RingRound | undefined,
+  t: number,
+  reduced: boolean,
+): { pos: number; tgt: number } | undefined {
+  if (!round || !round.changes.length) return undefined
+  const w = (RING.V / g.R) * toDeg // same line speed as the packets
+  const LAG = 46
+  const park = (c: RingRound["changes"][number]) => c.ang + parkOff(g, c.st)
+  const first = round.changes[0]
+  let pos = park(first)
+  let tgt = pos
+  let tp = first.t
+  for (const c of round.changes) {
+    if (c.t > t) break
+    pos = Math.min(tgt, pos + (c.t - tp) * w)
+    if (!(c.st === "end" || c.st === "abort")) tgt = Math.max(tgt, park(c))
+    pos = Math.max(pos, tgt - LAG) // jumping several stations ahead: at most one station behind, no queue
+    tp = c.t
+  }
+  pos = reduced ? tgt : Math.min(tgt, pos + (t - tp) * w)
+  return { pos, tgt }
+}
+
+/** SVG path `d` of the ring arc a1 -> a2 (degrees) at radius r, sampled every 3 degrees; "" when shorter than 0.3 degree. */
+export function arcPath(g: RingGeo, a1: number, a2: number, r: number): string {
+  if (a2 - a1 < 0.3) return ""
+  const pts: Pt[] = []
+  for (let a = a1; a < a2; a += 3) pts.push(ringPt(g, a, r))
+  pts.push(ringPt(g, a2, r))
+  return pts.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join("")
+}
+
+// ---------- wires ----------
+const flowOffset = (t: number, reduced: boolean) => (reduced ? undefined : Math.round((-(t * 0.03) % 12) * 10) / 10 || 0)
+
+/**
+ * Bus wires (mockup L1364-1400). Drawn only where there is a branch (every end touches something):
+ *   out bus  = call outlet + used tool rows + lane entry (expanded: top of the dispatch lane; collapsed: stub port)
+ *   back bus = used tool rows + return lane (expanded only) -> await-results inlet; absent when no row and no lane
+ * `top` wires go over the card; the collapsed-lane stub fades out as the lane opens (1 - k) and crosses the back bus
+ * with a 7 px gap (`gap.at`, opacity of the gap = wire.opacity / 0.4; port circle opacity = wire.opacity * 1.5).
+ * Dismissed questions keep a neutral colour (D18): the ask arc is `faint`, never `err`.
+ */
+export function wiresAt(g: RingGeo, frame: RingFrame, t: number, reduced: boolean): RingWire[] {
+  const st = frame.stage.st
+  const ended = st === "end" || st === "abort" || st === "pre"
+  const rows = frame.tools.rows
+  const cells = frame.subs.cells
+  const live =
+    !ended && (rows.some((r) => r.state === "run") || cells.some((c) => c.state === "run" || c.state === "docked"))
+  const busOp = live ? 0.75 : 0.22
+  const dash = live ? "6 6" : undefined
+  const dashOffset = live ? flowOffset(t, reduced) : undefined
+  const wide = g.mode === "wide"
+  const off = wide ? 4 : 3
+  const nRow = Math.min(g.rows.length, rows.length)
+  const rowY = (i: number) => g.rows[i].y + g.rows[i].h / 2
+  const laneDrawn = g.k > LANE_MIN_K && g.botY - g.topY > 2 * LANE_RX
+  const outYs = [g.cy]
+  const backYs: number[] = []
+  for (let i = 0; i < nRow; i++) {
+    outYs.push(rowY(i) - off)
+    backYs.push(rowY(i) + off)
+  }
+  if (laneDrawn) {
+    outYs.push(g.topY)
+    backYs.push(g.botY)
+  }
+  if (backYs.length) backYs.push(g.waitR.y)
+  const oLo = Math.min(...outYs)
+  const oHi = Math.max(...outYs)
+  const out: RingWire[] = []
+
+  out.push({ id: "bus-call", pts: [g.callR, P(g.busO, g.cy)], tone: "tool", width: 1.5, opacity: busOp, dash, dashOffset })
+  if (oHi - oLo > 0.5) {
+    out.push({
+      id: "bus-out", pts: [P(g.busO, oLo), P(g.busO, oHi)], tone: "tool", width: 1.5, opacity: busOp * 0.9, dash, dashOffset,
+    })
+  }
+  if (backYs.length) {
+    out.push({
+      id: "bus-back",
+      pts: [P(g.busB, Math.min(...backYs)), P(g.busB, Math.max(...backYs))],
+      tone: "ok", width: 1.5, opacity: live ? 0.55 : 0.18,
+    })
+    out.push({ id: "bus-wait", pts: [P(g.busB, g.waitR.y), g.waitR], tone: "ok", width: 1.5, opacity: live ? 0.6 : 0.18 })
+  }
+
+  // you <-> assemble
+  const youLit = st === "say" || (st === "asm" && frame.stage.request?.m === 1 && t - (frame.stage.round?.start ?? t) < 3000)
+  out.push({
+    id: "you", pts: g.pYou.pts, tone: "main", width: 1.5, opacity: youLit ? 0.85 : 0.22,
+    dash: youLit ? "6 6" : undefined, dashOffset: youLit ? flowOffset(t, reduced) : undefined,
+  })
+  // "await results" -> you (the ask arc): lit while waiting, neutral grey once the question was dismissed (D18)
+  const askLit = st === "ask"
+  const dismissed = st === "end" && frame.stage.why === "dismiss"
+  out.push({
+    id: "ask",
+    pts: g.pAsk.pts,
+    tone: askLit ? "attn" : "faint",
+    width: askLit ? 2 : 1.2,
+    opacity: askLit ? 0.9 : dismissed ? 0.45 : 0.16,
+    dash: askLit ? "6 6" : "4 6",
+    dashOffset: askLit ? flowOffset(t, reduced) : undefined,
+  })
+  // model channel: ring top -> model box
+  const mLit = st === "fly" || st === "think" || st === "out" || st === "call"
+  out.push({
+    id: "model",
+    pts: [P(g.cx, g.cy - g.R), P(g.cx, g.model.y + g.model.h)],
+    tone: mLit ? STAGE_TONE[st] : "faint",
+    width: mLit ? 2 : 1.2,
+    opacity: mLit ? 0.85 : 0.2,
+    dash: mLit ? "4 5" : undefined,
+    dashOffset: mLit ? flowOffset(t, reduced) : undefined,
+  })
+
+  // ----- top layer -----
+  if (g.k < 0.98) {
+    // collapsed lane: a short stub from the out bus to the left edge of the strip, ending in a port circle
+    const sy = g.lane.y + Math.min(RING.STRIP_H, g.lane.h) / 2
+    const from = sy > oHi ? oHi : sy < oLo ? oLo : sy
+    const so = 1 - g.k
+    const crosses = backYs.length > 0 && sy > Math.min(...backYs) + 4 && sy < Math.max(...backYs) - 4
+    out.push({
+      id: "strip", top: true,
+      pts: [P(g.busO, from), P(g.busO, sy), P(g.lane.x, sy)],
+      tone: "sub", width: 1.2, opacity: 0.4 * so, dash: "3 5",
+      port: P(g.lane.x, sy),
+      gap: crosses ? { at: P(g.busB, sy) } : undefined,
+    })
+  }
+  for (let i = 0; i < nRow; i++) {
+    const rw = g.rows[i]
+    const x0 = wide ? rw.x - 4 : rw.x + rw.w + 4
+    const y = rw.y + rw.h / 2
+    out.push({ id: `row-out-${i}`, top: true, pts: [P(g.busO, y - off), P(x0, y - off)], tone: "tool", width: 1.2, opacity: 0.45 })
+    out.push({ id: `row-back-${i}`, top: true, pts: [P(x0, y + off), P(g.busB, y + off)], tone: "ok", width: 1.2, opacity: 0.3 })
+  }
+  if (laneDrawn) {
+    const laneLit = cells.some((c) => c.state === "queued" || c.state === "run" || c.state === "docked")
+    const lo = (laneLit ? 0.8 : cells.length ? 0.35 : 0.18) * g.k
+    out.push({ id: "lane-in", top: true, pts: [P(g.busO, g.topY), P(g.sx0 + LANE_RX, g.topY)], tone: "sub", width: 1.2, opacity: lo * 0.7 })
+    out.push({ id: "lane-out", top: true, pts: [P(g.sx0 + LANE_RX, g.botY), P(g.busB, g.botY)], tone: "ok", width: 1.2, opacity: lo * 0.6 })
+  }
+  return out
+}
+
+// ---------- packets (mockup L1514-1555, subagent timing per the plan's table) ----------
+const flat = (s: string | undefined) =>
+  String(s ?? "")
+    .replace(/\*\*|`/g, "")
+    .replace(/\s+/g, " ")
+    .trim()
+const cut = (s: string | undefined, n: number) => {
+  const a = [...flat(s)]
+  return a.length > n ? a.slice(0, n - 1).join("") + "…" : a.join("")
+}
+const ph = (key: Phrase["key"], params?: Phrase["params"]): Phrase => (params ? { key, params } : { key })
+
+type Plan = {
+  id: string; path: Poly; t0: number; tone: Tone
+  park?: boolean; gone?: number; until?: number
+  label?: Phrase | string; long?: Phrase | string; mark?: Phrase; glyph?: string
+  sub?: RingSub
+}
+
+/** Where a task's return trip starts and when it may leave the berth. Only data at or before t is read. */
+function subTrip(sub: RingSub, t: number): { back?: number; until: number; fail: boolean } {
+  const end = at(sub.end, t) ? sub.end : undefined
+  const bg = sub.background
+  if (!bg) {
+    // sync task: leaves when the child session is done (childDoneAt) or at the task's own end; collected at end
+    return { back: childDoneAt(sub, t) ?? end, until: end ?? Infinity, fail: subStateAt(sub, t) === "err" }
+  }
+  const retrieved = at(bg.retrievedAt, t) ? bg.retrievedAt : undefined
+  let last: (typeof bg.notices)[number] | undefined
+  for (const n of bg.notices) if (n.at <= t) last = n
+  // The task part ends as soon as it returns the task id: that end is not a pickup, only a failed dispatch counts.
+  if (end !== undefined && sub.failed) return { back: end, until: end, fail: true }
+  if (retrieved === undefined && last && (last.kind === "error" || last.kind === "cancelled")) {
+    return { back: last.at, until: last.at, fail: true } // leaves at the notice, failure colour, no berth stop
+  }
+  let done = childDoneAt(sub, t)
+  if (done !== undefined && last?.kind === "cleared" && done < last.at) done = undefined // a retry cleared it
+  const notice = last?.kind === "done" ? last.at : undefined
+  const back = done !== undefined && notice !== undefined ? Math.min(done, notice) : (done ?? notice ?? retrieved)
+  return { back, until: retrieved ?? Infinity, fail: false }
+}
+
+/**
+ * Packets: position = (t - departure) x V along the path; a path with a `hold` (the berth) waits there until `until`.
+ * Running tool probes stay at their door; sync/background subagent probes follow the plan's table. After arrival a
+ * non-parked packet lingers LINGER_MS then fades for FADE_MS; with `reduced` it jumps (hold -> end) with no mid positions.
+ * `label` is set only on the two newest moving packets (and the dismissed marker once it parked); `long` only on the newest.
+ * One probe per subagent (the return trip when it exists), its stage = probeStageOfSub(subStateAt(sub, t)).
+ * `index` is not read: everything comes from the frame's round (kept for the contract signature).
+ */
+export function packetsAt(g: RingGeo, index: RingIndex, frame: RingFrame, t: number, reduced: boolean): RingPacket[] {
+  void index
+  const r = frame.stage.round
+  if (!r) return []
+  const cur = frame.stage.request?.messageID
+  const plans: Plan[] = []
+  plans.push({ id: "you", path: g.pYou, t0: r.start, tone: "main", label: ph("ring.pkt.you") })
+  for (const q of r.requests) {
+    if (q.created > t) break
+    for (const x of q.tools) {
+      if (x.kind === "tool") {
+        if (q.messageID !== cur || !at(x.start, t)) continue
+        const i = Math.min(x.slot, g.toolCap - 1)
+        const running = !at(x.end, t)
+        plans.push({
+          id: `out:${x.id}`, path: g.toolOut(i), t0: x.start, tone: "tool", gone: x.end, park: running,
+          label: `→ ${x.name}`, long: `→ ${x.name} ${cut(x.arg, 22)}`,
+        })
+        if (at(x.end, t)) toolBack(plans, g, x, i)
+      } else if (x.kind === "task") {
+        const sub = x.sub
+        if (!sub || !at(sub.start, t)) continue
+        const i = Math.min(x.slot, RING.SUB_CELLS - 1)
+        const trip = subTrip(sub, t)
+        const glyph = String(sub.num)
+        plans.push({
+          id: `sub-out:${sub.uid}`, path: g.subOut(i), t0: sub.start, tone: "sub", gone: trip.back, park: trip.back === undefined,
+          label: ph("ring.pkt.handoff", { n: sub.num }), glyph, sub,
+        })
+        if (trip.back !== undefined) {
+          // result text only once the task has ended (not before: no preview), never for background tasks
+          const text = !sub.background && at(sub.end, t) ? cut(sub.failed ? (sub.error ?? sub.result) : sub.result, 16) : ""
+          plans.push({
+            id: `sub-back:${sub.uid}`, path: g.subBack(i), t0: trip.back, tone: trip.fail ? "err" : "ok", until: trip.until,
+            label: ph("ring.pkt.return", { n: sub.num }),
+            long: text ? ph("ring.pkt.return.long", { n: sub.num, text }) : undefined,
+            glyph, sub,
+          })
+        }
+      } else if (x.kind === "question") {
+        if (at(x.start, t) && !at(x.end, t)) {
+          plans.push({
+            id: `ask:${x.id}`, path: g.pAsk, t0: x.start, tone: "attn", park: true, glyph: "?",
+            label: ph("ring.pkt.ask", { header: x.question?.header ?? "" }),
+          })
+        }
+        if (at(x.end, t) && x.declined === "dismissed") {
+          // D18: dismissed is neutral grey, not the failure colour
+          plans.push({
+            id: `askback:${x.id}`, path: g.pAskBack, t0: x.end, tone: "faint", park: true, glyph: "✕",
+            label: ph("ring.pkt.dismissed"), mark: ph("ring.pkt.dismissed.mark"),
+          })
+        }
+      }
+    }
+  }
+
+  type Placed = { pk: RingPacket; t0: number; arrived: boolean; label?: Phrase | string; long?: Phrase | string; mark?: Phrase }
+  const placed: Placed[] = []
+  const hasBack = new Set<string>()
+  for (const p of plans) if (p.id.startsWith("sub-back:") && p.sub) hasBack.add(p.sub.uid)
+  for (const p of plans) {
+    const path = p.path
+    if (t < p.t0) continue
+    const V = RING.V
+    let d: number
+    let tArr: number
+    let holding = false
+    if (path.hold !== undefined) {
+      const h = path.hold
+      const tB = p.t0 + h / V
+      const rel = Math.max(tB, p.until ?? Infinity)
+      tArr = rel + (path.L - h) / V
+      d = reduced ? (t < rel ? h : path.L) : t < tB ? (t - p.t0) * V : t < rel ? h : h + (t - rel) * V
+      holding = reduced ? t < rel : t >= tB && t < rel
+    } else {
+      tArr = p.t0 + path.L / V
+      d = reduced ? path.L : (t - p.t0) * V
+    }
+    const arrived = d >= path.L - 0.01
+    if (arrived && p.gone !== undefined && t >= p.gone) continue // outbound: the result has turned around, the probe is gone
+    const age = arrived ? t - tArr : 0
+    // reduced: a packet in flight jumps to its end and is not shown; one waiting at the berth is a state, so it stays
+    if (!p.park && !holding && (reduced || age > RING.LINGER_MS + RING.FADE_MS)) continue
+    const opacity = p.park || !arrived ? 1 : age < RING.LINGER_MS ? 1 : Math.max(0, 1 - (age - RING.LINGER_MS) / RING.FADE_MS)
+    const dd = Math.min(d, path.L)
+    const here = path.at(dd)
+    const pk: RingPacket = {
+      id: p.id, at: P(here.x, here.y), tone: p.tone, opacity, parked: (!!p.park && arrived) || holding,
+      glyph: p.glyph || undefined, dx: here.dx, dy: here.dy,
+    }
+    if (!arrived && !reduced) {
+      const tr = path.at(Math.max(0, dd - 18))
+      pk.trail = P(tr.x, tr.y)
+    }
+    // one probe per subagent: the return trip when there is one, else the outbound packet
+    if (p.sub && (p.id.startsWith("sub-back:") || !hasBack.has(p.sub.uid))) {
+      const state = subStateAt(p.sub, t)
+      if (state) pk.probe = { uid: p.sub.uid, stage: probeStageOfSub(state) }
+    }
+    placed.push({ pk, t0: p.t0, arrived, label: p.label, long: p.long, mark: p.mark })
+  }
+
+  // labels: the two newest packets that are still on their way (a held return trip counts), the newest may use `long`;
+  // a dismissed question that has parked shows its fixed marker instead.
+  const movers = placed
+    .filter((x) => !x.arrived && x.label !== undefined)
+    .sort((a, b) => b.t0 - a.t0)
+    .slice(0, 2)
+  for (const x of placed) {
+    const m = movers.indexOf(x)
+    if (m >= 0) {
+      x.pk.label = x.label
+      if (m === 0 && x.long !== undefined) x.pk.long = x.long
+    } else if (x.arrived && x.mark) {
+      x.pk.label = x.mark
+      x.pk.fixed = true
+    }
+  }
+  return placed.map((x) => x.pk)
+}
+
+function toolBack(plans: Plan[], g: RingGeo, x: RingTool, i: number) {
+  const rejected = x.declined === "rejected"
+  const fail = x.status === "error" && !x.declined
+  const mark = rejected ? "⊘" : fail ? "✗" : "✓"
+  plans.push({
+    id: `back:${x.id}`, path: g.toolBack(i), t0: x.end ?? 0,
+    tone: rejected ? "faint" : fail ? "err" : "ok", // D18: a refusal is neutral, not a failure
+    label: `← ${mark} ${x.name}`,
+    long: fail ? `← ✗ ${x.name} ${cut(x.error, 20)}` : undefined,
+    glyph: fail ? "✗" : rejected ? "⊘" : undefined,
+  })
+}
+
+// ---------- labels ----------
+const hits = (a: Box, b: Box) => a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y
+
+/** Box of the small text under a station pill (10.5 px mono); the view passes these as `extra` obstacles. */
+export function stationSubBox(g: RingGeo, id: PillId, text: string): Box {
+  const p = g.pill[id]
+  const yy = p.y + p.h + 13
+  const sw = textW(text, 10.5)
+  return { x: p.cx - sw / 2 - 2, y: yy - 11, w: sw + 4, h: 14 }
+}
+
+/**
+ * Greedy label placement (mockup L1480-1500): candidate offsets around the anchor, first one inside the stage and clear of
+ * `g.obst`, `extra` and the labels already placed wins; unplaceable labels are dropped. Only `fixed` labels (the abort
+ * marker, the dismissed marker) fall back to the first candidate even when crowded. `dx/dy` (the packet's direction of
+ * travel) prefer left/right of a vertical run; `extra` = boxes such as stationSubBox().
+ */
+export function placeLabels(g: RingGeo, items: LabelItem[], extra: Box[] = []): PlacedLabel[] {
+  const used = g.obst.concat(extra)
+  const out: PlacedLabel[] = []
+  for (const L of items) {
+    const w = textW(L.text, 11) + 12
+    const h = 18
+    const vert = L.dy != null && Math.abs(L.dy) > Math.abs(L.dx ?? 0)
+    const cands: [number, number][] = L.fixed
+      ? [[12, -9], [-w / 2, 9], [-w - 12, -9], [-w / 2, -27]]
+      : vert
+        ? [[-w - 12, -9], [12, -9], [-w - 12, -30], [12, -30], [-w - 12, 12], [12, 12]]
+        : [[-w / 2, -27], [-w / 2, 9], [-w / 2, -48], [12, -9], [-w - 12, -9]]
+    for (let ci = 0; ci <= cands.length; ci++) {
+      const last = ci === cands.length
+      if (last && !L.fixed) break
+      const [dx, dy] = cands[last ? 0 : ci]
+      const box = { x: L.at.x + dx, y: L.at.y + dy, w, h }
+      if (!last && (box.x < 2 || box.y < 2 || box.x + w > g.W - 2 || box.y + h > g.H - 2)) continue
+      if (!last && used.some((o) => hits(box, o))) continue
+      used.push(box)
+      out.push({
+        box, text: L.text, tone: L.tone, at: L.at,
+        lead: P(box.x + (dx < 0 && dx < -w / 2 ? w : dx > 0 ? 0 : w / 2), box.y + h / 2),
+      })
+      break
+    }
+  }
+  return out
+}
+
+// ---------- dangling-end check ----------
+const distSeg = (p: Pt, a: Pt, b: Pt) => {
+  const vx = b.x - a.x
+  const vy = b.y - a.y
+  const l2 = vx * vx + vy * vy
+  const k = l2 ? clamp(((p.x - a.x) * vx + (p.y - a.y) * vy) / l2, 0, 1) : 0
+  return Math.hypot(p.x - (a.x + k * vx), p.y - (a.y + k * vy))
+}
+const nearBox = (p: Pt, b: Box, tol: number) => p.x >= b.x - tol && p.x <= b.x + b.w + tol && p.y >= b.y - tol && p.y <= b.y + b.h + tol
+
+/**
+ * Ends of wires that touch nothing (tolerance 2 px). An end is anchored when it lies in (or within 2 px of) a box, a
+ * station pill, a port, the ring, the lane outline, a packet, or on another wire. Row doors sit 4 px outside the row but
+ * inside the tools box, so the tools box anchors them.
+ */
+export function freeEnds(g: RingGeo, wires: Wire[], packets: Packet[] = []): Pt[] {
+  const tol = 2
+  const boxes: Box[] = [g.you, g.model, g.ctr, g.pay, g.tools, g.lane, ...g.rows, ...g.cells, ...Object.values(g.pill)]
+  const free: Pt[] = []
+  wires.forEach((w, wi) => {
+    if (w.pts.length < 2) return
+    for (const p of [w.pts[0], w.pts[w.pts.length - 1]]) {
+      let ok = boxes.some((b) => nearBox(p, b, tol))
+      ok = ok || Math.abs(Math.hypot(p.x - g.cx, p.y - g.cy) - g.R) <= tol
+      ok = ok || (!!w.port && Math.hypot(p.x - w.port.x, p.y - w.port.y) <= tol)
+      ok = ok || packets.some((k) => Math.hypot(p.x - k.at.x, p.y - k.at.y) <= tol)
+      ok =
+        ok ||
+        wires.some((o, oi) => {
+          if (oi === wi) return false
+          for (let i = 1; i < o.pts.length; i++) if (distSeg(p, o.pts[i - 1], o.pts[i]) <= tol) return true
+          return false
+        })
+      if (!ok) free.push(p)
+    }
+  })
+  return free
+}
