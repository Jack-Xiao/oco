@@ -0,0 +1,148 @@
+// oco (patches/opencode/0019): pure predicates for runtime-view actions.
+// "requested" is click state only. "cancelled" is focus data only (MessageAbortedError).
+
+export type RuntimeMode = "live" | "replay"
+export type ActionRunState = "working" | "waiting-user" | "retrying" | "idle" | "error" | "unknown"
+export type CancelLabel = "requested" | "cancelled"
+
+const STOP_STATES: ReadonlySet<ActionRunState> = new Set(["working", "retrying", "waiting-user"])
+
+/** Stop renders only while live, root session is busy, and the run is still in progress (including a user wait or a retry). */
+export function actionsVisible(mode: RuntimeMode, runState: ActionRunState, busy: boolean): boolean {
+  return mode === "live" && busy && STOP_STATES.has(runState)
+}
+
+/**
+ * Label for data-oco-runtime-cancel.
+ * cancelled wins: it comes from focus, never from the click, including during replay.
+ * requested is this view's click and only while following live (a replay snapshot must not say "requested").
+ * While live, requested holds only when the click still covers this busy stretch (no later request has started).
+ */
+export function cancelLabel(
+  clickedAt: number | undefined,
+  busy: boolean,
+  focusKind: string,
+  lastRequestStart: number | undefined,
+  mode: RuntimeMode = "live",
+): CancelLabel | undefined {
+  if (focusKind === "cancelled") return "cancelled"
+  if (mode !== "live") return undefined
+  if (clickedAt !== undefined && busy && (lastRequestStart === undefined || lastRequestStart <= clickedAt)) return "requested"
+  return undefined
+}
+
+/**
+ * Forget a stop click once the live session is idle or a later live request has started.
+ * `liveLastStart` must be the live run's last request start, never a replay snapshot.
+ */
+export function stopClickExpired(clickedAt: number, busy: boolean, liveLastStart: number | undefined): boolean {
+  return !busy || (liveLastStart !== undefined && liveLastStart > clickedAt)
+}
+
+/** A failed reply stays visible only while that request is still in the live attention list. */
+export function failureVisible(id: string, attentionIds: readonly string[]): boolean {
+  return attentionIds.includes(id)
+}
+
+/** Arm "cancel requested" only when the page actually provided a stop handler. */
+export function stopClickedAt(hasHandler: boolean, now: number): number | undefined {
+  return hasHandler ? now : undefined
+}
+
+export type AutoSyncTool = { sessionID?: string; turn: number }
+
+/**
+ * Child sessions to `sync` for the current turn.
+ * Skips a missing session id, other turns, and ids already requested. Caps the turn's total at `limit` (default 8):
+ * `autoSynced` is how many this turn has already auto-synced, so repeated calls never exceed the cap.
+ * Does not mutate `already`.
+ */
+export function autoSyncTargets(
+  tools: readonly AutoSyncTool[],
+  lastTurn: number | undefined,
+  already: ReadonlySet<string>,
+  limit = 8,
+  autoSynced = 0,
+): string[] {
+  limit -= autoSynced
+  if (lastTurn === undefined || limit <= 0) return []
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const tool of tools) {
+    if (out.length >= limit) break
+    const id = tool.sessionID
+    if (!id || tool.turn !== lastTurn) continue
+    if (already.has(id) || seen.has(id)) continue
+    seen.add(id)
+    out.push(id)
+  }
+  return out
+}
+
+/** In-progress child lifecycles. A collapsed child in one of these stays pinned; terminal ones do not. */
+const PIN_LIFECYCLE: ReadonlySet<string> = new Set(["running", "retrying", "waiting-user"])
+
+export type PinTool = { sessionID?: string; lifecycle: string }
+
+/** Sessions to pin: every expanded id, plus in-progress children. Deduped. No id means skip. */
+export function pinTargets(tools: readonly PinTool[], expanded: ReadonlySet<string>): string[] {
+  const out: string[] = []
+  const seen = new Set<string>()
+  const add = (id: string | undefined) => {
+    if (!id || seen.has(id)) return
+    seen.add(id)
+    out.push(id)
+  }
+  for (const id of expanded) add(id)
+  for (const tool of tools) if (PIN_LIFECYCLE.has(tool.lifecycle)) add(tool.sessionID)
+  return out
+}
+
+/** Countdown for a retry `next` timestamp. due when next - now <= 0; otherwise whole seconds, rounded up. */
+export function retryWait(next: number, now: number): { due: boolean; seconds: number } {
+  const delta = next - now
+  if (delta <= 0) return { due: true, seconds: 0 }
+  return { due: false, seconds: Math.ceil(delta / 1000) }
+}
+
+export type PinDiff = {
+  pin: string[]
+  unpin: string[]
+}
+
+/**
+ * Computes incremental diff between previous and next sets of pinned session IDs.
+ * - `pin`: IDs in next but not in prev
+ * - `unpin`: IDs in prev but not in next
+ */
+export function pinDiff(prev: Iterable<string>, next: Iterable<string>): PinDiff {
+  const prevSet = prev instanceof Set ? (prev as Set<string>) : new Set(prev)
+  const nextSet = next instanceof Set ? (next as Set<string>) : new Set(next)
+  const pin: string[] = []
+  const unpin: string[] = []
+  for (const id of nextSet) {
+    if (!prevSet.has(id)) pin.push(id)
+  }
+  for (const id of prevSet) {
+    if (!nextSet.has(id)) unpin.push(id)
+  }
+  return { pin, unpin }
+}
+
+export type ChildToolLike = { id: string; child?: { sessionID?: string } }
+
+/**
+ * Computes the set of tool IDs that are the last row referencing each child session.
+ * When multiple task rows reference the same child session, only the last row renders
+ * the expand/collapse toggle and the expanded child panel.
+ */
+export function lastChildToolIds(tools: readonly ChildToolLike[]): Set<string> {
+  const lastForSession = new Map<string, string>()
+  for (const tool of tools) {
+    const sessionID = tool.child?.sessionID
+    if (sessionID) {
+      lastForSession.set(sessionID, tool.id)
+    }
+  }
+  return new Set(lastForSession.values())
+}
