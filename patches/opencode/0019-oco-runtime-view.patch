+}
+
+function PacketEl(props: { packet: () => RingPacket | undefined; reduced: () => boolean; t: () => number }) {
+  return (
+    <Show when={props.packet()}>
+      {(p) => {
+        const r = () => (p().probe ? 7 : 5)
+        const c = () => TONE[p().tone]
