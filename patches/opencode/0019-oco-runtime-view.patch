+// oco (patches/opencode/0019): fixed-frame agent tree mechanism view (Task 4d).
+// Contract and rules: docs/superpowers/plans/2026-10-03-runtime-dashboard-m3.md (改版 2: 固定框架).
+import { createEffect, createMemo, createSignal, For, Index, onCleanup, Show, type Accessor, type JSX } from "solid-js"
+import type { ChildLifecycle, RuntimeAttention, RuntimeModel, RuntimeTool, Stage } from "./session-runtime-model"
+import type { RuntimeText } from "./session-runtime-i18n"
+import { lanesOf, mechanismOf, reuseLanes, slotGlyph, type Lane, type Mechanism, type MechanismSlot } from "./session-runtime-mechanism"
+import { FOCUS, retryWait, toolDetail } from "./session-runtime-actions"
+import type { RuntimeReasoning } from "./session-runtime-reasoning"
+
+export const COLOR = {
+  model: "var(--rt-main)",
+  tool: "var(--rt-tool)",
+  subagent: "var(--rt-sub)",
+  attention: "var(--rt-attn)",
+  error: "var(--rt-err)",
+  ok: "var(--rt-ok)",
+  accent: "var(--rt-accent)",
+} as const
+
+const STAGES: Exclude<Stage, "idle">[] = ["prepare", "model", "tools", "fill"]
+
+export type RuntimeMechanismProps = {
+  model: Accessor<RuntimeModel>
+  t: RuntimeText["t"]
+  copy?: RuntimeText
+  childOf?: (sessionID: string) => RuntimeModel | undefined
+  narrow?: Accessor<boolean>
+  isStack?: Accessor<boolean>
+  isNarrow560?: Accessor<boolean>
+  isToolOpen?: (id: string) => boolean
+  toggleTool?: (id: string) => void
+  childOpen?: (id: string) => boolean
+  toggleChild?: (id: string) => void
+  assembleChild?: (sessionID: string) => RuntimeModel
+  onOpenSession?: (sessionID: string) => void
+  now?: Accessor<number>
+  pending?: Accessor<Readonly<Record<string, true>>>
+  failed?: Accessor<Readonly<Record<string, true>>>
+  respond?: (a: Accessor<RuntimeAttention>, reply: "once" | "always" | "reject") => void
+  onView?: (view: any) => void
+  renderedAttentionIds?: () => Set<string>
+  reasoningElement?: JSX.Element
+  enteredStack?: Accessor<string[]>
+  onEnterChild?: (sessionID: string) => void
+  onNavigateCrumb?: (index: number) => void
+  openDetailId?: Accessor<string | undefined>
+  onToggleDetail?: (id: string | undefined) => void
+  otherAttentionTools?: Accessor<RuntimeTool[]>
+  /** Reasoning of the root (no id) or of an entered child session. */
+  reasoningFor?: (sessionID?: string) => RuntimeReasoning[]
+}
+
+export function RuntimeMechanism(props: RuntimeMechanismProps) {
+  const t = props.t
+  const copy = props.copy
+  const now = () => props.now?.() ?? Date.now()
+
+  // Local navigation and detail state fallbacks
+  const [internalEnteredStack, setInternalEnteredStack] = createSignal<string[]>([])
+  const enteredStack = () => props.enteredStack?.() ?? internalEnteredStack()
+  const onEnterChild = (id: string) => {
+    if (props.onEnterChild) {
+      props.onEnterChild(id)
+    } else {
+      if (props.childOpen && !props.childOpen(id)) {
+        props.toggleChild?.(id)
+      }
+      setInternalEnteredStack((prev) => [...prev, id])
+    }
+  }
+  const onNavigateCrumb = (index: number) => {
+    if (props.onNavigateCrumb) {
+      props.onNavigateCrumb(index)
+    } else {
+      setInternalEnteredStack((prev) => (index < 0 ? [] : prev.slice(0, index + 1)))
+    }
+  }
+
+  const [internalDetailId, setInternalDetailId] = createSignal<string | undefined>()
+  const openDetailId = () => props.openDetailId?.() ?? internalDetailId()
+  const toggleDetail = (id: string | undefined) => {
+    if (props.onToggleDetail) {
+      props.onToggleDetail(id)
+    } else {
+      setInternalDetailId((prev) => (prev === id ? undefined : id))
+    }
+  }
+
+  // Active target session model: if inside a child session, resolve that child
+  const currentSessionID = () => {
+    const stack = enteredStack()
+    return stack.length > 0 ? stack[stack.length - 1] : undefined
+  }
+
+  const currentChildModel = createMemo<RuntimeModel | undefined>(() => {
+    const id = currentSessionID()
+    if (!id) return undefined
+    return props.childOf?.(id) ?? props.assembleChild?.(id)
+  })
+
+  // The model displayed in the tree: child model if navigated into child, else root model
+  const activeModel = () => currentChildModel() ?? props.model()
+  const isReplay = () => activeModel().mode === "replay"
+  const isLive = () => activeModel().mode === "live"
+
+  const mechanism = createMemo(() =>
+    mechanismOf(activeModel(), (id) => props.childOf?.(id) ?? props.assembleChild?.(id)),
+  )
+
+  // Unchanged lanes keep their object, so the card list does not rebuild (and drop keyboard focus) on
+  // updates that do not touch them, such as streamed reasoning.
+  const lanes = createMemo<Lane[]>((prev) => reuseLanes(prev, lanesOf(mechanism())), [])
+
+  // Find lifecycle & agent of current entered session in parent
+  // The task row that started an entered session lives in the level above it (root or an entered child).
+  const parentRowFor = (id: string) => {
+    const stack = enteredStack()
+    const at = stack.indexOf(id)
+    const parent = at > 0 ? props.childOf?.(stack[at - 1]) : props.model()
+    return parent?.tools.find((t) => t.child?.sessionID === id)
+  }
+
+  const currentChildInfo = createMemo(() => {
+    const id = currentSessionID()
+    if (!id) return undefined
+    const tRow = parentRowFor(id)
+    return {
+      agent: tRow?.child?.agent ?? tRow?.name ?? t("child.unnamed"),
+      lifecycle: tRow?.child?.lifecycle ?? ("running" as ChildLifecycle),
+    }
+  })
+
+  // Breadcrumb agent names
+  const agentNameFor = (id: string) => {
+    const tRow = parentRowFor(id)
+    return tRow?.child?.agent ?? tRow?.name ?? t("child.unnamed")
+  }
+
+  // Focus sentence for active model
+  const focus = () => activeModel().focus
+  const focusSentence = () => {
+    const f = focus()
+    if (f.kind === "attention") {
+      const a = f.attention
+      return a.kind === "permission"
+        ? t("focus.attention.permission", { what: [a.permission, ...a.patterns].join(" ") })
+        : t("focus.attention.question", { what: a.text })
+    }
+    if (f.kind === "retry") {
+      return t("focus.retry", { attempt: f.attempt, message: f.message })
+    }
+    if (f.kind === "error") {
+      return f.message ? t("focus.error", { message: f.message }) : t("focus.error.unknown")
+    }
+    if (f.kind === "working") {
+      return f.tool
+        ? t("focus.working.tool", { tool: f.tool.child?.agent ?? f.tool.name, input: f.tool.input })
+        : t(`stage.${f.stage === "idle" ? "prepare" : f.stage}` as any)
+    }
+    if (f.kind === "interrupted") return t("focus.interrupted")
+    if (f.kind === "cancelled") return t("focus.cancelled")
+    if (f.kind === "done") return t("focus.done")
+    return t("focus.idle")
+  }
+
+  const retryWaitText = () => {
+    const f = focus()
+    if (f.kind !== "retry" || !(f as { next?: number }).next) return ""
+    const wait = retryWait((f as { next: number }).next, now())
+    return wait.due ? t("retry.soon") : `${wait.seconds}s`
+  }
+
+  // Active reasoning
+  const currentReasoning = createMemo<RuntimeReasoning | undefined>(() => {
+    const list = props.reasoningFor?.(currentSessionID())
+    if (list && list.length > 0) return list[list.length - 1]
+    return undefined
+  })
+
+  let thinkBodyRef: HTMLDivElement | undefined
