+              {fitText(t("loop.round", { turn: loop().round.turn }), geo().r * 2 - 10)}
+            </text>
+          </Show>
+          <Show when={toolsText() && geo().r >= 34}>
+            <text
+              data-oco-runtime-core-tools
+              x={hub()[0]}
+              y={hub()[1] + 20}
+              text-anchor="middle"
+              fill="var(--rt-tool)"
+              style={{ "font-size": "10px" }}
