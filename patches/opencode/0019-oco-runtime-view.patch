+      } else if (o.stage === "end" || o.stage === "abort") {
+        const why = o.why === "stop" ? "finish" : o.why
+        expect(f.stage.why).toBe(why as RingFrame["stage"]["why"])
+        if (o.why === "stop") expect(f.stage.reason).toBe("stop")
+        expect(f.stage.endAt).toBe(o.endAt)
+      } else {
+        expect(f.stage.why).toBeUndefined()
+      }
+
+      // card kind (and tone: dismissed / rejected are neutral, not red, D18)
+      if (!d5) {
+        expect(f.card.kind).toBe(o.card.kind)
+        if (o.card.tone === "err" && (o.card.kind === "dismissed" || o.card.kind === "rejected")) {
+          expect(f.card.tone).toBe("faint")
+          diffs.push(`${o.id}: ${o.card.kind} card tone err (mockup) vs faint (D18)`)
+        } else {
+          expect(f.card.tone).toBe(o.card.tone as RingFrame["card"]["tone"])
+        }
+      }
+
+      // round N, request M, plan
+      expect(f.counter.round).toBe(o.round)
+      expect(f.counter.m).toBe(o.m)
+      expect(f.counter.plan && { done: f.counter.plan.done, inProgress: f.counter.plan.inProgress, total: f.counter.plan.total }).toEqual(
+        o.plan && { done: o.plan.done, inProgress: o.plan.inProgress, total: o.plan.total },
+      )
+
+      // tool rows: name, state, same-command position
+      expect(f.tools.rows.map((r) => [r.name, r.state, r.same ?? null])).toEqual(o.own)
+
+      // sub-agents: same cells in the same order; each state is subStateAt's; a difference from the mockup is D16 only
+      expect(f.subs.cells.map((c) => c.num)).toEqual(o.subs.map((s) => s[0]))
+      for (const c of f.subs.cells) {
+        expect(c.state).toBe(subStateAt(sub(c.uid), o.t) as RingFrame["subs"]["cells"][number]["state"])
+        const want = o.subs.find((s) => s[0] === c.num)?.[1]
+        if (c.state === want) continue
+        expect(want).toBe("docked")
+        expect(c.state).toBe("run")
+        expect(betweenSteps(sub(c.uid), o.t)).toBe(true)
+        diffs.push(`${o.id}: sub-agent #${c.num} docked (mockup) vs run (D16, between two steps of its session)`)
+      }
+
+      // you dock
+      expect(f.you.state).toBe(o.you.state)
+      expect(squash(zh.phrase(f.you.status))).toBe(squash(o.you.status))
+      if (o.you.state === "dismissed") {
+        expect(f.you.dismissed?.at).toBeDefined()
+        expect(o.you.status).toContain(utc8Clock(f.you.dismissed?.at ?? 0))
+      }
+
+      // status word key and tone
+      if (!d5) {
+        expect(f.status.word.key).toBe(STATUS_KEY.get(o.status.word) as typeof f.status.word.key)
+        expect(f.status.tone).toBe(o.status.tone as RingFrame["status"]["tone"])
+      }
+
+      // lane openness k
+      expect(Math.abs(f.k - o.lane)).toBeLessThanOrEqual(0.01)
+    })
+  }
+
+  test("every sub-agent state in the fixture is checked against subStateAt, in every keyframe", () => {
+    for (const o of oracle.frames) {
+      const f = frame(o.id)
+      for (const s of index.subs) {
+        const cell = f.subs.cells.find((c) => c.uid === s.uid)
+        if (cell) expect(cell.state).toBe(subStateAt(s, o.t) as typeof cell.state)
+      }
+    }
+  })
+
+  test("finish reasons in the fixture: every root request ends on stop or continues (so D5 never differs from the mockup here)", () => {
+    const reasons = new Set<string>()
+    for (const r of index.rounds) for (const q of r.requests) if (q.finish) reasons.add(q.finish.reason)
+    console.log(`[ring-keyframes] root finish reasons in the fixture: ${[...reasons].sort().join(", ")}`)
+    for (const reason of reasons) expect(["stop", ...LOOP_CONTINUE]).toContain(reason)
+  })
+})
+
+describe("keyframe text points", () => {
+  test("j01: plan card, plan 0/4", () => {
+    const f = frame("j01-r1-plan")
+    expect(f.card.kind).toBe("plan")
+    expect(f.counter.plan).toMatchObject({ done: 0, total: 4 })
+    expect(f.card.plan?.items.length).toBe(4)
+  })
+
+  test("j02: plan 4/4", () => {
