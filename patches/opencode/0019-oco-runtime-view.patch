+      test(`${loc} width ${W0}: freeEnds is empty at every keyframe, every height, animated and reduced`, () => {
+        const L = LABELS[loc]
+        let checked = 0
+        for (const H0 of HEIGHTS) {
+          const s = stageSize(W0, H0)
+          for (const reduced of [false, true]) {
+            for (const o of oracle.frames) {
+              const f = frameAt(index, o.t, { reduced, wide: s.wide })
+              const g = geoOf(s.W, s.H, f.k, L, L.next)
+              const wires = wiresAt(g, f, o.t, reduced)
+              const packets = packetsAt(g, index, f, o.t, reduced)
+              expect(freeEnds(g, wires, packets), `${loc} ${W0}x${H0} reduced=${reduced} ${o.id}`).toEqual([])
+              checked++
+            }
+          }
+        }
+        expect(checked).toBe(HEIGHTS.length * 2 * 14)
+      })
+    }
+  }
+
+  // beyond the 14 keyframes: every change time of the whole fixture, 1 ms either side and at the lane-opening offsets
+  test("sweep: no dangling ends at any change time of the fixture, 1100 / 560 / 1600 wide, animated and reduced", () => {
+    const times = new Set<number>()
+    for (const t of index.times) for (const d of [-1, 0, 1, 100, 250, 420, 700]) times.add(t + d)
+    let checked = 0
+    for (const [W0, H0] of [[1100, 720], [560, 900], [1600, 720]]) {
+      const s = stageSize(W0, H0)
+      for (const reduced of [false, true]) {
+        for (const t of times) {
+          const f = frameAt(index, t, { reduced, wide: s.wide })
+          const g = geoOf(s.W, s.H, f.k, LABELS.zh, LABELS.zh.next)
+          const free = freeEnds(g, wiresAt(g, f, t, reduced), packetsAt(g, index, f, t, reduced))
+          if (free.length) expect(free, `${W0}x${H0} reduced=${reduced} t=${t} k=${f.k}`).toEqual([])
+          checked++
+        }
+      }
+    }
+    expect(checked).toBe(3 * 2 * times.size)
+  })
+})
