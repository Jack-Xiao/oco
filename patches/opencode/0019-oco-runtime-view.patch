diff --git a/packages/app/src/components/session/session-runtime-mechanism.ts b/packages/app/src/components/session/session-runtime-mechanism.ts
new file mode 100644
index 0000000..fa55219
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-mechanism.ts
@@ -0,0 +1,340 @@
+// oco (patches/opencode/0019): pure projection from RuntimeModel to mechanism diagram state.
+// Contract and rules: docs/superpowers/plans/2026-10-03-runtime-dashboard-m3.md (Task 2 & Task 4).
+import type { ChildLifecycle, RuntimeModel, RuntimeTool, Stage } from "./session-runtime-model"
+import { lastChildToolIds } from "./session-runtime-actions"
+export type MechanismSlot = {
+  toolID: string // RuntimeTool.id，稳定身份
+  kind: "tool" | "child"
+  label: string // 工具名或子代理 agent
+  state: RuntimeTool["state"]
+  lifecycle?: ChildLifecycle // 仅 child
+  awaiting: boolean
+  interrupted: boolean
+  dispatch: boolean // 派发边活跃（裁定 4）
+  returning: boolean // 汇回边活跃（裁定 4）
+  input: string // 工具入参摘要，取 RuntimeTool.input
+  error?: string // 工具 error 文本，若模型里有；没有就从 RuntimeTool 现有字段取，查不到则不加并在报告说明
+  lastOutput?: string
+  description?: string // 子代理 child.description
+  activity?: { name: string; count: number } // 仅子代理槽：子模型最后一个请求中最后一个 pending/running 工具的名字，以及该请求中同名工具的数量；子模型未加载或无运行中工具则缺省
+  nested: number // 子模型 tools 中 child!==undefined 的行数；未加载为 0
+}
+
+export type Mechanism = {
+  stage: Stage
+  tools: MechanismSlot[] // ≤ 4
+  toolsOverflow: { total: number; running: number }
+  children: MechanismSlot[] // ≤ 3
+  childrenOverflow: { total: number; running: number }
+  empty: boolean // 无请求
+  fill: { done: number; total: number }
+  main: { agent?: string; model?: string; request: number }
+  // Set when the last request has no tool rows: slots and fill come from this earlier request (1-based number).
+  slotsFrom?: number
+}
+
+const isSubagent = (tool: RuntimeTool): boolean => tool.child !== undefined
+
+const toolErrorOf = (tool: RuntimeTool): string | undefined => {
+  const direct = (tool as { error?: string }).error
+  if (typeof direct === "string" && direct) return direct
+  if (tool.state === "error" && typeof tool.lastOutput === "string" && tool.lastOutput) {
+    return tool.lastOutput
+  }
+  return undefined
+}
+
+function childActivityOf(
+  sessionID: string | undefined,
+  childOf?: (sessionID: string) => RuntimeModel | undefined,
+): { name: string; count: number } | undefined {
+  if (!sessionID || !childOf) return undefined
+  const childModel = childOf(sessionID)
+  if (!childModel || childModel.requests.length === 0) return undefined
+
+  const lastReq = childModel.requests[childModel.requests.length - 1]
+  const lastReqIndex = lastReq.index
+  const reqTools = childModel.tools.filter((t) => t.request === lastReqIndex)
+  const activeTools = reqTools.filter((t) => t.state === "pending" || t.state === "running")
+  if (activeTools.length === 0) return undefined
+
+  const lastActive = activeTools[activeTools.length - 1]
+  const name = lastActive.name
+  const count = reqTools.filter((t) => t.name === name).length
+  return { name, count }
+}
+
+function childNestedOf(
+  sessionID: string | undefined,
+  childOf?: (sessionID: string) => RuntimeModel | undefined,
+): number {
+  if (!sessionID || !childOf) return 0
+  const childModel = childOf(sessionID)
+  if (!childModel) return 0
+  return childModel.tools.filter((t) => t.child !== undefined).length
+}
+
+export function mechanismOf(
+  model: RuntimeModel,
+  childOf?: (sessionID: string) => RuntimeModel | undefined,
+): Mechanism {
+  if (model.requests.length === 0) {
+    return {
+      stage: model.stage,
+      tools: [],
+      toolsOverflow: { total: 0, running: 0 },
+      children: [],
+      childrenOverflow: { total: 0, running: 0 },
+      empty: true,
+      fill: { done: 0, total: 0 },
+      main: { request: 0 },
+    }
+  }
+
+  const lastRequest = model.requests[model.requests.length - 1]
+  // Slots come from the last request that has tool rows, so the tree keeps the latest dispatch
+  // after the model moves on to a request without tools (e.g. the final text answer).
+  const slotRequestIndex =
+    [...model.requests].reverse().find((r) => model.tools.some((t) => t.request === r.index))?.index ??
+    lastRequest.index
+  const current = slotRequestIndex === lastRequest.index
+
+  // Tool slots: non-task tools of the slot request (≤ 4), preserving order in model.tools
+  const candidateTools = model.tools.filter(
+    (tool) => !isSubagent(tool) && tool.request === slotRequestIndex,
+  )
+  const toolSlots = candidateTools.slice(0, 4)
+  const toolOverflows = candidateTools.slice(4)
+  const toolsOverflow = {
+    total: toolOverflows.length,
+    running: toolOverflows.filter((t) => t.state === "running").length,
+  }
+
+  const tools: MechanismSlot[] = toolSlots.map((tool) => {
+    const awaiting = Boolean(tool.awaiting)
+    const interrupted = Boolean(tool.interrupted)
+    const returning = current && model.stage === "fill"
+    const dispatch =
+      !returning &&
+      current &&
+      model.stage === "tools" &&
+      (tool.state === "pending" || tool.state === "running") &&
+      !awaiting &&
+      !interrupted
+    const error = toolErrorOf(tool)
+
+    return {
+      toolID: tool.id,
+      kind: "tool",
+      label: tool.name,
+      state: tool.state,
+      awaiting,
+      interrupted,
+      dispatch,
+      returning,
+      input: tool.input,
+      ...(error !== undefined ? { error } : {}),
+      ...(tool.lastOutput !== undefined ? { lastOutput: tool.lastOutput } : {}),
+      nested: 0,
+    }
+  })
+
+  // Child slots: slot-request task rows + task rows from any request whose child lifecycle
+  // is running | retrying | waiting-user. Deduped to last row per child session.
+  const lastChildIds = lastChildToolIds(model.tools)
+  const candidateChildren: RuntimeTool[] = []
+
+  for (const tool of model.tools) {
+    if (tool.child !== undefined) {
+      const isLastForSession = !tool.child.sessionID || lastChildIds.has(tool.id)
+      if (!isLastForSession) continue
+
+      const inLastRequest = tool.request === slotRequestIndex
+      const activeLifecycle =
+        tool.child.lifecycle === "running" ||
+        tool.child.lifecycle === "retrying" ||
+        tool.child.lifecycle === "waiting-user"
+
+      if (inLastRequest || activeLifecycle) {
+        candidateChildren.push(tool)
+      }
+    }
+  }
+
+  const childSlots = candidateChildren.slice(0, 3)
+  const childOverflows = candidateChildren.slice(3)
+  const childrenOverflow = {
+    total: childOverflows.length,
+    running: childOverflows.filter((t) => t.child?.lifecycle === "running").length,
+  }
+
+  const children: MechanismSlot[] = childSlots.map((tool) => {
+    const child = tool.child!
+    const returning = current && model.stage === "fill" && tool.request === slotRequestIndex
+    const awaiting = Boolean(tool.awaiting)
+    const interrupted = Boolean(tool.interrupted)
+    const dispatch =
+      !returning &&
+      (child.lifecycle === "running" || child.lifecycle === "retrying") &&
+      !awaiting &&
+      !interrupted
+    const error = toolErrorOf(tool)
+    const activity = childActivityOf(child.sessionID, childOf)
+    const nested = childNestedOf(child.sessionID, childOf)
+
+    return {
+      toolID: tool.id,
+      kind: "child",
+      label: child.agent || tool.name,
+      state: tool.state,
+      lifecycle: child.lifecycle,
+      awaiting,
+      interrupted,
+      dispatch,
+      returning,
+      input: tool.input,
+      ...(error !== undefined ? { error } : {}),
+      ...(tool.lastOutput !== undefined ? { lastOutput: tool.lastOutput } : {}),
+      ...(child.description !== undefined ? { description: child.description } : {}),
+      ...(activity !== undefined ? { activity } : {}),
+      nested,
+    }
+  })
+
+  const candidateChildrenInLastReq = candidateChildren.filter((tool) => tool.request === slotRequestIndex)
+  const lastReqSlots = [...candidateTools, ...candidateChildrenInLastReq]
+  const fill = {
+    done: lastReqSlots.filter((t) => t.state === "completed" || t.state === "error").length,
+    total: lastReqSlots.length,
+  }
+
+  const mainModel =
+    typeof (lastRequest.model as unknown) === "string"
+      ? (lastRequest.model as unknown as string)
+      : lastRequest.model?.providerID && lastRequest.model?.modelID
+        ? `${lastRequest.model.providerID}/${lastRequest.model.modelID}`
+        : undefined
+  const requestNum =
+    typeof lastRequest.index === "number" ? lastRequest.index + 1 : model.requests.length
+  const main = {
+    ...(lastRequest.agent ? { agent: lastRequest.agent } : {}),
+    ...(mainModel ? { model: mainModel } : {}),
+    request: requestNum,
+  }
+
+  return {
+    stage: model.stage,
+    tools,
+    toolsOverflow,
+    children,
+    childrenOverflow,
+    empty: false,
+    fill,
+    main,
+    ...(current ? {} : { slotsFrom: slotRequestIndex + 1 }),
+  }
+}
+
+export type MechanismViewNode = {
+  id: string
+  kind: "main" | "tool" | "child"
+  label: string
+  glyph: string
+  statusKey: string
+  state?: RuntimeTool["state"]
+}
+
+export type MechanismViewEdge = {
+  toolID: string
+  dir: "dispatch" | "return"
+  active: boolean
+  flow: boolean
+}
+
+export type MechanismViewSlot = {
+  slot: MechanismSlot
+  glyph: string
+  statusKey: string
+  dispatchEdge: MechanismViewEdge
+  returnEdge: MechanismViewEdge
+}
+
+export type MechanismView = {
+  empty: boolean
+  stage: Stage
+  mainNode: MechanismViewNode
+  tools: MechanismViewSlot[]
+  toolsOverflow: { total: number; running: number }
+  children: MechanismViewSlot[]
+  childrenOverflow: { total: number; running: number }
+  fillRow: {
+    active: boolean
+  }
+}
+
+export function slotGlyph(slot: MechanismSlot): string {
+  if (slot.awaiting) return "!"
+  if (slot.interrupted) return "◌"
+  if (slot.kind === "child" && slot.lifecycle) {
+    if (slot.lifecycle === "running" || slot.lifecycle === "retrying") return "◐"
+    if (slot.lifecycle === "waiting-user") return "!"
+    if (slot.lifecycle === "done") return "✓"
+    if (slot.lifecycle === "error") return "✕"
+    if (slot.lifecycle === "cancelled") return "⊘"
+    return "○"
+  }
+  if (slot.state === "running") return "◐"
+  if (slot.state === "completed") return "✓"
+  if (slot.state === "error") return "✕"
+  return "○"
+}
+
+export function slotStatusKey(slot: MechanismSlot): string {
+  if (slot.awaiting) return "tool.awaiting"
+  if (slot.interrupted) return "tool.interrupted"
+  if (slot.kind === "child" && slot.lifecycle) {
+    return `child.lifecycle.${slot.lifecycle}`
+  }
+  return `tool.state.${slot.state}`
+}
+
+export function mechanismView(mechanism: Mechanism, mode: "live" | "replay"): MechanismView {
+  const isReplay = mode === "replay"
+
+  const mapSlot = (slot: MechanismSlot): MechanismViewSlot => ({
+    slot,
+    glyph: slotGlyph(slot),
+    statusKey: slotStatusKey(slot),
+    dispatchEdge: {
+      toolID: slot.toolID,
+      dir: "dispatch",
+      active: slot.dispatch,
+      flow: slot.dispatch && !isReplay,
+    },
+    returnEdge: {
+      toolID: slot.toolID,
+      dir: "return",
+      active: slot.returning,
+      flow: slot.returning && !isReplay,
+    },
+  })
+
+  return {
+    empty: mechanism.empty,
+    stage: mechanism.stage,
+    mainNode: {
+      id: "main",
+      kind: "main",
+      label: "mechanism.main",
+      glyph: "◐",
+      statusKey: "state.working",
+    },
+    tools: mechanism.tools.map(mapSlot),
+    toolsOverflow: mechanism.toolsOverflow,
+    children: mechanism.children.map(mapSlot),
+    childrenOverflow: mechanism.childrenOverflow,
+    fillRow: {
+      active: mechanism.stage === "fill",
+    },
+  }
+}
diff --git a/packages/app/src/components/session/session-runtime-model.test.ts b/packages/app/src/components/session/session-runtime-model.test.ts
new file mode 100644
index 0000000..a692aae
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-model.test.ts
@@ -0,0 +1,1491 @@
+// oco (patches/opencode/0019): runtime view data model.
+import { describe, expect, test } from "bun:test"
+import { buildTrajectory } from "./session-trajectory-model"
+import { trajectoryText } from "./session-trajectory-i18n"
+import {
+  buildRuntime,
+  collectTreeRequests,
+  eventSessionID,
+  inFlightOf,
+  lastLine,
+  mergeFreshness,
+  snapshotAt,
+  treeSessionIDs,
+  type RuntimeInput,
+} from "./session-runtime-model"
+
+const language = trajectoryText({ locale: () => "en", intl: () => "en" })
+const T0 = 1_790_000_000_000
+
+/** An ascending OpenCode id created at `ms` (same encoding as packages/opencode/src/id/id.ts). */
+const id = (prefix: string, ms: number, counter = 0) =>
+  `${prefix}_${((BigInt(ms) * 4096n + BigInt(counter)) % 2n ** 48n).toString(16).padStart(12, "0")}AbCdEfGhIjKlMn`
+
+const user = (ms: number) =>
+  ({ id: id("msg", ms), sessionID: "s", role: "user", time: { created: ms }, agent: "build", model: {} }) as any
+
+const assistant = (parent: any, ms: number, extra: Record<string, unknown> = {}) =>
+  ({
+    id: id("msg", ms),
+    sessionID: "s",
+    role: "assistant",
+    parentID: parent.id,
+    time: { created: ms, completed: ms + 2000 },
+    modelID: "m",
+    providerID: "p",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/", root: "/" },
+    cost: 0,
+    tokens: { input: 100, output: 50, reasoning: 0, cache: { read: 900, write: 0 } },
+    ...extra,
+  }) as any
+
+const tool = (ms: number, name: string, state: Record<string, unknown>, extra: Record<string, unknown> = {}) =>
+  ({ id: id("prt", ms), sessionID: "s", messageID: "", type: "tool", tool: name, callID: `c${ms}`, state, ...extra }) as any
+
+type Fixture = {
+  messages: any[]
+  parts?: Record<string, any[]>
+  now?: number
+  busy?: boolean
+  input?: Partial<RuntimeInput>
+}
+
+/** Runs the real trajectory builder, then buildRuntime over its requests (the production wiring). */
+const runtime = (f: Fixture) => {
+  const now = f.now ?? T0 + 10_000
+  const parts = (messageID: string) => (f.parts?.[messageID] ?? []) as any[]
+  const trajectory = buildTrajectory({ messages: f.messages, parts, now, busy: f.busy ?? true, language })
+  return buildRuntime(
+    {
+      mode: "live",
+      sessionID: "s",
+      parts,
+      status: undefined,
+      permissions: [],
+      questions: [],
+      childStatus: () => undefined,
+      requests: trajectory.requests,
+      ...f.input,
+    },
+    now,
+  )
+}
+
+const u = user(T0)
+const running = assistant(u, T0 + 100, { time: { created: T0 + 100 } })
+
+describe("run state", () => {
+  test("busy status without anything else is working (event evidence)", () => {
+    const m = runtime({ messages: [u, running], input: { status: { type: "busy" } } })
+    expect(m.run.state).toBe("working")
+    expect(m.run.evidence).toBe("event")
+  })
+
+  test("retry keeps attempt and next and is not folded into working", () => {
+    const status = { type: "retry", attempt: 2, message: "429 rate limit", next: T0 + 30_000 } as const
+    const m = runtime({ messages: [u, running], input: { status } })
+    expect(m.run.state).toBe("retrying")
+    expect(m.run.retry).toEqual({ attempt: 2, message: "429 rate limit", next: T0 + 30_000 })
+  })
+
+  test("a pending permission wins the state but the retry stays visible (independent)", () => {
+    const status = { type: "retry", attempt: 1, message: "x", next: T0 + 1 } as const
+    const permissions = [{ id: "per_1", sessionID: "s", permission: "edit", patterns: ["a.ts"], metadata: {}, always: [] }] as any
+    const m = runtime({ messages: [u, running], input: { status, permissions } })
+    expect(m.run.state).toBe("waiting-user")
+    expect(m.run.retry?.attempt).toBe(1)
+    expect(m.run.attention).toEqual([
+      { kind: "permission", id: "per_1", sessionID: "s", permission: "edit", patterns: ["a.ts"], toolRef: undefined },
+    ])
+  })
+
+  test("a missing status entry means idle, marked inferred", () => {
+    const m = runtime({ messages: [u, assistant(u, T0 + 100)], busy: false })
+    expect(m.run.state).toBe("idle")
+    expect(m.run.evidence).toBe("inferred")
+  })
+
+  test("replay mode never claims an attention list and says so", () => {
+    const permissions = [{ id: "per_1", sessionID: "s", permission: "edit", patterns: [], metadata: {}, always: [] }] as any
+    const m = runtime({ messages: [u, running], input: { mode: "replay", permissions } })
+    expect(m.run.attention).toEqual([])
+    expect(m.run.attentionKnown).toBe(false)
+    expect(m.run.state).toBe("working")
+    expect(m.run.evidence).toBe("inferred")
+  })
+})
+
+const done = (ms: number, input: Record<string, unknown>, output: string) => ({
+  status: "completed",
+  input,
+  output,
+  title: "t",
+  metadata: {},
+  time: { start: ms, end: ms + 400 },
+})
+
+describe("tools", () => {
+  test("parallel tools keep part order and identity regardless of state changes", () => {
+    const a = assistant(u, T0 + 100)
+    const t1 = tool(T0 + 200, "read", done(T0 + 200, { filePath: "/a.ts" }, "x"), { messageID: a.id })
+    const t2 = tool(T0 + 210, "bash", { status: "running", input: { command: "bun test" }, time: { start: T0 + 210 } }, { messageID: a.id })
+    const t3 = tool(T0 + 220, "grep", { status: "pending", input: { pattern: "foo" }, raw: "" }, { messageID: a.id })
+    const m = runtime({ messages: [u, a], parts: { [a.id]: [t1, t2, t3] } })
+    expect(m.tools.map((t) => [t.name, t.state])).toEqual([
+      ["read", "completed"],
+      ["bash", "running"],
+      ["grep", "pending"],
+    ])
+    expect(m.tools.map((t) => t.id)).toEqual([t1.id, t2.id, t3.id])
+    expect(m.tools[1].input).toBe("bun test")
+    expect(m.tools[0].request).toBe(0)
+  })
+
+  test("last output is the last non-empty line; running bash reads metadata.output", () => {
+    const a = assistant(u, T0 + 100)
+    const t1 = tool(T0 + 200, "bash", done(T0 + 200, { command: "x" }, "one\n\ntwo  \n\n"), { messageID: a.id })
+    const t2 = tool(
+      T0 + 210,
+      "bash",
+      { status: "running", input: { command: "y" }, metadata: { output: "building\nlinking" }, time: { start: T0 + 210 } },
+      { messageID: a.id },
+    )
+    const t3 = tool(T0 + 220, "edit", { status: "error", input: {}, error: "no match for\nold string", time: { start: T0 + 220, end: T0 + 230 } }, { messageID: a.id })
+    const m = runtime({ messages: [u, a], parts: { [a.id]: [t1, t2, t3] } })
+    expect(m.tools.map((t) => t.lastOutput)).toEqual(["two", "linking", "old string"])
+  })
+
+  test("a permission linked by {messageID, callID} marks only that tool as awaiting", () => {
