@@ -0,0 +1,273 @@
+// oco (patches/opencode/0019): pure projection from RuntimeModel to the loop lane (M4 batch 2).
+// Contract and rules: docs/design/runtime-m4.md (sections 4–8, 「第二批实施计划」).
+import type { RuntimeModel, RuntimeTool } from "./session-runtime-model"
+
+export type ProbeStage = "queued" | "running" | "docked" | "absorbed"
+export type ProbeFlag = "error" | "ask"
+export type LoopZone = "queue" | "work" | "dock"
+
+export type Probe = {
+  /** Stable key: background task id, else child session id, else the dispatching tool part id. */
+  id: string
+  /** RuntimeTool.id of the first task row. Unlike `id` it does not change when a background dispatch learns its
+   *  task id, so the view keeps one node (and its position) per probe across that switch. */
+  node: string
+  /** RuntimeTool.id of the newest task row for this probe. */
+  toolID: string
+  sessionID?: string
+  agent: string
+  description: string
+  background: boolean
+  stage: ProbeStage
+  flag?: ProbeFlag
+  /** The run stopped while it was out (cancelled / interrupted). Not on the lane, not counted as absorbed. */
+  cancelled: boolean
+  /** RuntimeModel request index of the first dispatch, and of the retrieval (background) or return (sync). */
+  dispatchRequest: number
+  retrieveRequest?: number
+  prompt?: string
+  result?: string
+  /** Child model facts, when loaded. */
+  childTools?: number
+  start?: number
+  end?: number
+}
+
+export type LoopPlace = { zone: LoopZone; slot: number; visible: boolean }
+export type LoopCluster = { zone: LoopZone; slot: number; count: number; ids: string[] }
+export type LoopCore = "dispatching" | "gathering" | "waiting" | "working" | "idle"
+
+export type Loop = {
+  /** Current round only, in dispatch order. */
+  probes: Probe[]
+  /** Probes dispatched before the current round (folded into “+N earlier”). Earlier probes still running in a live
+   *  session stay on the lane, in `probes`. */
+  earlier: number
+  /** The current round: 1-based turn number as the session log shows it (0 = no request yet), its requests so far,
+   *  and the main agent's own tool calls in it. */
+  round: { turn: number; requests: number; tools: number }
+  places: Record<string, LoopPlace>
+  clusters: LoopCluster[]
+  core: LoopCore
+  absorbed: number
+  /** The main agent's own tools in its last request (subagent rows and background_output excluded). */
+  coreTools: { name: string; count: number; running: number }[]
+  /** Newest subagent of the whole session (any round; a cancelled one only when nothing else exists). The handoff card
+   *  shows it while nothing is selected. */
+  latest?: Probe
+  /** Newest tool call of the main agent itself (whole session): the handoff card's fallback when no subagent exists. */
+  lastTool?: RuntimeTool
+  counts: { total: number; running: number; blocked: number; docked: number; queued: number }
+}
+
+export const LOOP_CAPACITY: Record<LoopZone, number> = { queue: 4, work: 12, dock: 5 }
+
+const ZONE_OF: Partial<Record<ProbeStage, LoopZone>> = { queued: "queue", running: "work", docked: "dock" }
+
+const keyOf = (tool: RuntimeTool) => tool.child?.backgroundTaskId ?? tool.child?.sessionID ?? `tool:${tool.id}`
+
+/** Stage rules (design 「阶段判定规则」). `last` is the newest task row for the probe. */
+export function probeStageOf(
+  last: RuntimeTool,
+  live: boolean,
+): { stage: ProbeStage; flag?: ProbeFlag; cancelled: boolean } {
+  const child = last.child!
+  const started = !!child.sessionID && last.state !== "pending"
+  const where: ProbeStage = started ? "running" : "queued"
+  const ask = !!last.awaiting || child.lifecycle === "waiting-user"
+  if (last.cancelled || last.interrupted || child.lifecycle === "cancelled" || child.notice === "cancelled")
+    return { stage: where, cancelled: true }
+  if (!child.background) {
+    if (last.state === "completed") return { stage: "absorbed", cancelled: false }
+    if (last.state === "error" || child.lifecycle === "error") return { stage: where, flag: "error", cancelled: false }
+    return { stage: where, ...(ask ? { flag: "ask" as const } : {}), cancelled: false }
+  }
+  // Background: the task part completes as soon as it hands back `bg_…`; that is not the child finishing.
+  if (child.retrieved) return { stage: "absorbed", cancelled: false }
+  if (last.state === "error" || child.lifecycle === "error" || child.notice === "error")
+    return { stage: where, flag: "error", cancelled: false }
+  if (child.notice === "done" || (live && child.lifecycle === "done")) return { stage: "docked", cancelled: false }
+  return { stage: where, ...(ask ? { flag: "ask" as const } : {}), cancelled: false }
+}
+
+/** Stable slots in dispatch order. When the zone overflows, the last slot becomes a “+N” cluster; a flagged probe
+ *  that would fall into it swaps with the last visible unflagged probe, so nothing else moves. */
+export function orderZone(probes: readonly Pick<Probe, "id" | "flag">[], cap: number): string[] {
+  const ids = probes.map((p) => p.id)
+  if (ids.length <= cap) return ids
+  const flagged = new Set(probes.filter((p) => p.flag).map((p) => p.id))
+  const visible = cap - 1
+  const hidden = ids.slice(visible).filter((id) => flagged.has(id))
+  let j = visible - 1
+  for (const h of hidden) {
+    while (j >= 0 && flagged.has(ids[j])) j--
+    if (j < 0) break
+    const hi = ids.indexOf(h)
+    ;[ids[j], ids[hi]] = [ids[hi], ids[j]]
+    j--
+  }
+  return ids
+}
+
+export function layoutLoop(
+  probes: readonly Probe[],
+  capacity: Record<LoopZone, number> = LOOP_CAPACITY,
+): { places: Record<string, LoopPlace>; clusters: LoopCluster[] } {
+  const places: Record<string, LoopPlace> = {}
+  const clusters: LoopCluster[] = []
+  for (const zone of ["queue", "work", "dock"] as const) {
+    const cap = Math.max(1, capacity[zone])
+    const members = probes.filter((p) => !p.cancelled && ZONE_OF[p.stage] === zone)
+    const ids = orderZone(members, cap)
+    const over = ids.length > cap
+    const visible = over ? cap - 1 : cap
+    ids.forEach((id, i) => {
+      places[id] = { zone, slot: Math.min(i, cap - 1), visible: i < visible }
+    })
+    if (over) clusters.push({ zone, slot: cap - 1, count: ids.length - visible, ids: ids.slice(visible) })
+  }
+  return { places, clusters }
+}
+
+export function loopOf(model: RuntimeModel, childOf?: (sessionID: string) => RuntimeModel | undefined): Loop {
+  const live = model.mode === "live"
+  const groups = new Map<string, RuntimeTool[]>()
+  for (const tool of model.tools) {
+    if (!tool.child) continue
+    const key = keyOf(tool)
+    const list = groups.get(key)
+    if (list) list.push(tool)
+    else groups.set(key, [tool])
+  }
+
+  const all: Probe[] = []
+  for (const [id, rows] of groups) {
+    const first = rows[0]
+    const last = rows[rows.length - 1]
+    const child = last.child!
+    const { stage, flag, cancelled } = probeStageOf(last, live)
+    const sub = child.sessionID ? childOf?.(child.sessionID) : undefined
+    const subStart = sub?.requests[0]?.start
+    const subEnd = sub?.requests[sub.requests.length - 1]?.end
+    const retrieveRequest =
+      child.retrieved?.request ?? (!child.background && last.state === "completed" ? last.request : undefined)
+    all.push({
+      id,
+      node: first.id,
+      toolID: last.id,
+      ...(child.sessionID ? { sessionID: child.sessionID } : {}),
+      agent: child.agent || last.name,
+      description: child.description,
+      background: child.background,
+      stage,
+      ...(flag ? { flag } : {}),
+      cancelled,
+      dispatchRequest: first.request,
+      ...(retrieveRequest !== undefined ? { retrieveRequest } : {}),
+      ...(child.prompt ? { prompt: child.prompt } : {}),
+      ...(child.result ? { result: child.result } : {}),
+      ...(sub ? { childTools: sub.tools.length } : {}),
+      ...((subStart ?? first.start) !== undefined ? { start: subStart ?? first.start } : {}),
+      ...((child.background ? (subEnd ?? child.retrieved?.at) : last.end) !== undefined
+        ? { end: child.background ? (subEnd ?? child.retrieved?.at) : last.end }
+        : {}),
+    })
+  }
+
+  // A probe from an earlier round that is still out (live only) stays on the lane until it comes back. A failed one has
+  // come back: its stage stays running/queued only to place the error mark, so it folds into "earlier".
+  const probes = all.filter(
+    (p) =>
+      p.dispatchRequest >= model.roundStart ||
+      (live && !p.cancelled && p.flag !== "error" && (p.stage === "running" || p.stage === "queued")),
+  )
+  const earlier = all.length - probes.length
+  const { places, clusters } = layoutLoop(probes)
+
+  const lastRequest = model.requests[model.requests.length - 1]
+  const lastTools = lastRequest ? model.tools.filter((t) => t.request === lastRequest.index) : []
+  const own = lastTools.filter((t) => !t.child && !t.retrieves)
+  const byName = new Map<string, { name: string; count: number; running: number }>()
+  for (const t of own) {
+    const entry = byName.get(t.name) ?? { name: t.name, count: 0, running: 0 }
+    entry.count++
+    if ((t.state === "pending" || t.state === "running") && !t.interrupted) entry.running++
+    byName.set(t.name, entry)
+  }
+
+  const first = model.requests.find((r) => r.index === model.roundStart)
+  const round = {
+    turn: first ? first.turn + 1 : 0,
+    requests: first ? model.requests.filter((r) => r.index >= model.roundStart).length : 0,
+    tools: first ? model.tools.filter((t) => t.request >= model.roundStart && !t.child && !t.retrieves).length : 0,
+  }
+
+  const onLane = probes.filter((p) => !p.cancelled)
+  const counts = {
+    total: probes.length,
+    running: onLane.filter((p) => p.stage === "running" && !p.flag).length,
+    blocked: onLane.filter((p) => p.flag).length,
+    docked: onLane.filter((p) => p.stage === "docked").length,
+    queued: onLane.filter((p) => p.stage === "queued").length,
+  }
+  const absorbed = onLane.filter((p) => p.stage === "absorbed").length
+
+  const working = model.run.state === "working" || model.run.state === "retrying" || model.run.state === "waiting-user"
+  const dispatching = lastTools.some(
+    (t) => t.child && (t.state === "pending" || (t.state === "running" && !t.child.sessionID)),
+  )
+  const retrieving = lastTools.some((t) => t.retrieves && (t.state === "pending" || t.state === "running"))
+  const outstanding = counts.running + counts.queued + counts.docked
+  const core: LoopCore = !working
+    ? outstanding > 0 && live
+      ? "waiting"
+      : "idle"
+    : dispatching
+      ? "dispatching"
+      : retrieving || (absorbed > 0 && outstanding === 0 && (model.stage === "model" || model.stage === "fill"))
+        ? "gathering"
+        : outstanding > 0 && model.stage === "tools" && own.every((t) => t.state !== "running" && t.state !== "pending")
+          ? "waiting"
+          : "working"
+
+  const latest = all.findLast((p) => !p.cancelled) ?? all[all.length - 1]
+  const lastTool = model.tools.findLast((t) => !t.child && !t.retrieves)
+
+  return {
+    probes,
+    earlier,
+    round,
+    places,
+    clusters,
+    core,
+    absorbed,
+    coreTools: [...byName.values()],
+    counts,
+    ...(latest ? { latest } : {}),
+    ...(lastTool ? { lastTool } : {}),
+  }
+}
+
+/** Under 60s: `Ns`. Under 60m: `Nm Ss`. At or over 60m: `Nh Nm`, including past 24h (`62h 18m`). */
+export function formatDuration(ms: number): string {
+  const s = Math.max(0, Math.round(ms / 1000))
+  if (s < 60) return `${s}s`
+  const minutes = Math.floor(s / 60)
+  if (minutes < 60) return `${minutes}m ${s % 60}s`
+  return `${Math.floor(minutes / 60)}h ${minutes % 60}m`
+}
+
+/** Elapsed label for one handoff row. An open row (no `end`) runs until `now`. */
+export function formatElapsed(start: number, end: number | undefined, now: number): string {
+  return formatDuration((end ?? now) - start)
+}
+
+/** Replay durations follow the cursor. Live follows the wall clock. A missing cursor falls back to the wall. */
+export function elapsedClock(mode: "live" | "replay", cursor: number | undefined, wall: number): number {
+  return mode === "replay" ? (cursor ?? wall) : wall
+}
+
+/** Status-bar context messages: the cursor snapshot while replaying, otherwise the full list. */
+export function messagesForContext<T>(mode: "live" | "replay", all: T[], snapshot: T[] | undefined): T[] {
+  return mode === "replay" ? (snapshot ?? []) : all
+}
diff --git a/packages/app/src/components/session/session-runtime-mechanism-view.tsx b/packages/app/src/components/session/session-runtime-mechanism-view.tsx
