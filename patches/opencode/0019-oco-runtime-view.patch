+                      </Show>
+                    </Show>
+                  </>
+                )}
+              </Show>
+              <Show when={isToolOpen(x().id)}>
+                <div
+                  id={`oco-runtime-tool-detail-${x().id}`}
+                  data-oco-runtime-tool-detail={x().id}
