index 0000000..c5bd8c2
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-model-bg.test.ts
@@ -0,0 +1,546 @@
+// oco (patches/opencode/0019): unit tests for background task data modeling (M4 batch 2).
+import { describe, expect, test } from "bun:test"
+import type { Message, Part, ToolPart } from "@opencode-ai/sdk/v2/client"
+import { buildTrajectory } from "./session-trajectory-model"
+import { trajectoryText } from "./session-trajectory-i18n"
+import {
+  backgroundNoticesOf,
+  buildRuntime,
+  roundStartOf,
+  runtimeSubagentOf,
+  snapshotAt,
+  type RuntimeInput,
+} from "./session-runtime-model"
+
+const language = trajectoryText({ locale: () => "en", intl: () => "en" })
+const T0 = 1_790_000_000_000
+
+const id = (prefix: string, ms: number, counter = 0) =>
+  `${prefix}_${((BigInt(ms) * 4096n + BigInt(counter)) % 2n ** 48n).toString(16).padStart(12, "0")}AbCdEfGhIjKlMn`
+
+const user = (ms: number, extra: Record<string, unknown> = {}): Message =>
+  ({
+    id: id("msg", ms),
+    sessionID: "s",
+    role: "user",
+    time: { created: ms },
+    agent: "build",
+    model: {},
+    ...extra,
+  }) as any
+
+const assistant = (parent: Message, ms: number, extra: Record<string, unknown> = {}): Message =>
+  ({
+    id: id("msg", ms),
+    sessionID: "s",
+    role: "assistant",
+    parentID: parent.id,
+    time: { created: ms, completed: ms + 2000 },
+    modelID: "m",
+    providerID: "p",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/", root: "/" },
+    cost: 0,
+    tokens: { input: 100, output: 50, reasoning: 0, cache: { read: 900, write: 0 } },
+    ...extra,
+  }) as any
+
+const tool = (
+  ms: number,
+  name: string,
+  state: Record<string, unknown>,
+  extra: Record<string, unknown> = {},
+): ToolPart =>
+  ({
+    id: id("prt", ms),
+    sessionID: "s",
+    messageID: "",
+    type: "tool",
+    tool: name,
+    callID: `c${ms}`,
+    state,
+    ...extra,
+  }) as any
+
+const textPart = (ms: number, text: string, extra: Record<string, unknown> = {}): Part =>
+  ({ id: id("prt", ms), sessionID: "s", messageID: "", type: "text", text, ...extra }) as any
+
+type Fixture = {
+  messages: Message[]
+  parts?: Record<string, Part[]>
+  now?: number
+  busy?: boolean
+  input?: Partial<RuntimeInput>
+}
+
+const runtime = (f: Fixture) => {
+  const now = f.now ?? T0 + 10_000
+  const parts = (messageID: string) => f.parts?.[messageID] ?? []
+  const trajectory = buildTrajectory({ messages: f.messages, parts, now, busy: f.busy ?? true, language })
+  return buildRuntime(
+    {
+      mode: "live",
+      sessionID: "s",
+      parts,
+      status: undefined,
+      permissions: [],
+      questions: [],
+      childStatus: () => undefined,
+      requests: trajectory.requests,
+      messages: f.messages,
+      ...f.input,
+    },
+    now,
+  )
+}
+
+describe("runtimeSubagentOf", () => {
+  test("returns undefined for non-task tool", () => {
+    const part = tool(T0, "bash", { status: "running", input: { command: "ls" } })
+    expect(runtimeSubagentOf(part)).toBeUndefined()
+  })
+
+  test("uses metadata.agent when category is present without subagent_type", () => {
+    const part = tool(T0, "task", {
+      status: "running",
+      input: { category: "quick", description: "check health" },
+      metadata: { agent: "health-agent" },
+    })
+    const res = runtimeSubagentOf(part)
+    expect(res).toBeDefined()
+    expect(res?.agent).toBe("health-agent")
+    expect(res?.description).toBe("check health")
+  })
+
+  test("falls back to input.category when metadata.agent and subagent_type are absent", () => {
+    const part = tool(T0, "task", {
+      status: "running",
+      input: { category: "explore", description: "find files" },
+    })
+    const res = runtimeSubagentOf(part)
+    expect(res).toBeDefined()
+    expect(res?.agent).toBe("explore")
+    expect(res?.description).toBe("find files")
+  })
+
+  test("extracts sessionId from output line matching session_id: ses_... when completed", () => {
+    const part = tool(T0, "task", {
+      status: "completed",
+      input: { category: "deep", description: "deep search" },
+      output: "Task initialized.\nsession_id: ses_abc123_xyz\nRunning...",
+    })
+    const res = runtimeSubagentOf(part)
+    expect(res).toBeDefined()
+    expect(res?.session).toBe("ses_abc123_xyz")
+  })
+
+  test("does not extract session_id from output when state is not completed", () => {
+    const part = tool(T0, "task", {
+      status: "running",
+      input: { category: "deep", description: "deep search" },
+      metadata: { output: "session_id: ses_running_123" },
+    })
+    const res = runtimeSubagentOf(part)
+    expect(res?.session).toBeUndefined()
+  })
+
+  test("metadata.sessionId takes precedence over output line", () => {
+    const part = tool(T0, "task", {
+      status: "completed",
+      input: { category: "deep", description: "deep search" },
+      metadata: { sessionId: "ses_meta" },
+      output: "session_id: ses_output",
+    })
+    const res = runtimeSubagentOf(part)
+    expect(res?.session).toBe("ses_meta")
+  })
+})
+
+describe("background dispatch and linkBackground", () => {
+  const u = user(T0)
+
+  test("metadata.backgroundTaskId marks child.background=true and sets backgroundTaskId", () => {
+    const a = assistant(u, T0 + 100)
+    const task = tool(
+      T0 + 200,
+      "task",
+      {
+        status: "completed",
+        input: { category: "explore", description: "search in bg" },
+        metadata: { backgroundTaskId: "bg_test_1", sessionId: "ses_bg_1" },
+        output: "Dispatched",
+        time: { start: T0 + 200, end: T0 + 250 },
+      },
+      { messageID: a.id },
+    )
+    const m = runtime({ messages: [u, a], parts: { [a.id]: [task] } })
+    const t0 = m.tools[0]
+    expect(t0.child).toBeDefined()
+    expect(t0.child?.background).toBe(true)
+    expect(t0.child?.backgroundTaskId).toBe("bg_test_1")
+    expect(t0.child?.sessionID).toBe("ses_bg_1")
+    // When backgroundTaskId is present, completed part output is NOT treated as child.result
+    expect(t0.child?.result).toBeUndefined()
+  })
+
+  test("background_output with full_session counts as retrieved only when the task completed", () => {
+    const fullOutput = (status: string) =>
+      `# Full Session Output\n\nTask ID: bg_full\nDescription: find items\nStatus: ${status}\nSession ID: ses_bg_full\n\n## Messages\n\n[assistant (explore)] found 3 files`
+    const build = (status: string) => {
+      const a1 = assistant(u, T0 + 100)
+      const task = tool(
+        T0 + 200,
+        "task",
+        {
+          status: "completed",
+          input: { category: "explore", description: "find items" },
+          metadata: { backgroundTaskId: "bg_full", sessionId: "ses_bg_full" },
+          output: "Dispatched",
+          time: { start: T0 + 200, end: T0 + 250 },
+        },
+        { messageID: a1.id },
+      )
+      const a2 = assistant(u, T0 + 2000)
+      const out = tool(
+        T0 + 2100,
+        "background_output",
+        {
+          status: "completed",
+          input: { task_id: "bg_full", full_session: true },
+          output: fullOutput(status),
+          time: { start: T0 + 2100, end: T0 + 2300 },
+        },
+        { messageID: a2.id },
+      )
+      return runtime({ messages: [u, a1, a2], parts: { [a1.id]: [task], [a2.id]: [out] } })
+    }
+    const done = build("completed").tools[0]
+    expect(done.child?.retrieved).toEqual({ request: 1, at: T0 + 2300 })
+    expect(done.child?.result).toBe("[assistant (explore)] found 3 files")
+    expect(build("running").tools[0].child?.retrieved).toBeUndefined()
+  })
+
+  test("completed background_output with Task Result populates child.retrieved and child.result", () => {
+    const a1 = assistant(u, T0 + 100)
+    const task = tool(
+      T0 + 200,
+      "task",
+      {
+        status: "completed",
+        input: { category: "explore", description: "find items" },
+        metadata: { backgroundTaskId: "bg_test_2", sessionId: "ses_bg_2" },
+        output: "Dispatched",
+        time: { start: T0 + 200, end: T0 + 250 },
+      },
+      { messageID: a1.id },
+    )
+    const a2 = assistant(u, T0 + 2000)
+    const retrieveTool = tool(
+      T0 + 2100,
+      "background_output",
+      {
+        status: "completed",
+        input: { task_id: "bg_test_2" },
+        output: "Task Result: Found 5 files in workspace\n1. a.ts\n2. b.ts",
+        time: { start: T0 + 2100, end: T0 + 2300 },
+      },
+      { messageID: a2.id },
+    )
+
+    const m = runtime({
+      messages: [u, a1, a2],
+      parts: {
+        [a1.id]: [task],
+        [a2.id]: [retrieveTool],
+      },
+    })
+
+    const dispatchTool = m.tools[0]
