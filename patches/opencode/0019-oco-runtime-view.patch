@@ -0,0 +1,106 @@
+import { describe, expect, test } from "bun:test"
+import type { AssistantMessage, Message, Part, ToolPart } from "@opencode-ai/sdk/v2/client"
+import { idTime } from "./session-trajectory-model"
+import { buildM5, loadM5Fixture, loadM5Oracle, loadM5Raw, m5RawText } from "./session-runtime-ring.fixture"
+import type { RingSource } from "./session-runtime-ring-types"
+
+const raw = loadM5Raw()
+const built = buildM5(raw)
+const { input, keyframes } = loadM5Fixture()
+const near = raw.round_starts[0]
+
+const isTool = (p: Part): p is ToolPart => p.type === "tool"
+const tasks = () => input.messages.flatMap((m) => input.parts(m.id)).filter(isTool).filter((p) => p.tool === "task")
+const sources = (): [string, RingSource][] => [
+  [input.sessionID, input],
+  ...built.children.map((id): [string, RingSource] => [id, input.child(id)!]),
+]
+const sorted = (ids: string[]) => [...ids].sort()
+
+describe("M5 real-session fixture", () => {
+  test("round starts are the real user messages' times", () => {
+    expect(raw.round_starts).toHaveLength(4)
+    const users = input.messages.filter((m) => m.role === "user").map((m) => m.time.created)
+    expect(users).toEqual(raw.round_starts)
+  })
+
+  test("8 child sessions, each reachable from its task call", () => {
+    expect(built.children).toHaveLength(8)
+    const linked = tasks().map((p) => {
+      const meta = p.state.status === "pending" ? undefined : p.state.metadata
+      return meta?.sessionId
+    })
+    expect(linked).toHaveLength(8)
+    expect(new Set(linked)).toEqual(new Set(built.children))
+    for (const id of built.children) {
+      const c = input.child(id)!
+      expect(c.messages.length).toBeGreaterThan(0)
+      expect(c.messages.every((m) => m.sessionID === id)).toBe(true)
+    }
+    expect(input.child("ses_missing")).toBeUndefined()
+  })
+
+  test("child assistant messages all carry a finish reason; the last one ends the loop", () => {
+    for (const id of built.children) {
+      const asst = input.child(id)!.messages.filter((m): m is AssistantMessage => m.role === "assistant")
+      expect(asst.length).toBeGreaterThanOrEqual(2)
+      expect(asst.every((m) => typeof m.finish === "string" && m.finish.length > 0)).toBe(true)
+      expect(["tool-calls", "unknown"]).not.toContain(asst[asst.length - 1].finish)
+    }
+  })
+
+  test("14 keyframes, ascending, and the oracle has one verdict per keyframe", () => {
+    expect(keyframes).toHaveLength(14)
+    expect(keyframes.map((k) => k.t)).toEqual([...keyframes.map((k) => k.t)].sort((a, b) => a - b))
+    const oracle = loadM5Oracle()
+    expect(oracle.frames.map((f) => [f.id, f.t])).toEqual(keyframes.map((k) => [k.id, k.t]))
+  })
+
+  test("every synthesized id decodes back to its original time", () => {
+    expect(built.ids.length).toBeGreaterThan(300)
+    expect(new Set(built.ids.map((x) => x.id)).size).toBe(built.ids.length)
+    for (const x of built.ids) expect(idTime(x.id, near)).toBe(x.at)
+    // and through the SDK shapes: message → created, text/reasoning → start, tool → created (raw), steps → created (raw)
+    const rawBy = new Map<string, number[]>()
+    const all: [Message, readonly Part[]][] = sources().flatMap(([, s]) => s.messages.map((m): [Message, readonly Part[]] => [m, s.parts(m.id)]))
+    const rawMsgs = [...raw.root, ...raw.children.flatMap((c) => c.messages)]
+    expect(all).toHaveLength(rawMsgs.length)
+    all.forEach(([m, ps], i) => {
+      expect(idTime(m.id, near)).toBe(m.time.created)
+      expect(m.time.created).toBe(rawMsgs[i].created)
+      rawBy.set(m.id, rawMsgs[i].parts.map((p) => p.created))
+      expect(ps.map((p) => idTime(p.id, near))).toEqual(rawBy.get(m.id)!)
+      for (const p of ps) if (p.type === "text" || p.type === "reasoning") expect(p.time!.start).toBeLessThanOrEqual(p.time!.end ?? Infinity)
+    })
+  })
+
+  test("id order equals array order (messages per session, parts per message)", () => {
+    for (const [, s] of sources()) {
+      const ids = s.messages.map((m) => m.id)
+      expect(sorted(ids)).toEqual(ids)
+      for (const m of s.messages) {
+        const pids = s.parts(m.id).map((p) => p.id)
+        expect(sorted(pids)).toEqual(pids)
+      }
+    }
+  })
+
+  test("tool output length matches output_chars (fixture is self-consistent)", () => {
+    const rawTools = [...raw.root, ...raw.children.flatMap((c) => c.messages)].flatMap((m) => m.parts).filter((p) => p.type === "tool")
+    const tools = sources().flatMap(([, s]) => s.messages.flatMap((m) => s.parts(m.id))).filter(isTool)
+    expect(tools).toHaveLength(rawTools.length)
+    tools.forEach((p, i) => {
+      const out = p.state.status === "completed" ? p.state.output : ""
+      expect([...out].length).toBe(p.state.status === "completed" ? rawTools[i].output_chars! : [...out].length)
+      expect(typeof p.state.input).toBe("object")
+    })
+    const q = tools.find((p) => p.tool === "question")!
+    expect(Array.isArray(q.state.input.questions)).toBe(true)
+  })
+
+  test("no sensitive patterns in the fixture", () => {
+    const text = m5RawText()
+    expect(text.length).toBeGreaterThan(1000)
+    expect(text).not.toMatch(/\/Users\/|xiaojiang|@[a-z0-9.-]+\.(com|net|org)|sk-[A-Za-z0-9]{8}|ghp_|AKIA|gcp-/)
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-ring-frame-perf.test.ts b/packages/app/src/components/session/session-runtime-ring-frame-perf.test.ts
new file mode 100644
index 0000000..e8db865
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-frame-perf.test.ts
@@ -0,0 +1,115 @@
+// oco (patches/opencode/0019): M5 runtime ring — per-frame budget (Task 11, D11). One frame of the view is
+// frameAt + geoOf + tokenAt + wiresAt + packetsAt + placeLabels; p95 over 300 sample times must be <= 4 ms, at stage
+// widths 1100 (wide) and 560 (narrow), on the real fixture and on Task 5's scale B (1500 requests, 8 children, 100
+// notices). Prints the numbers (the main thread records them in the evidence file).
+import { describe, expect, test } from "bun:test"
+import { runtimeText } from "./session-runtime-i18n"
+import { buildRingIndex, frameAt } from "./session-runtime-ring"
+import { loadM5Fixture } from "./session-runtime-ring.fixture"
+import { geoOf, packetsAt, placeLabels, stageSize, tokenAt, wiresAt } from "./session-runtime-ring-geo"
+import { bigSession, SCALE_B } from "./session-runtime-ring-perf.fixture"
+import type { PillId, RingIndex } from "./session-runtime-ring-types"
+
+const BUDGET_MS = 4
+const SAMPLES = 300
+const zh = runtimeText({ locale: () => "zh", intl: () => "zh-CN" })
+const PILLS: PillId[] = ["asm", "think", "out", "call", "wait", "next"]
+const LABELS = Object.fromEntries(PILLS.map((id) => [id, zh.t(`ring.pill.${id}` as const)])) as Record<PillId, string>
+
+const p95 = (xs: number[]) => {
+  const s = [...xs].sort((a, b) => a - b)
+  return s[Math.min(s.length - 1, Math.ceil(s.length * 0.95) - 1)]
+}
+const fmt = (v: number) => v.toFixed(3)
+
+/** `n` sample times spread evenly over the index's change times (each one ms after the event), so frames are busy ones. */
+function sampleTimes(index: RingIndex, n = SAMPLES) {
+  const ts = index.times
+  return Array.from({ length: n }, (_, i) => ts[Math.min(ts.length - 1, Math.floor(((i + 0.5) * ts.length) / n))] + 1)
+}
+
+const STEPS = ["frameAt", "geoOf", "tokenAt", "wiresAt", "packetsAt", "placeLabels"] as const
+type Step = (typeof STEPS)[number]
+let sink = 0
+
+/** One view frame, timed per step. */
+function oneFrame(index: RingIndex, t: number, width: number, height: number) {
+  const s = stageSize(width, height)
+  const ms = {} as Record<Step, number>
+  let a = performance.now()
+  const lap = (step: Step) => {
+    const b = performance.now()
+    ms[step] = b - a
+    a = b
+  }
+  const f = frameAt(index, t, { reduced: false, wide: s.wide })
+  lap("frameAt")
+  const g = geoOf(s.W, s.H, f.k, LABELS, LABELS.next)
+  lap("geoOf")
+  const tok = tokenAt(g, f.stage.round, t, false)
+  lap("tokenAt")
+  const wires = wiresAt(g, f, t, false)
+  lap("wiresAt")
+  const packets = packetsAt(g, index, f, t, false)
+  lap("packetsAt")
+  const labels = placeLabels(
+    g,
+    packets.flatMap((p) =>
+      p.label === undefined
+        ? []
+        : [{ at: p.at, text: typeof p.label === "string" ? p.label : zh.phrase(p.label), tone: p.tone, dx: p.dx, dy: p.dy }],
+    ),
+  )
+  lap("placeLabels")
+  sink += (tok?.pos ?? 0) + wires.length + packets.length + labels.length
+  return ms
+}
+
+function measure(index: RingIndex, width: number, height: number) {
+  const ts = sampleTimes(index)
+  for (const t of ts) oneFrame(index, t, width, height) // warm-up: JIT, and the per-index lookup tables
+  Bun.gc(true)
+  const rows = ts.map((t) => oneFrame(index, t, width, height))
+  const totals = rows.map((r) => STEPS.reduce((n, k) => n + r[k], 0))
+  return {
+    total: p95(totals),
+    max: Math.max(...totals),
+    steps: Object.fromEntries(STEPS.map((k) => [k, p95(rows.map((r) => r[k]))])) as Record<Step, number>,
+  }
+}
+
+function report(name: string, width: number, index: RingIndex) {
+  const height = width >= 980 ? 720 : 900
+  const r = measure(index, width, height)
+  console.log(
+    `[ring-frame-perf] ${name} ${width}x${height} p95=${fmt(r.total)} ms max=${fmt(r.max)} ms (budget ${BUDGET_MS}) | p95 per step: ` +
+      STEPS.map((k) => `${k}=${fmt(r.steps[k])}`).join(" ") +
+      ` | times=${index.times.length}`,
+  )
+  return r
+}
+
+describe(`per-frame budget: frameAt + geoOf + tokenAt + wiresAt + packetsAt + placeLabels, p95 <= ${BUDGET_MS} ms over ${SAMPLES} sample times`, () => {
+  const fixtureIndex = buildRingIndex(loadM5Fixture().input)
+  const big = buildRingIndex(bigSession(SCALE_B).input)
+
+  test("the sample times are spread over the whole index", () => {
+    for (const index of [fixtureIndex, big]) {
+      const ts = sampleTimes(index)
+      expect(ts.length).toBe(SAMPLES)
+      expect(new Set(ts).size).toBeGreaterThan(SAMPLES / 2)
+      expect(ts[0]).toBeLessThan(ts[SAMPLES - 1])
+    }
+    expect(big.rounds[0].requests.length).toBe(1500)
+    expect(big.subs.filter((x) => x.child).length).toBe(8)
+  })
+
+  for (const width of [1100, 560]) {
+    test(`real fixture, width ${width}`, () => {
+      expect(report("fixture", width, fixtureIndex).total).toBeLessThanOrEqual(BUDGET_MS)
+    })
+    test(`scale B (1500 requests, 8 children, 100 notices), width ${width}`, () => {
+      expect(report("scaleB", width, big).total).toBeLessThanOrEqual(BUDGET_MS)
+    })
+  }
+})
diff --git a/packages/app/src/components/session/session-runtime-ring-geo.test.ts b/packages/app/src/components/session/session-runtime-ring-geo.test.ts
new file mode 100644
index 0000000..a35b287
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-ring-geo.test.ts
@@ -0,0 +1,746 @@
+// oco (patches/opencode/0019): unit tests for the M5 ring geometry, bus wires, packets, token and labels (Task 8).
+// Synthetic frames and hand-built indexes only: key-frame checks on the real fixture belong to Task 11.
+import { describe, expect, test } from "bun:test"
+import { runtimeText } from "./session-runtime-i18n"
+import {
+  arcPath,
+  freeEnds,
+  geoOf,
+  packetsAt,
+  placeLabels,
+  poly,
+  ringPt,
+  stageSize,
+  stationSubBox,
+  textW,
+  tokenAt,
+  wiresAt,
+  type RingGeoX,
+} from "./session-runtime-ring-geo"
+import {
+  RING,
+  type Box,
+  type PillId,
+  type RingFrame,
+  type RingIndex,
+  type RingRequest,
+  type RingRound,
+  type RingStageId,
+  type RingSub,
+  type RingTool,
+  type ToolRowState,
+  type RingSubCell,
+  type SubState,
+} from "./session-runtime-ring-types"
+
+// ---------- labels ----------
+const PILLS: PillId[] = ["asm", "think", "out", "call", "wait", "next"]
+const labelsOf = (locale: "zh" | "zht" | "en", intl: string) => {
+  const text = runtimeText({ locale: () => locale, intl: () => intl })
+  return Object.fromEntries(PILLS.map((id) => [id, text.t(`ring.pill.${id}` as const)])) as Record<PillId, string>
+}
+const ZH = labelsOf("zh", "zh-CN")
+const ZHT = labelsOf("zht", "zh-TW")
+const EN = labelsOf("en", "en-US")
+const geo = (W: number, H: number, k: number, L = ZH, dk = 1): RingGeoX => {
+  const s = stageSize(W, H)
+  return geoOf(s.W, s.H, k, L, L.next, dk)
+}
+
+const hit = (a: Box, b: Box) => a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y
+const dist = (a: { x: number; y: number }, b: { x: number; y: number }) => Math.hypot(a.x - b.x, a.y - b.y)
+const named = (g: RingGeoX): [string, Box][] => [
+  ["you", g.you],
+  ["model", g.model],
+  ["pay", g.pay],
+  ["ctr", g.ctr],
+  ["tools", g.tools],
+  ["lane", g.lane],
+  ...PILLS.map((id) => [`pill.${id}`, g.pill[id]] as [string, Box]),
+]
+const overlaps = (boxes: [string, Box][]) => {
+  const out: string[] = []
+  for (let i = 0; i < boxes.length; i++)
+    for (let j = i + 1; j < boxes.length; j++) if (hit(boxes[i][1], boxes[j][1])) out.push(`${boxes[i][0]}x${boxes[j][0]}`)
+  return out
+}
+
+// One rule for every locale: all boxes inside the stage with a positive size, raw boxes apart, and the label-avoidance
+// boxes (`g.obst`, every box grown by 3 px per side) apart as well. No exemptions.
+function clean(g: RingGeoX, tag: string) {
+  const list = named(g)
+  for (const [n, b] of list) {
+    expect(b.w, `${tag} ${n} w`).toBeGreaterThan(0)
+    expect(b.h, `${tag} ${n} h`).toBeGreaterThan(0)
+    expect(b.x, `${tag} ${n} x`).toBeGreaterThanOrEqual(0)
+    expect(b.y, `${tag} ${n} y`).toBeGreaterThanOrEqual(0)
+    expect(b.x + b.w, `${tag} ${n} right`).toBeLessThanOrEqual(g.W + 1e-6)
+    expect(b.y + b.h, `${tag} ${n} bottom`).toBeLessThanOrEqual(g.H + 1e-6)
+  }
+  expect(overlaps(list), `${tag} raw`).toEqual([])
+  expect(g.obst.length, tag).toBe(list.length)
+  const bad: string[] = []
+  for (let i = 0; i < g.obst.length; i++)
+    for (let j = i + 1; j < g.obst.length; j++) if (hit(g.obst[i], g.obst[j])) bad.push(`${list[i][0]}~${list[j][0]}`)
+  expect(bad, `${tag} obst`).toEqual([])
+}
+const LOCALES: [string, Record<PillId, string>][] = [["zh", ZH], ["zht", ZHT], ["en", EN]]
+const ANGLE: Record<PillId, number> = { asm: 180, think: 240, out: 300, call: 0, wait: 60, next: 120 }
+
+const WIDTHS = [560, 760, 979, 980, 1100, 1600]
+const HEIGHTS = [470, 720, 1000]
+const KS = [0, 0.5, 1]
+
+// ---------- synthetic frame / index builders (complete objects, no loose casts) ----------
+const ph = (key: RingFrame["caption"]["key"]) => ({ key })
+function row(i: number, state: ToolRowState, same?: [number, number]) {
+  return { id: `prt_row${i}`, name: "bash", state, arg: state === "pend" ? "" : `cmd ${i}`, same }
+}
+function cell(i: number, state: SubState): RingSubCell {
+  return { uid: `sub${i}`, num: i + 1, slot: i, state }
+}
+function frameOf(over: {
+  st?: RingStageId
+  why?: "finish" | "dismiss" | "abort" | "idle"
+  round?: RingRound
+  request?: RingRequest
+  rows?: ReturnType<typeof row>[]
+  cells?: RingSubCell[]
+  k?: number
+  t?: number
+}): RingFrame {
+  const rows = over.rows ?? []
+  const cells = over.cells ?? []
+  const counts = { pend: 0, run: 0, ok: 0, err: 0 }
+  for (const r of rows) counts[r.state]++
+  const sc = { queued: 0, run: 0, docked: 0, done: 0, err: 0 }
+  for (const c of cells) sc[c.state]++
+  return {
+    t: over.t ?? 0,
+    stage: { st: over.st ?? "call", round: over.round, request: over.request, why: over.why },
+    status: { word: ph("ring.status.running"), tone: "sub", state: "working" },
+    counter: { agent: "build", ended: false, requests: [] },
+    model: { model: "p/m", line: ph("ring.model.waiting"), tone: "faint", ctx: ph("ring.model.waiting"), lit: false },
+    card: {
+      kind: "idle", tone: "faint", from: "", to: "", body: "", bodyMode: "head", mono: false, streaming: false, meta: [],
+    },
+    pills: {
+      asm: { lit: false }, think: { lit: false }, out: { lit: false }, call: { lit: false }, wait: { lit: false }, next: { lit: false },
+    },
+    you: { state: "idle", status: ph("ring.status.running") },
+    tools: { rows, counts },
+    subs: {
+      cells, counts: sc, total: cells.length,
+      stripWhat: ph("ring.status.running"), stripSession: ph("ring.status.running"), stripButton: false,
+    },
+    k: over.k ?? 0,
+    dk: 1,
+    caption: ph("ring.status.running"),
+    live: ph("ring.status.running"),
+    bar: { waitMs: 0 },
+  }
+}
+const EMPTY_INDEX: RingIndex = { sessionID: "ses_root", rounds: [], subs: [], plans: [], times: [], nav: [] }
+
+function toolOf(over: Partial<RingTool> & { id: string }): RingTool {
+  return {
+    callID: over.id, messageID: "msg_req", name: "bash", kind: "tool", created: 0, status: "completed", input: {},
+    arg: "ls -la", key: "", chars: 0, slot: 0, ...over,
+  }
+}
+function subOf(over: Partial<RingSub> = {}): RingSub {
+  return {
+    uid: "ses_child", sessionID: "ses_child", round: 1, request: 1, num: 1, name: "explore", type: "explore",
+    agent: "build", prompt: "p", result: "THE RESULT BODY", created: 0, start: 100, end: 400, failed: false, ...over,
+  }
+}
+function requestOf(tools: RingTool[], over: Partial<RingRequest> = {}): RingRequest {
+  return {
+    messageID: "msg_req", round: 1, m: 1, created: 0, agent: "build", model: "p/m", think: [], texts: [], tools, ...over,
+  }
+}
+function roundOf(requests: RingRequest[], over: Partial<RingRound> = {}): RingRound {
+  return { n: 1, userMessageID: "msg_user", start: 0, text: "hi", agent: "build", requests, prevHadTask: false, changes: [], ...over }
+}
+/** A frame whose round holds one request with the given tools (kind tool / task / question). */
+function frameWith(tools: RingTool[], over: Parameters<typeof frameOf>[0] = {}) {
+  const request = requestOf(tools)
+  const round = roundOf([request])
+  return frameOf({ round, request, ...over })
+}
+
+// ---------- helpers ----------
+describe("textW / poly / stageSize / arcPath", () => {
+  test("CJK counts a full em, the rest 0.61 em", () => {
+    expect(textW("组装", 12)).toBe(24)
+    expect(textW("ab", 10)).toBeCloseTo(12.2, 6)
+    expect(textW("", 12)).toBe(0)
+  })
+  test("poly measures and interpolates", () => {
+    const p = poly([{ x: 0, y: 0 }, { x: 10, y: 0 }, { x: 10, y: 10 }])
+    expect(p.L).toBe(20)
+    expect(p.at(5)).toMatchObject({ x: 5, y: 0, dx: 10, dy: 0 })
+    expect(p.at(15)).toMatchObject({ x: 10, y: 5, dx: 0, dy: 10 })
+    expect(p.at(99)).toMatchObject({ x: 10, y: 10 })
+    expect(p.at(-1)).toMatchObject({ x: 0, y: 0 })
+  })
+  test("stageSize pads the height by layout", () => {
+    expect(stageSize(979, 100)).toEqual({ W: 979, H: RING.MIN_H_NARROW, wide: false })
+    expect(stageSize(980, 100)).toEqual({ W: 980, H: RING.MIN_H_WIDE, wide: true })
+    expect(stageSize(1100, 900)).toEqual({ W: 1100, H: 900, wide: true })
+  })
+  test("arcPath is an SVG path or empty when shorter than 0.3 degree", () => {
+    const g = geo(1100, 720, 0)
+    expect(arcPath(g, 10, 10.2, g.R)).toBe("")
+    const d = arcPath(g, 180, 300, g.R)
+    expect(d.startsWith("M")).toBe(true)
+    expect(d.split("L").length).toBe(Math.ceil(120 / 3) + 1)
+  })
+})
+
+// ---------- 1, 2: geometry ----------
+describe("geoOf layout", () => {
+  test("1. zh, zht and en: every box inside the stage, no overlaps, no obst overlaps (all widths x heights x k)", () => {
+    for (const [name, L] of LOCALES)
+      for (const w of WIDTHS)
+        for (const h of HEIGHTS)
+          for (const k of KS) {
+            const g = geo(w, h, k, L)
+            const tag = `${name} ${w}x${h} k=${k} R=${g.R}`
+            expect(g.mode).toBe(w >= RING.WIDE_MIN ? "wide" : "narrow")
+            clean(g, tag)
+            if (g.mode === "wide") {
+              expect(Math.abs(g.pay.x + g.pay.w / 2 - g.cx), tag).toBeLessThanOrEqual(0.5)
+              expect(Math.abs(g.pay.y + g.pay.h / 2 - g.cy), tag).toBeLessThanOrEqual(0.5)
+            }
+          }
+  })
+
+  test("1b. every pill still covers its own point on the ring, and the anchor is that ring point", () => {
+    for (const [name, L] of LOCALES)
+      for (const w of WIDTHS)
+        for (const h of HEIGHTS)
+          for (const k of KS) {
+            const g = geo(w, h, k, L)
+            for (const id of PILLS) {
+              const p = g.pill[id]
+              const a = g.anchor[id]
+              const r = ringPt(g, ANGLE[id])
+              const tag = `${name} ${w}x${h} k=${k} ${id}`
+              expect(Math.hypot(a.x - r.x, a.y - r.y), tag).toBeLessThan(1e-9)
+              expect(a.x, tag).toBeGreaterThanOrEqual(p.x + 1)
+              expect(a.x, tag).toBeLessThanOrEqual(p.x + p.w - 1)
+              expect(a.y, tag).toBeGreaterThanOrEqual(p.y)
+              expect(a.y, tag).toBeLessThanOrEqual(p.y + p.h)
+              expect(p.cx, tag).toBeCloseTo(p.x + p.w / 2, 9) // cx / cy are the box centre
+              expect(p.cy, tag).toBeCloseTo(p.y + p.h / 2, 9)
+            }
+          }
+  })
+
+  test("1c. fidelity: with room to spare (zh at 760x720 and 1100x720) every pill is centred on its ring point", () => {
+    for (const [w, h] of [[760, 720], [1100, 720], [1600, 1000]] as const)
+      for (const L of [ZH, ZHT]) {
+        const g = geo(w, h, 1, L)
+        for (const id of PILLS) expect(Math.abs(g.pill[id].cx - g.anchor[id].x), `${w}x${h} ${id}`).toBeLessThan(1e-9)
+      }
+  })
+
+  test("1d. zh output keeps the mockup values where they fit (pay width 2(R-44), ctr 1.12R, spine 44 px past the ring)", () => {
+    const wide = geo(1100, 720, 1)
+    expect(wide.pay.w).toBe(Math.round(2 * (wide.R - 44)))
+    const narrow = geo(760, 720, 1)
+    expect(narrow.ctr.w).toBeCloseTo(1.12 * narrow.R, 6)
+    expect(narrow.busO).toBeCloseTo(narrow.cx + narrow.R + 44 - 4, 6)
+    expect(narrow.cx).toBeCloseTo(66 + narrow.R, 6)
+  })
+
+  test("1e. narrow keeps a usable counter box and payload column in every locale", () => {
+    for (const [name, L] of LOCALES)
+      for (const w of [560, 760, 979])
+        for (const h of HEIGHTS)
+          for (const k of KS) {
+            const g = geo(w, h, k, L)
+            const tag = `${name} ${w}x${h} k=${k}`
+            expect(g.ctr.w, tag).toBeGreaterThanOrEqual(g.R - 1e-6) // at least R wide (half the radius either side)
+            expect(g.pay.w, tag).toBeGreaterThanOrEqual(170)
+            expect(Math.abs(g.ctr.x + g.ctr.w / 2 - g.cx), tag).toBeLessThan(1e-9)
+          }
+  })
+
+  test("1f. label sweep: uniform labels of 2..18 characters and one long label among short ones stay clean", () => {
+    const mk = (n: number) => "m".repeat(n)
+    const all = (n: number) => Object.fromEntries(PILLS.map((id) => [id, mk(n)])) as Record<PillId, string>
+    const one = (id: PillId, n: number) => ({ ...all(5), [id]: mk(n) }) as Record<PillId, string>
+    // 18 latin characters is a 152 px pill, wider than the longest English label (Bring results back); beyond that the
+    // wide layout would need to move the "you" box as well
+    const sets: [string, Record<PillId, string>][] = []
+    for (const n of [2, 4, 6, 8, 10, 12, 14, 16, 18]) sets.push([`all ${n}`, all(n)])
+    for (const id of PILLS) for (const n of [8, 12, 16]) sets.push([`${id} ${n}`, one(id, n)])
+    // CJK-width labels (a full em per character) too
