+    const after = createMockTool({
+      id: "task-part",
+      state: "completed",
+      child: {
+        agent: "explore",
+        description: "bg",
+        background: true,
+        lifecycle: "running",
+        evidence: "event",
+        sessionID: "ses-bg",
+        backgroundTaskId: "bg_1",
+      },
+    })
+    const a = loopOf(createMockModel({ tools: [before] })).probes[0]
+    const b = loopOf(createMockModel({ tools: [after] })).probes[0]
+    expect(a.id).toBe("ses-bg")
+    expect(b.id).toBe("bg_1")
+    expect(a.node).toBe("task-part")
+    expect(b.node).toBe(a.node)
+  })
+})
+
+describe("handoff card fallbacks", () => {
+  const child = (sessionID: string, description: string) => ({
+    agent: "explore",
+    description,
+    background: false,
+    lifecycle: "done" as const,
+    evidence: "event" as const,
+    sessionID,
+  })
+
+  test("latest is the newest subagent of the whole session, earlier rounds included", () => {
+    const old = createMockTool({ id: "t1", request: 0, state: "completed", child: child("s1", "first") })
+    const newer = createMockTool({ id: "t2", request: 1, state: "completed", child: child("s2", "second") })
+    const loop = loopOf(createMockModel({ roundStart: 5, tools: [old, newer] }))
+    expect(loop.probes).toHaveLength(0)
+    expect(loop.latest?.description).toBe("second")
+  })
+
+  test("a cancelled subagent is the latest only when nothing else exists", () => {
+    const done = createMockTool({ id: "t1", request: 0, state: "completed", child: child("s1", "kept") })
+    const cancelled = createMockTool({ id: "t2", request: 1, state: "error", cancelled: true, child: child("s2", "stopped") })
+    expect(loopOf(createMockModel({ tools: [done, cancelled] })).latest?.description).toBe("kept")
+    expect(loopOf(createMockModel({ tools: [cancelled] })).latest?.description).toBe("stopped")
+  })
+
+  test("lastTool is the main agent's newest own call; subagent rows do not count", () => {
+    const bash = createMockTool({ id: "t1", name: "bash", request: 0, state: "completed", child: undefined })
+    const task = createMockTool({ id: "t2", request: 1, state: "completed", child: child("s1", "x") })
+    const loop = loopOf(createMockModel({ tools: [bash, task] }))
+    expect(loop.lastTool?.name).toBe("bash")
+    expect(loopOf(createMockModel({ tools: [] })).lastTool).toBeUndefined()
+  })
+})
+
+describe("handoff duration and replay context (D1 D2)", () => {
+  const start = 1_000_000
+  const cursor = start + 90_000
+  const wall = start + 62 * 3_600_000 + 18 * 60_000 + 40_000
+
+  test("replay clock is the cursor; live clock is the wall", () => {
+    expect(elapsedClock("replay", cursor, wall)).toBe(cursor)
+    expect(elapsedClock("live", cursor, wall)).toBe(wall)
+    expect(elapsedClock("replay", undefined, wall)).toBe(wall)
+  })
+
+  test("an open handoff in replay measures to the cursor, not the wall", () => {
+    expect(formatElapsed(start, undefined, elapsedClock("replay", cursor, wall))).toBe("1m 30s")
+    expect(formatElapsed(start, undefined, elapsedClock("live", cursor, wall))).toBe("62h 18m")
+    expect(formatElapsed(start, start + 5_000, wall)).toBe("5s")
+  })
+
+  test("formatDuration adds an hour tier and does not roll into days", () => {
+    expect(formatDuration(0)).toBe("0s")
+    expect(formatDuration(59_000)).toBe("59s")
+    expect(formatDuration(61_000)).toBe("1m 1s")
+    expect(formatDuration(59 * 60_000 + 59_000)).toBe("59m 59s")
+    expect(formatDuration(60 * 60_000)).toBe("1h 0m")
+    expect(formatDuration(62 * 3_600_000 + 18 * 60_000 + 40_000)).toBe("62h 18m")
+    expect(formatDuration(26 * 3_600_000 + 5 * 60_000)).toBe("26h 5m")
+    expect(formatDuration(-5_000)).toBe("0s")
+  })
+
+  test("replay context uses the cursor snapshot; live keeps the full list", () => {
+    const assistant = (id: string, input: number) =>
+      ({
+        id,
+        role: "assistant",
+        providerID: "openai",
+        modelID: "gpt",
+        tokens: { input, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+        time: { created: 1 },
+      }) as unknown as Message
+    const early = assistant("a1", 110)
+    const later = assistant("a2", 66_000)
+    const all = [early, later]
+    const snapshot = [early]
+    const providers = [{ id: "openai", models: { gpt: { limit: { context: 1_000_000 } } } }]
+
+    expect(messagesForContext("replay", all, snapshot)).toBe(snapshot)
+    expect(messagesForContext("live", all, snapshot)).toBe(all)
+    expect(messagesForContext("replay", all, undefined)).toEqual([])
+
+    const replay = getSessionContext(messagesForContext("replay", all, snapshot), providers)
+    const live = getSessionContext(messagesForContext("live", all, snapshot), providers)
+    expect(replay?.message.id).toBe("a1")
+    expect(replay?.total).toBe(110)
+    expect(live?.message.id).toBe("a2")
+    expect(live?.total).toBe(66_000)
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-loop.ts b/packages/app/src/components/session/session-runtime-loop.ts
