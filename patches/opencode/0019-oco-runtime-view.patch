+// oco (patches/opencode/0019): unit tests for the M5 subagent state / detail / list pure functions (Task 6).
+import { describe, expect, test } from "bun:test"
+import { childDoneAt, probeStageOfSub, subDetailAt, subListAt, subStateAt } from "./session-runtime-ring-sub"
+import type { Phrase, RingChild, RingSpan, RingSub, RingTool } from "./session-runtime-ring-types"
+
+// ---------- synthetic builders ----------
+function tool(over: Partial<RingTool> & { id: string }): RingTool {
+  return {
+    callID: over.id,
+    messageID: "msg_child",
+    name: "bash",
+    kind: "tool",
+    created: 0,
+    status: "completed",
+    input: {},
+    arg: "ls",
+    key: "",
+    chars: 0,
+    slot: 0,
+    ...over,
+  }
+}
+const text = (span: RingSpan) => ({ kind: "text" as const, at: span.start, span })
+const toolAct = (t: RingTool) => ({ kind: "tool" as const, at: t.created, tool: t })
+
+type Msg = RingChild["messages"][number]
+const msg = (created: number, completed: number | undefined, finish?: string, over: Partial<Msg> = {}): Msg => ({
+  created,
+  completed,
+  model: `p/m${created}`,
+  cost: 0,
+  finish,
+  ...over,
+})
+const child = (over: Partial<RingChild> = {}): RingChild => ({ messages: [], acts: [], thinks: [], ...over })
+
+function sub(over: Partial<RingSub> = {}): RingSub {
+  return {
+    uid: "ses_child",
+    sessionID: "ses_child",
+    round: 2,
+    request: 1,
+    num: 1,
+    name: "Demo explore",
+    type: "explore",
+    agent: "build",
+    prompt: "Look **here** and `there`\nsecond line",
+    result: "RESULT **raw**",
+    created: 1000,
+    start: 2000,
+    end: 10_000,
+    failed: false,
+    ...over,
+  }
+}
+
+// three child requests: tool-calls, tool-calls, stop (D16 / test 1a)
+const steps = (third: Partial<Msg> = {}) =>
+  child({
+    messages: [
+      msg(2100, 3000, "tool-calls", { model: "p/m1", cost: 0.001 }),
+      msg(3010, 5000, "tool-calls", { model: "p/m2", cost: 0.002 }),
+      msg(5010, 7000, "stop", { model: "p/m3", cost: 0.003, ...third }),
+    ],
+  })
+
+describe("childDoneAt / subStateAt (D16)", () => {
+  test("1a: done only after the request that ends the loop completes; between steps it is still running", () => {
+    const s = sub({ child: steps() })
+    for (const t of [2050, 2500, 3000, 4000, 5000, 5005, 6000, 6999]) {
+      expect(childDoneAt(s, t)).toBeUndefined()
+      expect(subStateAt(s, t)).toBe("run")
+    }
+    for (const t of [7000, 8000, 9999]) {
+      expect(childDoneAt(s, t)).toBe(7000)
+      expect(subStateAt(s, t)).toBe("docked")
+    }
+    expect(subStateAt(s, 10_000)).toBe("done")
+  })
+
+  test("1a: length and error also end the loop; unknown and a missing finish do not", () => {
+    expect(childDoneAt(sub({ child: steps({ finish: "length" }) }), 8000)).toBe(7000)
+    expect(childDoneAt(sub({ child: steps({ finish: undefined, error: true }) }), 8000)).toBe(7000)
+    expect(childDoneAt(sub({ child: steps({ finish: undefined }) }), 8000)).toBeUndefined()
+    const unknown = sub({ child: child({ messages: [msg(2100, 3000, "unknown")] }) })
+    for (const t of [3000, 5000, 9999]) expect(childDoneAt(unknown, t)).toBeUndefined()
+    expect(subStateAt(unknown, 9999)).toBe("run")
+  })
+
+  test("1a: child not loaded: a sync task runs until its end", () => {
+    const s = sub()
+    expect(childDoneAt(s, 9999)).toBeUndefined()
+    expect(subStateAt(s, 9999)).toBe("run")
+    expect(subStateAt(s, 10_000)).toBe("done")
+    expect(subStateAt(sub({ failed: true, error: "boom" }), 10_000)).toBe("err")
+  })
+
+  test("1: sync state table cell by cell, and probe stages", () => {
+    const s = sub({ child: steps() })
+    expect(subStateAt(s, 999)).toBeUndefined()
+    expect(subStateAt(s, 1000)).toBe("queued")
+    expect(subStateAt(s, 1999)).toBe("queued")
+    expect(subStateAt(s, 2000)).toBe("run")
+    expect(subStateAt(s, 7000)).toBe("docked")
+    expect(subStateAt(s, 10_000)).toBe("done")
+    expect(subStateAt(sub({ child: steps(), failed: true }), 10_000)).toBe("err")
+    expect(probeStageOfSub("queued")).toBe("queued")
+    expect(probeStageOfSub("run")).toBe("running")
+    expect(probeStageOfSub("docked")).toBe("docked")
+    expect(probeStageOfSub("done")).toBe("absorbed")
+    expect(probeStageOfSub("err")).toBe("absorbed")
+  })
+
+  test("1b: background notices: done → docked, cleared → run, error → err; own end is not a pickup", () => {
+    const s = sub({
+      end: 2500,
+      background: {
+        taskId: "bg_1",
+        notices: [
+          { at: 4000, kind: "done" },
+          { at: 5000, kind: "cleared" },
+          { at: 6000, kind: "error" },
+        ],
+      },
+    })
+    expect(subStateAt(s, 1500)).toBe("queued")
+    expect(subStateAt(s, 3000)).toBe("run")
+    expect(subStateAt(s, 4000)).toBe("docked")
+    expect(subStateAt(s, 4999)).toBe("docked")
+    expect(subStateAt(s, 5000)).toBe("run")
+    expect(subStateAt(s, 6000)).toBe("err")
+    expect(
+      subStateAt(sub({ end: 2500, background: { taskId: "bg_1", notices: [{ at: 4000, kind: "cancelled" }] } }), 4000),
+    ).toBe("err")
+    // docked line falls back to the done notice when the child is not loaded
+    expect(subDetailAt(s, 4500, { narrow: false })!.stateLine).toEqual({
+      key: "ring.sub.docked.line",
+      params: { dur: { ms: 2500 }, done: { ms: 2000 }, wait: { ms: 500 } },
+    })
+    expect(subDetailAt(s, 6500, { narrow: false })!.stateLine).toEqual({
+      key: "ring.sub.tookErr",
+      params: { dur: { ms: 4000 }, at: { at: 6000 } },
+    })
+  })
+
+  test("1b: background retrieval → done; a loaded child that finished before a clear does not keep it docked", () => {
+    const got = sub({
+      end: 2500,
+      background: { taskId: "bg_1", retrievedAt: 4500, notices: [{ at: 4000, kind: "done" }] },
+    })
+    expect(subStateAt(got, 4499)).toBe("docked")
+    expect(subStateAt(got, 4500)).toBe("done")
+    expect(subDetailAt(got, 4600, { narrow: false })!.stateLine).toEqual({
+      key: "ring.sub.took",
+      params: { dur: { ms: 2500 }, at: { at: 4500 } },
+    })
+    const bg = { taskId: "bg_1", notices: [{ at: 7500, kind: "cleared" as const }] }
+    const s = sub({ end: 2500, background: bg, child: steps() })
+    expect(subStateAt(s, 7200)).toBe("docked")
+    expect(subStateAt(s, 7500)).toBe("run")
+    const again = sub({
+      end: 2500,
+      background: bg,
+      child: child({ messages: [...steps().messages, msg(7600, 8000, "stop")] }),
+    })
+    expect(subStateAt(again, 7700)).toBe("run")
+    expect(subStateAt(again, 8000)).toBe("docked")
+  })
+})
+
+describe("subDetailAt", () => {
+  test("2: time gate: no name, type or handoff before start; open disabled", () => {
+    const s = sub()
+    const q = subDetailAt(s, 1500, { narrow: false })!
