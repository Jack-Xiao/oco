+// ---------- index ----------
+/** Root-derived event times (with EMIT_MS pads) of an index, kept for the incremental child-only rebuild. */
+const ROOT_TIMES = new WeakMap<RingIndex, readonly number[]>()
+/** Side data of a settled request (completed, finish set, every tool and span ended), kept so that a later full
+ *  rebuild can take the request from `prev` by messageID without reading its parts (D11). Only settled requests have
+ *  an entry. The object itself is reused only without task or todowrite calls (`reuse`): a task's sub gets background
+ *  state from later messages and its slot from the round, and planVersion is numbered over the whole session; such a
+ *  request is rebuilt, but its times are final, so it still counts for FIX. */
+type ReqAux = {
+  reuse: boolean
+  parts: number                   // part count when built: a later change to the message shows up here
+  steps: number                   // side-table record count when built (D21): a late step part shows up here
+  agent?: string; roundAgent: string; provider: string; model: string   // raw inputs of RingRequest.agent / model
+  times: number[]                 // everything the request added to the root times (raw times and EMIT_MS pads)
+  lo?: number; hi?: number        // min / max of its raw times (firstAt / lastAt)
+  got: [string, number][]         // background_output retrievals: [taskId, end]
+}
+const REQ_AUX = new WeakMap<RingRequest, ReqAux>()
