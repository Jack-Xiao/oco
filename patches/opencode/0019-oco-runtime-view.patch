+test("16 step side table (D21): step parts fed through the side table equal the parts path at every t; no future leak", () => {
+  const { input } = loadM5Fixture()
+  const full = buildRingIndex(input)
+  const isStep = (type: string) => type === "step-start" || type === "step-finish"
+  // the sync layer's view: step parts dropped from the parts arrays, their times kept in a per-session side table
+  const viaSide = (src: RingSource, late = false): RingSource => {
+    const table = new Map<string, RingStepTimes>()
+    for (const m of src.messages)
+      for (const p of src.parts(m.id)) addStepPart(table, p, m.role === "assistant" ? m.time.created : Date.now())
+    if (late)
+      for (const m of src.messages) {
+        const rec = table.get(m.id)
+        const ats = src.parts(m.id).filter((p) => !isStep(p.type)).map((p) => idTime(p.id, m.time.created)!)
+        if (rec && ats.length) rec.start = Math.min(...ats) + 200 // start-step after a part (processor.ts: tool first)
+      }
+    return { messages: src.messages, parts: (id) => src.parts(id).filter((p) => !isStep(p.type)), steps: (id) => table.get(id) }
+  }
+  const sideInput = (late = false): RingIndexInput => {
+    const kids = new Map<string, RingSource | undefined>()
+    return {
+      sessionID: input.sessionID,
+      ...viaSide(input, late),
+      child: (id) => {
+        if (!kids.has(id)) {
+          const src = input.child(id)
+          kids.set(id, src ? viaSide(src, late) : undefined)
+        }
+        return kids.get(id)
+      },
+    }
+  }
+  const sideIn = sideInput()
+  const reqs = (ix: RingIndex) => ix.rounds.flatMap((r) => r.requests)
+  expect(reqs(full).every((q) => q.stepStart !== undefined)).toBe(true)
+  expect(input.messages.some((m) => sideIn.parts(m.id).some((p) => isStep(p.type)))).toBe(false)
+  // whole data: identical index (stepStart, finish, times, children)
+  expect(buildRingIndex(sideIn)).toStrictEqual(full)
+  // every cut: the side-table path equals the parts path (truncateAt cuts the side table too)
+  const pick = Array.from({ length: 60 }, (_, i) => full.times[Math.floor((i * (full.times.length - 1)) / 59)])
+  const pts = pick.flatMap((t) => [t - 1, t, t + 1])
+  // and the sent instant itself, where asm turns into fly
+  const sent = reqs(full).flatMap((q) => [q.stepStart! - 1, q.stepStart!, q.stepStart! + 1])
+  for (const t of [...pts, ...sent]) {
+    const a = buildRingIndex(truncateAt(input, t))
+    const b = buildRingIndex(truncateAt(sideIn, t))
+    expect({ t, b: reqs(b).map((q) => [q.messageID, q.stepStart, q.finish]) }).toEqual({ t, b: reqs(a).map((q) => [q.messageID, q.stepStart, q.finish]) })
+    expect(b).toStrictEqual(a)
+    expect({ t, st: stageAt(b, t).st }).toEqual({ t, st: stageAt(a, t).st })
+    expect({ t, st: stageAt(b, t).st }).toEqual({ t, st: stageAt(full, t).st })
