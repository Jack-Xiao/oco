+// oco (patches/opencode/0019): one-level subagent panel. Grandchildren are a single line; no further expand.
+import type { Accessor } from "solid-js"
+import { createMemo, For, Show } from "solid-js"
+import { retryWait } from "./session-runtime-actions"
+import { keyed } from "./session-runtime-keyed"
+import type { RuntimeText } from "./session-runtime-i18n"
+import type { ChildLifecycle, RuntimeModel, RuntimeTool, Stage } from "./session-runtime-model"
+
+const GLYPH = { pending: "○", running: "◐", completed: "✓", error: "✕" } as const
+const BTN = "h-6 px-2 rounded-[5px] text-12-medium bg-surface-inset-base text-text-base"
+
+const stageKey = (s: Stage): Exclude<Stage, "idle"> => (s === "idle" ? "prepare" : s)
+const lifecycleKey = (lifecycle: ChildLifecycle) => `child.lifecycle.${lifecycle}` as "child.lifecycle.running"
+
+const focusLine = (m: RuntimeModel, t: RuntimeText["t"], now: number) => {
+  const focus = m.focus
+  switch (focus.kind) {
+    case "attention":
+      return focus.attention.kind === "permission"
+        ? t("focus.attention.permission", { what: [focus.attention.permission, ...focus.attention.patterns].join(" ") })
+        : t("focus.attention.question", { what: focus.attention.text })
+    case "retry": {
+      const wait = retryWait(focus.next, now)
+      return wait.due ? t("retry.soon") : t("retry.countdown", { attempt: focus.attempt, seconds: wait.seconds })
+    }
+    case "error":
+      return focus.message ? t("focus.error", { message: focus.message }) : t("focus.error.unknown")
+    case "working":
+      return focus.tool
+        ? t("focus.working.tool", { tool: focus.tool.child?.agent ?? focus.tool.name, input: focus.tool.input })
+        : t(`stage.${stageKey(focus.stage)}`)
+    case "interrupted":
+      return t("focus.interrupted")
+    case "cancelled":
+      return t("focus.cancelled")
+    case "done":
+      return t("focus.done")
+    default:
+      return t("focus.idle")
+  }
+}
+
+const childToolLine = (x: Accessor<RuntimeTool>, t: RuntimeText["t"]) => {
+  const grand = () => x().child
+  return (
+    <Show
+      when={grand()}
+      fallback={
+        <div
+          data-oco-runtime-tool={x().id}
+          class="flex items-center gap-2 min-w-0 rounded-md px-2 py-1.5 bg-surface-inset-base"
+          style={{ "border-left": "3px solid var(--syntax-warning)" }}
+        >
+          <span aria-hidden="true">{x().cancelled ? "⊘" : GLYPH[x().state]}</span>
+          <span class="text-12-medium text-text-strong shrink-0">{x().name}</span>
+          <span class="min-w-0 truncate text-12-regular text-text-weak">{x().input}</span>
+          <span class="ml-auto shrink-0 text-12-regular text-text-weak">
+            {x().cancelled ? t("tool.cancelled") : t(`tool.state.${x().state}`)}
+          </span>
+        </div>
+      }
+    >
+      {(c) => (
+        <div data-oco-runtime-tool={x().id} class="flex items-center gap-2 min-w-0 text-12-regular">
+          <span class="text-12-medium text-text-strong shrink-0">{c().agent}</span>
+          <span class="text-text-weak">{t(lifecycleKey(c().lifecycle))}</span>
+        </div>
+      )}
+    </Show>
+  )
+}
+
+export function RuntimeChildPanel(props: {
+  sessionID: string
+  lifecycle: ChildLifecycle
+  model: Accessor<RuntimeModel>
+  now: Accessor<number>
+  t: RuntimeText["t"]
+  onOpen?: (sessionID: string) => void
+}) {
+  const active = createMemo(() =>
+    props.model().tools.filter((x) => !x.interrupted && (x.state === "pending" || x.state === "running")),
+  )
+  const activeKeys = keyed(active, (x) => x.id)
+  return (
+    <div
+      data-oco-runtime-child={props.sessionID}
+      data-oco-runtime-child-lifecycle={props.lifecycle}
+      class="flex flex-col gap-1 rounded-md px-2 py-1.5"
+    >
+      <Show when={props.model().mode === "replay"}>
+        <div class="text-12-regular text-text-weak">{props.t("child.replay.unknown")}</div>
+      </Show>
+      <div class="text-12-medium text-text-strong">{focusLine(props.model(), props.t, props.now())}</div>
+      <For each={activeKeys.ids()}>{(id) => childToolLine(() => activeKeys.get(id)!, props.t)}</For>
+      <div class="text-12-regular text-text-weak">{props.t(lifecycleKey(props.lifecycle))}</div>
+      <button
+        type="button"
+        class={`${BTN} self-start`}
+        data-oco-runtime-child-open={props.sessionID}
+        onClick={() => props.onOpen?.(props.sessionID)}
+      >
+        {props.t("child.open")}
+      </button>
+    </div>
+  )
+}
