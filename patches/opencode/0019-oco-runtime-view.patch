index 0000000..78e0b0b
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-events.test.ts
@@ -0,0 +1,399 @@
+// oco (patches/opencode/0019): event-level checks — what only an event sequence can prove.
+import { describe, expect, test } from "bun:test"
+import type { Message, Part, PermissionRequest, QuestionRequest, Session } from "@opencode-ai/sdk/v2/client"
+import { createStore } from "solid-js/store"
+import { applyDirectoryEvent } from "@/context/global-sync/event-reducer"
+import type { State } from "@/context/global-sync/types"
+import { buildTrajectory } from "./session-trajectory-model"
+import { trajectoryText } from "./session-trajectory-i18n"
+import { buildRuntime, collectTreeRequests, eventSessionID, inFlightOf, snapshotAt } from "./session-runtime-model"
+
+const rootSession = (input: { id: string; parentID?: string; archived?: number }) =>
+  ({
+    id: input.id,
+    parentID: input.parentID,
+    time: {
+      created: 1,
+      updated: 1,
+      archived: input.archived,
+    },
+  }) as Session
+
+const userMessage = (id: string, sessionID: string, created = 1) =>
+  ({
+    id,
+    sessionID,
+    role: "user",
+    time: { created },
+    agent: "assistant",
+    model: { providerID: "openai", modelID: "gpt" },
+  }) as Message
+
+const textPart = (id: string, sessionID: string, messageID: string) =>
+  ({
+    id,
+    sessionID,
+    messageID,
+    type: "text",
+    text: id,
+  }) as Part
+
+const permissionRequest = (id: string, sessionID: string, title = id) =>
+  ({
+    id,
+    sessionID,
+    permission: title,
+    patterns: ["*"],
+    metadata: {},
+    always: [],
+  }) as PermissionRequest
+
+const questionRequest = (id: string, sessionID: string, title = id) =>
+  ({
+    id,
+    sessionID,
+    questions: [
+      {
+        question: title,
+        header: title,
+        options: [{ label: title, description: title }],
+      },
+    ],
+  }) as QuestionRequest
+
+const baseState = (input: Partial<State> = {}) =>
+  ({
+    status: "complete",
+    agent: [],
+    command: [],
+    project: "",
+    projectMeta: undefined,
+    icon: undefined,
+    provider: {} as State["provider"],
+    config: {} as State["config"],
+    path: { directory: "/tmp" } as State["path"],
+    session: [],
+    sessionTotal: 0,
+    session_status: {},
+    session_diff: {},
+    todo: {},
+    permission: {},
+    question: {},
+    mcp: {},
+    lsp: [],
+    vcs: undefined,
+    limit: 10,
+    message: {},
+    session_message: {},
+    part: {},
+    part_text_accum_delta: {},
+    ...input,
+  }) as State
+
+const language = trajectoryText({ locale: () => "en", intl: () => "en" })
+const SID = "ses_1"
+const T0 = 1_790_000_000_000
+
+const feed = (store: any, setStore: any, type: string, properties: unknown) =>
+  applyDirectoryEvent({ event: { type, properties }, store, setStore, push() {}, directory: "/tmp", loadLsp() {} })
+
+const runtimeOf = (store: any, now: number) => {
+  const messages = store.message[SID] ?? []
+  const parts = (id: string) => store.part[id] ?? []
+  const built = buildTrajectory({ messages, parts, now, busy: true, language })
+  return buildRuntime(
+    {
+      mode: "live",
+      sessionID: SID,
+      parts,
+      status: store.session_status[SID],
+      permissions: store.permission[SID] ?? [],
+      questions: store.question[SID] ?? [],
+      childStatus: (id: string) => store.session_status[id],
+      requests: built.requests,
+    },
+    now,
+  )
+}
+
+describe("runtime over the real reducer", () => {
+  test("permission asked → replied moves the run through waiting-user and back", () => {
+    const [store, setStore] = createStore(baseState({}))
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "busy" } })
+    expect(runtimeOf(store, T0).run.state).toBe("working")
+    feed(store, setStore, "permission.asked", { id: "per_1", sessionID: SID, permission: "edit", patterns: ["a.ts"], metadata: {}, always: [] })
+    expect(runtimeOf(store, T0).run.state).toBe("waiting-user")
+    feed(store, setStore, "permission.replied", { sessionID: SID, requestID: "per_1" })
+    expect(runtimeOf(store, T0).run.state).toBe("working")
+  })
+
+  test("a retry status reaches the model with attempt and next, then clears on busy", () => {
+    const [store, setStore] = createStore(baseState({}))
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "retry", attempt: 3, message: "429", next: T0 + 5000 } })
+    expect(runtimeOf(store, T0).run.retry).toEqual({ attempt: 3, message: "429", next: T0 + 5000 })
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "busy" } })
+    expect(runtimeOf(store, T0).run.retry).toBeUndefined()
+  })
+
+  test("a part delta that arrives before its part is dropped by the store (documented upstream behavior)", () => {
+    const [store, setStore] = createStore(baseState({}))
+    feed(store, setStore, "message.part.delta", { sessionID: SID, messageID: "msg_x", partID: "prt_x", field: "text", delta: "hi" })
+    expect(store.part["msg_x"]).toBeUndefined()
+    expect(store.part_text_accum_delta?.["prt_x"]).toBeUndefined()
+  })
+
+  test("eventSessionID matches the events the reducer receives, so unrelated sessions never refresh freshness", () => {
+    expect(eventSessionID({ type: "session.status", properties: { sessionID: SID, status: { type: "busy" } } })).toBe(SID)
+    expect(eventSessionID({ type: "permission.asked", properties: { id: "p", sessionID: SID } })).toBe(SID)
+    expect(eventSessionID({ type: "server.heartbeat", properties: {} })).toBeUndefined()
+  })
+
+  test("child session permission asked is stored under child id and collected for root", () => {
+    const [store, setStore] = createStore(
+      baseState({
+        session: [
+          rootSession({ id: SID }),
+          rootSession({ id: "ses_child", parentID: SID }),
+          rootSession({ id: "ses_grandchild", parentID: "ses_child" }),
+        ],
+      }),
+    )
+    feed(store, setStore, "permission.asked", {
+      id: "per_child",
+      sessionID: "ses_child",
+      permission: "edit",
+      patterns: ["b.ts"],
+      metadata: {},
+      always: [],
+    })
+    expect(store.permission["ses_child"]?.map((p) => p.id)).toEqual(["per_child"])
+    expect(store.permission[SID]).toBeUndefined()
+
+    const collected = collectTreeRequests(SID, store.session, store.permission, store.question)
+    expect(collected.permissions.map((p) => p.id)).toEqual(["per_child"])
+    expect(collected.questions).toEqual([])
+  })
+})
+
+// M2: the same wiring session-runtime.tsx uses — tree-wide pending requests, child messages and parents for the
+// live model; snapshotAt + empty requests for replay.
+const CHILD = "ses_child"
+
+const assistantMessage = (id: string, sessionID: string, created: number, extra: Record<string, unknown> = {}) =>
+  ({
+    id,
+    sessionID,
+    role: "assistant",
+    parentID: "msg_u1",
+    time: { created },
+    modelID: "m",
+    providerID: "p",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/", root: "/" },
+    cost: 0,
+    tokens: { input: 10, output: 5, reasoning: 0, cache: { read: 0, write: 0 } },
+    ...extra,
+  }) as Message
+
+const toolPart = (id: string, messageID: string, tool: string, state: Record<string, unknown>, sessionID = SID) =>
+  ({ id, sessionID, messageID, type: "tool", tool, callID: `call_${id}`, state }) as unknown as Part
+
+const taskState = (status: "running" | "completed", start: number, end?: number) => ({
+  status,
+  input: { subagent_type: "explore", description: "probe" },
+  metadata: { sessionId: CHILD },
+  time: end === undefined ? { start } : { start, end },
+  ...(status === "completed" ? { output: "<task><task_result>ok</task_result></task>", title: "probe" } : {}),
+})
+
+const treeState = () =>
+  baseState({ session: [rootSession({ id: SID }), rootSession({ id: CHILD, parentID: SID })] })
+
+const liveOf = (store: any, now: number) => {
+  const messages = store.message[SID] ?? []
+  const parts = (id: string) => store.part[id] ?? []
+  const busy = store.session_status[SID]?.type === "busy"
+  const built = buildTrajectory({ messages, parts, now, busy, language })
+  const tree = collectTreeRequests(SID, store.session, store.permission, store.question)
+  return buildRuntime(
+    {
+      mode: "live",
+      sessionID: SID,
+      parts,
+      status: store.session_status[SID],
+      permissions: tree.permissions,
+      questions: tree.questions,
+      childStatus: (id: string) => store.session_status[id],
+      childMessages: (id: string) => store.message[id],
+      parentOf: (id: string) => store.session.find((s: Session) => s.id === id)?.parentID,
+      requests: built.requests,
+    },
+    now,
+  )
+}
+
+const replayOf = (store: any, at: number) => {
+  const messages = store.message[SID] ?? []
+  const parts = (id: string) => store.part[id] ?? []
+  const busy = store.session_status[SID]?.type === "busy"
+  const view = snapshotAt(messages, parts, at, inFlightOf(messages, busy))
+  const built = buildTrajectory({ messages: view.messages, parts: view.parts, now: at, busy: view.busy, language })
+  return buildRuntime(
+    {
+      mode: "replay",
+      sessionID: SID,
+      parts: view.parts,
+      status: undefined,
+      permissions: [],
+      questions: [],
+      childStatus: () => undefined,
+      childMessages: (id: string) => store.message[id],
+      parentOf: (id: string) => store.session.find((s: Session) => s.id === id)?.parentID,
+      requests: built.requests,
+    },
+    at,
+  )
+}
+
+/** Root turn with one running `task` call whose child session is CHILD. */
+const startTask = (store: any, setStore: any) => {
+  feed(store, setStore, "session.status", { sessionID: SID, status: { type: "busy" } })
+  feed(store, setStore, "message.updated", { info: userMessage("msg_u1", SID, T0) })
+  feed(store, setStore, "message.updated", { info: assistantMessage("msg_a1", SID, T0 + 100) })
+  feed(store, setStore, "message.part.updated", { part: toolPart("prt_t1", "msg_a1", "task", taskState("running", T0 + 200)) })
+  feed(store, setStore, "session.status", { sessionID: CHILD, status: { type: "busy" } })
+}
+
+const childPermission = { id: "per_child", sessionID: CHILD, permission: "bash", patterns: ["rm -rf tmp"], metadata: {}, always: [] }
+
+describe("runtime M2 over the real reducer", () => {
+  test("a child permission reaches root attention with the child's own sessionID, and replying clears it", () => {
+    const [store, setStore] = createStore(treeState())
+    startTask(store, setStore)
+    feed(store, setStore, "permission.asked", childPermission)
+    const asked = liveOf(store, T0 + 1000)
+    expect(asked.run.state).toBe("waiting-user")
+    expect(asked.run.attention.map((a) => [a.kind, a.id, a.sessionID])).toEqual([["permission", "per_child", CHILD]])
+    expect(asked.tools.find((t) => t.id === "prt_t1")?.child?.lifecycle).toBe("waiting-user")
+
+    feed(store, setStore, "permission.replied", { sessionID: CHILD, requestID: "per_child" })
+    const replied = liveOf(store, T0 + 1100)
+    expect(replied.run.attention).toEqual([])
+    expect(replied.run.state).toBe("working")
+    expect(replied.tools.find((t) => t.id === "prt_t1")?.child?.lifecycle).toBe("running")
+  })
+
+  test("replay of the same data has no attention and says the attention is unknown", () => {
+    const [store, setStore] = createStore(treeState())
+    startTask(store, setStore)
+    feed(store, setStore, "permission.asked", childPermission)
+    expect(liveOf(store, T0 + 1000).run.attention).toHaveLength(1)
+
+    const replay = replayOf(store, T0 + 1000)
+    expect(replay.mode).toBe("replay")
+    expect(replay.run.attention).toEqual([])
+    expect(replay.run.attentionKnown).toBe(false)
+    expect(replay.run.state).not.toBe("waiting-user")
+    expect(replay.tools.find((t) => t.id === "prt_t1")?.child?.lifecycle).toBe("unknown")
+  })
+
+  test("an aborted request ends with focus cancelled and a request.cancelled event", () => {
+    const [store, setStore] = createStore(baseState({}))
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "busy" } })
+    feed(store, setStore, "message.updated", { info: userMessage("msg_u1", SID, T0) })
+    feed(store, setStore, "message.updated", { info: assistantMessage("msg_a1", SID, T0 + 100) })
+    feed(store, setStore, "message.part.updated", {
+      part: toolPart("prt_b1", "msg_a1", "bash", { status: "running", input: { command: "sleep 60" }, time: { start: T0 + 200 } }),
+    })
+    const running = liveOf(store, T0 + 300)
+    expect(running.focus.kind).toBe("working")
+    expect(running.tools[0]?.state).toBe("running")
+
+    feed(store, setStore, "message.updated", {
+      info: assistantMessage("msg_a1", SID, T0 + 100, {
+        time: { created: T0 + 100, completed: T0 + 900 },
+        error: { name: "MessageAbortedError", data: { message: "aborted" } },
+      }),
+    })
+    feed(store, setStore, "message.part.updated", {
+      part: toolPart("prt_b1", "msg_a1", "bash", {
+        status: "error",
+        input: { command: "sleep 60" },
+        error: "Tool execution aborted",
+        time: { start: T0 + 200, end: T0 + 900 },
+      }),
+    })
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "idle" } })
+    const done = liveOf(store, T0 + 1000)
+    expect(done.run.state).toBe("idle")
+    expect(done.focus.kind).toBe("cancelled")
+    expect(done.tools[0]?.cancelled).toBe(true)
+    expect(done.events.map((e) => e.kind)).toContain("request.cancelled")
+    expect(done.events.map((e) => e.kind)).not.toContain("request.error")
+  })
+
+  test("retry → busy → idle moves run.state retrying → working → idle", () => {
+    const [store, setStore] = createStore(baseState({}))
+    feed(store, setStore, "message.updated", { info: userMessage("msg_u1", SID, T0) })
+    const states: string[] = []
+    feed(store, setStore, "session.status", {
+      sessionID: SID,
+      status: { type: "retry", attempt: 1, message: "Rate limit reached (mock)", next: T0 + 1000 },
+    })
+    const retrying = liveOf(store, T0 + 10)
+    states.push(retrying.run.state)
+    expect(retrying.focus).toEqual({ kind: "retry", attempt: 1, message: "Rate limit reached (mock)", next: T0 + 1000 })
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "busy" } })
+    states.push(liveOf(store, T0 + 1100).run.state)
+    feed(store, setStore, "message.updated", {
+      info: assistantMessage("msg_a1", SID, T0 + 1100, { time: { created: T0 + 1100, completed: T0 + 1500 }, finish: "stop" }),
+    })
+    feed(store, setStore, "session.status", { sessionID: SID, status: { type: "idle" } })
+    states.push(liveOf(store, T0 + 1600).run.state)
+    expect(states).toEqual(["retrying", "working", "idle"])
+    expect(liveOf(store, T0 + 1600).run.retry).toBeUndefined()
+  })
+
+  test("a pending root permission is the focus while a child keeps running; both are shown", () => {
+    const [store, setStore] = createStore(treeState())
+    startTask(store, setStore)
+    feed(store, setStore, "permission.asked", {
+      id: "per_root",
+      sessionID: SID,
+      permission: "edit",
+      patterns: ["a.ts"],
+      metadata: {},
+      always: [],
+    })
+    const model = liveOf(store, T0 + 1000)
+    expect(model.focus.kind).toBe("attention")
+    if (model.focus.kind === "attention") {
+      expect(model.focus.attention.id).toBe("per_root")
+      expect(model.focus.attention.sessionID).toBe(SID)
+    }
+    const task = model.tools.find((t) => t.id === "prt_t1")
+    expect(task?.child?.lifecycle).toBe("running")
+    expect(task?.awaiting).toBeUndefined()
+  })
+
+  test("a background task: task completed while the child is busy stays running; child idle + completed is done", () => {
+    const [store, setStore] = createStore(treeState())
+    startTask(store, setStore)
+    feed(store, setStore, "message.part.updated", {
+      part: toolPart("prt_t1", "msg_a1", "task", taskState("completed", T0 + 200, T0 + 400)),
+    })
+    const background = liveOf(store, T0 + 500).tools.find((t) => t.id === "prt_t1")
+    expect(background?.state).toBe("completed")
+    expect(background?.child?.lifecycle).toBe("running")
+
+    feed(store, setStore, "message.updated", { info: userMessage("msg_cu1", CHILD, T0 + 210) })
+    feed(store, setStore, "message.updated", {
+      info: assistantMessage("msg_ca1", CHILD, T0 + 220, { time: { created: T0 + 220, completed: T0 + 800 }, finish: "stop" }),
+    })
+    feed(store, setStore, "session.status", { sessionID: CHILD, status: { type: "idle" } })
+    const finished = liveOf(store, T0 + 900).tools.find((t) => t.id === "prt_t1")
+    expect(finished?.state).toBe("completed")
+    expect(finished?.child?.lifecycle).toBe("done")
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-i18n.test.ts b/packages/app/src/components/session/session-runtime-i18n.test.ts
new file mode 100644
index 0000000..7555eff
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-i18n.test.ts
@@ -0,0 +1,106 @@
+// oco (patches/opencode/0019): the three runtime dictionaries have the same keys and placeholders.
+import { describe, expect, test } from "bun:test"
+import { RUNTIME_DICTS_FOR_TEST as d, runtimeText } from "./session-runtime-i18n"
+
+const keys = (o: Record<string, string>) => Object.keys(o).sort()
+const holes = (s: string) => [...s.matchAll(/{{\s*(\w+)\s*}}/g)].map((m) => m[1]).sort()
+
+describe("runtime copy", () => {
+  test("zh and zht have exactly the keys of en", () => {
+    expect(keys(d.zh)).toEqual(keys(d.en))
+    expect(keys(d.zht)).toEqual(keys(d.en))
+  })
+  test("placeholders match per key across languages", () => {
+    for (const k of Object.keys(d.en)) {
+      expect(holes(d.zh[k])).toEqual(holes(d.en[k]))
+      expect(holes(d.zht[k])).toEqual(holes(d.en[k]))
+    }
+  })
+  test("no copy claims a disconnect", () => {
+    for (const lang of [d.en, d.zh, d.zht]) for (const v of Object.values(lang)) expect(/disconnect|断连|斷連|斷線/i.test(v)).toBe(false)
+  })
+  test("t fills placeholders and falls back to English for other locales", () => {
+    const t = runtimeText({ locale: () => "fr", intl: () => "fr" }).t
+    expect(t("focus.retry", { attempt: 2, message: "m" })).toBe("Retrying (attempt 2): m")
+  })
+})
+
+// oco (patches/opencode/0019): M5 ring copy and formatters.
+describe("ring copy", () => {
+  const ring = (o: Record<string, string>) => Object.keys(o).filter((k) => k.startsWith("ring."))
+  const en = runtimeText({ locale: () => "en", intl: () => "en-US" })
+  const zh = runtimeText({ locale: () => "zh", intl: () => "zh-CN" })
+
+  test("the three dictionaries add the same ring keys", () => {
+    expect(ring(d.en).length).toBe(268)
+    expect(ring(d.zh).sort()).toEqual(ring(d.en).sort())
+    expect(ring(d.zht).sort()).toEqual(ring(d.en).sort())
+  })
+  test("ring copy never claims a disconnect", () => {
+    for (const lang of [d.en, d.zh, d.zht]) for (const k of ring(lang)) expect(/disconnect|断连|斷連/i.test(lang[k])).toBe(false)
+  })
+  test("zht ring copy has no simplified characters left", () => {
+    for (const k of ring(d.zht)) expect(/[个这还没调轮请结运发写给问题时间闲务参数开处后对带执计说话输组装选项随齐复划传侧刚办志权来显无绝见败费进]/.test(d.zht[k])).toBe(false)
+  })
+  test("D18: the legend keeps failed apart from dismissed / rejected", () => {
+    expect(d.en["ring.legend.err"]).toBe("Failed")
+    expect(d.zh["ring.legend.err"]).toBe("失败")
+    for (const lang of [d.en, d.zh, d.zht]) expect(/失败|失敗|fail/i.test(lang["ring.legend.declined"])).toBe(false)
+    expect(d.zh["ring.tools.row.rejected"]).toBe("你已拒绝授权")
+  })
+  test("dur short form follows the mockup's sK", () => {
+    const cases: [number, string, string][] = [
+      [-5, "0.0s", "0.0秒"],
+      [9_950, "9.9s", "9.9秒"],
+      [10_000, "10s", "10秒"],
+      [59_999, "59s", "59秒"],
+      [60_000, "1m 0s", "1分0秒"],
+      [125_500, "2m 5s", "2分5秒"],
+      [3_600_000, "60m 0s", "60分0秒"],
+    ]
+    for (const [ms, a, b] of cases) {
+      expect(en.dur(ms)).toBe(a)
+      expect(zh.dur(ms)).toBe(b)
+    }
+  })
+  test("dur long form follows the mockup's sCN and adds hours", () => {
+    const cases: [number, string, string][] = [
+      [9_950, "9.9 s", "9.9 秒"],
+      [10_000, "10 s", "10 秒"],
+      [59_999, "59 s", "59 秒"],
+      [60_000, "1 min 0 s", "1 分 0 秒"],
+      [3_599_999, "59 min 59 s", "59 分 59 秒"],
+      [3_600_000, "1 h 0 min", "1 小时 0 分"],
+      [5_430_000, "1 h 30 min", "1 小时 30 分"],
+    ]
+    for (const [ms, a, b] of cases) {
+      expect(en.dur(ms, true)).toBe(a)
+      expect(zh.dur(ms, true)).toBe(b)
+    }
+  })
+  test("clock prints local HH:MM:SS on a 24-hour cycle", () => {
+    expect(en.clock(new Date(2026, 9, 8, 0, 5, 9).getTime())).toBe("00:05:09")
+    expect(zh.clock(new Date(2026, 9, 8, 23, 59, 59).getTime())).toBe("23:59:59")
+    expect(en.clock(new Date(2026, 9, 8, 13, 4, 0).getTime())).toMatch(/^\d{2}:\d{2}:\d{2}$/)
+  })
+  test("tok uses compact notation and usd four decimals", () => {
+    expect(en.tok(12_345)).toBe("12.3K")
+    expect(zh.tok(12_345)).toBe("1.2万")
+    expect(en.tok(999)).toBe("999")
+    expect(en.usd(0.01234)).toBe("$0.0123")
+    expect(zh.usd(0)).toBe("$0.0000")
+  })
+  test("phrase translates nested phrases and formatter params", () => {
+    expect(zh.phrase({ key: "ring.cap.wait", params: { phrase: { key: "ring.wait.left", params: { n: 2 } } } })).toBe("等 2 个结果回来。")
+    expect(en.phrase({ key: "ring.cap.wait", params: { phrase: { key: "ring.wait.left", params: { n: 2 } } } })).toBe("Waiting for 2 results.")
+    const at = new Date(2026, 9, 8, 9, 3, 7).getTime()
+    expect(zh.phrase({ key: "ring.card.end.meta", params: { at: { at }, dur: { ms: 61_000 } } })).toBe("09:03:07 · 已空闲 1分1秒")
+    expect(en.phrase({ key: "ring.card.end.meta", params: { at: { at }, dur: { ms: 61_000, long: true } } })).toBe("09:03:07 · idle 1 min 1 s")
+    expect(
+      en.phrase({
+        key: "ring.model.receipt",
+        params: { total: { tok: 12_345 }, in: { tok: 12_000 }, out: { tok: 345 }, cost: { usd: 0.0123 } },
+      }),
+    ).toBe("Receipt 12.3K total (in 12K · out 345) · $0.0123")
+  })
+})
