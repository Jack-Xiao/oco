+// oco (patches/opencode/0019): Task 10 — RingSubView mounted on the real-data fixture: focus returns to the opener,
+// panels close when t moves before the dispatch (no future leak), nodes stay put during playback, D18 neutral ⊘.
+import { afterEach, expect, test } from "bun:test"
+import { createMemo, createSignal } from "solid-js"
+import { render } from "solid-js/web"
+import { runtimeText } from "../src/components/session/session-runtime-i18n"
+import { buildRingIndex, frameAt } from "../src/components/session/session-runtime-ring"
+import { geoOf, packetsAt, stageSize } from "../src/components/session/session-runtime-ring-geo"
+import { RingSubView } from "../src/components/session/session-runtime-ring-sub-view"
+import { loadM5Fixture } from "../src/components/session/session-runtime-ring.fixture"
+import type { PillId, RingIndex } from "../src/components/session/session-runtime-ring-types"
+
+const text = runtimeText({ locale: () => "en", intl: () => "en-US" })
+const PILLS: PillId[] = ["asm", "think", "out", "call", "wait", "next"]
+const LABELS = Object.fromEntries(PILLS.map((id) => [id, text.t(`ring.pill.${id}` as const)])) as Record<PillId, string>
+const fixture = loadM5Fixture()
+const INDEX = buildRingIndex(fixture.input)
+const KF = Object.fromEntries(fixture.keyframes.map((k) => [k.id.slice(0, 3), k.t])) as Record<string, number>
+
+const cleanups: (() => void)[] = []
+afterEach(() => {
+  while (cleanups.length) cleanups.pop()!()
+})
+
+function mount(t0: number, index: RingIndex = INDEX) {
+  const host = document.createElement("div")
+  host.setAttribute("data-oco-runtime", "")
+  host.tabIndex = -1
+  host.style.position = "relative"
+  document.body.appendChild(host)
+  const [t, setT] = createSignal(t0)
+  const calls = { load: [] as string[], enter: [] as string[], retry: [] as string[] }
+  const dispose = render(() => {
+    const frame = createMemo(() => frameAt(index, t(), { reduced: false, wide: true }))
+    const geo = createMemo(() => {
+      const s = stageSize(1280, 720)
+      return geoOf(s.W, s.H, frame().k, LABELS, LABELS.next)
+    })
+    const packets = createMemo(() => packetsAt(geo(), index, frame(), t(), false))
+    return (
+      <RingSubView
+        geo={geo}
+        frame={frame}
+        index={() => index}
+        t={t}
+        packets={packets}
+        text={text}
+        reduced={() => false}
+        mode={() => "replay"}
+        childLoad={() => "ready"}
+        onLoadChild={(id) => calls.load.push(id)}
+        onRetryChild={(id) => calls.retry.push(id)}
+        onEnterChild={(id) => calls.enter.push(id)}
+      />
+    )
+  }, host)
+  cleanups.push(() => {
+    dispose()
+    host.remove()
+  })
+  const q = <T extends Element = HTMLElement>(sel: string) => host.querySelector(sel) as T | null
+  const qa = (sel: string) => [...host.querySelectorAll<HTMLElement>(sel)]
+  const cellOf = (num: number) => {
+    const sub = index.subs.find((s) => s.num === num && s.created <= t() && s.round === frameAt(index, t(), { reduced: false, wide: true }).subs.round)!
+    return q(`[data-oco-runtime-sub-cell="${sub.uid}"]`)!
+  }
+  return { host, t, setT, q, qa, calls, cellOf }
+}
+
+const key = (el: Element, k: string) =>
+  el.dispatchEvent(new KeyboardEvent("keydown", { key: k, bubbles: true, cancelable: true }))
+
+test("k03: clicking a cell opens the detail with focus on ✕; Esc closes it and focus returns to the cell", () => {
+  const m = mount(KF.k03)
+  const cell = m.qa("[data-oco-runtime-sub-cell]")[0]
+  expect(cell).toBeTruthy()
+  expect(m.q("[data-oco-runtime-sub-panel]")).toBeNull()
+  cell.click()
+  const panel = m.q("[data-oco-runtime-sub-panel]")!
+  expect(panel).toBeTruthy()
+  expect(panel.getAttribute("data-oco-runtime-sub-panel-mode")).toBe("detail")
+  expect(panel.getAttribute("role")).toBe("dialog")
+  expect(document.getElementById(panel.getAttribute("aria-labelledby")!)?.textContent).toContain("#1")
+  expect(document.activeElement).toBe(m.q("[data-oco-runtime-sub-close]"))
+  expect(m.calls.load.length).toBe(1)
+  // look and navigate only: no reply / stop / cancel controls, no forbidden attribute names
+  for (const bad of ["question", "reply", "stop", "roster", "stats", "attention"])
+    expect(m.q(`[data-oco-runtime-${bad}]`)).toBeNull()
+  expect(m.qa("[data-oco-runtime-sub-panel] button").map((b) => b.textContent)).toEqual(["✕", "Open child session ↗"])
+  key(document.activeElement!, "Escape")
+  expect(m.q("[data-oco-runtime-sub-panel]")).toBeNull()
+  expect(document.activeElement).toBe(cell)
+})
+
+test("k04: Enter opens #5; moving t to j03 closes the panel (the future does not leak)", () => {
+  const m = mount(KF.k04)
+  const cell = m.cellOf(5)
+  cell.focus()
+  key(cell, "Enter")
+  const title = () => document.getElementById(m.q("[data-oco-runtime-sub-panel]")!.getAttribute("aria-labelledby")!)!
+  expect(title().textContent).toBe("#5 largest files")
+  m.setT(KF.j03)
+  expect(m.q("[data-oco-runtime-sub-panel]")).toBeNull()
+  expect(m.qa("[data-oco-runtime-sub-cell]").length).toBe(1)
+  // focus was inside the closed panel and the opener is gone: it falls back to the runtime root
+  expect(document.activeElement).toBe(m.host)
+})
+
+test("k10: the strip opens the list; at j03 the list only has Demo explore", () => {
+  const m = mount(KF.k10)
+  const strip = m.q("[data-oco-runtime-subs-strip]")!
+  expect(m.q("[data-oco-runtime-subs]")!.getAttribute("data-oco-runtime-subs-mode")).toBe("strip")
+  strip.click()
+  const panel = m.q("[data-oco-runtime-sub-panel]")!
+  expect(panel.getAttribute("data-oco-runtime-sub-panel-mode")).toBe("list")
+  expect(m.qa("[data-oco-runtime-sub-row]").length).toBe(8)
+  expect(document.activeElement).toBe(m.qa("[data-oco-runtime-sub-row]")[0])
+  m.setT(KF.j03)
+  expect(m.q("[data-oco-runtime-sub-panel]")).toBe(panel)
+  const rows = m.qa("[data-oco-runtime-sub-row]")
+  expect(rows.length).toBe(1)
+  expect(rows[0].textContent).toContain("Demo explore")
+  // a row opens the detail with "← List"; back returns to the list; Esc returns focus to the strip
+  rows[0].click()
+  expect(m.q("[data-oco-runtime-sub-back]")).toBeTruthy()
+  m.q<HTMLElement>("[data-oco-runtime-sub-back]")!.click()
+  expect(m.q("[data-oco-runtime-sub-panel]")!.getAttribute("data-oco-runtime-sub-panel-mode")).toBe("list")
+  m.setT(KF.k10)
+  key(document.activeElement!, "Escape")
+  expect(m.q("[data-oco-runtime-sub-panel]")).toBeNull()
+  expect(document.activeElement).toBe(m.q("[data-oco-runtime-subs-strip]"))
+})
+
+test("playback ticks keep the panel node, its scroll position and the focus", () => {
+  const m = mount(KF.k03)
+  m.cellOf(2).click()
+  const panel = m.q("[data-oco-runtime-sub-panel]")!
+  const close = m.q("[data-oco-runtime-sub-close]")!
+  const body = close.parentElement!.nextElementSibling as HTMLElement
+  const cells = m.qa("[data-oco-runtime-sub-cell]")
+  body.scrollTop = 24
+  const scroll = body.scrollTop
+  expect(scroll).toBe(24)
+  const before = m.q("[data-oco-runtime-sub-panel] section")!
+  for (let i = 1; i <= 3; i++) {
+    m.setT(KF.k03 + i * 150)
+    expect(m.q("[data-oco-runtime-sub-panel]")).toBe(panel)
+    expect(m.q("[data-oco-runtime-sub-panel] section")).toBe(before)
+    expect(body.scrollTop).toBe(scroll)
+    expect(document.activeElement).toBe(close)
+    m.qa("[data-oco-runtime-sub-cell]").forEach((c, j) => expect(c).toBe(cells[j]))
+  }
+})
+
+test("the strip is a button with aria-expanded only when the session has dispatched subagents", () => {
+  const none = mount(KF.j01)
+  const s0 = none.q("[data-oco-runtime-subs-strip]")!
+  expect(s0).toBeTruthy()
+  expect(s0.hasAttribute("role")).toBe(false)
+  expect(s0.hasAttribute("aria-expanded")).toBe(false)
+  expect(s0.hasAttribute("tabindex")).toBe(false)
+  s0.click()
+  expect(none.q("[data-oco-runtime-sub-panel]")).toBeNull()
+
+  const some = mount(KF.k10)
+  const s1 = some.q("[data-oco-runtime-subs-strip]")!
+  expect(s1.getAttribute("role")).toBe("button")
+  expect(s1.getAttribute("aria-expanded")).toBe("false")
+  s1.click()
+  expect(s1.getAttribute("aria-expanded")).toBe("true")
+})
+
+test("the selected probe hit target carries -probe-selected=true", () => {
+  const m = mount(KF.k03)
+  const probes = m.qa("[data-oco-runtime-probe]")
+  expect(probes.length).toBeGreaterThan(0)
+  for (const p of probes) {
+    expect(p.getAttribute("role")).toBe("button")
+    expect(p.getAttribute("data-oco-runtime-probe-selected")).toBe("false")
+    expect(["queued", "running", "docked", "absorbed"]).toContain(p.getAttribute("data-oco-runtime-probe-stage")!)
+  }
+  const target = probes[probes.length - 1]
+  const uid = target.getAttribute("data-oco-runtime-probe")!
+  target.click()
+  expect(target.getAttribute("data-oco-runtime-probe-selected")).toBe("true")
+  for (const p of m.qa("[data-oco-runtime-probe]"))
+    if (p !== target) expect(p.getAttribute("data-oco-runtime-probe-selected")).toBe("false")
+  expect(m.q("[data-oco-runtime-sub-panel]")).toBeTruthy()
+  key(document.activeElement!, "Escape")
+  expect(document.activeElement?.getAttribute("data-oco-runtime-probe")).toBe(uid)
+})
+
+test("D18: a rejected child tool call is a neutral ⊘ row, never the error colour", () => {
+  const index = structuredClone(INDEX)
+  const sub = index.subs.find((s) => s.round === 3 && s.num === 1)!
+  const act = sub.child!.acts.find((a) => a.kind === "tool")!
+  if (act.kind !== "tool") throw new Error("fixture: no child tool call")
+  act.tool.declined = "rejected"
+  act.tool.status = "error"
+  act.tool.error = "The user rejected permission to use this specific tool call."
+  const m = mount(KF.k04, index)
+  m.cellOf(1).click()
+  const li = m.qa("[data-oco-runtime-sub-panel] li").find((el) => el.textContent?.includes("⊘"))!
+  expect(li).toBeTruthy()
+  expect(li.textContent).toContain(text.t("ring.tools.row.rejected"))
+  expect(li.textContent).not.toContain("✗")
+  expect(li.style.getPropertyValue("border-left-color")).toBe("var(--rt-faint)")
+  for (const el of [li, ...li.querySelectorAll<HTMLElement>("*")]) expect(el.getAttribute("style") ?? "").not.toContain("--rt-err")
+  // a real failure elsewhere keeps the error colour (the cell and the panel are unaffected otherwise)
+  expect(m.q("[data-oco-runtime-sub-panel]")!.textContent).not.toContain(text.t("ring.sub.state.err"))
+})
+
+test("D18: a real child tool failure keeps the red ✗ row (only declined calls are neutral)", () => {
+  const index = structuredClone(INDEX)
+  const sub = index.subs.find((s) => s.round === 3 && s.num === 1)!
+  const act = sub.child!.acts.find((a) => a.kind === "tool")!
+  if (act.kind !== "tool") throw new Error("fixture: no child tool call")
+  act.tool.declined = undefined
+  act.tool.status = "error"
