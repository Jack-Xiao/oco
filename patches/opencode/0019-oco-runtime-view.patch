+          </Index>
+          <g class={animated() ? undefined : breathe}>
+            <circle
+              data-oco-runtime-core-ring
+              class={moving("oco-loop-spin")}
+              cx={hub()[0]}
+              cy={hub()[1]}
+              r={geo().r + 8}
