+// oco (patches/opencode/0019): pure predicates for runtime-view actions.
+import type { ChildLifecycle, Evidence, RuntimeModel, RuntimeTool } from "./session-runtime-model"
+
+export type AutoSyncTool = { sessionID?: string; turn: number }
+
+/**
+ * Child sessions to `sync` for the current turn.
+ * Skips a missing session id, other turns, and ids already requested. Caps the turn's total at `limit` (default 8):
+ * `autoSynced` is how many this turn has already auto-synced, so repeated calls never exceed the cap.
+ * Does not mutate `already`.
+ */
+export function autoSyncTargets(
+  tools: readonly AutoSyncTool[],
+  lastTurn: number | undefined,
+  already: ReadonlySet<string>,
+  limit = 8,
+  autoSynced = 0,
+): string[] {
+  limit -= autoSynced
+  if (lastTurn === undefined || limit <= 0) return []
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const tool of tools) {
+    if (out.length >= limit) break
+    const id = tool.sessionID
+    if (!id || tool.turn !== lastTurn) continue
+    if (already.has(id) || seen.has(id)) continue
+    seen.add(id)
+    out.push(id)
+  }
+  return out
+}
+
+/** In-progress child lifecycles. A collapsed child in one of these stays pinned; terminal ones do not. */
+const PIN_LIFECYCLE: ReadonlySet<string> = new Set(["running", "retrying", "waiting-user"])
+
+export type PinTool = { sessionID?: string; lifecycle: string }
+
+/** Sessions to pin: every expanded id, plus in-progress children. Deduped. No id means skip. */
+export function pinTargets(tools: readonly PinTool[], expanded: ReadonlySet<string>): string[] {
+  const out: string[] = []
+  const seen = new Set<string>()
+  const add = (id: string | undefined) => {
+    if (!id || seen.has(id)) return
+    seen.add(id)
+    out.push(id)
+  }
+  for (const id of expanded) add(id)
+  for (const tool of tools) if (PIN_LIFECYCLE.has(tool.lifecycle)) add(tool.sessionID)
+  return out
+}
+
+/** Countdown for a retry `next` timestamp. due when next - now <= 0; otherwise whole seconds, rounded up. */
+export function retryWait(next: number, now: number): { due: boolean; seconds: number } {
+  const delta = next - now
+  if (delta <= 0) return { due: true, seconds: 0 }
+  return { due: false, seconds: Math.ceil(delta / 1000) }
+}
+
+export type PinDiff = {
+  pin: string[]
+  unpin: string[]
+}
+
+/**
+ * Computes incremental diff between previous and next sets of pinned session IDs.
+ * - `pin`: IDs in next but not in prev
+ * - `unpin`: IDs in prev but not in next
+ */
+export function pinDiff(prev: Iterable<string>, next: Iterable<string>): PinDiff {
+  const prevSet = prev instanceof Set ? (prev as Set<string>) : new Set(prev)
+  const nextSet = next instanceof Set ? (next as Set<string>) : new Set(next)
+  const pin: string[] = []
+  const unpin: string[] = []
+  for (const id of nextSet) {
+    if (!prevSet.has(id)) pin.push(id)
+  }
+  for (const id of prevSet) {
+    if (!nextSet.has(id)) unpin.push(id)
+  }
+  return { pin, unpin }
+}
+
+export type ChildToolLike = { id: string; child?: { sessionID?: string } }
+
+/**
+ * Computes the set of tool IDs that are the last row referencing each child session.
+ * When multiple task rows reference the same child session, only the last row renders
+ * the expand/collapse toggle and the expanded child panel.
+ */
+export function lastChildToolIds(tools: readonly ChildToolLike[]): Set<string> {
+  const lastForSession = new Map<string, string>()
+  for (const tool of tools) {
+    const sessionID = tool.child?.sessionID
+    if (sessionID) {
+      lastForSession.set(sessionID, tool.id)
+    }
+  }
+  return new Set(lastForSession.values())
+}
+
+export type TreeNode = {
+  sessionID: string
+  parent: string
+  depth: number
+  order: number
+  current: boolean
+  lifecycle: ChildLifecycle
+}
+
+/**
+ * Builds a breadth-first list of descendant session tree nodes starting from the root tools.
+ * Traverses loaded child models up to maxDepth (default 8).
+ * Avoids cycles by tracking the ancestor chain and terminates on any duplicate/cycle.
+ * "current" is determined by Ruling 7: task tool belongs to parent's last request or lifecycle is running|retrying|waiting-user.
+ */
+export function treeNodes(
+  rootTools: RuntimeTool[],
+  childModel: (sessionID: string) => RuntimeModel | undefined,
+  maxDepth = 8,
+): TreeNode[] {
+  if (maxDepth < 1) return []
+
+  const result: TreeNode[] = []
+  const depthOrder = new Map<number, number>()
+  const allVisited = new Set<string>()
+
+  const extractChildTools = (tools: readonly RuntimeTool[]): RuntimeTool[] => {
+    const lastForSession = new Map<string, RuntimeTool>()
+    for (const tool of tools) {
+      const sessionID = tool.child?.sessionID
+      if (sessionID) {
+        lastForSession.set(sessionID, tool)
+      }
+    }
+    const out: RuntimeTool[] = []
+    const seen = new Set<string>()
+    for (const tool of tools) {
+      const sessionID = tool.child?.sessionID
+      if (sessionID && !seen.has(sessionID) && lastForSession.get(sessionID) === tool) {
+        seen.add(sessionID)
+        out.push(tool)
+      }
+    }
+    return out
+  }
+
+  const rootLastReq = rootTools.length > 0 ? Math.max(...rootTools.map((t) => t.request)) : -1
+
+  type QueueItem = {
+    sessionID: string
+    parent: string
+    depth: number
+    tool: RuntimeTool
+    ancestors: Set<string>
+  }
+
+  const queue: QueueItem[] = []
+
+  const rootChildTools = extractChildTools(rootTools)
+  for (const tool of rootChildTools) {
+    const sessionID = tool.child!.sessionID!
+    if (allVisited.has(sessionID)) continue
+    allVisited.add(sessionID)
+    queue.push({
+      sessionID,
+      parent: "",
+      depth: 1,
+      tool,
+      ancestors: new Set([sessionID]),
+    })
+  }
+
+  while (queue.length > 0) {
+    const item = queue.shift()!
+    const order = depthOrder.get(item.depth) ?? 0
+    depthOrder.set(item.depth, order + 1)
+
+    const lifecycle = item.tool.child?.lifecycle ?? "unknown"
+    let isCurrent = PIN_LIFECYCLE.has(lifecycle)
+    if (!isCurrent) {
+      if (item.depth === 1) {
+        isCurrent = rootLastReq >= 0 && item.tool.request === rootLastReq
+      } else {
+        const parentM = childModel(item.parent)
+        if (parentM) {
+          const parentLastReq =
+            parentM.requests.length > 0
+              ? parentM.requests[parentM.requests.length - 1].index
+              : parentM.tools.length > 0
+                ? Math.max(...parentM.tools.map((t) => t.request))
+                : -1
+          isCurrent = parentLastReq >= 0 && item.tool.request === parentLastReq
+        }
+      }
+    }
+
+    result.push({
+      sessionID: item.sessionID,
+      parent: item.parent,
+      depth: item.depth,
+      order,
+      current: isCurrent,
+      lifecycle,
+    })
+
+    if (item.depth < maxDepth) {
+      const model = childModel(item.sessionID)
+      if (model) {
+        const childTools = extractChildTools(model.tools)
+        for (const childTool of childTools) {
+          const cID = childTool.child!.sessionID!
+          if (item.ancestors.has(cID) || allVisited.has(cID)) {
+            continue
+          }
+          allVisited.add(cID)
+          const nextAncestors = new Set(item.ancestors)
+          nextAncestors.add(cID)
+          queue.push({
+            sessionID: cID,
+            parent: item.sessionID,
+            depth: item.depth + 1,
+            tool: childTool,
+            ancestors: nextAncestors,
+          })
+        }
+      }
+    }
+  }
+
+  return result
+}
+
+/**
+ * Targets to auto-sync for the current turn across the whole session tree.
+ * Filters for current and not yet done, sorted by depth ascending, then order ascending (near-root first).
+ * Caps at limit (default 8).
+ */
+export function treeSyncTargets(nodes: readonly TreeNode[], done: ReadonlySet<string>, limit = 8): string[] {
+  if (limit <= 0) return []
+  const filtered = nodes.filter((n) => n.current && !done.has(n.sessionID))
+  filtered.sort((a, b) => a.depth - b.depth || a.order - b.order)
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const node of filtered) {
+    if (out.length >= limit) break
+    if (!seen.has(node.sessionID)) {
+      seen.add(node.sessionID)
+      out.push(node.sessionID)
+    }
+  }
+  return out
+}
+
+/**
+ * Sessions to pin across the entire tree: every expanded session plus any descendant
+ * with in-progress lifecycle (running | retrying | waiting-user). Deduped.
+ */
+export function treePinTargets(nodes: readonly TreeNode[], open: ReadonlySet<string>): string[] {
+  const out: string[] = []
+  const seen = new Set<string>()
+  const add = (id: string | undefined) => {
+    if (!id || seen.has(id)) return
+    seen.add(id)
+    out.push(id)
+  }
+  for (const id of open) add(id)
+  for (const node of nodes) {
+    if (PIN_LIFECYCLE.has(node.lifecycle)) {
+      add(node.sessionID)
+    }
+  }
+  return out
+}
+
+export const FOCUS =
+  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-border-focus"
+
+export const BTN = `h-6 px-2 rounded-[5px] text-12-medium bg-surface-inset-base text-text-base disabled:opacity-50 ${FOCUS}`
+
+export type ToolDetailInfo = {
+  callID: string
+  start?: number
+  end?: number
+  duration?: number
+  startText: string
+  endText: string
+  durationText: string
+  evidence?: Evidence
+  error?: string
+  sessionID?: string
+}
+
+export function toolDetail(
+  tool: RuntimeTool,
+  t?: (key: any, params?: any) => string,
+  locale?: string,
+): ToolDetailInfo {
+  const unknown = t ? t("tool.detail.unknown") : "未知"
+  const start = tool.start
+  const end = tool.end
+  const hasStart = typeof start === "number" && !isNaN(start)
+  const hasEnd = typeof end === "number" && !isNaN(end)
+  const duration = hasStart && hasEnd ? Math.max(0, end - start) : undefined
+
+  const formatTime = (ts: number) => {
+    try {
+      return new Date(ts).toLocaleTimeString(locale)
+    } catch {
+      return new Date(ts).toISOString()
+    }
+  }
+
+  const formatDur = (ms: number) => {
+    if (ms < 1000) return `${ms} ms`
+    const sec = (ms / 1000).toFixed(1)
+    const cleanSec = sec.endsWith(".0") ? sec.slice(0, -2) : sec
+    return t ? t("ago.seconds", { value: cleanSec }) : `${cleanSec} s`
+  }
+
+  const startText = hasStart ? formatTime(start!) : unknown
+  const endText = hasEnd ? formatTime(end!) : unknown
+  const durationText = duration !== undefined ? formatDur(duration) : unknown
+
+  const evidence = tool.child?.evidence ?? (tool.interrupted ? "inferred" : undefined)
+
+  let error: string | undefined
+  if (tool.state === "error") {
+    error =
+      tool.lastOutput ||
+      (tool.cancelled ? (t ? t("tool.cancelled") : "Cancelled") : t ? t("tool.state.error") : "Failed")
+  }
+
+  const sessionID = tool.child?.sessionID
+
+  return {
+    callID: tool.callID,
+    start,
+    end,
+    duration,
+    startText,
+    endText,
+    durationText,
+    evidence,
+    error,
+    sessionID,
+  }
+}
diff --git a/packages/app/src/components/session/session-runtime-child-sync.ts b/packages/app/src/components/session/session-runtime-child-sync.ts
new file mode 100644
index 0000000..93e625a
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-child-sync.ts
@@ -0,0 +1,164 @@
+// oco (patches/opencode/0019): reactive wiring for whole-tree child auto-sync and pinning.
+import type { Accessor } from "solid-js"
+import { createEffect, createMemo, createSignal, onCleanup, untrack } from "solid-js"
+import { pinDiff, treeNodes, treePinTargets, treeSyncTargets } from "./session-runtime-actions"
+import type { RuntimeModel, RuntimeTool } from "./session-runtime-model"
+
+export type ChildSyncDeps = {
+  sync: (sessionID: string) => Promise<unknown>
+  pin: (sessionID: string) => void
+  unpin: (sessionID: string) => void
+  childModel: (sessionID: string) => RuntimeModel | undefined
+  turn: Accessor<number | undefined>
+  open: Accessor<ReadonlySet<string>>
+  tools: Accessor<RuntimeTool[]>
+  limit?: number
+  /** Children the replay needs (the round under the playhead). Each id is requested once; at most `limit` new ids
+   *  per distinct list. A failed one lands in `failed` and waits for an explicit `requestSync`. Never pinned. */
+  replayTargets?: Accessor<readonly string[]>
+}
+
+export type ChildSync = {
+  requestSync: (sessionID: string) => void
+  synced: ReadonlySet<string>
+  failed: ReadonlySet<string>
+  /** Bumps whenever `failed` changes, so views can show a failed child and offer a retry. */
+  failedVersion: Accessor<number>
+  pinned: Accessor<string[]>
+}
+
+export function createChildSync(deps: ChildSyncDeps): ChildSync {
+  const synced = new Set<string>()
+  const failed = new Set<string>()
+  const [failedVersion, setFailedVersion] = createSignal(0)
+
+  const requestSync = (id: string) => {
+    synced.add(id)
+    if (failed.delete(id)) setFailedVersion((n) => n + 1)
+    void Promise.resolve(deps.sync(id)).catch(() => {
+      failed.add(id)
+      setFailedVersion((n) => n + 1)
+    })
+  }
+
+  let autoTurn: number | undefined
+  let autoCount = 0
+
+  createEffect(() => {
+    const currentTurn = deps.turn()
+    if (currentTurn !== autoTurn) {
+      autoTurn = currentTurn
+      autoCount = 0
+    }
+    if (currentTurn === undefined) return
+
+    const rootTools = deps.tools()
+    const nodes = treeNodes(rootTools, deps.childModel)
+    const remainingLimit = (deps.limit ?? 8) - autoCount
+    if (remainingLimit > 0) {
+      const targets = treeSyncTargets(nodes, synced, remainingLimit)
+      autoCount += targets.length
+      untrack(() => {
+        for (const id of targets) {
+          requestSync(id)
+        }
+      })
+    }
+  })
+
+  // A child that finished before its updates were subscribed keeps stale messages, so its lifecycle reads
+  // "unknown" (status idle, last assistant message not completed). Once its task row has settled, load it
+  // one more time. At most one extra load per child.
+  const resynced = new Set<string>()
+  createEffect(() => {
+    const stale = deps
+      .tools()
+      .filter(
+        (t) =>
+          t.child?.sessionID &&
+          t.child.lifecycle === "unknown" &&
+          (t.state === "completed" || t.state === "error") &&
+          synced.has(t.child.sessionID) &&
+          !resynced.has(t.child.sessionID),
+      )
+      .map((t) => t.child!.sessionID!)
+    if (!stale.length) return
+    untrack(() => {
+      for (const id of stale) {
+        resynced.add(id)
+        requestSync(id)
+      }
+    })
+  })
+
+  const replayTargets = deps.replayTargets
+  if (replayTargets) {
+    let replayKey: string | undefined
+    let replayCount = 0
+    createEffect(() => {
+      const targets = replayTargets()
+      const key = targets.join("\n")
+      if (key !== replayKey) {
+        replayKey = key
+        replayCount = 0
+      }
+      const room = (deps.limit ?? 8) - replayCount
+      if (room <= 0) return
+      const ids = [...new Set(targets)].filter((id) => !synced.has(id)).slice(0, room)
+      if (!ids.length) return
+      replayCount += ids.length
+      untrack(() => {
+        for (const id of ids) requestSync(id)
+      })
+    })
+  }
+
+  let prevOpen = new Set<string>()
+  createEffect(() => {
+    const currentOpen = deps.open()
+    for (const id of currentOpen) {
+      if (!prevOpen.has(id)) {
+        if (!synced.has(id) || failed.has(id) || deps.childModel(id) === undefined) {
+          requestSync(id)
+        }
+      }
+    }
+    prevOpen = new Set(currentOpen)
+  })
+
+  const pinned = createMemo(
+    () => {
+      const rootTools = deps.tools()
+      const nodes = treeNodes(rootTools, deps.childModel)
+      return treePinTargets(nodes, deps.open())
+    },
+    [] as string[],
+    { equals: (prev, next) => prev.length === next.length && prev.every((id, index) => id === next[index]) },
+  )
+
+  let lastPinned = new Set<string>()
+  createEffect(() => {
+    const nextIds = pinned()
+    untrack(() => {
+      const { pin, unpin } = pinDiff(lastPinned, nextIds)
+      for (const id of unpin) deps.unpin(id)
+      for (const id of pin) deps.pin(id)
+      lastPinned = new Set(nextIds)
+    })
+  })
+
+  onCleanup(() => {
+    untrack(() => {
+      for (const id of lastPinned) deps.unpin(id)
+      lastPinned.clear()
+    })
+  })
+
+  return {
+    requestSync,
+    synced,
+    failed,
+    failedVersion,
+    pinned,
+  }
+}
diff --git a/packages/app/src/components/session/session-runtime-events.test.ts b/packages/app/src/components/session/session-runtime-events.test.ts
