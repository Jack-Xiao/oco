+++ b/packages/app/src/components/session/session-runtime-step-times.test.ts
@@ -0,0 +1,82 @@
+// oco (patches/opencode/0019): M5 ring — step times side table (D21).
+import { afterEach, describe, expect, test } from "bun:test"
+import {
+  addStepPart,
+  clearStepTimes,
+  lastStepFinish,
+  recordStepPart,
+  snapStepTime,
+  stepCount,
+  stepTimesOf,
+} from "./session-runtime-step-times"
+import type { RingStepTimes } from "./session-runtime-ring-types"
+import { idTime } from "./session-trajectory-model"
+
+const T0 = 1_790_000_000_000
+// a part id whose idTime is `ms` (same layout as the server's ascending ids)
+const idAt = (ms: number, n = 0) => `prt_${((ms % 2 ** 36) * 0x1000 + n).toString(16).padStart(12, "0")}abcdefghijklmn`
+const tokens = { total: 30, input: 10, output: 15, reasoning: 5, cache: { read: 0, write: 0 } }
+const start = (ms: number, n = 0, messageID = "msg_a", sessionID = "ses_a") => ({
+  id: idAt(ms, n), type: "step-start", sessionID, messageID,
+})
+const finish = (ms: number, n = 0, reason = "stop", messageID = "msg_a", sessionID = "ses_a") => ({
+  id: idAt(ms, n), type: "step-finish", sessionID, messageID, reason, cost: 0.01, tokens,
+})
+
+afterEach(() => clearStepTimes())
+
+describe("step times side table (D21)", () => {
+  test("ignores every part type but step-start / step-finish", () => {
+    for (const type of ["text", "reasoning", "tool", "patch", "file"]) recordStepPart({ id: idAt(T0), type, sessionID: "ses_a", messageID: "msg_a" })
+    expect(stepTimesOf("ses_a")).toBeUndefined()
+    const table = new Map<string, RingStepTimes>()
+    expect(addStepPart(table, { id: idAt(T0), type: "text", sessionID: "s", messageID: "m" }, T0)).toBe(false)
+    expect(table.size).toBe(0)
+  })
+
+  test("step-start: time = idTime(part.id); idempotent; the earliest start wins", () => {
+    recordStepPart(start(T0 + 300), T0)
+    recordStepPart(start(T0 + 300), T0)
+    expect(stepTimesOf("ses_a")!.get("msg_a")).toEqual({ start: T0 + 300, finishes: [] })
+    expect(stepTimesOf("ses_a")!.get("msg_a")!.start).toBe(idTime(idAt(T0 + 300), T0)!)
+    recordStepPart(start(T0 + 900, 1), T0)
+    recordStepPart(start(T0 + 100, 2), T0)
+    expect(stepTimesOf("ses_a")!.get("msg_a")!.start).toBe(T0 + 100)
+  })
+
+  test("step-finish: one entry per part id, receipt fields kept, ascending by part id; repeats replace", () => {
+    recordStepPart(finish(T0 + 2000, 0, "tool-calls"), T0)
+    recordStepPart(finish(T0 + 1000, 0, "stop"), T0)
+    recordStepPart(finish(T0 + 2000, 0, "tool-calls"), T0)
+    const rec = stepTimesOf("ses_a")!.get("msg_a")!
+    expect(rec.finishes.map((f) => [f.at, f.reason])).toEqual([[T0 + 1000, "stop"], [T0 + 2000, "tool-calls"]])
+    expect(rec.finishes[0]).toEqual({ partID: idAt(T0 + 1000), at: T0 + 1000, reason: "stop", cost: 0.01, tokens })
+    expect(lastStepFinish(rec)!.reason).toBe("tool-calls")
+    expect(stepCount(rec)).toBe(2)
+    recordStepPart(start(T0 + 50), T0)
+    expect(stepCount(rec)).toBe(3)
+    expect(stepCount(undefined)).toBe(0)
+  })
+
+  test("sessions and messages are kept apart; clearStepTimes drops one or all", () => {
+    recordStepPart(start(T0, 0, "msg_a", "ses_a"), T0)
+    recordStepPart(start(T0 + 5, 0, "msg_b", "ses_a"), T0)
+    recordStepPart(start(T0 + 9, 0, "msg_c", "ses_b"), T0)
+    expect([...stepTimesOf("ses_a")!.keys()]).toEqual(["msg_a", "msg_b"])
+    expect(stepTimesOf("ses_b")!.get("msg_c")!.start).toBe(T0 + 9)
+    clearStepTimes("ses_a")
+    expect(stepTimesOf("ses_a")).toBeUndefined()
+    expect(stepTimesOf("ses_b")).toBeDefined()
+    clearStepTimes()
+    expect(stepTimesOf("ses_b")).toBeUndefined()
+  })
+
+  test("snapStepTime: a time recorded near any clock re-reads as idTime(id, created)", () => {
+    const id = idAt(T0 + 777)
+    for (const near of [T0, T0 + 2 ** 35 - 1, T0 - 2 ** 35 + 1, T0 + 3 * 2 ** 36, Date.now()]) {
+      const rec = idTime(id, near)!
+      expect(snapStepTime(rec, T0 + 500)).toBe(idTime(id, T0 + 500)!)
+      expect(snapStepTime(rec, T0 + 500)).toBe(T0 + 777)
+    }
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-step-times.ts b/packages/app/src/components/session/session-runtime-step-times.ts
new file mode 100644
index 0000000..3008106
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-step-times.ts
@@ -0,0 +1,79 @@
+// oco (patches/opencode/0019): M5 ring — step times side table (D21). The app's sync layer drops step-start /
+// step-finish parts (SKIP_PARTS in context/global-sync/event-reducer.ts and context/server-session.ts). At those 4 drop
+// points the part is first handed to recordStepPart, which keeps its time (and the step-finish receipt) here, keyed
+// sessionID -> messageID. The parts arrays and every other consumer are unchanged; the ring reads this table through
+// RingSource.steps, so live events and REST history (a reopened session) feed it the same way.
+import type { RingStepFinish, RingStepTimes } from "./session-runtime-ring-types"
+import { idTime } from "./session-trajectory-model"
+
+type StepLike = { id: string; type: string; sessionID: string; messageID: string }
+type FinishLike = StepLike & { reason?: string; cost?: number; tokens?: RingStepFinish["tokens"] }
+
+const ID_PERIOD = 2 ** 36 // same period as idTime in session-trajectory-model.ts
+const ZERO: RingStepFinish["tokens"] = { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } }
+const TABLES = new Map<string, Map<string, RingStepTimes>>()
+
+/** Pure core: adds one step part to `table` (messageID -> record). Idempotent: a step-start keeps the earliest time,
+ *  a step-finish is keyed by its part id (a repeat replaces it). Other part types are ignored (returns false). */
+export function addStepPart(table: Map<string, RingStepTimes>, part: StepLike, near = Date.now()): boolean {
+  if (part.type !== "step-start" && part.type !== "step-finish") return false
+  const at = idTime(part.id, near)
+  if (at === undefined) return false
+  let rec = table.get(part.messageID)
+  if (!rec) table.set(part.messageID, (rec = { finishes: [] }))
+  if (part.type === "step-start") {
+    if (rec.start === undefined || at < rec.start) rec.start = at
+    return true
+  }
+  const p = part as FinishLike
+  const fin: RingStepFinish = { partID: p.id, at, reason: p.reason ?? "", cost: p.cost ?? 0, tokens: p.tokens ?? ZERO }
+  const i = rec.finishes.findIndex((f) => f.partID === p.id)
+  if (i >= 0) rec.finishes[i] = fin
+  else {
+    rec.finishes.push(fin)
+    rec.finishes.sort((a, b) => (a.partID < b.partID ? -1 : a.partID > b.partID ? 1 : 0))
+  }
+  return true
+}
+
+/** Called at the sync layer's drop points with every part it sees; only step-start / step-finish are kept. */
+export function recordStepPart(part: StepLike, near?: number): void {
+  if (part.type !== "step-start" && part.type !== "step-finish") return
+  let table = TABLES.get(part.sessionID)
+  if (!table) TABLES.set(part.sessionID, (table = new Map()))
+  addStepPart(table, part, near)
+}
+
+/** Read-only view of one session's table (messageID -> record); undefined before its first step part. */
+export function stepTimesOf(sessionID: string): ReadonlyMap<string, Readonly<RingStepTimes>> | undefined {
+  return TABLES.get(sessionID)
+}
+
+/** Drops one session's table, or every table without an argument. */
+export function clearStepTimes(sessionID?: string) {
+  if (sessionID === undefined) TABLES.clear()
+  else TABLES.delete(sessionID)
+}
+
+/** Re-reads a recorded time near `near` (message.time.created): equals idTime(part.id, near) for the part it came
+ *  from, whatever `near` was used when it was recorded. */
+export function snapStepTime(at: number, near: number): number {
+  const low = ((at % ID_PERIOD) + ID_PERIOD) % ID_PERIOD
+  let t = near - (near % ID_PERIOD) + low
+  if (t - near > ID_PERIOD / 2) t -= ID_PERIOD
+  if (near - t > ID_PERIOD / 2) t += ID_PERIOD
+  return t
+}
+
+/** Count of what a record holds (request reuse in the ring compares it, D11). */
+export function stepCount(rec: RingStepTimes | undefined): number {
+  return rec ? (rec.start !== undefined ? 1 : 0) + rec.finishes.length : 0
+}
+
+/** The step-finish with the latest time (the parts path takes the last step-finish part). */
+export function lastStepFinish(rec: RingStepTimes | undefined): RingStepFinish | undefined {
+  if (!rec) return
+  let out: RingStepFinish | undefined
+  for (const f of rec.finishes) if (!out || f.at >= out.at) out = f
+  return out
+}
diff --git a/packages/app/src/components/session/session-runtime.tsx b/packages/app/src/components/session/session-runtime.tsx
new file mode 100644
index 0000000..c6a2426
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime.tsx
@@ -0,0 +1,1217 @@
+// oco (patches/opencode/0019): 对话 / 轨迹 / 运行 — the runtime view.
+// M5 (2026-10-08): top bar / stage (ring) / caption line / status bar. The ring index is rebuilt at most every
+// RING.REBUILD_MS from a dirty-session set (D11); the frame at the visual t is recomputed per animation frame into a
+// reconciled store, so the views only touch the DOM that changed.
+import { createEffect, createMemo, createSignal, For, on, onCleanup, onMount, Show, untrack } from "solid-js"
+import type { Accessor, JSX } from "solid-js"
+import { createStore, reconcile, unwrap } from "solid-js/store"
+import type { Message, Part } from "@opencode-ai/sdk/v2/client"
+import { useSync } from "@/context/sync"
+import { useSDK } from "@/context/sdk"
+import { useServerSync } from "@/context/server-sync"
+import { useLanguage } from "@/context/language"
+import { useProviders } from "@/hooks/use-providers"
+import { getSessionContext } from "./session-context-metrics"
+import { trajectoryText } from "./session-trajectory-i18n"
+import { buildTrajectory } from "./session-trajectory-model"
+import { SessionViewToggle, type SessionViewMode } from "./session-trajectory"
+import { runtimeText, type RuntimeText } from "./session-runtime-i18n"
+import {
+  buildRuntime,
+  collectTreeRequests,
+  eventSessionID,
+  mergeFreshness,
+  treeSessionIDs,
+  type ChildLifecycle,
+  type RuntimeEvent,
+  type RuntimeModel,
+} from "./session-runtime-model"
+import { nextSpeed, playAdvance, playbackKey, playStartV, type PlaybackSpeed } from "./session-runtime-playback"
+import { FOCUS } from "./session-runtime-actions"
+import { createChildSync } from "./session-runtime-child-sync"
+import { buildRingIndex, frameAt, liveTime, roundAt, trackInputOf } from "./session-runtime-ring"
+import { stepTimesOf } from "./session-runtime-step-times"
+import { navStep, trackMap } from "./session-runtime-ring-track"
+import { RingTrack } from "./session-runtime-ring-track-view"
+import { RingView } from "./session-runtime-ring-view"
+import {
+  RING,
+  type Phrase,
+  type RingFrame,
+  type RingIndex,
+  type RingLiveInput,
+  type RingSource,
+  type RingStage,
+  type Tone,
+} from "./session-runtime-ring-types"
+
+const emptyMessages: Message[] = []
+const emptyParts: Part[] = []
+
+const TONE: Record<Tone, string> = {
+  faint: "var(--rt-faint)",
+  main: "var(--rt-main)",
+  sub: "var(--rt-sub)",
+  tool: "var(--rt-tool)",
+  acc: "var(--rt-accent)",
+  text: "var(--rt-text)",
+  ok: "var(--rt-ok)",
+  attn: "var(--rt-attn)",
+  err: "var(--rt-err)",
+}
+
+// Status-bar legend (D18: failed and dismissed / rejected are two items; the latter is neutral grey, never red).
+const LEGEND: { key: Phrase["key"]; glyph: string; color: string }[] = [
+  { key: "ring.legend.think", glyph: "●", color: "var(--rt-accent)" },
+  { key: "ring.legend.run", glyph: "●", color: "var(--rt-main)" },
+  { key: "ring.legend.ok", glyph: "✓", color: "var(--rt-ok)" },
+  { key: "ring.legend.err", glyph: "✗", color: "var(--rt-err)" },
+  { key: "ring.legend.declined", glyph: "⊘", color: "var(--rt-weak)" },
+  { key: "ring.legend.attn", glyph: "●", color: "var(--rt-attn)" },
+]
+
+// Frame fields kept in the reconciled store; `stage` holds index objects (round / request) and lives in a signal.
+const FRAME_KEYS = ["t", "status", "counter", "model", "card", "pills", "you", "tools", "subs", "k", "dk", "caption", "live", "bar"] as const
+// every RingFrame field except stage must be listed above, or the view reads undefined for it
+const FRAME_KEYS_COMPLETE: Exclude<keyof RingFrame, "stage"> extends (typeof FRAME_KEYS)[number] ? true : never = true
+void FRAME_KEYS_COMPLETE
+type FrameRest = Omit<RingFrame, "stage">
+
+const sameStage = (a: RingStage, b: RingStage) =>
+  a.st === b.st &&
+  a.round === b.round &&
+  a.request === b.request &&
+  a.ask === b.ask &&
+  a.permission === b.permission &&
+  a.endAt === b.endAt &&
+  a.why === b.why &&
+  a.dismissed === b.dismissed &&
+  a.reason === b.reason
+
+const sameIds = (a: readonly string[], b: readonly string[]) => a.length === b.length && a.every((x, i) => x === b[i])
+
+const ago = (t: RuntimeText["t"], ms: number) => {
+  const s = Math.max(0, Math.round(ms / 1000))
+  if (s < 60) return t("ago.seconds", { value: s })
+  if (s < 3600) return t("ago.minutes", { value: Math.floor(s / 60) })
+  return t("ago.hours", { value: Math.floor(s / 3600) })
+}
+
+const eventText = (t: RuntimeText["t"], e: RuntimeEvent) => {
+  if (e.role === "model") return t(`event.${e.kind}` as "event.request.start")
+  // The user's own no (a rejected permission, a dismissed question) reads as that, not as a failure.
+  if (e.kind === "tool.rejected" || e.kind === "tool.dismissed") return t(`event.${e.kind}`, { label: e.label })
+  const kind = e.kind === "tool.start" ? "start" : e.kind === "tool.end" ? "end" : "error"
+  return t(`event.${e.role}.${kind}` as "event.tool.start", { label: e.label })
+}
+
+const sameRefs = (prev: readonly unknown[], next: readonly unknown[]) => {
+  if (prev.length !== next.length) return false
+  for (let i = 0; i < prev.length; i++) if (prev[i] !== next[i]) return false
+  return true
+}
+
+export function SessionRuntime(props: {
+  sessionID: string
+  onView: (view: SessionViewMode) => void
+  actions?: JSX.Element
+  onOpenSession?: (sessionID: string) => void
+}) {
+  const sync = useSync()
+  const sdk = useSDK()
+  const serverSync = useServerSync()
+  const providers = useProviders(() => sdk().directory)
+  const language = useLanguage()
+  const trajectory = trajectoryText(language)
+  const copy = runtimeText(language)
+  const t = copy.t
+
+  const [arrived, setArrived] = createSignal<number | undefined>()
+
+  const info = createMemo(() => sync().session.get(props.sessionID))
+  const messages = createMemo(() => (sync().data.message[props.sessionID] ?? emptyMessages) as Message[])
+  const parts = (messageID: string) => (sync().data.part[messageID] ?? emptyParts) as Part[]
+  const status = createMemo(() => sync().data.session_status[props.sessionID])
+  const busy = createMemo(() => (status()?.type ?? "idle") !== "idle")
+  const contextLimit = createMemo(() => getSessionContext(messages(), [...providers.all().values()])?.limit)
+
+  const treeIds = createMemo(() => treeSessionIDs(props.sessionID, sync().data.session))
+  const treeRequests = createMemo(
+    () => collectTreeRequests(props.sessionID, sync().data.session, sync().data.permission, sync().data.question),
+    { permissions: [], questions: [] } as ReturnType<typeof collectTreeRequests>,
+    {
+      equals: (prev, next) => sameRefs(prev.permissions, next.permissions) && sameRefs(prev.questions, next.questions),
+    },
+  )
+
+  const childMessagesOf = (id: string) => sync().data.message[id] as Message[] | undefined
+  const parentOfSession = (id: string) => sync().session.get(id)?.parentID
+
+  // D1: the M4 model is kept for live only — run state and alerts, background linking, the log, last event, evidence.
+  const assemble = (
+    view: { messages: Message[]; parts: (id: string) => Part[] },
+    scope?: {
+      sessionID: string
+      busy: boolean
+      status: ReturnType<typeof status>
+      permissions: ReturnType<typeof treeRequests>["permissions"]
+      questions: ReturnType<typeof treeRequests>["questions"]
+      contextLimit?: number
+    },
+  ) => {
+    const at = Date.now()
+    const built = buildTrajectory({
+      messages: view.messages,
+      parts: view.parts,
+      now: at,
+      busy: scope?.busy ?? busy(),
+      language: trajectory,
+    })
+    return buildRuntime(
+      {
+        mode: "live",
+        sessionID: scope?.sessionID ?? props.sessionID,
+        parts: view.parts,
+        status: scope ? scope.status : status(),
+        permissions: scope ? scope.permissions : treeRequests().permissions,
+        questions: scope ? scope.questions : treeRequests().questions,
+        childStatus: (id) => sync().data.session_status[id],
+        childMessages: childMessagesOf,
+        parentOf: parentOfSession,
+        requests: built.requests,
+        messages: view.messages,
+        contextLimit: scope ? scope.contextLimit : contextLimit(),
+      },
+      at,
+    )
+  }
+
+  const assembleChild = (sessionID: string) => {
+    const childMessages = (sync().data.message[sessionID] ?? emptyMessages) as Message[]
+    const childStatus = sync().data.session_status[sessionID]
+    const reqs = collectTreeRequests(sessionID, sync().data.session, sync().data.permission, sync().data.question)
+    return assemble(
+      { messages: childMessages, parts },
+      {
+        sessionID,
+        busy: (childStatus?.type ?? "idle") !== "idle",
+        status: childStatus,
+        permissions: reqs.permissions,
+        questions: reqs.questions,
+        contextLimit: getSessionContext(childMessages, [...providers.all().values()])?.limit,
+      },
+    )
+  }
+
+  const live = createMemo<RuntimeModel>(() => assemble({ messages: messages(), parts }))
+  const freshness = createMemo(() => mergeFreshness(live().freshness, arrived(), "live"))
+  const attention = createMemo(() => live().run.attention)
+
+  // ---------- entered subagents (D9) ----------
+  const [enteredStack, setEnteredStack] = createSignal<string[]>([])
+  const shownID = createMemo(() => enteredStack().at(-1) ?? props.sessionID)
+  const entered = () => enteredStack().length > 0
+  const openSet = createMemo<ReadonlySet<string>>(() => new Set(enteredStack()))
+  const shownModel = createMemo<RuntimeModel>(() => (shownID() === props.sessionID ? live() : assembleChild(shownID())))
+  const shownRequests = createMemo(() =>
+    shownID() === props.sessionID
+      ? treeRequests()
+      : collectTreeRequests(shownID(), sync().data.session, sync().data.permission, sync().data.question),
+  )
+
+  // ---------- ring index: data version, at most one rebuild per RING.REBUILD_MS (D11) ----------
+  const dirty = new Set<string>()
+  const [version, setVersion] = createSignal(0)
+  let lastBuild = -Infinity
+  let rebuildTimer: ReturnType<typeof setTimeout> | undefined
+  // Always deferred (after the store applied the event); a change while a rebuild is pending rides on that rebuild,
+  // so the last change is always followed by one more rebuild.
+  const markDirty = (id: string) => {
+    dirty.add(id)
+    if (rebuildTimer !== undefined) return
+    const wait = Math.max(0, lastBuild + RING.REBUILD_MS - performance.now())
+    rebuildTimer = setTimeout(() => {
+      rebuildTimer = undefined
+      setVersion((v) => v + 1)
+    }, wait)
+  }
+  onCleanup(() => {
+    if (rebuildTimer !== undefined) clearTimeout(rebuildTimer)
+  })
+
+  // Raw (unwrapped) store data: the index never holds store proxies and reading it does not subscribe.
+  const partsRaw = (messageID: string) => (unwrap(sync().data.part[messageID]) ?? emptyParts) as readonly Part[]
+  // D21: step-start / step-finish times of session `id` from the side table the sync layer fills at its drop points
+  const stepsOf = (id: string) => (messageID: string) => stepTimesOf(id)?.get(messageID)
+  const sourceOf = (id: string): RingSource | undefined => {
+    const list = sync().data.message[id]
+    return list ? { messages: unwrap(list) as readonly Message[], parts: partsRaw, steps: stepsOf(id) } : undefined
+  }
+  let prevIndex: RingIndex | undefined
+  let skew = 0
+  let indexed = 0 // messages of the shown session the current index was built from (history state below)
+  const index = createMemo<RingIndex>(() => {
+    version()
+    const sid = shownID()
+    return untrack(() => {
+      const reuse = prevIndex && prevIndex.sessionID === sid ? prevIndex : undefined
+      const src = sourceOf(sid) ?? { messages: emptyMessages, parts: partsRaw, steps: stepsOf(sid) }
+      const next = buildRingIndex(
+        { sessionID: sid, messages: src.messages, parts: src.parts, steps: src.steps, child: sourceOf, dirty: reuse ? new Set(dirty) : undefined },
+        reuse,
+      )
+      indexed = src.messages.length
+      dirty.clear()
+      lastBuild = performance.now()
+      prevIndex = next
+      skew = liveTime(Date.now(), next.lastAt, skew).skew
+      return next
+    })
+  })
+  // A first open (or an old session fetched over HTTP) can arrive without any SDK event. Tracks the length, not just
+  // the list: an older page (history.loadMore) is reconciled into the same store array, which leaves the list
+  // reference unchanged and fires no SDK event.
+  createEffect(() => {
+    const sid = shownID()
+    void sync().data.message[sid]?.length
+    markDirty(sid)
+  })
+
+  // A reopened session starts with only its newest page of messages, but the ring and the replay read the whole
+  // session. Same walk as the trajectory view (session-trajectory.tsx): page back until the history is complete.
+  // Differences: wait for the first sync (this view can mount before it lands), stop when the session changes,
+  // wait out a load that is already running (loadMore would return at once), swallow errors (best effort).
+  // Subagent sessions go through childSync below, not through this walk (their first page is the whole session
+  // unless a child has more than 20 messages).
+  // walk: "loading" while paging, "done" once the server reports no older page, "partial" when the walk gave up.
+  const [walk, setWalk] = createSignal<"loading" | "done" | "partial">("loading")
+  createEffect(
+    on(
+      () => props.sessionID,
+      async (id) => {
+        const history = sync().session.history
+        setWalk("loading")
+        try {
+          await sync().session.sync(id)
+          for (let i = 0; i < 100 && id === props.sessionID && history.more(id); i++) {
+            if (history.loading(id)) await new Promise((resolve) => setTimeout(resolve, 100))
+            else await history.loadMore(id)
+          }
+          if (id === props.sessionID) setWalk(history.more(id) ? "partial" : "done")
+        } catch {
+          // the replay shows what is loaded; the next mount tries again
+          if (id === props.sessionID) setWalk("partial")
+        }
+      },
+    ),
+  )
+  // data-oco-runtime-history: "done" only once the ring index was rebuilt from every loaded message (the rebuild is
+  // throttled, so the walk ending is not enough). Inside a subagent the walk state of the root is shown as is.
+  const historyState = createMemo(() => {
+    index()
+    const w = walk()
+    if (w !== "done" || shownID() !== props.sessionID) return w
+    return untrack(() => sync().data.message[props.sessionID]?.length ?? 0) === indexed ? "done" : "loading"
+  })
+
+  // ---------- clock (D11): visual t; live = wall + skew, replay = playhead ----------
+  const [now, setNow] = createSignal(Date.now())
+  const [mode, setMode] = createSignal<"live" | "replay">("live")
+  const [replayT, setReplayT] = createSignal(0)
+  const [frozenT1, setFrozenT1] = createSignal(0)
+  const [pausedAt, setPausedAt] = createSignal<number | undefined>()
+  const [playing, setPlaying] = createSignal(false)
+  const [speed, setSpeed] = createSignal<PlaybackSpeed>(1)
+  const [reduced, setReduced] = createSignal(false)
+  const [visible, setVisible] = createSignal(true)
+  const [stageW, setStageW] = createSignal(1200)
+  const [rootW, setRootW] = createSignal(1200)
+  const [geoMode, setGeoMode] = createSignal<"wide" | "narrow">()
+
+  const liveT = createMemo(() => {
+    index()
+    return now() + skew
+  })
+  const t1 = () => (mode() === "live" ? liveT() : frozenT1())
+  const vt = createMemo(() => (mode() === "live" ? liveT() : replayT()))
+  const trackIn = createMemo(() => trackInputOf(index(), t1()))
+  const map = createMemo(() => trackMap(trackIn()))
+  const t0 = () => trackIn().t0
+  const hasData = () => index().rounds.length > 0
+
+  // ---------- frame at t ----------
+  const liveInput = createMemo<RingLiveInput>(() => {
+    const sid = shownID()
+    const reqs = shownRequests()
+    const childAttention = new Set<string>()
+    const mark = (id: string) => {
+      let cur: string | undefined = id
+      for (let guard = 0; cur && cur !== sid && guard < 64; guard++) {
+        childAttention.add(cur)
+        cur = parentOfSession(cur)
+      }
+    }
+    for (const p of reqs.permissions) mark(p.sessionID)
+    for (const q of reqs.questions) mark(q.sessionID)
+    return {
+      run: shownModel().run.state,
+      permissions: reqs.permissions.map((p) => ({
+        id: p.id,
+        sessionID: p.sessionID,
+        permission: p.permission,
+        patterns: [...p.patterns],
+        callID: p.tool?.callID,
+      })),
+      childAttention,
+    }
+  })
+  const wide = () => stageW() >= RING.WIDE_MIN
+  const frameOpts = () => ({ live: mode() === "live" ? liveInput() : undefined, reduced: reduced(), wide: wide() })
+  const computeFrame = () => frameAt(index(), vt(), frameOpts())
+
+  const first = untrack(computeFrame)
+  const { stage: firstStage, ...firstRest } = first
+  const [store, setStore] = createStore<FrameRest>(structuredClone(firstRest))
+  const [stage, setStage] = createSignal<RingStage>(firstStage, { equals: sameStage })
+  createEffect(() => {
+    const { stage: s, ...rest } = computeFrame()
+    setStage(s)
+    // Cloned so reconcile never writes into index or store data; rows match by id (D11, D13).
+    setStore(reconcile(structuredClone(rest), { key: "id" }))
+  })
+  const frame = {} as RingFrame
+  for (const k of FRAME_KEYS) Object.defineProperty(frame, k, { enumerable: true, get: () => store[k] })
+  Object.defineProperty(frame, "stage", { enumerable: true, get: stage })
+  const frameAcc: Accessor<RingFrame> = () => frame
+
+  // ---------- playback ----------
