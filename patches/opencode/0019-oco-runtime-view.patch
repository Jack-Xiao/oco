+++ b/packages/app/test-browser/session-runtime-ring-view.test.tsx
@@ -0,0 +1,217 @@
+// oco (patches/opencode/0019): RingView mounted on the real-data fixture (Task 9): data attributes, tool-row node
+// identity across frames, focus back to the opener after the full-text overlay closes, no forbidden attribute names.
+import { afterEach, expect, mock, test } from "bun:test"
+import { existsSync } from "node:fs"
+import { createMemo, createSignal, type Accessor } from "solid-js"
+import { render } from "solid-js/web"
+import { runtimeText } from "../src/components/session/session-runtime-i18n"
+import { buildRingIndex, frameAt } from "../src/components/session/session-runtime-ring"
+import { loadM5Fixture } from "../src/components/session/session-runtime-ring.fixture"
+import type { RingFrame, RingGeo } from "../src/components/session/session-runtime-ring-types"
+
+// The subagent dock is Task 10's component. Only while that file does not exist yet is it replaced by an empty stub,
+// so this file never shadows the real module for other test files in the same process.
+const SUB_VIEW = new URL("../src/components/session/session-runtime-ring-sub-view.tsx", import.meta.url).pathname
+if (!existsSync(SUB_VIEW)) mock.module(SUB_VIEW, () => ({ RingSubView: () => null }))
+const { RingView } = await import("../src/components/session/session-runtime-ring-view")
+
+const text = runtimeText({ locale: () => "en", intl: () => "en-US" })
+const fixture = loadM5Fixture()
+const index = buildRingIndex(fixture.input)
+const at = (prefix: string) => {
+  const k = fixture.keyframes.find((x) => x.id.startsWith(prefix))
+  if (!k) throw new Error(`keyframe ${prefix} missing`)
+  return Number(k.t)
+}
+const FORBIDDEN = ["question", "reply", "stop", "roster", "stats", "attention"].map((s) => `data-oco-runtime-${s}`)
+
+const mounted: (() => void)[] = []
+afterEach(() => {
+  while (mounted.length) mounted.pop()!()
+})
+
+function mount(t0: number) {
+  const host = document.createElement("div")
+  document.body.appendChild(host)
+  const [t, setT] = createSignal(t0)
+  let frame!: Accessor<RingFrame>
+  let geo: RingGeo | undefined
+  const dispose = render(() => {
+    frame = createMemo(() => frameAt(index, t(), { reduced: false, wide: true }))
+    return (
+      <RingView
+        index={() => index}
+        frame={frame}
+        t={t}
+        mode={() => "replay"}
+        reduced={() => false}
+        text={text}
+        childLoad={() => "ready"}
+        onLoadChild={() => {}}
+        onRetryChild={() => {}}
+        onEnterChild={() => {}}
+        onGeo={(g) => (geo = g)}
+      />
+    )
+  }, host)
+  mounted.push(() => {
+    dispose()
+    host.remove()
+  })
+  return { host, setT, frame: () => frame(), geo: () => geo! }
+}
+
+const rowsShown = (f: RingFrame, g: RingGeo) => (f.tools.rows.length <= g.toolCap ? f.tools.rows.length : g.toolCap - 1)
+
+for (const id of ["k03", "k05", "k08"]) {
+  test(`${id}: card kind, tool rows and stage attributes follow frameAt`, () => {
+    const v = mount(at(id))
+    const f = v.frame()
+    const stage = v.host.querySelector("[data-oco-runtime-stage]")!
+    expect(stage.getAttribute("data-oco-runtime-stage")).toBe(f.stage.st)
+    expect(stage.getAttribute("data-oco-runtime-lane-k")).toBe((Math.round(f.k * 1000) / 1000).toFixed(3))
+    expect(v.host.querySelector("[data-oco-runtime-ring]")).not.toBeNull()
+
+    const card = v.host.querySelector("[data-oco-runtime-card]")!
+    expect(card.getAttribute("data-oco-runtime-card-kind")).toBe(f.card.kind)
+    expect(card.getAttribute("data-oco-runtime-card-tone")).toBe(f.card.tone)
+    for (const slot of ["route", "body"]) expect(card.querySelector(`[data-oco-runtime-card-${slot}]`)).not.toBeNull()
+    // the card itself is the full-text opener; its meta line moved to the overlay
+    expect(card.hasAttribute("data-oco-runtime-card-expand")).toBe(true)
+    expect(card.querySelector("[data-oco-runtime-card-meta]")).toBeNull()
+
+    const rows = [...v.host.querySelectorAll("[data-oco-runtime-tool-row]")]
+    // k03 / k05 have own tools in flight; k08's request only sent a question, so the dock shows its empty line
+    if (id === "k08") expect(f.tools.rows.length).toBe(0)
+    else expect(f.tools.rows.length).toBeGreaterThan(0)
+    expect(rows.length).toBe(rowsShown(f, v.geo()))
+    rows.forEach((el, i) => {
+      expect(el.getAttribute("data-oco-runtime-tool-row")).toBe(f.tools.rows[i].id)
+      expect(el.getAttribute("data-oco-runtime-tool-state")).toBe(f.tools.rows[i].state)
+    })
+
+    const counter = v.host.querySelector("[data-oco-runtime-counter]")!
+    expect(counter.getAttribute("data-oco-runtime-round")).toBe(String(f.counter.round))
+    expect(counter.getAttribute("data-oco-runtime-agent")).toBe(f.counter.agent)
+    const plan = v.host.querySelector("[data-oco-runtime-plan]")
+    if (f.counter.plan) expect(plan?.getAttribute("data-oco-runtime-plan")).toBe(`${f.counter.plan.done}/${f.counter.plan.total}`)
+    else expect(plan).toBeNull()
+
+    const pills = [...v.host.querySelectorAll("[data-oco-runtime-pill]")]
+    expect(pills.map((p) => p.getAttribute("data-oco-runtime-pill")).sort()).toEqual(["asm", "call", "next", "out", "think", "wait"])
+    for (const p of pills) {
+      const pid = p.getAttribute("data-oco-runtime-pill") as keyof RingFrame["pills"]
+      expect(p.getAttribute("data-oco-runtime-pill-lit")).toBe(String(f.pills[pid].lit))
+    }
+    const token = v.host.querySelector("[data-oco-runtime-token]")
+    expect(token).not.toBeNull()
+    expect(token!.getAttribute("data-oco-runtime-token-pos")).toMatch(/^-?\d+\.\d$/)
+    expect(token!.classList.contains("oco-loop-anim")).toBe(true)
+    expect(v.host.querySelector("[data-oco-runtime-you]")!.getAttribute("data-oco-runtime-you-state")).toBe(f.you.state)
+    expect(v.host.querySelector("[data-oco-runtime-model]")).not.toBeNull()
+    expect(v.host.querySelector("[data-oco-runtime-tools]")).not.toBeNull()
+  })
+}
+
+test("k08: the you dock lists the question's options as list items, never buttons", () => {
+  const v = mount(at("k08"))
+  expect(v.frame().you.state).toBe("need")
+  const you = v.host.querySelector("[data-oco-runtime-you]")!
+  const options = [...you.querySelectorAll("[data-oco-runtime-you-option]")]
+  expect(options.length).toBeGreaterThanOrEqual(2)
+  expect(options.length).toBe(v.frame().you.ask!.options.length)
+  for (const o of options) {
+    expect(o.tagName).toBe("LI")
+    expect(o.parentElement!.tagName).toBe("OL")
+    expect(o.getAttribute("role")).toBeNull()
+  }
+  expect(you.querySelectorAll("button, [role=button]").length).toBe(0)
+})
+
+test("k03 -> k04: a tool row with the same id keeps the same DOM node", () => {
+  const v = mount(at("k03"))
+  const before = new Map([...v.host.querySelectorAll("[data-oco-runtime-tool-row]")].map((el) => [el.getAttribute("data-oco-runtime-tool-row")!, el]))
+  const textBefore = new Map([...before].map(([id, el]) => [id, el.textContent]))
+  v.setT(at("k04"))
+  const after = [...v.host.querySelectorAll("[data-oco-runtime-tool-row]")]
+  const shared = after.filter((el) => before.has(el.getAttribute("data-oco-runtime-tool-row")!))
+  expect(shared.length).toBeGreaterThan(0)
+  for (const el of shared) expect(el).toBe(before.get(el.getAttribute("data-oco-runtime-tool-row")!)!)
+  // the frame really moved and the kept nodes were updated in place (running times / states changed)
+  expect(v.frame().t).toBe(at("k04"))
+  expect(shared.some((el) => el.textContent !== textBefore.get(el.getAttribute("data-oco-runtime-tool-row")!))).toBe(true)
+  // the card is a resident element: same node across frames
+  const card = v.host.querySelector("[data-oco-runtime-card]")
+  v.setT(at("k05"))
+  expect(v.host.querySelector("[data-oco-runtime-card]")).toBe(card)
+})
+
+test("k08: the card opens its full text, Esc closes it and focus returns to the card", async () => {
+  const v = mount(at("k08"))
+  const expand = v.host.querySelector("[data-oco-runtime-card-expand]") as HTMLElement
+  // the whole card is the opener (no separate full-text button)
+  expect(expand.hasAttribute("data-oco-runtime-card")).toBe(true)
+  expect(expand.getAttribute("aria-disabled")).toBeNull()
+  expect(expand.tabIndex).toBe(0)
+  expand.focus()
+  expand.click()
+  await Promise.resolve()
+  await Promise.resolve()
+  const panel = v.host.querySelector("[data-oco-runtime-card-panel]")!
+  expect(panel).not.toBeNull()
+  expect(panel.textContent).toContain(v.frame().card.full ?? v.frame().card.body)
+  expect(panel.contains(document.activeElement)).toBe(true)
+  ;(document.activeElement ?? panel).dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }))
+  expect(v.host.querySelector("[data-oco-runtime-card-panel]")).toBeNull()
+  expect(document.activeElement).toBe(expand)
+  // the button is resident: still the same node after the overlay round trip
+  expect(v.host.querySelector("[data-oco-runtime-card-expand]")).toBe(expand)
+  // the close button (✕) does the same
+  expand.click()
+  await Promise.resolve()
+  await Promise.resolve()
+  const close = v.host.querySelector("[data-oco-runtime-card-panel] button") as HTMLButtonElement
+  expect(document.activeElement).toBe(close)
+  close.click()
+  expect(v.host.querySelector("[data-oco-runtime-card-panel]")).toBeNull()
+  expect(document.activeElement).toBe(expand)
+})
+
+test("plan chip opens the plan list; a round-end card can show its full text", async () => {
+  const withPlan = fixture.keyframes.map((k) => Number(k.t)).find((t) => frameAt(index, t, { reduced: false, wide: true }).counter.plan)
+  expect(withPlan).toBeDefined()
+  const v = mount(withPlan!)
+  const chip = v.host.querySelector("[data-oco-runtime-plan]") as HTMLButtonElement
+  expect(chip.tagName).toBe("BUTTON")
+  chip.focus()
+  chip.click()
+  await Promise.resolve()
+  await Promise.resolve()
+  const panel = v.host.querySelector('[data-oco-runtime-card-panel="plan"]')!
+  expect(panel).not.toBeNull()
+  const items = v.frame().counter.plan!.items
+  expect(panel.querySelectorAll("li").length).toBe(items.length)
+  for (const o of items) expect(panel.textContent).toContain(o.text)
+  ;(document.activeElement ?? panel).dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }))
+  expect(v.host.querySelector("[data-oco-runtime-card-panel]")).toBeNull()
+  expect(document.activeElement).toBe(chip)
+
+  const end = fixture.keyframes.map((k) => Number(k.t)).find((t) => {
+    const c = frameAt(index, t, { reduced: false, wide: true }).card
+    return c.kind === "round-end" && !!c.body
+  })
+  expect(end).toBeDefined()
+  v.setT(end!)
+  expect(v.host.querySelector("[data-oco-runtime-card-expand]")!.getAttribute("aria-disabled")).toBeNull()
+  // the meta line is not in the card any more; it is in the overlay
+  expect(v.host.querySelector("[data-oco-runtime-card] [data-oco-runtime-card-meta]")).toBeNull()
+})
+
+test("no element carries a forbidden attribute name", () => {
+  for (const id of ["k03", "k05", "k08", "k09"]) {
+    const v = mount(at(id))
+    for (const el of [v.host, ...v.host.querySelectorAll("*")]) {
+      for (const name of el.getAttributeNames()) expect(FORBIDDEN).not.toContain(name)
+    }
+  }
+})
diff --git a/packages/app/test-browser/solid-jsx-preload.ts b/packages/app/test-browser/solid-jsx-preload.ts
new file mode 100644
index 0000000..902bac1
--- /dev/null
+++ b/packages/app/test-browser/solid-jsx-preload.ts
@@ -0,0 +1,20 @@
+// oco (patches/opencode/0019): compile Solid TSX for bun test (test-browser only)
+import { plugin } from "bun"
+import { createRequire } from "node:module"
+// @babel/core and babel-preset-solid are dependencies of vite-plugin-solid, not of packages/app
+const req = createRequire(createRequire(import.meta.path).resolve("vite-plugin-solid/package.json"))
+const babel = req("@babel/core")
+const solid = req("babel-preset-solid")
+plugin({
+  name: "oco-solid-jsx",
+  setup(build) {
+    build.onLoad({ filter: /\.tsx$/ }, async (args) => {
+      const out = await babel.transformAsync(await Bun.file(args.path).text(), {
+        filename: args.path, babelrc: false, configFile: false,
+        parserOpts: { plugins: ["jsx", "typescript"] },
+        presets: [[solid, { generate: "dom", hydratable: false }]],
+      })
+      return { contents: out.code, loader: "ts" }   // Bun strips the remaining types
+    })
+  },
+})
