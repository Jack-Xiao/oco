+// oco (patches/opencode/0019): left column overview (M4 batch 3).
+import { describe, expect, test } from "bun:test"
+import type { Message, Part } from "@opencode-ai/sdk/v2/client"
+import { goalOf, todoCounts, todosOf } from "./session-runtime-overview"
+
+const user = (id: string) => ({ id, role: "user", sessionID: "s", time: { created: 1 } }) as unknown as Message
+const asst = (id: string, parentID: string) =>
+  ({ id, role: "assistant", parentID, sessionID: "s", time: { created: 2 } }) as unknown as Message
+const text = (id: string, value: string, extra: Record<string, unknown> = {}) =>
+  ({ id, type: "text", text: value, ...extra }) as unknown as Part
+const todo = (id: string, todos: unknown) =>
+  ({ id, type: "tool", tool: "todowrite", state: { status: "completed", input: { todos } } }) as unknown as Part
+
+const viewOf = (messages: Message[], parts: Record<string, Part[]>) => ({
+  messages,
+  parts: (id: string) => parts[id] ?? [],
+})
+
+describe("round goal", () => {
+  test("reads the typed text of the round's user message, skipping synthetic and ignored parts", () => {
+    const view = viewOf([user("u1"), asst("a1", "u1")], {
+      u1: [
+        text("t1", " fix the build "),
+        text("t2", "<file>", { synthetic: true }),
+        text("t3", "x", { ignored: true }),
+      ],
+    })
+    expect(goalOf(view, "a1")).toBe("fix the build")
+  })
+  test("is undefined without a request or text", () => {
+    const view = viewOf([user("u1"), asst("a1", "u1")], {})
+    expect(goalOf(view, undefined)).toBeUndefined()
+    expect(goalOf(view, "a1")).toBeUndefined()
+    expect(goalOf(view, "missing")).toBeUndefined()
+  })
+})
+
+describe("todos", () => {
+  test("the newest todowrite wins", () => {
+    const view = viewOf([user("u1"), asst("a1", "u1"), asst("a2", "u1")], {
+      a1: [todo("p1", [{ id: "1", content: "old", status: "pending", priority: "high" }])],
+      a2: [
+        todo("p2", [
+          { id: "1", content: "plan", status: "completed", priority: "high" },
+          { content: "ship", status: "in_progress" },
+          { bad: true },
+        ]),
+      ],
+    })
+    expect(todosOf(view)).toEqual([
+      { id: "1", content: "plan", status: "completed", priority: "high" },
+      { id: "p2:1", content: "ship", status: "in_progress", priority: "medium" },
+    ])
+  })
+  test("undefined when the session never wrote a list; partial input is skipped", () => {
+    expect(todosOf(viewOf([user("u1"), asst("a1", "u1")], {}))).toBeUndefined()
+    const pending = {
+      id: "p",
+      type: "tool",
+      tool: "todowrite",
+      state: { status: "pending", input: {} },
+    } as unknown as Part
+    expect(todosOf(viewOf([asst("a1", "u1")], { a1: [pending] }))).toBeUndefined()
+  })
+  test("counts leave cancelled items out of the total", () => {
+    expect(todoCounts([{ status: "completed" }, { status: "pending" }, { status: "cancelled" }])).toEqual({
+      done: 1,
+      total: 2,
+    })
+  })
+})
diff --git a/packages/app/src/components/session/session-runtime-overview.ts b/packages/app/src/components/session/session-runtime-overview.ts
new file mode 100644
index 0000000..e9ce4a4
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-overview.ts
@@ -0,0 +1,52 @@
+// oco (patches/opencode/0019): left column overview — the current round's goal and the todo list (M4 batch 3).
+// Both read the same messages the model was assembled from, so replay shows them as they were at the cursor.
+import type { Message, Part, Todo } from "@opencode-ai/sdk/v2/client"
+
+export type OverviewTodo = Pick<Todo, "content" | "status" | "priority"> & { id: string }
+
+type View = { messages: readonly Message[]; parts: (messageID: string) => Part[] }
+
+/** Text the user typed in the message that started the round (the parent of the round's first request). */
+export function goalOf(view: View, requestMessageID: string | undefined): string | undefined {
+  if (!requestMessageID) return undefined
+  const request = view.messages.find((m) => m.id === requestMessageID)
+  if (!request || request.role !== "assistant") return undefined
+  const text = view
+    .parts(request.parentID)
+    .filter((p): p is Extract<Part, { type: "text" }> => p.type === "text" && !p.synthetic && !p.ignored)
+    .map((p) => p.text.trim())
+    .filter(Boolean)
+    .join("\n")
+  return text || undefined
+}
+
+const isTodo = (v: unknown): v is { content: string; status?: string; priority?: string; id?: string } =>
+  !!v && typeof v === "object" && typeof (v as { content?: unknown }).content === "string"
+
+/** The newest `todowrite` call's list; undefined when the session never wrote one. */
+export function todosOf(view: View): OverviewTodo[] | undefined {
+  for (let i = view.messages.length - 1; i >= 0; i--) {
+    const m = view.messages[i]
+    if (m.role !== "assistant") continue
+    const parts = view.parts(m.id)
+    for (let j = parts.length - 1; j >= 0; j--) {
+      const p = parts[j]
+      if (p.type !== "tool" || p.tool !== "todowrite") continue
+      const todos = (p.state.input as { todos?: unknown } | undefined)?.todos
+      if (!Array.isArray(todos)) continue
+      return todos.filter(isTodo).map((t, k) => ({
+        id: t.id ?? `${p.id}:${k}`,
+        content: t.content,
+        status: t.status ?? "pending",
+        priority: t.priority ?? "medium",
+      }))
+    }
+  }
+  return undefined
+}
+
+export function todoCounts(todos: readonly Pick<Todo, "status">[]) {
+  const done = todos.filter((t) => t.status === "completed").length
+  const cancelled = todos.filter((t) => t.status === "cancelled").length
+  return { done, total: todos.length - cancelled }
+}
diff --git a/packages/app/src/components/session/session-runtime-perf.test.ts b/packages/app/src/components/session/session-runtime-perf.test.ts
new file mode 100644
index 0000000..03f37bd
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime-perf.test.ts
@@ -0,0 +1,161 @@
+// oco (patches/opencode/0019): runtime view performance measurement.
+// Pure function measurement of assemble (buildTrajectory + buildRuntime) over 200 requests (3 tools each, 1 task)
+// plus an in-flight assistant message with 100 reasoning deltas.
+import { describe, expect, test } from "bun:test"
+import type { Message, Part } from "@opencode-ai/sdk/v2/client"
+import { buildTrajectory } from "./session-trajectory-model"
+import { trajectoryText } from "./session-trajectory-i18n"
+import { buildRuntime, type RuntimeInput } from "./session-runtime-model"
+
+const language = trajectoryText({ locale: () => "en", intl: () => "en" })
+const T0 = 1_790_000_000_000
+
+const id = (prefix: string, ms: number, counter = 0) =>
+  `${prefix}_${((BigInt(ms) * 4096n + BigInt(counter)) % 2n ** 48n).toString(16).padStart(12, "0")}AbCdEfGhIjKlMn`
+
+const user = (ms: number) =>
+  ({ id: id("msg", ms), sessionID: "s", role: "user", time: { created: ms }, agent: "build", model: {} }) as any
+
+const assistant = (parent: any, ms: number, extra: Record<string, unknown> = {}) =>
+  ({
+    id: id("msg", ms),
+    sessionID: "s",
+    role: "assistant",
+    parentID: parent.id,
+    time: { created: ms, completed: ms + 1500 },
+    modelID: "m",
+    providerID: "p",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/", root: "/" },
+    cost: 0,
+    tokens: { input: 100, output: 50, reasoning: 0, cache: { read: 900, write: 0 } },
+    ...extra,
+  }) as any
+
+const tool = (ms: number, name: string, state: Record<string, unknown>, extra: Record<string, unknown> = {}) =>
+  ({ id: id("prt", ms), sessionID: "s", messageID: "", type: "tool", tool: name, callID: `c${ms}`, state, ...extra }) as any
+
+function assemble(
+  view: { messages: Message[]; parts: (id: string) => Part[]; busy?: boolean },
+  mode: "live" | "replay",
+  at: number,
+) {
+  const built = buildTrajectory({
+    messages: view.messages,
+    parts: view.parts,
+    now: at,
+    busy: mode === "live" ? true : (view.busy ?? false),
+    language,
+  })
+  return buildRuntime(
+    {
+      mode,
+      sessionID: "s",
+      parts: view.parts,
+      status: { type: "busy" } as any,
+      permissions: [],
+      questions: [],
+      childStatus: () => undefined,
+      requests: built.requests,
+    },
+    at,
+  )
+}
+
+describe("session runtime performance", () => {
+  test("measures 200 requests x 3 tools with 100 reasoning deltas across 5 rounds", () => {
+    const u = user(T0)
+    const messages: Message[] = [u]
+    const partsByMsg = new Map<string, Part[]>()
+
+    // 200 requests (assistant messages), each with 3 tools (including 1 task)
+    for (let i = 0; i < 200; i++) {
+      const reqTime = T0 + 1000 + i * 2000
+      const a = assistant(u, reqTime)
+      messages.push(a)
+
+      const t1 = tool(reqTime + 10, "bash", {
+        status: "completed",
+        input: { command: `echo ${i}` },
+        output: `${i}`,
+        time: { start: reqTime + 10, end: reqTime + 20 },
+      })
+      const t2 = tool(reqTime + 30, "read", {
+        status: "completed",
+        input: { filePath: `/file_${i}.txt` },
+        output: "ok",
+        time: { start: reqTime + 30, end: reqTime + 40 },
+      })
+      const t3 = tool(reqTime + 50, "task", {
+        status: "completed",
+        input: { subagent_type: "worker", description: `worker ${i}` },
+        output: "<task_result>ok</task_result>",
+        metadata: { sessionId: `sub_${i}` },
+        time: { start: reqTime + 50, end: reqTime + 100 },
+      })
+      partsByMsg.set(a.id, [t1, t2, t3])
+    }
+
+    // In-flight assistant message at the end
+    const inFlightTime = T0 + 1000 + 200 * 2000
+    const inFlight = assistant(u, inFlightTime, { time: { created: inFlightTime } }) // no completed
+    messages.push(inFlight)
+
+    const reasoningPart: Part = {
+      id: id("prt", inFlightTime + 1),
+      sessionID: "s",
+      messageID: inFlight.id,
+      type: "reasoning",
+      text: "",
+      time: { start: inFlightTime + 1 },
+    } as any
+
+    partsByMsg.set(inFlight.id, [reasoningPart])
+
+    const parts = (msgId: string) => partsByMsg.get(msgId) ?? []
+
+    const roundMedians: number[] = []
+    const roundP95s: number[] = []
+    const triggersPerDelta = 1 // In unbatched architecture, each store delta triggers assemble
+
+    const ROUNDS = 5
+    const DELTAS = 100
+
+    for (let round = 0; round < ROUNDS; round++) {
+      ;(reasoningPart as any).text = ""
+      const durations: number[] = []
+
+      for (let d = 0; d < DELTAS; d++) {
+        ;(reasoningPart as any).text += ` delta_${d}: thinking about step ${d}... `
+        const now = inFlightTime + 10 + d * 50
+        const start = performance.now()
+        const model = assemble({ messages, parts }, "live", now)
+        const duration = performance.now() - start
+        durations.push(duration)
+        expect(model.requests.length).toBeGreaterThan(0)
+      }
+
+      durations.sort((a, b) => a - b)
+      const median = durations[Math.floor(durations.length / 2)]!
+      const p95 = durations[Math.floor(durations.length * 0.95)]!
+      roundMedians.push(median)
+      roundP95s.push(p95)
+    }
+
+    roundMedians.sort((a, b) => a - b)
+    roundP95s.sort((a, b) => a - b)
+
+    const finalMedian = roundMedians[Math.floor(roundMedians.length / 2)]!
+    const finalP95 = roundP95s[Math.floor(roundP95s.length / 2)]!
+
+    console.log(
+      `[session-runtime-perf] 5 rounds median assemble time: ${finalMedian.toFixed(2)} ms, p95: ${finalP95.toFixed(2)} ms, triggers per delta: ${triggersPerDelta}`,
+    )
+    console.log(`[session-runtime-perf] round medians: [${roundMedians.map((m) => m.toFixed(2)).join(", ")}] ms`)
+    console.log(`[session-runtime-perf] round p95s: [${roundP95s.map((p) => p.toFixed(2)).join(", ")}] ms`)
+
+    expect(finalMedian).toBeGreaterThan(0)
+    expect(finalP95).toBeGreaterThan(0)
+  })
+})
