+  obst: Box[]
+}
+export type Wire = { id: string; pts: Pt[]; tone: Tone; width: number; opacity: number; dash?: string; dashOffset?: number; port?: Pt; gap?: { at: Pt } }
+export type Packet = {
+  id: string; at: Pt; tone: Tone; opacity: number; parked: boolean
+  glyph?: string; label?: Phrase | string; long?: Phrase | string
+  probe?: { uid: string; stage: "queued" | "running" | "docked" | "absorbed" }
+}
+
+// ---------- step times (side table, D21) ----------
+// The app's sync layer drops step-start / step-finish parts (SKIP_PARTS). At its 4 drop points their times and receipts
+// go into a side table (session-runtime-step-times.ts), sessionID -> messageID -> RingStepTimes; RingSource.steps
+// reads one session's table. Times are idTime(part.id) taken near the record time; the ring re-reads them near
+// message.time.created (snapStepTime), the same decoding as a step part in the parts array.
+export type RingStepTokens = {
+  total?: number; input: number; output: number; reasoning: number; cache: { read: number; write: number }
+}
+export type RingStepFinish = { partID: string; at: number; reason: string; cost: number; tokens: RingStepTokens }
+export type RingStepTimes = {
+  start?: number                  // earliest step-start of the message
+  finishes: RingStepFinish[]      // one per step-finish part id, ascending by part id (= by time)
+}
