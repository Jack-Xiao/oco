+                <span class="text-12-regular text-text-weak">{t("replay.new", { count: newSince() })}</span>
+              </Show>
+            </Show>
+          </div>
+
+          <Show when={model().mode === "replay"}>
+            <div class="text-12-regular text-text-weak" data-oco-runtime-replay-note>{t("replay.attention")}</div>
+          </Show>
+
+          {/* 2. Focus sentence */}
+          <div
+            data-oco-runtime-focus={model().focus.kind}
+            class="rounded-md px-3 py-2 bg-surface-inset-base text-14-medium text-text-strong font-mono"
+            style={{ "border-left": `3px solid ${model().focus.kind === "error" ? COLOR.error : model().focus.kind === "attention" ? COLOR.attention : COLOR.model}` }}
+          >
+            <Switch>
+              <Match when={model().focus.kind === "attention" && attention().length}>
+                {(() => {
+                  const firstAtt = () => attention()[0]
+                  const inNode = () => isAttentionInToolNode(firstAtt())
+                  return (
+                    <Show
+                      when={!inNode()}
+                      fallback={
+                        <div>
+                          <div class="break-words">{attentionText(t, firstAtt())}</div>
+                          <div class="text-11-regular text-text-weak mt-0.5">{t("focus.attention.hint")}</div>
+                        </div>
+                      }
+                    >
+                      <div class="flex flex-col gap-1">
+                        {attentionRow(firstAtt)}
+                        <div class="text-11-regular text-text-weak mt-0.5">{t("focus.attention.hint")}</div>
+                      </div>
+                    </Show>
+                  )
+                })()}
+              </Match>
+              <Match when={model().focus.kind === "retry" && (model().focus as { attempt: number; message: string; next: number })}>
+                {(r) => {
+                  const wait = () => retryWait(r().next, wall())
+                  return (
+                    <div data-oco-runtime-retry>
+                      {wait().due
+                        ? t("retry.soon")
+                        : t("retry.countdown", { attempt: r().attempt, seconds: wait().seconds })}
+                      <Show when={r().message}>
+                        <div class="text-12-regular text-text-weak">{r().message}</div>
+                      </Show>
+                    </div>
+                  )
+                }}
+              </Match>
+              <Match when={model().focus.kind === "error" && (model().focus as { message: string })}>
+                {(r) => <div>{r().message ? t("focus.error", { message: r().message }) : t("focus.error.unknown")}</div>}
+              </Match>
+              <Match when={model().focus.kind === "working" && (model().focus as { tool?: RuntimeTool; stage: Stage })}>
+                {(w) => (
+                  <div>
+                    {w().tool
+                      ? t("focus.working.tool", { tool: w().tool!.child?.agent ?? w().tool!.name, input: w().tool!.input })
+                      : t(`stage.${stageKey(w().stage)}`)}
+                  </div>
+                )}
+              </Match>
+              <Match when={model().focus.kind === "interrupted"}>
+                <div>{t("focus.interrupted")}</div>
+              </Match>
+              <Match when={model().focus.kind === "cancelled"}>
+                <div data-oco-runtime-cancel="cancelled">{t("focus.cancelled")}</div>
+              </Match>
+              <Match when={model().focus.kind === "done"}>
+                <div>{t("focus.done")}</div>
+              </Match>
+              <Match when={true}>
+                <div>{t("focus.idle")}</div>
+              </Match>
+            </Switch>
+          </div>
+
+          {/* Screen-reader mirror: run state + one focus sentence only. No ticking timers, buttons or attributes E2E selects on. */}
+          <div class="sr-only" aria-live="polite" data-oco-runtime-live>
+            {liveSentence()}
+          </div>
+        </div>
+
+        {/* Secondary attention items not rendered inside tool nodes */}
+        <Show when={attention().length > 1}>
+          <div class="flex flex-col gap-2">
+            <For each={attention().slice(1)}>
+              {(item) => (
+                <Show when={!isAttentionInToolNode(item)}>
+                  {attentionRow(() => item)}
+                </Show>
+              )}
+            </For>
+          </div>
+        </Show>
+
+        {/* 3. Legend + 4. Agent Tree (Main + Thinking side-note + Dispatch + Slots + Return + Fill) */}
+        <RuntimeMechanism
+          model={model}
+          t={t}
+          copy={copy}
+          childOf={(id) => (childMessagesOf(id) ? assembleChild(id) : undefined)}
+          narrow={narrow}
+          isToolOpen={isToolOpen}
+          toggleTool={toggleTool}
+          childOpen={childOpen}
+          toggleChild={toggleChild}
+          assembleChild={assembleChild}
+          onOpenSession={props.onOpenSession}
+          now={wall}
+          pending={pending}
+          failed={failed}
+          respond={respond}
+          onView={props.onView}
+          reasoningElement={
+            <Show when={reasoningKeys.ids().length > 0}>
+              <div class="flex flex-col gap-2 min-w-0">
+                <For each={reasoningKeys.ids()}>
+                  {(id) => (
+                    <RuntimeReasoningBlock
+                      reasoning={() => reasoningKeys.get(id)}
+                      t={t}
+                      isReplay={() => model().mode === "replay"}
+                    />
+                  )}
+                </For>
+              </div>
+            </Show>
+          }
+        />
+
+        {/* 5. Other items needing attention (tools not in current slice but error/interrupted/awaiting) */}
+        <Show when={otherAttentionTools().length > 0}>
+          <div class="flex flex-col gap-1.5 font-mono">
+            <div class="text-12-medium text-text-base flex items-center gap-1.5">
+              <span style={{ color: COLOR.attention }}>!</span>
+              <span>{t("runtime.other_attention")}</span>
+            </div>
+            <For each={otherAttentionTools()}>
+              {(tool) => toolRow(() => tool)}
+            </For>
+          </div>
+        </Show>
+
+        {/* 6. Session Log */}
+        <div class="flex flex-col gap-1 font-mono" data-oco-runtime-events>
+          <div class="flex items-baseline justify-between gap-2 min-w-0">
+            <span class="text-12-medium text-text-base">{t("runtime.log_title")}</span>
+            <span class="text-11-regular text-text-weak">{t("runtime.log_hint")}</span>
+          </div>
+          <div class="flex flex-col gap-1 p-2 rounded border border-dashed border-border-subtle bg-surface-inset-base max-h-60 overflow-auto min-w-0">
+            <Show when={model().events.length} fallback={<div class="text-11-regular text-text-weak">{t("events.none")}</div>}>
+              <For each={eventKeys.ids()}>{(id) => eventRow(() => eventKeys.get(id)!)}</For>
+            </Show>
+          </div>
+        </div>
+
+        {/* 7. Bottom Summary */}
+        <div
+          data-oco-runtime-summary
+          class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 border-t border-border-subtle text-11-regular font-mono text-text-weak shrink-0 min-w-0"
+        >
+          <span>
+            <span class="text-text-strong font-medium">{summaryAgent()}</span>
+            <span> · </span>
+            <span>{summaryModel()}</span>
+          </span>
+          <span>{summaryChildren()}</span>
+          <span>{summaryTools()}</span>
+          <span>{summaryRequest()}</span>
+          <span>{summaryTokens()}</span>
+        </div>
+      </div>
+    </div>
+  )
+}
