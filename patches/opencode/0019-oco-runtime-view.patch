+// ---------- 5: token ----------
+function changesFor(g: RingGeoX) {
+  // ring angle per stage change, request 1 then request 2 (360 further), ending in end
+  const seq: [number, RingStageId, number][] = [
+    [1000, "say", 180], [1200, "asm", 180], [1500, "fly", 212], [2500, "think", 240], [4000, "out", 300],
+    [5500, "call", 360], [6000, "wait", 420], [9000, "next", 480], [9100, "asm", 540], [9400, "think", 600], [12_000, "end", 0],
+  ]
+  void g
+  return seq.map(([t, st, ang]) => ({ t, st, ang }))
+}
+describe("tokenAt", () => {
+  test("5. monotone in t (never moves backwards), pos <= tgt, reduced pos == tgt", () => {
+    for (const w of [560, 1100, 1600]) {
+      const g = geo(w, 720, 0.5)
+      const round = roundOf([], { changes: changesFor(g) })
+      expect(tokenAt(g, undefined, 0, false)).toBeUndefined()
+      expect(tokenAt(g, roundOf([]), 0, false)).toBeUndefined()
+      let prev = -Infinity
+      let prevTgt = -Infinity
+      for (let t = 900; t <= 14_000; t += 25) {
+        const tk = tokenAt(g, round, t, false)!
+        expect(tk.pos, `${w} t=${t}`).toBeGreaterThanOrEqual(prev - 1e-9)
+        expect(tk.tgt).toBeGreaterThanOrEqual(prevTgt - 1e-9)
+        expect(tk.pos).toBeLessThanOrEqual(tk.tgt + 1e-9)
+        prev = tk.pos
+        prevTgt = tk.tgt
+        const rd = tokenAt(g, round, t, true)!
+        expect(rd.pos).toBe(rd.tgt)
+        expect(rd.tgt).toBe(tk.tgt)
+      }
+    }
+  })
+  test("5b. it travels at the packet speed and lags at most one station behind a jump", () => {
+    const g = geo(1100, 720, 0)
+    const round = roundOf([], { changes: changesFor(g) })
+    const w = (RING.V / g.R) * (180 / Math.PI)
+    const a = tokenAt(g, round, 5600, false)!
+    const b = tokenAt(g, round, 5700, false)!
+    expect(b.pos - a.pos).toBeLessThanOrEqual(100 * w + 1e-6)
+    const jump = tokenAt(g, round, 5500, false)!
+    expect(jump.tgt - jump.pos).toBeLessThanOrEqual(46 + 1e-6)
+  })
+})
