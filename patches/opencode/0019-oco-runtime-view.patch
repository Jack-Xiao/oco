+// oco (patches/opencode/0019): loop lane — subagents as probes travelling dispatch → work → dock → core (M4 batch 2).
+// Contract and rules: docs/design/runtime-m4.md (sections 4–8); geometry follows docs/design/runtime-m4-loop-mockup.html.
+import {
+  createEffect,
+  createMemo,
+  createSignal,
+  For,
+  Index,
+  on,
+  onCleanup,
+  onMount,
+  Show,
+  type Accessor,
+} from "solid-js"
+import type { RuntimeText } from "./session-runtime-i18n"
+import { LOOP_CAPACITY, formatElapsed, layoutLoop, type Loop, type LoopZone, type Probe } from "./session-runtime-loop"
+import type { RuntimeTool } from "./session-runtime-model"
+import { FOCUS } from "./session-runtime-actions"
+
+type XY = readonly [number, number]
+const MAX_TICKS = 16
+const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v))
+
+export type LoopGeometry = {
+  w: number
+  h: number
+  hub: XY
+  /** Core radius; the turning ring sits at r + 8, absorbed ticks at r + 16. */
+  r: number
+  probeR: number
+  /** Label baseline below a probe's centre. */
+  labelY: number
+  lane: string
+  zone: { x: number; y: number; w: number; h: number }
+  slots: Record<LoopZone, XY[]>
+  /** Label width budget per zone in px; 0 hides labels (the name stays in the tooltip and the handoff). */
+  labelPx: Record<LoopZone, number>
+  /** Work slots that fit at a readable cell width (≤ 12); overflow folds into the “+N” cluster. */
+  workCap: number
+  xL: number
+  xArc: number
+  /** Baseline of the dispatch lane's title, above the lane. */
+  titleY: number
+  /** The lane sampled every few px from the hub's upper exit to its lower entry; probes travel along it. */
+  track: XY[]
+  /** Index range of `track` on the arc, where probes leave the lane for the work zone and rejoin it. */
+  arc: [number, number]
+}
+
+/** Samples the lane: hub exit → top lane → arc (right side of an ellipse) → bottom lane → hub entry. */
+function trackOf(start: XY, xL: number, topY: number, xArc: number, botY: number, rx: number, ry: number, end: XY) {
+  const step = 6
+  const pts: XY[] = []
+  const line = (a: XY, b: XY) => {
+    const n = Math.max(1, Math.ceil(Math.hypot(b[0] - a[0], b[1] - a[1]) / step))
+    for (let i = 0; i < n; i++) pts.push([a[0] + ((b[0] - a[0]) * i) / n, a[1] + ((b[1] - a[1]) * i) / n])
+  }
+  line(start, [xL, topY])
+  line([xL, topY], [xArc, topY])
+  const arcFrom = pts.length
+  const cy = (topY + botY) / 2
+  const n = Math.max(8, Math.ceil((Math.PI * (rx + ry)) / 2 / step))
+  for (let i = 0; i < n; i++) {
+    const a = -Math.PI / 2 + (Math.PI * i) / n
+    pts.push([xArc + rx * Math.cos(a), cy + ry * Math.sin(a)])
+  }
+  const arcTo = pts.length
+  line([xArc, botY], [xL, botY])
+  line([xL, botY], end)
+  pts.push(end)
+  return { track: pts, arc: [arcFrom, arcTo] as [number, number] }
+}
+
+export type LoopSpot = { kind: "hub" | LoopZone; xy: XY }
+
+const STEP: Record<LoopSpot["kind"], number> = { hub: 0, queue: 1, work: 2, dock: 3 }
+
+/** Like routeOf, but a probe whose stage jumped ahead (the child finished, or was collected, before the probe got
+ *  there) still passes the work zone and, for a background task, the dock on its way, without stopping. */
+export function tripOf(
+  geo: Pick<LoopGeometry, "track" | "arc" | "zone" | "slots">,
+  from: LoopSpot,
+  to: LoopSpot,
+  background: boolean,
+): XY[] {
+  const a = STEP[from.kind]
+  const b = to.kind === "hub" ? 4 : STEP[to.kind]
+  const stops: LoopSpot[] = [from]
+  if (a < 2 && b > 2) stops.push({ kind: "work", xy: [geo.zone.x + geo.zone.w / 2, geo.zone.y + geo.zone.h / 2] })
+  if (background && a < 3 && b > 3) stops.push({ kind: "dock", xy: geo.slots.dock[0] })
+  stops.push(to)
+  const path: XY[] = []
+  for (let i = 1; i < stops.length; i++) path.push(...routeOf(geo, stops[i - 1], stops[i]).slice(i === 1 ? 0 : 1))
+  return path
+}
+
+/** Path a probe follows between two spots: forward along the lane, hopping off it only to reach a work cell or a
+ *  hidden slot. Anything that would run the lane backwards is a straight hop. */
+export function routeOf(geo: Pick<LoopGeometry, "track" | "arc">, from: LoopSpot, to: LoopSpot): XY[] {
+  const { track, arc } = geo
+  const nearest = (xy: XY, lo: number, hi: number) => {
+    let best = lo
+    let d = Infinity
+    for (let i = lo; i < hi; i++) {
+      const e = (track[i][0] - xy[0]) ** 2 + (track[i][1] - xy[1]) ** 2
+      if (e < d) {
+        d = e
+        best = i
+      }
+    }
+    return best
+  }
+  if (from.kind === to.kind) return [from.xy, to.xy]
+  // Hub and lane slots map to a track index directly. The work zone joins the lane at the nearest point on the
+  // way: entering from the dispatch lane or the arc, leaving through the arc or the return lane.
+  const fixed = (spot: LoopSpot, end: "from" | "to") =>
+    spot.kind === "hub" ? (end === "from" ? 0 : track.length - 1) : nearest(spot.xy, 0, track.length)
+  let a: number
+  let b: number
+  if (to.kind === "work") {
+    a = fixed(from, "from")
+    b = nearest(to.xy, a, arc[1])
+  } else if (from.kind === "work") {
+    b = fixed(to, "to")
+    a = nearest(from.xy, arc[0], b + 1)
+  } else {
+    a = fixed(from, "from")
+    b = fixed(to, "to")
+  }
+  if (a > b) return [from.xy, to.xy]
+  return [from.xy, ...track.slice(a, b + 1), to.xy]
+}
+
+/** Lane geometry in real pixels for a `w`×`h` box. The frame's lane row is short and wide (about 140–260 px tall),
+ *  so the mockup's 800×330 drawing cannot just be scaled: text would shrink to a few px. Positions follow the box;
+ *  radii and text stay at fixed pixel sizes. */
+export function loopGeometry(width: number, height: number): LoopGeometry {
+  const w = Math.max(width, 360)
+  const h = Math.max(height, 120)
+  const probeR = h < 170 ? 8 : 10
+  const labelY = probeR + 13
+  const r = clamp((h - 44) / 2 - 16, 22, 46)
+  const hub: XY = [16 + r + 16, h / 2]
+  const titleY = 14
+  const topY = 34
+  const botY = h - 30
+  const xL = hub[0] + r + 30
+  const ry = (botY - topY) / 2
+  const rx = Math.min(ry, 90)
+  // The work zone's right edge sits at the box edge and the arc runs through it, a little short of that edge.
+  const overhang = 28
+  const xArc = w - 14 - overhang - rx
+  const laneStart: XY = [hub[0] + r + 18, hub[1] - r * 0.5]
+  const laneEnd: XY = [hub[0] + r + 18, hub[1] + r * 0.5]
+  const lane = `M${laneStart[0]} ${laneStart[1]} L${xL} ${topY} H${xArc} A${rx} ${ry} 0 0 1 ${xArc} ${botY} H${xL} L${laneEnd[0]} ${laneEnd[1]}`
+  // Work zone between the lanes, title at its top; up to three rows.
+  const zoneTop = topY + labelY + 6
+  const zoneH = Math.max(botY - probeR - 6 - zoneTop, labelY + 14)
+  const innerTop = zoneTop + 26
+  const innerBot = zoneTop + zoneH
+  const rows = clamp(Math.floor((innerBot - innerTop) / (labelY + 16)), 1, 3)
+  // The zone is one part of the loop: its right half at most, sticking out past the arc, with cells no wider than a
+  // label needs. Fewer cells fit on a short or narrow lane; the rest fold into the “+N” cluster.
+  const zoneR = w - 14
+  const room = zoneR - (xL + (xArc - xL) * 0.5) - 12
+  const cols = clamp(Math.min(Math.floor(room / 80), Math.ceil(12 / rows)), 1, 12)
+  const workCap = Math.min(12, cols * rows)
+  const cellW = Math.min(120, room / cols)
+  const zoneW = Math.max(cols * cellW + 12, 190)
+  const zoneL = zoneR - zoneW
+  const zone = { x: zoneL, y: zoneTop, w: zoneW, h: zoneH }
+  const rowStep = (innerBot - innerTop) / rows
+  const work = Array.from(
+    { length: 12 },
+    (_, i) =>
+      [
+        zoneR - 6 - cellW * (cols - (i % cols) - 0.5),
+        innerTop + rowStep * Math.floor(Math.min(i, workCap - 1) / cols) + probeR + 2,
+      ] as const,
+  )
+  const queueStep = (xArc - xL - 34) / 4
+  const queue = Array.from({ length: 4 }, (_, i) => [xL + 24 + queueStep * (i + 0.5), topY] as const)
+  // Dock runs right to left; the bottom-right corner keeps room for the lane title.
+  const dockRight = Math.max(xL + 140, xArc - 190)
+  const dockStep = (dockRight - xL - 24) / 5
+  const dock = Array.from({ length: 5 }, (_, i) => [dockRight - dockStep * (i + 0.5), botY] as const)
+  const budget = (step: number) => (step >= 44 ? step - 16 : 0)
+  return {
+    w,
+    h,
+    hub,
+    r,
+    probeR,
+    labelY,
+    lane,
+    zone,
+    slots: { queue, work, dock },
+    labelPx: { queue: budget(queueStep), work: budget(cellW), dock: budget(dockStep) },
+    workCap,
+    ...trackOf(laneStart, xL, topY, xArc, botY, rx, ry, laneEnd),
+    xL,
+    xArc,
+    titleY,
+  }
+}
+
+/** Estimated width at 11px mono (see fitText). */
+export const textPx = (text: string) => [...text].reduce((n, ch) => n + (ch.codePointAt(0)! >= 0x2e80 ? 11 : 6.7), 0)
+
+/** Truncates to a pixel budget at 11px mono: ASCII ≈ 6.7px, CJK and other wide glyphs ≈ 11px. */
+export const fitText = (text: string, px: number) => {
+  if (px <= 0) return ""
+  let used = 0
+  let out = ""
+  for (const ch of text) {
+    const cw = ch.codePointAt(0)! >= 0x2e80 ? 11 : 6.7
+    if (used + cw > px) return out ? out.replace(/\s+$/, "") + "…" : ""
+    used += cw
+    out += ch
+  }
+  return out
+}
+
+export const probeColor = (p: Pick<Probe, "flag" | "stage">) =>
+  p.flag === "error"
+    ? "var(--rt-err)"
+    : p.flag === "ask" || p.stage === "docked"
+      ? "var(--rt-attn)"
+      : p.stage === "absorbed"
+        ? "var(--rt-ok)"
+        : p.stage === "running"
+          ? "var(--rt-sub)"
+          : "var(--rt-accent)"
+
+const glyphOf = (p: Probe) =>
+  p.flag === "error" ? "✕" : p.flag === "ask" ? "!" : p.stage === "docked" ? "●" : p.stage === "queued" ? "·" : ""
+
+// Quiet time before the lane and core stop moving (bridges the gap between one step and the next).
+const IDLE_MS = 2000
+
+export type RuntimeLoopProps = {
+  loop: Accessor<Loop>
+  t: RuntimeText["t"]
+  live: Accessor<boolean>
+  agent: Accessor<string>
+  selected: Accessor<string | undefined>
+  onSelect: (id: string | undefined) => void
+  onEnterChild: (sessionID: string) => void
+  now: Accessor<number>
+}
+
+export function RuntimeLoop(props: RuntimeLoopProps) {
+  const t = props.t
+  const loop = props.loop
+  // The svg's own pixel size drives the geometry (see loopGeometry).
+  let box: HTMLDivElement | undefined
+  const [size, setSize] = createSignal<[number, number]>([800, 220])
+  onMount(() => {
+    if (!box || typeof ResizeObserver === "undefined") return
+    const ro = new ResizeObserver((entries) => {
+      const r = entries[0]?.contentRect
+      if (r && r.width > 0 && r.height > 0) setSize([Math.round(r.width), Math.round(r.height)])
+    })
+    ro.observe(box)
+    onCleanup(() => ro.disconnect())
+  })
+  const geo = createMemo(() => loopGeometry(size()[0], size()[1]))
+  const hub = () => geo().hub
+  const layout = createMemo(() => layoutLoop(loop().probes, { ...LOOP_CAPACITY, work: geo().workCap }))
+  type At = LoopSpot & { shown: boolean }
+  const placeOf = (p: Probe): At => {
+    if (p.stage === "absorbed") return { kind: "hub", xy: hub(), shown: false }
+    const place = layout().places[p.id]
+    if (!place) return { kind: "hub", xy: hub(), shown: false }
+    return { kind: place.zone, xy: geo().slots[place.zone][place.slot], shown: place.visible }
+  }
+
+  // Pause animations while the view is off screen or the window is hidden.
+  let root: HTMLDivElement | undefined
+  const [visible, setVisible] = createSignal(true)
+  const [docVisible, setDocVisible] = createSignal(
+    typeof document === "undefined" || document.visibilityState !== "hidden",
+  )
+  onMount(() => {
+    const onVis = () => setDocVisible(document.visibilityState !== "hidden")
+    document.addEventListener("visibilitychange", onVis)
+    let io: IntersectionObserver | undefined
+    if (root && typeof IntersectionObserver !== "undefined") {
+      io = new IntersectionObserver((entries) => setVisible(entries.some((e) => e.isIntersecting)))
+      io.observe(root)
+    }
+    onCleanup(() => {
+      document.removeEventListener("visibilitychange", onVis)
+      io?.disconnect()
+    })
+  })
+
+  // Tractor beam: a docked probe the main agent just collected (live only).
+  const [beams, setBeams] = createSignal<{ id: string; xy: XY }[]>([])
+  const timers = new Set<ReturnType<typeof setTimeout>>()
+  onCleanup(() => timers.forEach(clearTimeout))
+  let lastPlaces = new Map<string, { stage: Probe["stage"]; xy: XY }>()
+  createEffect(
+    on(loop, (next) => {
+      const fresh: { id: string; xy: XY }[] = []
+      for (const p of next.probes) {
+        const before = lastPlaces.get(p.id)
+        if (props.live() && before?.stage === "docked" && p.stage === "absorbed")
+          fresh.push({ id: p.id, xy: before.xy })
+      }
+      lastPlaces = new Map(next.probes.map((p) => [p.id, { stage: p.stage, xy: placeOf(p).xy }]))
+      if (!fresh.length) return
+      setBeams((list) => [...list.filter((b) => !fresh.some((f) => f.id === b.id)), ...fresh])
+      const timer = setTimeout(() => {
+        timers.delete(timer)
+        setBeams((list) => list.filter((b) => !fresh.some((f) => f.id === b.id)))
+      }, 1200)
+      timers.add(timer)
+    }),
+  )
+
+  const core = () => loop().core
+  // Live and replay alike (M4 batch 3): the lane flows and the core turns while the main agent works; idle, they breathe.
+  // One steady speed (changing the duration mid-turn makes the ring jump). The gap between steps (a task finishing,
+  // the next request starting) is not idle: motion stops only after IDLE_MS of quiet, and then pauses in place
+  // (oco-loop-rest) so it resumes from where it was instead of restarting.
+  const busyNow = () => core() !== "idle" || loop().counts.running > 0
+  const [animated, setAnimated] = createSignal(busyNow())
+  let idleTimer: ReturnType<typeof setTimeout> | undefined
+  createEffect(
+    on(busyNow, (busy) => {
+      if (idleTimer) clearTimeout(idleTimer)
+      idleTimer = undefined
+      if (busy) return setAnimated(true)
+      idleTimer = setTimeout(() => setAnimated(false), IDLE_MS)
+    }),
+  )
+  onCleanup(() => idleTimer && clearTimeout(idleTimer))
+  const moving = (cls: string) => `${cls} oco-loop-anim${animated() ? "" : " oco-loop-rest"}`
+  const breathe = "oco-loop-breathe oco-loop-anim"
+  // loopOf builds new objects on every update; iterate node keys so each probe keeps its element and its position,
+  // even when a background dispatch switches its id to the task id.
+  const probeNodes = createMemo(
+    () =>
+      loop()
+        .probes.filter((p) => !p.cancelled)
+        .map((p) => p.node),
+    [],
+    { equals: (a, b) => a.length === b.length && a.every((x, i) => x === b[i]) },
+  )
+  // Probes that mount in the first frames belong to the session as it was opened, not to a fresh dispatch.
+  let ready = false
+  onMount(() => {
+    const timer = setTimeout(() => (ready = true), 600)
+    timers.add(timer)
+  })
+  const reduced = () => typeof matchMedia !== "undefined" && matchMedia("(prefers-reduced-motion: reduce)").matches
+  const absorbedProbes = createMemo(() => loop().probes.filter((p) => p.stage === "absorbed" && !p.cancelled))
+  const onLaneCount = () => loop().probes.filter((p) => !p.cancelled).length
+
+  const toolsText = () =>
+    loop()
+      .coreTools.slice(0, 2)
+      .map((x) => (x.count > 1 ? `${x.name} ×${x.count}` : x.name))
+      .join(" ")
+  const runningTools = () =>
+    Math.min(
+      6,
+      loop().coreTools.reduce((n, x) => n + x.running, 0),
+    )
+  const zoneCount = (zone: LoopZone) => {
+    const c = loop().counts
+    const n =
+      zone === "queue"
+        ? c.queued
+        : zone === "dock"
+          ? c.docked
+          : loop().probes.filter((p) => !p.cancelled && p.stage === "running").length
+    return n ? ` ${n}` : ""
+  }
+
+  const selectedProbe = createMemo(() => {
+    const id = props.selected()
+    return id ? loop().probes.find((p) => p.id === id) : undefined
+  })
+  // What the handoff card shows (user feedback): the selected task; with nothing selected, the newest subagent of the
+  // session; with no subagent at all, the main agent's newest tool call.
+  const latestProbe = () => (props.selected() ? undefined : loop().latest)
+  const shownProbe = () => selectedProbe() ?? latestProbe()
+  const shownTool = () => (props.selected() || loop().latest ? undefined : loop().lastTool)
+  const shownKind = () =>
+    selectedProbe() ? "selected" : props.selected() ? "missing" : loop().latest ? "latest" : loop().lastTool ? "tool" : "empty"
+  const toolStateText = (x: RuntimeTool) =>
+    x.declined
+      ? t(`handoff.declined.${x.declined}`)
+      : x.cancelled
+        ? t("tool.cancelled")
+        : x.interrupted
+          ? t("tool.interrupted")
+          : t(`tool.state.${x.state}`)
+  const toolStateColor = (x: RuntimeTool) =>
+    x.state === "error" && !x.declined && !x.cancelled
+      ? "var(--rt-err)"
+      : x.state === "completed"
+        ? "var(--rt-ok)"
+        : x.state === "running" || x.state === "pending"
+          ? "var(--rt-tool)"
+          : "var(--rt-weak)"
+  const [expanded, setExpanded] = createSignal(false)
+  createEffect(on(props.selected, () => setExpanded(false)))
+
+  const stageText = (p: Probe) =>
+    p.cancelled ? t("loop.cancelled") : p.flag ? t(`loop.flag.${p.flag}` as any) : t(`loop.stage.${p.stage}` as any)
+
+  return (
+    <div
+      ref={root}
+      data-oco-runtime-loop
+      data-oco-runtime-loop-core={core()}
+      data-paused={!visible() || !docVisible() ? "true" : "false"}
+      class="relative flex flex-col min-h-0 min-w-0 gap-[clamp(10px,1.6cqh,16px)]"
+      onKeyDown={(e) => {
+        if (e.key === "Escape" && props.selected()) {
+          e.stopPropagation()
+          props.onSelect(undefined)
+        }
+      }}
+    >
+      <div
+        ref={box}
+        class="flex-1 min-h-0 min-w-0 relative rounded-lg"
+        style={{ background: "var(--rt-panel)", border: "1px solid var(--rt-line)" }}
+      >
+        <svg
+          viewBox={`0 0 ${geo().w} ${geo().h}`}
+          preserveAspectRatio="xMinYMid meet"
+          role="group"
+          aria-label={t("loop.label")}
+          class="absolute inset-0 block w-full h-full"
+          style={{ "font-size": "11px", "font-family": "inherit" }}
+        >
+          <g class={animated() ? undefined : breathe}>
+            <rect
+              x={geo().zone.x}
+              y={geo().zone.y}
+              width={geo().zone.w}
+              height={geo().zone.h}
+              rx="2"
+              fill="none"
+              stroke="var(--rt-line-mid)"
+              stroke-dasharray="3 5"
+              class={moving("oco-loop-dash-zone")}
+            />
+          </g>
+          <text x={geo().zone.x + 10} y={geo().zone.y + 16} fill="var(--rt-faint)">
+            {t("loop.work")}
+            <tspan fill="var(--rt-text)">{zoneCount("work")}</tspan>
+          </text>
+          <path d={geo().lane} fill="none" stroke="var(--rt-line)" stroke-width="3" />
+          <g class={animated() ? undefined : breathe}>
+            <path
+              d={geo().lane}
+              class={moving("oco-loop-dash")}
+              fill="none"
+              stroke="var(--rt-sub)"
+              stroke-width="1.2"
+              stroke-dasharray="3 11"
+              opacity=".5"
+            />
+          </g>
+          <text x={geo().xL + 24} y={geo().titleY} fill="var(--rt-faint)">
+            {t("loop.queue")}
+            <tspan fill="var(--rt-text)">{zoneCount("queue")}</tspan> ›
+          </text>
+          <text x={geo().w - 6} y={geo().h - 4} text-anchor="end" fill="var(--rt-faint)">
+            ‹ {t("loop.dock")}
+            <tspan fill="var(--rt-text)">{zoneCount("dock")}</tspan>
+          </text>
+          <Show when={loop().earlier > 0}>
+            <text
+              data-oco-runtime-loop-earlier={loop().earlier}
+              x={geo().w - 6}
+              y="12"
+              text-anchor="end"
+              fill="var(--rt-faint)"
+            >
+              {t("loop.earlier", { n: loop().earlier })}
+            </text>
+          </Show>
+          <text
+            x={hub()[0]}
+            y={Math.min(geo().h - 4, hub()[1] + geo().r + 32)}
+            text-anchor="middle"
+            fill="var(--rt-weak)"
+            data-oco-runtime-absorbed={absorbedProbes().length}
+          >
+            {t("loop.absorbed", { n: absorbedProbes().length, total: onLaneCount() })}
+          </text>
+
+          <For each={beams()}>
+            {(b) => (
+              <line
+                data-oco-runtime-beam={b.id}
+                class="oco-loop-dash oco-loop-anim"
+                x1={hub()[0] + geo().r}
+                y1={hub()[1]}
+                x2={b.xy[0]}
+                y2={b.xy[1]}
+                stroke="var(--rt-ok)"
+                stroke-width="2"
+                stroke-dasharray="5 4"
+              />
+            )}
+          </For>
+
+          {/* Main agent core */}
+          <circle cx={hub()[0]} cy={hub()[1]} r={geo().r + 16} fill="none" stroke="var(--rt-line)" />
+          <Index each={absorbedProbes().slice(0, MAX_TICKS)}>
+            {(p, i) => {
+              const a = ((-90 + i * 22) * Math.PI) / 180
+              return (
+                <circle
+                  data-oco-runtime-tick={p().id}
+                  cx={hub()[0] + (geo().r + 16) * Math.cos(a)}
+                  cy={hub()[1] + (geo().r + 16) * Math.sin(a)}
