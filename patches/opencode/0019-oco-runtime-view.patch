index 0000000..d8a22a3
--- /dev/null
+++ b/packages/app/src/components/session/session-runtime.tsx
@@ -0,0 +1,1109 @@
+// oco (patches/opencode/0019): 对话 / 轨迹 / 运行 — the runtime view.
+// Fixed-frame Tokyo Night layout (改版 2: 固定框架 / Task 4d).
+import { createEffect, createMemo, createSignal, For, onCleanup, onMount, Show, untrack } from "solid-js"
+import type { Accessor, JSX } from "solid-js"
+import type { Message, Part } from "@opencode-ai/sdk/v2/client"
+import { useSync } from "@/context/sync"
+import { useSDK } from "@/context/sdk"
+import { useServerSync } from "@/context/server-sync"
+import { useLanguage } from "@/context/language"
+import { useProviders } from "@/hooks/use-providers"
+import { getSessionContext } from "./session-context-metrics"
+import { trajectoryText } from "./session-trajectory-i18n"
+import { buildTrajectory } from "./session-trajectory-model"
+import { SessionViewToggle, type SessionViewMode } from "./session-trajectory"
+import { runtimeText, type RuntimeText } from "./session-runtime-i18n"
+import {
+  buildRuntime,
+  collectTreeRequests,
+  eventSessionID,
+  inFlightOf,
+  mergeFreshness,
+  snapshotAt,
+  treeSessionIDs,
+  type ChildLifecycle,
+  type RuntimeAttention,
+  type RuntimeEvent,
+  type RuntimeModel,
+  type RuntimeTool,
+  type Stage,
+} from "./session-runtime-model"
+import { keyed } from "./session-runtime-keyed"
+import {
+  actionsVisible,
+  cancelLabel,
+  failureVisible,
+  FOCUS,
+  lastChildToolIds,
+  retryWait,
+  stopClickExpired,
+  stopClickedAt,
+} from "./session-runtime-actions"
+import { createChildSync } from "./session-runtime-child-sync"
+import { reasoningAt, reasoningOf, type RuntimeReasoning } from "./session-runtime-reasoning"
+import { RuntimeMechanism } from "./session-runtime-mechanism-view"
+import { mechanismOf, rosterOf, slotGlyph } from "./session-runtime-mechanism"
+
+const emptyMessages: Message[] = []
+const emptyParts: Part[] = []
+
+const COLOR = {
+  model: "var(--rt-main)",
+  tool: "var(--rt-tool)",
+  subagent: "var(--rt-sub)",
+  attention: "var(--rt-attn)",
+  error: "var(--rt-err)",
+  ok: "var(--rt-ok)",
+  accent: "var(--rt-accent)",
+} as const
+
+const stageKey = (s: Stage): Exclude<Stage, "idle"> => (s === "idle" ? "prepare" : s)
+
+const ago = (t: RuntimeText["t"], ms: number) => {
+  const s = Math.max(0, Math.round(ms / 1000))
+  if (s < 60) return t("ago.seconds", { value: s })
+  if (s < 3600) return t("ago.minutes", { value: Math.floor(s / 60) })
+  return t("ago.hours", { value: Math.floor(s / 3600) })
+}
+
+const count = (n: number, locale: string) => new Intl.NumberFormat(locale, { notation: "compact" }).format(n)
+
+const attentionText = (t: RuntimeText["t"], a: RuntimeAttention) =>
+  a.kind === "permission"
+    ? t("focus.attention.permission", { what: [a.permission, ...a.patterns].join(" ") })
+    : t("focus.attention.question", { what: a.text })
+
+const eventText = (t: RuntimeText["t"], e: RuntimeEvent) => {
+  if (e.role === "model") return t(`event.${e.kind}` as "event.request.start")
+  const kind = e.kind === "tool.start" ? "start" : e.kind === "tool.end" ? "end" : "error"
+  return t(`event.${e.role}.${kind}` as "event.tool.start", { label: e.label })
+}
+
+const sameRefs = (prev: readonly unknown[], next: readonly unknown[]) => {
+  if (prev.length !== next.length) return false
+  for (let i = 0; i < prev.length; i++) if (prev[i] !== next[i]) return false
+  return true
+}
+
+export function SessionRuntime(props: {
+  sessionID: string
+  onView: (view: SessionViewMode) => void
+  actions?: JSX.Element
+  onStop?: () => void | Promise<unknown>
+  onOpenSession?: (sessionID: string) => void
+}) {
+  const sync = useSync()
+  const sdk = useSDK()
+  const serverSync = useServerSync()
+  const providers = useProviders(() => sdk().directory)
+  const language = useLanguage()
+  const trajectory = trajectoryText(language)
+  const copy = runtimeText(language)
+  const t = copy.t
+
+  const [wall, setWall] = createSignal(Date.now())
+  const [arrived, setArrived] = createSignal<number | undefined>()
+  const [cursor, setCursor] = createSignal<number | undefined>()
+  const [pausedAt, setPausedAt] = createSignal<number | undefined>()
+
+  const info = createMemo(() => sync().session.get(props.sessionID))
+  const messages = createMemo(() => (sync().data.message[props.sessionID] ?? emptyMessages) as Message[])
+  const parts = (messageID: string) => (sync().data.part[messageID] ?? emptyParts) as Part[]
+  const status = createMemo(() => sync().data.session_status[props.sessionID])
+  const busy = createMemo(() => (status()?.type ?? "idle") !== "idle")
+
+  const contextLimit = createMemo(() => getSessionContext(messages(), [...providers.all().values()])?.limit)
+
+  const inFlightMessageID = createMemo(() => inFlightOf(messages(), busy()))
+
+  const treeIds = createMemo(() => treeSessionIDs(props.sessionID, sync().data.session))
+  const treeRequests = createMemo(
+    () => collectTreeRequests(props.sessionID, sync().data.session, sync().data.permission, sync().data.question),
+    { permissions: [], questions: [] } as ReturnType<typeof collectTreeRequests>,
+    {
+      equals: (prev, next) => sameRefs(prev.permissions, next.permissions) && sameRefs(prev.questions, next.questions),
+    },
+  )
+
+  const childMessagesOf = (id: string) => sync().data.message[id] as Message[] | undefined
+  const parentOfSession = (id: string) => sync().session.get(id)?.parentID
+
+  const assemble = (
+    view: { messages: Message[]; parts: (id: string) => Part[]; busy?: boolean },
+    mode: "live" | "replay",
+    at: number,
+    scope?: {
+      sessionID: string
+      busy: boolean
+      status: ReturnType<typeof status>
+      permissions: ReturnType<typeof treeRequests>["permissions"]
+      questions: ReturnType<typeof treeRequests>["questions"]
+      contextLimit?: number
+    },
+  ) => {
+    const built = buildTrajectory({
+      messages: view.messages,
+      parts: view.parts,
+      now: at,
+      busy: mode === "live" ? (scope?.busy ?? busy()) : (view.busy ?? false),
+      language: trajectory,
+    })
+    return buildRuntime(
+      {
+        mode,
+        sessionID: scope?.sessionID ?? props.sessionID,
+        parts: view.parts,
+        status: mode === "live" ? (scope ? scope.status : status()) : undefined,
+        permissions: mode === "live" ? (scope ? scope.permissions : treeRequests().permissions) : [],
+        questions: mode === "live" ? (scope ? scope.questions : treeRequests().questions) : [],
+        childStatus: mode === "live" ? ((id) => sync().data.session_status[id]) : (() => undefined),
+        childMessages: childMessagesOf,
+        parentOf: parentOfSession,
+        requests: built.requests,
+        contextLimit: scope ? scope.contextLimit : contextLimit(),
+      },
+      at,
+    )
+  }
+
+  const assembleChild = (sessionID: string) => {
+    const childMessages = (sync().data.message[sessionID] ?? emptyMessages) as Message[]
+    const childStatus = sync().data.session_status[sessionID]
+    const childBusy = (childStatus?.type ?? "idle") !== "idle"
+    const mode = model().mode
+    const at = mode === "replay" ? (cursor() ?? Date.now()) : Date.now()
+    const view =
+      mode === "replay"
+        ? snapshotAt(childMessages, parts, at, inFlightOf(childMessages, childBusy))
+        : { messages: childMessages, parts, busy: childBusy }
+    const reqs = collectTreeRequests(sessionID, sync().data.session, sync().data.permission, sync().data.question)
+    return assemble(view, mode, at, {
+      sessionID,
+      busy: childBusy,
+      status: childStatus,
+      permissions: reqs.permissions,
+      questions: reqs.questions,
+      contextLimit: getSessionContext(childMessages, [...providers.all().values()])?.limit,
+    })
+  }
+
+  const live = createMemo<RuntimeModel>(() => assemble({ messages: messages(), parts }, "live", Date.now()))
+  const steps = createMemo(() => [...new Set(live().events.map((e) => e.at))])
+  const replay = createMemo<RuntimeModel | undefined>(() => {
+    const at = cursor()
+    return at === undefined ? undefined : assemble(snapshotAt(messages(), parts, at, inFlightMessageID()), "replay", at)
+  })
+  const model = () => replay() ?? live()
+  const freshness = createMemo(() => mergeFreshness(model().freshness, arrived(), model().mode))
+  const stepIndex = createMemo(() => {
+    const at = cursor()
+    return at === undefined ? -1 : steps().filter((x) => x <= at).length - 1
+  })
+  // Live follows the newest step, so the timeline reads "n / n" until the user pauses.
+  const shownStep = () => (cursor() === undefined ? steps().length : stepIndex() + 1)
+  const newSince = createMemo(() => {
+    const p = pausedAt()
+    return p === undefined ? 0 : Math.max(0, steps().length - p)
+  })
+
+  let containerRef: HTMLDivElement | undefined
+  const [isStack, setIsStack] = createSignal(false)
+  const [isNarrow560, setIsNarrow560] = createSignal(false)
+
+  onMount(() => {
+    const tick = setInterval(() => {
+      setWall(Date.now())
+    }, 1000)
+    const stop = sdk().event.listen((e) => {
+      const id = eventSessionID(e.details)
+      if (id && treeIds().has(id)) setArrived(Date.now())
+    })
+    let ro: ResizeObserver | undefined
+    if (typeof ResizeObserver === "function" && containerRef) {
+      ro = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          const w = entry.contentRect.width
+          setIsStack(w < 900)
+          setIsNarrow560(w < 560)
+        }
+      })
+      ro.observe(containerRef)
+      const w = containerRef.clientWidth
+      setIsStack(w < 900)
+      setIsNarrow560(w < 560)
+    }
+    onCleanup(() => {
+      clearInterval(tick)
+      stop()
+      ro?.disconnect()
+    })
+  })
+
+  const pause = () => {
+    setPausedAt(steps().length)
+    setCursor(steps()[steps().length - 1] ?? Date.now())
+  }
+  const goLive = () => {
+    setCursor(undefined)
+    setPausedAt(undefined)
+  }
+  const seek = (index: number) => setCursor(steps()[Math.min(Math.max(index, 0), steps().length - 1)])
+
+  const isSubagent = (x: RuntimeTool) => x.child !== undefined
+  const recentEvents = createMemo(() => model().events.slice(-60))
+  const attention = createMemo(() => model().run.attention)
+
+  const liveSentence = createMemo(() => {
+    const m = model()
+    const state = t(`state.${m.run.state}`) + (m.run.evidence === "inferred" ? ` (${t("evidence.inferred")})` : "")
+    const f = m.focus
+    const focus =
+      f.kind === "attention"
+        ? attentionText(t, f.attention)
+        : f.kind === "retry"
+          ? t("focus.retry", { attempt: f.attempt, message: f.message })
+          : f.kind === "error"
+            ? f.message
+              ? t("focus.error", { message: f.message })
+              : t("focus.error.unknown")
+            : f.kind === "working"
+              ? f.tool
+                ? t("focus.working.tool", { tool: f.tool.child?.agent ?? f.tool.name, input: f.tool.input })
+                : t(`stage.${stageKey(f.stage)}`)
+              : t(`focus.${f.kind}`)
+    return `${state}. ${focus}`
+  })
+
+  const eventKeys = keyed(recentEvents, (e) => e.id)
+  const attentionKeys = keyed(attention, (a) => a.id)
+
+  const mechanism = createMemo(() =>
+    mechanismOf(model(), (id) => (childMessagesOf(id) ? assembleChild(id) : undefined)),
+  )
+
+  const treeToolIds = createMemo(() => {
+    const m = mechanism()
+    return new Set([...m.tools.map((s) => s.toolID), ...m.children.map((s) => s.toolID)])
+  })
+
+  // Outside the tree but still worth a look. Tools the user stopped or whose permission the user rejected are the
+  // user's own decisions, not issues (rejection text: packages/core/src/v1/permission.ts).
+  const userRejected = (tool: RuntimeTool) => tool.state === "error" && /^The user rejected permission/.test(tool.lastOutput ?? "")
+  const otherAttentionTools = createMemo(() => {
+    const ids = treeToolIds()
+    return model().tools.filter(
+      (t) =>
+        !ids.has(t.id) &&
+        !t.cancelled &&
+        !userRejected(t) &&
+        (t.state === "error" || t.interrupted || Boolean(t.awaiting)),
+    )
+  })
+
+  const rosterItems = createMemo(() =>
+    rosterOf(model(), (id) => (childMessagesOf(id) ? assembleChild(id) : undefined)),
+  )
+
+  const summaryAgent = () => mechanism().main.agent ?? t("mechanism.main")
+  const summaryModel = () => mechanism().main.model ?? t("runtime.unknown")
+  const summaryRequest = () => t("summary.request", { n: mechanism().main.request })
+
+  // Same count as the roster: one per child session.
+  const summaryChildren = () => {
+    const items = rosterItems()
+    const running = items.filter((x) => x.lifecycle === "running" || x.lifecycle === "retrying").length
+    return t("summary.children", { running, total: items.length })
+  }
+
+  const summaryTools = () => {
+    const nonSub = model().tools.filter((t) => !isSubagent(t))
+    const running = nonSub.filter(
+      (t) => (t.state === "running" || t.state === "pending") && !t.awaiting && !t.interrupted,
+    ).length
+    const waiting = nonSub.filter((t) => Boolean(t.awaiting)).length
+    return t("summary.tools", { running, waiting })
+  }
+
+  const summaryUsage = () => {
+    const u = model().usage.tokens
+    if (!u) {
+      return model().usage.requests === 0
+        ? t("usage.none")
+        : model().usage.settled
+          ? t("usage.unknown")
+          : t("usage.counting")
+    }
+    return `${count(u.input, copy.intl())} / ${count(u.output, copy.intl())}`
+  }
+
+  const summaryContext = () => {
+    const c = getSessionContext(messages(), [...providers.all().values()])
+    if (!c || c.limit === undefined) return ""
+    return t("summary.context", {
+      used: count(c.total ?? 0, copy.intl()),
+      limit: count(c.limit, copy.intl()),
+    })
+  }
+
+  const summaryCost = () => {
+    const reqs = model().requests
+    const cost = reqs.reduce((acc, r) => acc + (r.cost ?? 0), 0)
+    return cost > 0 ? t("summary.cost", { cost: cost.toFixed(4) }) : undefined
+  }
+
+  const activeReasonings = createMemo<RuntimeReasoning[]>(() => {
+    const m = model()
+    if (m.mode === "replay") {
+      const at = cursor()
+      if (at === undefined) return []
+      const reqs = m.requests
+      const lastReq = reqs[reqs.length - 1]
+      if (!lastReq) return []
+      return reasoningAt(parts(lastReq.messageID), at)
+    }
+    const inFlight = inFlightMessageID()
+    const targetID = inFlight ?? m.requests[m.requests.length - 1]?.messageID
+    if (!targetID) return []
+    return reasoningOf(parts(targetID), inFlight === targetID)
+  })
+
+  // Reasoning shown in the think box: the root's, or an entered child's (its latest assistant message).
+  const reasoningFor = (sessionID?: string): RuntimeReasoning[] => {
+    if (!sessionID) return activeReasonings()
+    const msgs = childMessagesOf(sessionID)
+    const last = msgs && [...msgs].reverse().find((m) => m.role === "assistant")
+    if (!msgs || !last) return []
+    if (model().mode === "replay") {
+      const at = cursor()
+      return at === undefined ? [] : reasoningAt(parts(last.id), at)
+    }
+    const childBusy = (sync().data.session_status[sessionID]?.type ?? "idle") !== "idle"
+    return reasoningOf(parts(last.id), inFlightOf(msgs, childBusy) === last.id)
+  }
+
+  const [openChildren, setOpenChildren] = createSignal<ReadonlySet<string>>(new Set())
+  const childOpen = (id: string) => openChildren().has(id)
+
+  const childSync = createChildSync({
+    sync: (id) => sync().session.sync(id),
+    pin: (id) => serverSync().session.pin(id),
+    unpin: (id) => serverSync().session.unpin(id),
+    childModel: (id) => (childMessagesOf(id) ? assembleChild(id) : undefined),
+    turn: () => live().requests[live().requests.length - 1]?.turn,
+    open: openChildren,
+    tools: () => live().tools,
+  })
+
+  const toggleChild = (id: string) => {
+    const opening = !openChildren().has(id)
+    setOpenChildren((prev) => {
+      const next = new Set(prev)
+      if (next.has(id)) next.delete(id)
+      else next.add(id)
+      return next
+    })
+    if (opening && (!childSync.synced.has(id) || childSync.failed.has(id) || childMessagesOf(id) === undefined)) {
+      childSync.requestSync(id)
+    }
+  }
+
+  // Navigation stack for entering subagents
+  const [enteredStack, setEnteredStack] = createSignal<string[]>([])
+  const onEnterChild = (id: string) => {
+    if (!openChildren().has(id)) {
+      toggleChild(id)
+    }
+    setEnteredStack((prev) => [...prev, id])
+  }
+  const onNavigateCrumb = (index: number) => {
+    setEnteredStack((prev) => (index < 0 ? [] : prev.slice(0, index + 1)))
+  }
+
+  // Tool detail panel state
+  const [openDetailId, setOpenDetailId] = createSignal<string | undefined>()
+  const onToggleDetail = (id: string | undefined) => {
+    setOpenDetailId((prev) => (prev === id ? undefined : id))
+  }
+
+  const [pending, setPending] = createSignal<Readonly<Record<string, true>>>({})
+  const [failed, setFailed] = createSignal<Readonly<Record<string, true>>>({})
+  const [clickedAt, setClickedAt] = createSignal<number | undefined>()
+
+  const lastRequestStart = () => {
+    const reqs = model().requests
+    return reqs.length ? reqs[reqs.length - 1]!.start : undefined
+  }
+  const cancelKind = () => cancelLabel(clickedAt(), busy(), model().focus.kind, lastRequestStart(), model().mode)
+
+  const pruneGone = (prev: Readonly<Record<string, true>>, liveIds: ReadonlySet<string>) => {
+    let changed = false
+    const next: Record<string, true> = {}
+    for (const id in prev) {
+      if (liveIds.has(id)) next[id] = true
+      else changed = true
+    }
+    return changed ? next : prev
+  }
+
+  createEffect(() => {
+    const liveIds = new Set(live().run.attention.map((item) => item.id))
+    setPending((prev) => pruneGone(prev, liveIds))
+    setFailed((prev) => pruneGone(prev, liveIds))
+  })
+
+  createEffect(() => {
+    const at = clickedAt()
+    if (at === undefined) return
+    const reqs = live().requests
