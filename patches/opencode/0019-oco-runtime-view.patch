+          ),
+        ),
+      ].sort((a, b) => a.at - b.at)
+      return c
+    })(),
+  })
+  const bg = sub({
+    end: 2500,
+    child: steps(),
+    background: {
+      taskId: "bg_1",
+      retrievedAt: 9000,
+      notices: [
+        { at: 4000, kind: "done" },
+        { at: 5000, kind: "cleared" },
+        { at: 8000, kind: "done" },
+      ],
+    },
+  })
+  for (const [name, s] of [
+    ["sync", rich],
+    ["background", bg],
+  ] as const)
+    test(`subDetailAt / subStateAt equal on data truncated at t (${name}, wide and narrow)`, () => {
+      const ts = timesOf(s)
+      expect(ts.length).toBeGreaterThan(20)
+      for (const t of ts) {
