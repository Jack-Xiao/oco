+        messageID: "msg-0",
+        turn: 0,
+        start: 1000,
+        status: "running",
+        cancelled: false,
+        evidence: "event",
+        settled: false,
+        known: false,
+      },
+    ],
+    tools: [],
+    events: [],
+    usage: { requests: 1, knownRequests: 0, settled: false, context: {} },
+    ...overrides,
+  }
+}
