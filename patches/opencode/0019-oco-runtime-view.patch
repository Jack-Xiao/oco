+    const rej = subDetailAt(rejected, 2400, { narrow: false })!.acts.items[0]
+    expect(rej).toMatchObject({ glyph: "⊘", line2: { key: "ring.tools.row.rejected" }, border: "faint" })
+    if (rej.kind !== "tool") throw new Error("expected a tool row")
+    expect(rej.glyph).not.toBe("✗")
+    expect(rej.border).not.toBe("err")
+    const dismissed = sub({
+      child: child({
