+describe("loopGeometry work zone", () => {
+  test("the work zone stays in the right part of the loop and fits fewer cells on a short lane", () => {
+    for (const [w, h] of [
+      [900, 237],
+      [1100, 200],
+      [1600, 300],
+      [2400, 237],
+    ]) {
+      const g = loopGeometry(w, h)
+      expect(g.workCap).toBeGreaterThanOrEqual(1)
+      expect(g.workCap).toBeLessThanOrEqual(12)
+      expect(g.zone.x).toBeGreaterThanOrEqual(g.xL + (g.xArc - g.xL) * 0.5 - 1)
+    }
+    expect(loopGeometry(900, 237).workCap).toBe(10)
+  })
+
+  test("the arc runs through the work zone: the zone's right edge sticks out past the arc", () => {
+    const g = loopGeometry(900, 237)
+    const apex = Math.max(...g.track.slice(g.arc[0], g.arc[1]).map((p) => p[0]))
+    expect(g.zone.x + g.zone.w).toBeGreaterThan(apex + 10)
+    expect(g.zone.x).toBeLessThan(apex)
+  })
+
+  test("routes follow the lane: dispatch lane → arc → work cell → arc → return lane → hub", () => {
+    const g = loopGeometry(900, 237)
+    const hub = { kind: "hub" as const, xy: g.hub }
+    const queue = { kind: "queue" as const, xy: g.slots.queue[0] }
+    const work = { kind: "work" as const, xy: g.slots.work[0] }
+    const dock = { kind: "dock" as const, xy: g.slots.dock[0] }
+    const onArc = (path: readonly (readonly [number, number])[]) =>
+      path.some((p) => g.track.indexOf(p) >= g.arc[0] && g.track.indexOf(p) < g.arc[1])
+    const toWork = routeOf(g, queue, work)
+    expect(toWork[0]).toBe(queue.xy)
+    expect(toWork[toWork.length - 1]).toBe(work.xy)
+    // Along the dispatch lane, dropping into the zone from the lane point nearest the cell.
+    expect(toWork.slice(1, -1).every((p) => Math.abs(p[1] - g.slots.queue[0][1]) < 1)).toBe(true)
+    expect(Math.abs(toWork[toWork.length - 2][0] - work.xy[0])).toBeLessThan(8)
+    // A cell on the arc's side is reached along the arc.
+    const far = { kind: "work" as const, xy: [g.zone.x + g.zone.w - 20, g.hub[1]] as const }
+    expect(onArc(routeOf(g, queue, far))).toBe(true)
+    // To the dock: through the arc when the cell sits right of the dock slot's way, else straight down onto the
+    // return lane; either way the last lane point is on the return lane.
+    const toDock = routeOf(g, work, dock)
+    expect(toDock[toDock.length - 1]).toBe(dock.xy)
+    expect(toDock[toDock.length - 2][1]).toBeCloseTo(g.slots.dock[0][1], 0)
+    const farToDock = routeOf(g, far, { kind: "dock", xy: g.slots.dock[4] })
+    expect(onArc(farToDock)).toBe(true)
+    const home = routeOf(g, dock, hub)
+    expect(home[home.length - 1]).toBe(g.hub)
+    expect(home.length).toBeGreaterThan(5)
+    const out = routeOf(g, hub, queue)
+    expect(out[1]).toBe(g.track[0])
+    // A stage that jumped ahead still passes the work zone and, for a background task, the dock.
+    const zc = [g.zone.x + g.zone.w / 2, g.zone.y + g.zone.h / 2]
+    const viaWork = (p: readonly (readonly [number, number])[]) => p.some((q) => q[0] === zc[0] && q[1] === zc[1])
+    const bgTrip = tripOf(g, queue, hub, true)
+    expect(viaWork(bgTrip)).toBe(true)
+    expect(bgTrip).toContain(g.slots.dock[0])
+    expect(bgTrip[bgTrip.length - 1]).toBe(g.hub)
+    const syncTrip = tripOf(g, queue, hub, false)
+    expect(viaWork(syncTrip)).toBe(true)
+    expect(syncTrip).not.toContain(g.slots.dock[0])
+    expect(tripOf(g, work, dock, true)).toEqual(routeOf(g, work, dock))
+    // Backwards or within one zone: a straight hop.
+    expect(routeOf(g, dock, queue)).toHaveLength(2)
+    expect(routeOf(g, work, { kind: "work", xy: g.slots.work[1] })).toHaveLength(2)
+  })
+
+  test("layoutLoop honours a smaller work capacity", () => {
+    const probes = Array.from({ length: 5 }, (_, i) => ({
