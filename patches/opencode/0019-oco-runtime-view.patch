+          <circle
+            cx={hub()[0]}
+            cy={hub()[1]}
+            r={geo().r}
+            fill="var(--rt-inset)"
+            stroke="var(--rt-main)"
+            stroke-width="1.6"
+          />
+          <text
+            x={hub()[0]}
+            y={hub()[1] - (geo().r >= 34 ? 8 : 2)}
+            text-anchor="middle"
+            fill="var(--rt-main)"
+            style={{ "font-size": "12px" }}
+          >
+            {fitText(props.agent(), geo().r * 2 - 10)}
+          </text>
+          <Show when={loop().round.turn > 0}>
+            <text
+              data-oco-runtime-round={loop().round.turn}
+              data-oco-runtime-round-requests={loop().round.requests}
+              data-oco-runtime-round-tools={loop().round.tools}
+              x={hub()[0]}
+              y={hub()[1] + (geo().r >= 34 ? 7 : 11)}
+              text-anchor="middle"
+              fill="var(--rt-weak)"
+            >
+              <title>
+                {t("loop.round.tip", {
+                  turn: loop().round.turn,
+                  requests: loop().round.requests,
+                  tools: loop().round.tools,
+                  children: onLaneCount(),
+                })}
