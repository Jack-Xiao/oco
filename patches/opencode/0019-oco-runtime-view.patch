+
+const zh = runtimeText({ locale: () => "zh", intl: () => "zh-CN" })
+const en = runtimeText({ locale: () => "en", intl: () => "en-US" })
+
+const fixture = loadM5Fixture()
+const oracle = loadM5Oracle()
+const index = buildRingIndex(fixture.input)
+const MIN = 60_000
+const frames = new Map(oracle.frames.map((o) => [o.id, frameAt(index, o.t, { reduced: false, wide: true })]))
+const frame = (id: string): RingFrame => {
+  const f = frames.get(id)
+  if (!f) throw new Error(`no keyframe ${id}`)
+  return f
+}
+const oracleOf = (id: string): M5OracleFrame => {
+  const o = oracle.frames.find((x) => x.id === id)
+  if (!o) throw new Error(`no oracle frame ${id}`)
+  return o
+}
+
+// ---------- differences between the mockup's verdicts and the plan's decisions (printed at the end) ----------
+const diffs: string[] = []
+afterAll(() => {
+  console.log(`[ring-keyframes] ${diffs.length} documented difference(s) from the mockup's verdicts${diffs.length ? ":" : " (none on these 14 keyframes)"}`)
+  for (const d of diffs) console.log(`[ring-keyframes]   ${d}`)
+})
+
+/** t lies after one step of the child session completed and before its next step was created (D16). */
+const betweenSteps = (sub: RingSub, t: number) => {
+  const m = sub.child?.messages ?? []
+  return m.some((a, i) => a.completed !== undefined && a.completed <= t && i + 1 < m.length && m[i + 1].created > t)
+}
+// the mockup writes seconds as "0.7 秒" and a clock in the machine's zone (UTC+8 when the fixture was captured)
+const squash = (s: string) => s.replace(/\s+/g, "").replace(/\d{2}:\d{2}:\d{2}/g, "HH:MM:SS")
