+    const perm = { id: "per_wait", sessionID: "ses_wait", permission: "bash", patterns: [], metadata: {}, always: [] } as any
+    const retry = { type: "retry", attempt: 1, message: "429", next: T0 + 9_000 } as const
+    const messages: Record<string, any[] | undefined> = {
+      ses_done: [assistant(u, T0 + 500, { sessionID: "ses_done" })],
