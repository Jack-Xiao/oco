diff --git a/packages/app/src/utils/oco-worktree-events.ts b/packages/app/src/utils/oco-worktree-events.ts
new file mode 100644
index 0000000..444945d
--- /dev/null
+++ b/packages/app/src/utils/oco-worktree-events.ts
@@ -0,0 +1,22 @@
+// oco (patches/opencode/0023): the new layout never resolves a pending worktree (only the legacy layout listens
+// for worktree.ready / worktree.failed), so a new-session page that creates one would wait for the 5-minute
+// timeout before sending. The embedded host mounts this on the new-session page and the session page, which
+// together cover the whole create → navigate → send sequence.
+import { onCleanup } from "solid-js"
+import { useLanguage } from "@/context/language"
+import { usePlatform } from "@/context/platform"
+import { useServerSDK } from "@/context/server-sdk"
+import { Worktree } from "@/utils/worktree"
+
+export function useOcoWorktreeEvents() {
+  const platform = usePlatform()
+  if (!platform.embedded) return
+  const serverSDK = useServerSDK()
+  const language = useLanguage()
+  const unsub = serverSDK().event.listen((e) => {
+    if (e.details?.type === "worktree.ready") Worktree.ready(serverSDK().scope, e.name)
+    if (e.details?.type === "worktree.failed")
+      Worktree.failed(serverSDK().scope, e.name, e.details.properties?.message ?? language.t("common.requestFailed"))
+  })
+  onCleanup(unsub)
+}
