+const dicts: Partial<Record<string, Record<Key, string>>> = { zh, zht }
+
+export type TrajectoryText = ReturnType<typeof trajectoryText>
+
+/** Reads the app language reactively; call t / plural inside tracked scopes. */
+export function trajectoryText(language: Pick<ReturnType<typeof useLanguage>, "locale" | "intl">) {
+  const dict = () => dicts[language.locale()] ?? en
+  const fill = (text: string, params: Params = {}) =>
+    text.replace(/{{\s*(\w+)\s*}}/g, (_, name: string) => String(params[name] ?? ""))
+  return {
+    intl: language.intl,
+    t: (key: TextKey, params?: Params) => fill(dict()[key], params),
+    plural: (key: PluralKey, count: number, params?: Params) => {
+      const current = dict() as Record<string, string>
+      return fill(current[`${key}.${pluralCategory(language.intl(), count)}`] ?? current[`${key}.other`]!, { ...params, count })
+    },
+  }
+}
