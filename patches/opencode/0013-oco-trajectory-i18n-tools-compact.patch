+      open = undefined
+      items.push({ kind: "row", row })
+      continue
+    }
+    if (!open || open.turn !== row.turn) {
+      open = { id: `group:${row.id}`, turn: row.turn, rows: [], steps: 0, tools: [], firstOfRequest: false }
+      items.push({ kind: "group", group: open })
+    }
+    if (open.rows.at(-1)?.request !== row.request) open.steps++
+    open.rows.push(row)
+    if (row.kind === "tool") open.tools.push(row.tool)
+    if (row.firstOfRequest) open.firstOfRequest = true
+  }
+  return items
