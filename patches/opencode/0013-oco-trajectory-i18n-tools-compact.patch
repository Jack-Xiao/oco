+/** Compact list: within a turn, each run of thinking, tool calls and file changes folds into one
+ *  summary item. User input, context, replies, retries and errors stay visible. */
+export function groupRows(rows: TrajectoryRow[]): TrajectoryItem[] {
+  const items: TrajectoryItem[] = []
+  let open: TrajectoryGroup | undefined
+  for (const row of rows) {
+    const fold =
+      row.request !== undefined && (row.kind === "reasoning" || row.kind === "tool" || (row.kind === "event" && !row.error))
