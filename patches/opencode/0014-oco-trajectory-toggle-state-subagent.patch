+export type TrajectorySubagent = { agent: string; description: string; session?: string }
+
+/** OpenCode has no tool per subagent: the `task` tool names the agent in `subagent_type` and
+ *  records the child session it created in `metadata.sessionId`. */
+export function subagentOf(part: ToolPart): TrajectorySubagent | undefined {
+  if (part.tool !== "task") return
+  const input = part.state.input as Record<string, unknown> | undefined
+  const agent = input?.subagent_type
+  if (typeof agent !== "string" || !agent) return
+  const metadata = "metadata" in part.state ? (part.state.metadata as Record<string, unknown> | undefined) : undefined
+  return {
+    agent,
+    description: typeof input?.description === "string" ? input.description : "",
+    session: typeof metadata?.sessionId === "string" ? metadata.sessionId : undefined,
+  }
+}
+
+/** A `task` call's output wraps the subagent's answer in `<task …><task_result>…</task_result></task>`. */
+function taskResult(part: ToolPart) {
+  if (part.tool !== "task" || part.state.status !== "completed") return ""
+  return /<task_result>([\s\S]*?)<\/task_result>/.exec(part.state.output)?.[1]?.trim() ?? ""
+}
