{
  "name": "oco-root",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": ["apps/extension", "packages/contracts"],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "bun run build:webview && bun run build:extension",
    "build:webview": "bash scripts/build-webview.sh",
    "build:extension": "bun run --cwd apps/extension build",
    "typecheck": "tsc -p packages/contracts && tsc -p apps/extension --noEmit",
    "test:unit": "bun test tests/unit",
    "test:server": "bash scripts/test-server.sh",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:bench": "node tests/bench/run.mjs",
    "brief": "node scripts/brief.mjs",
    "verify:brief": "node scripts/brief.mjs --verify"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/vscode": "1.95.0",
    "esbuild": "0.25.10",
    "mermaid": "11.17.2",
    "playwright-core": "1.56.1",
    "typescript": "5.8.2"
  }
}
