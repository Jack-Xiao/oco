{
  "name": "oco",
  "displayName": "oco (OpenCode for VS Code)",
  "description": "OpenCode v1 sessions in the VS Code sidebar and editor tabs (attached server).",
  "version": "0.0.4",
  "publisher": "oco-local-test",
  "icon": "media/icon.png",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:oco.chat",
    "onView:oco.sessions",
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "oco-logo": {
        "description": "oco",
        "default": {
          "fontPath": "media/oco-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "commands": [
      {
        "command": "oco.openSession",
        "title": "Open Session",
        "category": "oco",
        "icon": "$(go-to-file)"
      },
      {
        "command": "oco.openSessionInNewPanel",
        "title": "Open in New Panel",
        "category": "oco",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "oco.newSession",
        "title": "New Session",
        "category": "oco",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.renameSession",
        "title": "Rename Session",
        "category": "oco",
        "icon": "$(edit)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.archiveSession",
        "title": "Archive Session",
        "category": "oco",
        "icon": "$(archive)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.deleteSession",
        "title": "Delete Session",
        "category": "oco",
        "icon": "$(trash)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.pinSession",
        "title": "Pin Session",
        "category": "oco",
        "icon": "$(pinned)"
      },
      {
        "command": "oco.unpinSession",
        "title": "Unpin Session",
        "category": "oco",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "oco.markSessionsUnread",
        "title": "Mark Session as Unread",
        "category": "oco",
        "icon": "$(mail)"
      },
      {
        "command": "oco.compactSession",
        "title": "Compact Session (summarize context)",
        "category": "oco",
        "icon": "$(fold)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.exportSession",
        "title": "Export Session as Markdown",
        "category": "oco",
        "icon": "$(markdown)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.exportSessionToFile",
        "title": "Export Session to File…",
        "category": "oco",
        "icon": "$(save)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.sessions.stop",
        "title": "Stop Session",
        "category": "oco",
        "icon": "$(debug-stop)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.sessions.stopAllRunning",
        "title": "Stop All Running Sessions…",
        "category": "oco",
        "icon": "$(debug-stop)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.addToDraft",
        "title": "Add to Draft… (Problems / Git diff)",
        "category": "oco",
        "icon": "$(add)"
      },
      {
        "command": "oco.addTerminalOutputToDraft",
        "title": "Add Terminal Output to Session Draft",
        "category": "oco"
      },
      {
        "command": "oco.addProblemToDraft",
        "title": "Add Problem to Session Draft",
        "category": "oco"
      },
      {
        "command": "oco.addGitDiffToDraft",
        "title": "Add Git Diff to Session Draft",
        "category": "oco"
      },
      {
        "command": "oco.git.askCommit",
        "title": "Ask Agent to Commit Changes",
        "category": "oco"
      },
      {
        "command": "oco.git.commitWithOpenCode",
        "title": "Commit with OpenCode",
        "category": "oco"
      },
      {
        "command": "oco.git.askOpenPR",
        "title": "Ask Agent to Open a Pull Request",
        "category": "oco"
      },
      {
        "command": "oco.git.openScm",
        "title": "Open Source Control View",
        "category": "oco"
      },
      {
        "command": "oco.fixWithOpenCode",
        "title": "Fix with OpenCode",
        "category": "oco"
      },
      {
        "command": "oco.searchSessions",
        "title": "Search Sessions",
        "category": "oco",
        "icon": "$(search)"
      },
      {
        "command": "oco.loadMoreSessions",
        "title": "Load More Sessions",
        "category": "oco"
      },
      {
        "command": "oco.clearSearch",
        "title": "Clear Session Search",
        "category": "oco",
        "icon": "$(clear-all)"
      },
      {
        "command": "oco.reconnect",
        "title": "Reconnect",
        "category": "oco",
        "icon": "$(refresh)"
      },
      {
        "command": "oco.openSettings",
        "title": "Open Settings",
        "category": "oco",
        "icon": "$(gear)"
      },
      {
        "command": "oco.addSelectionToDraft",
        "title": "Add Selection to Session Draft",
        "category": "oco"
      },
      {
        "command": "oco.addToReviewNotes",
        "title": "Add to Review Notes",
        "category": "oco"
      },
      {
        "command": "oco.reviewNotes.sendAll",
        "title": "Send Review Notes to Draft",
        "category": "oco"
      },
      {
        "command": "oco.reviewNotes.clear",
        "title": "Clear Review Notes",
        "category": "oco"
      },
      {
        "command": "oco.setServerPassword",
        "title": "Set Server Password",
        "category": "oco"
      },
      {
        "command": "oco.debugState",
        "title": "Debug State",
        "category": "oco"
      },
      {
        "command": "oco.restartManagedServer",
        "title": "Restart Managed Server",
        "category": "oco",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.stopManagedServer",
        "title": "Stop Managed Server",
        "category": "oco"
      },
      {
        "command": "oco.showLog",
        "title": "Show Log",
        "category": "oco"
      },
      {
        "command": "oco.exportDiagnostics",
        "title": "Export Diagnostics",
        "category": "oco"
      },
      {
        "command": "oco.selectFolder",
        "title": "Select Workspace Folder",
        "category": "oco",
        "icon": "$(root-folder)"
      },
      {
        "command": "oco.inbox.next",
        "title": "Inbox: Next Action",
        "category": "oco"
      },
      {
        "command": "oco.session.parent",
        "title": "Open Parent Session",
        "category": "oco"
      },
      {
        "command": "oco.session.child",
        "title": "Open Child Session",
        "category": "oco"
      },
      {
        "command": "oco.session.nextSibling",
        "title": "Open Next Sibling Session",
        "category": "oco"
      },
      {
        "command": "oco.session.previousSibling",
        "title": "Open Previous Sibling Session",
        "category": "oco"
      },
      {
        "command": "oco.session.recent",
        "title": "Switch to Recent Session",
        "category": "oco"
      },
      {
        "command": "oco.follow.toggle",
        "title": "Toggle Follow Mode",
        "category": "oco",
        "icon": "$(eye)"
      },
      {
        "command": "oco.follow.toggleOff",
        "title": "Toggle Follow Mode",
        "category": "oco",
        "icon": "$(eye-closed)"
      },
      {
        "command": "oco.reviewNotes.removeNote",
        "title": "Remove Note",
        "category": "oco",
        "icon": "$(trash)"
      },
      {
        "command": "oco.reviewNotes.createNote",
        "title": "Add Review Note",
        "category": "oco",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oco.newSession",
          "when": "view == oco.sessions",
          "group": "navigation@1"
        },
        {
          "command": "oco.searchSessions",
          "when": "view == oco.sessions",
          "group": "navigation@2"
        },
        {
          "command": "oco.clearSearch",
          "when": "view == oco.sessions && oco.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "oco.reconnect",
          "when": "view == oco.sessions",
          "group": "navigation@4"
        },
        {
          "command": "oco.openSettings",
          "when": "view == oco.sessions",
          "group": "navigation@5"
        },
        {
          "command": "oco.selectFolder",
          "when": "view == oco.sessions && oco.multiRoot",
          "group": "navigation@0"
        }
      ],
      "webview/context": [
        {
          "command": "oco.openSessionInNewPanel",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "0_open@1"
        },
        {
          "command": "oco.sessions.stop",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session' && running",
          "group": "0_run@1"
        },
        {
          "command": "oco.renameSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "1_edit@1"
        },
        {
          "command": "oco.archiveSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "1_edit@2"
        },
        {
          "command": "oco.deleteSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "1_edit@3"
        },
        {
          "command": "oco.compactSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "2_context@1"
        },
        {
          "command": "oco.exportSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "2_context@2"
        },
        {
          "command": "oco.exportSessionToFile",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "2_context@3"
        },
        {
          "command": "oco.pinSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session' && !pinned",
          "group": "3_organize@1"
        },
        {
          "command": "oco.unpinSession",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session' && pinned",
          "group": "3_organize@1"
        },
        {
          "command": "oco.markSessionsUnread",
          "when": "webviewId == 'oco.sessions' && webviewSection == 'session'",
          "group": "3_organize@2"
        }
      ],
      "commandPalette": [
        {
          "command": "oco.addProblemToDraft",
          "when": "false"
        },
        {
          "command": "oco.fixWithOpenCode",
          "when": "false"
        },
        {
          "command": "oco.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "oco.clearSearch",
          "when": "oco.searchActive"
        },
        {
          "command": "oco.selectFolder",
          "when": "oco.multiRoot"
        },
        {
          "command": "oco.sessions.stop",
          "when": "false"
        },
        {
          "command": "oco.follow.toggleOff",
          "when": "false"
        },
        {
          "command": "oco.reviewNotes.removeNote",
          "when": "false"
        },
        {
          "command": "oco.reviewNotes.createNote",
          "when": "false"
        },
        {
          "command": "oco.git.commitWithOpenCode",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "oco.follow.toggle",
          "when": "activeWebviewPanelId == 'oco.chat' && !oco.follow.active",
          "group": "navigation"
        },
        {
          "command": "oco.follow.toggleOff",
          "when": "activeWebviewPanelId == 'oco.chat' && oco.follow.active",
          "group": "navigation"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "oco.reviewNotes.removeNote",
          "title": "Remove Note",
          "when": "commentThread == oco.reviewNote",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "oco.reviewNotes.createNote",
          "title": "Add Review Note",
          "group": "inline"
        }
      ],
      "terminal/context": [
        {
          "command": "oco.addTerminalOutputToDraft",
          "group": "oco"
        }
      ],
      "problems/context": [
        {
          "command": "oco.addProblemToDraft",
          "group": "oco"
        }
      ],
      "scm/title": [
        {
          "command": "oco.addGitDiffToDraft",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "oco.git.commitWithOpenCode",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "oco.git.askOpenPR",
          "when": "scmProvider == git",
          "group": "1_oco@1"
        }
      ],
      "editor/context": [
        {
          "command": "oco.addSelectionToDraft",
          "group": "oco@1"
        },
        {
          "command": "oco.addToReviewNotes",
          "when": "editorHasSelection",
          "group": "oco@2"
        }
      ]
    },
    "configuration": {
      "title": "oco",
      "properties": {
        "oco.decorations.changedFiles": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Show badges on files modified in the active OpenCode session's most recent diff."
        },
        "oco.serverMode": {
          "type": "string",
          "enum": [
            "attached",
            "managed"
          ],
          "default": "attached",
          "scope": "machine",
          "enumDescriptions": [
            "Attach to an existing server (oco.serverUrl). oco never starts, stops, or modifies it.",
            "oco starts one `opencode serve` in this window (127.0.0.1 only, random port, random password), shared by every session tab. Closing the window or disabling the extension stops only that process."
          ],
          "markdownDescription": "How oco connects. `attached`: connect to the existing server at `oco.serverUrl`. `managed`: oco starts and manages its own server with `oco.opencodePath` (the workspace must be trusted). An unexpected exit does not restart forever; run “oco: Restart Managed Server” to start it again. User settings only (machine scope)."
        },
        "oco.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4096",
          "scope": "machine",
          "markdownDescription": "Address of a running OpenCode server. Origin only, for example `http://127.0.0.1:4096` or `https://oc.example.com`. Do not include a path or credentials. User settings only (machine scope); a workspace or repository cannot override this. Used when `oco.serverMode` is `attached` (the default). oco only connects to that server and never starts, stops, or modifies it. Changing it reconnects. Open session tabs stay bound to the previous address and are not moved."
        },
        "oco.serverUsername": {
          "type": "string",
          "default": "opencode",
          "scope": "machine",
          "markdownDescription": "HTTP Basic username for the server. Defaults to `opencode` and must match the server. **Do not enter the password here.** Run “oco: Set Server Password”. The password is stored in VS Code Secret Storage (per address and username), not in settings.json."
        },
        "oco.opencodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to the OpenCode executable used in managed mode, for example `/usr/local/bin/opencode`. Leave empty to look up `opencode` on the extension host `PATH` (on a remote window, the remote machine's PATH). oco does not install or upgrade OpenCode. User settings only (machine scope)."
        },
        "oco.sessions.notifyPending": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Show a desktop warning notification when background sessions or subagents are waiting for permission or an answer.",
          "markdownDeprecationMessage": "Replaced by `#oco.notify.needsMe#` and `#oco.notify.finished#`. If this is set to `false` and neither new setting is set, both stay off."
        },
        "oco.notify.needsMe": {
          "type": "string",
          "enum": [
            "off",
            "windowNotFocused",
            "always"
          ],
          "enumDescriptions": [
            "Never.",
            "Only when this VS Code window is not focused.",
            "Always, except for the session you have in front of you."
          ],
          "default": "windowNotFocused",
          "scope": "machine",
          "markdownDescription": "Notify when a background session or subagent needs you: waiting for permission or an answer. Notifications appear inside VS Code, not in the system notification center."
        },
        "oco.notify.finished": {
          "type": "string",
          "enum": [
            "off",
            "windowNotFocused",
            "always"
          ],
          "enumDescriptions": [
            "Never.",
            "Only when this VS Code window is not focused.",
            "Always, except for the session you have in front of you."
          ],
          "default": "windowNotFocused",
          "scope": "machine",
          "markdownDescription": "Notify when a background session finishes or fails, with a one-line result summary and Open / Diff. Notifications appear inside VS Code, not in the system notification center."
        },
        "oco.statusBar.hud": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Show the focused session's model, context usage and cost in the status bar."
        },
        "oco.git.commitPrompt": {
          "type": "string",
          "default": "Commit the current changes in this repository.\nBranch: ${branch}\nChanged files (${count}):\n${files}\n\nReview the diff with git first, group related changes into one or more commits with concise conventional commit messages (subject under 72 characters, body saying why), and run the commits yourself. Do not push.",
          "scope": "machine",
          "editPresentation": "multilineText",
          "markdownDescription": "Prompt template for “oco: Ask Agent to Commit Changes” (also the “Commit with OpenCode” button in the Source Control title bar). Placeholders: `${branch}` current branch, `${count}` number of changed files, `${files}` up to 20 changed file paths, one per line. The rendered text is added to the main panel's session draft and never sent automatically; the agent runs git itself, oco never does. Leave empty for the built-in template. User settings only (machine scope), so a repository cannot inject text into your prompts."
        },
        "oco.git.prPrompt": {
          "type": "string",
          "default": "Open a pull request for the current branch.\nBranch: ${branch}\nUncommitted changes (${count}):\n${files}\n\nIf there are uncommitted changes, commit them first. Push the branch and open the pull request with the gh CLI (or this repository's equivalent) with a title under 70 characters, a summary of what changed and why, and how it was tested. Do not merge it. Report the pull request URL when done.",
          "scope": "machine",
          "editPresentation": "multilineText",
          "markdownDescription": "Prompt template for “oco: Ask Agent to Open a Pull Request”. Placeholders: `${branch}` current branch, `${count}` number of changed files, `${files}` up to 20 changed file paths, one per line. The rendered text is added to the main panel's session draft and never sent automatically; the agent runs git itself, oco never does. Leave empty for the built-in template. User settings only (machine scope), so a repository cannot inject text into your prompts."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oco",
          "title": "oco",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "oco": [
        {
          "type": "webview",
          "id": "oco.sessions",
          "name": "Sessions",
          "contextualTitle": "oco"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --alias:@oco/contracts=../../packages/contracts/src/bridge.ts"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode you can view sessions, but you cannot create sessions or run session actions that have side effects.",
      "restrictedConfigurations": [
        "oco.serverUrl",
        "oco.serverUsername"
      ]
    }
  }
}
