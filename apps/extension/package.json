{
  "name": "oco",
  "displayName": "oco (OpenCode for VS Code)",
  "description": "OpenCode v1 sessions in the VS Code sidebar and editor tabs (attached server).",
  "version": "0.0.1",
  "publisher": "oco-local-test",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:oco.chat",
    "onView:oco.sessions"
  ],
  "contributes": {
    "commands": [
      {
        "command": "oco.openSession",
        "title": "Open Session",
        "category": "oco",
        "icon": "$(go-to-file)"
      },
      {
        "command": "oco.newSession",
        "title": "New Session",
        "category": "oco",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.renameSession",
        "title": "Rename Session",
        "category": "oco",
        "icon": "$(edit)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oco.searchSessions",
        "title": "Search Sessions",
        "category": "oco",
        "icon": "$(search)"
      },
      {
        "command": "oco.clearSearch",
        "title": "Clear Session Search",
        "category": "oco",
        "icon": "$(clear-all)"
      },
      {
        "command": "oco.reconnect",
        "title": "Reconnect",
        "category": "oco",
        "icon": "$(refresh)"
      },
      {
        "command": "oco.openSettings",
        "title": "Open Settings",
        "category": "oco",
        "icon": "$(gear)"
      },
      {
        "command": "oco.addSelectionToDraft",
        "title": "Add Selection to Session Draft",
        "category": "oco"
      },
      {
        "command": "oco.setServerPassword",
        "title": "Set Server Password",
        "category": "oco"
      },
      {
        "command": "oco.debugState",
        "title": "Debug State",
        "category": "oco"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oco.newSession",
          "when": "view == oco.sessions",
          "group": "navigation@1"
        },
        {
          "command": "oco.searchSessions",
          "when": "view == oco.sessions",
          "group": "navigation@2"
        },
        {
          "command": "oco.clearSearch",
          "when": "view == oco.sessions && oco.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "oco.reconnect",
          "when": "view == oco.sessions",
          "group": "navigation@4"
        },
        {
          "command": "oco.openSettings",
          "when": "view == oco.sessions",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "oco.openSession",
          "when": "view == oco.sessions && viewItem == oco.session",
          "group": "inline@1"
        },
        {
          "command": "oco.renameSession",
          "when": "view == oco.sessions && viewItem == oco.session",
          "group": "inline@2"
        },
        {
          "command": "oco.openSession",
          "when": "view == oco.sessions && viewItem == oco.session",
          "group": "1_open@1"
        },
        {
          "command": "oco.renameSession",
          "when": "view == oco.sessions && viewItem == oco.session",
          "group": "2_edit@1"
        }
      ],
      "commandPalette": [
        {
          "command": "oco.clearSearch",
          "when": "oco.searchActive"
        }
      ],
      "editor/context": [
        {
          "command": "oco.addSelectionToDraft",
          "group": "oco@1"
        }
      ]
    },
    "configuration": {
      "title": "oco",
      "properties": {
        "oco.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4096",
          "scope": "machine",
          "markdownDescription": "已运行的 OpenCode 服务地址，只写 origin，例如 `http://127.0.0.1:4096` 或 `https://oc.example.com`；不要带路径、账号密码。仅在用户设置中生效（machine 范围），工作区/仓库不能覆盖。oco 只连接该服务，不会启动、停止或修改它。修改后自动重连；已打开的会话标签页保持绑定原地址，不会迁移到新地址。"
        },
        "oco.serverUsername": {
          "type": "string",
          "default": "opencode",
          "scope": "machine",
          "markdownDescription": "连接服务使用的 HTTP Basic 用户名，默认 `opencode`，与服务端设置的用户名一致。**密码不在这里填写**：执行命令“oco: Set Server Password”，密码保存在 VS Code SecretStorage（按地址+用户名区分），不写入 settings.json。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oco",
          "title": "OpenCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "oco": [
        {
          "id": "oco.sessions",
          "name": "Sessions",
          "contextualTitle": "OpenCode"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "oco.sessions",
        "when": "oco.connState == unconfigured && oco.connIssue == folder",
        "contents": "oco 未就绪：需要先打开一个工作区文件夹。\n[打开文件夹](command:workbench.action.files.openFolder)"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == unconfigured && oco.connIssue != folder",
        "contents": "服务地址设置无效（见上方原因）。\n[打开设置](command:oco.openSettings)"
      },
      {
        "view": "oco.sessions",
        "when": "!oco.connState || oco.connState == connecting",
        "contents": "正在连接 OpenCode 服务……"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == unauthorized",
        "contents": "服务要求认证，用户名或密码不正确（密码未设置也会如此）。\n[设置密码](command:oco.setServerPassword)\n[打开设置](command:oco.openSettings)"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == error",
        "contents": "无法连接 OpenCode 服务（服务离线或地址不对），正在按退避间隔重试。\n[立即重连](command:oco.reconnect)\n[打开设置](command:oco.openSettings)"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == reconnecting",
        "contents": "连接中断，正在重连……\n[立即重连](command:oco.reconnect)\n[打开设置](command:oco.openSettings)"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == connected && !oco.searchActive && isWorkspaceTrusted",
        "contents": "当前工作区还没有 OpenCode 会话。\n[新建会话](command:oco.newSession)"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == connected && !oco.searchActive && !isWorkspaceTrusted",
        "contents": "当前工作区还没有会话。受限模式下不能新建会话。"
      },
      {
        "view": "oco.sessions",
        "when": "oco.connState == connected && oco.searchActive",
        "contents": "没有匹配的会话。\n[清除搜索](command:oco.clearSearch)"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --alias:@oco/contracts=../../packages/contracts/src/bridge.ts"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式下可以查看会话，但不能创建会话或执行有副作用的会话操作。",
      "restrictedConfigurations": [
        "oco.serverUrl",
        "oco.serverUsername"
      ]
    }
  }
}
